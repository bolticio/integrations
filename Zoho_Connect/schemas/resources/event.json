{
    "getGroups": {
        "definition": {
            "url": "https://connect.zoho.in/pulse/api/allGroups?scopeID={{parameters.scope_id}}&isRecentSort=true",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.status}}",
                    "error": "{{response.data}}",
                    "message": "{{response.data.message || response.data.error}}"
                },
                "output": "{{response.data.allGroups.groups}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Event",
                        "value": "event.create",
                        "description": "Create a new event in Zoho Connect."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Choose an action for Event.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select operation"
            },
            "name": "operation"
        }
    ],
    "getNetworks": {
        "definition": {
            "qs": {},
            "url": "https://connect.zoho.in/pulse/api/allScopes",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": "{{response.data}}",
                "output": "{{response.data.allScopes.scopes}}"
            }
        }
    },
    "getNetworkUsers": {
        "definition": {
            "url": "https://connect.zoho.in/pulse/nativeapi/orgMembers?scopeID={{parameters.scope_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.status}}",
                    "error": "{{response.data}}",
                    "message": "{{response.data.message || response.data.error}}"
                },
                "output": "{{response.data.orgMembers.usersDetails}}"
            }
        }
    },
    "create": {
        "definition": {
            "qs": {
                "desc": "{{parameters.desc}}",
                "title": "{{parameters.title}}",
                "allDay": "{{parameters.allDay}}",
                "endMin": "{{parameters.endMin}}",
                "fields": "{{parameters.fields}}",
                "endDate": "{{parameters.endDate}}",
                "endHour": "{{parameters.endHour}}",
                "endYear": "{{parameters.endYear}}",
                "scopeID": "{{parameters.scope_id}}",
                "endMonth": "{{parameters.endMonth}}",
                "location": "{{parameters.location}}",
                "startMin": "{{parameters.startMin}}",
                "startDate": "{{parameters.startDate}}",
                "startHour": "{{parameters.startHour}}",
                "startYear": "{{parameters.startYear}}",
                "startMonth": "{{parameters.startMonth}}",
                "intervalDay": "{{parameters.intervalDay}}",
                "partitionId": "{{parameters.partitionId}}",
                "intervalHour": "{{parameters.intervalHour}}",
                "invitedGroups": "{{parameters.invitedGroups}}",
                "intervalMinute": "{{parameters.intervalMinute}}",
                "invitedMembers": "{{parameters.invitedMembers}}"
