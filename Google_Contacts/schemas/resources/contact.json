    "updatecontact": {
        "definition": {
            "url": "https://people.googleapis.com/v1/{{parameters.resourceName}}:updateContact?updatePersonFields=names,emailAddresses,phoneNumbers",
            "body": {
                "etag": "{{parameters.etag}}",
                "names": [
                    {
                        "givenName": "{{parameters.givenName}}",
                        "familyName": "{{parameters.familyName}}"
                    }
                ],
                "phoneNumbers": [
                    {
                        "type": "mobile",
                        "value": "{{parameters.phone}}"
                    }
                ],
                "emailAddresses": [
                    {
                        "value": "{{parameters.email}}"
                    }
                ]
            },
            "method": "patch",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "if (body.phoneNumbers && body.phoneNumbers.length > 0) {\n  let phone = body.phoneNumbers[0].value;\n\n  if (phone !== undefined && phone !== null) {\n    phone = String(phone).trim();\n\n    body.phoneNumbers[0].value = phone;\n    body.phoneNumbers[0].type = 'mobile';\n  }\n\n  if (!phone) {\n    delete body.phoneNumbers;\n  }\n}\n\nreturn body;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "google_contacts",
                            "secret": "{{parameters.secret}}",
                            "resource": "contact",
                            "operation": "contact.updateContact",
                            "loadOptionsMethod": "loadContacts"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "resourceName"
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Choose a Google Contact to update",
                    "displayName": "Contact",
                    "displayType": "autocomplete",
                    "placeholder": "Select a Contact"
                },
                "name": "resourceName"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "google_contacts",
                            "secret": "{{parameters.secret}}",
                            "resource": "contact",
                            "operation": "contact.updateContact",
                            "loadOptionsMethod": "loadContacts"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "etag"
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "ETag of the contact (required for update)",
                    "displayName": "ETag",
                    "displayType": "autocomplete",
                    "placeholder": "Select a Contact",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "resourceName",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "etag"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the first name of the contact.",
                    "displayName": "First Name",
                    "displayType": "text",
                    "placeholder": "Enter first name"
                },
                "name": "givenName"
            },
            {
                "meta": {
                    "description": "Surname of the contact.",
                    "displayName": "Last Name",
                    "displayType": "text",
                    "placeholder": "Provide last name"
                },
                "name": "familyName"
            },
            {
                "meta": {
                    "description": "Enter the email address of the contact.",
                    "displayName": "Email",
                    "displayType": "email",
                    "placeholder": "Email address"
                },
                "name": "email"
            },
            {
                "meta": {
                    "description": "Enter the phone number of the contact.",
                    "displayName": "Phone Number",
                    "displayType": "number",
                    "placeholder": "Mobile number"
                },
                "name": "phone"
            }
        ]
    },
    "findcontact": {
        "definition": {
            "url": "https://people.googleapis.com/v1/people:searchContacts?query={{parameters.inputquery}}&readMask=names,emailAddresses,phoneNumbers",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "description": "Enter the email address or name of the contact.",
                    "displayName": "Search Contact",
                    "displayType": "text",
                    "placeholder": "Search contact by mail or name"
                },
                "name": "inputquery"
            }
