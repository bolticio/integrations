{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Contact",
                        "value": "contact.createcontact",
                        "description": "Create a New Contact."
                    },
                    {
                        "label": "Delete Contact",
                        "value": "contact.deletecontact",
                        "description": "Delete an Existing Contact."
                    },
                    {
                        "label": "Update Contact",
                        "value": "contact.updatecontact",
                        "description": "Update an Existing Contact."
                    },
                    {
                        "label": "Search Contact",
                        "value": "contact.findcontact",
                        "description": "Search For a Contact."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "contact",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "loadContacts": {
        "definition": {
            "url": "https://people.googleapis.com/v1/people/me/connections?personFields=names,emailAddresses",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.connections}}"
            },
            "transform": {
                "output": "var list = output; if (list && list.data) list = list.data; var res = []; for (var i = 0; i < (list || []).length; i++) { var x = list[i]; while (x && x.d) { x = x.d; } var n = (x && x.names && x.names[0]) ? x.names[0] : null; res.push({ etag: x ? x.etag : undefined, resourceName: x ? x.resourceName : undefined, name: n ? n.displayName : (x ? x.name : undefined) }); } return res;"
            }
        }
    },
    "deletecontact": {
        "definition": {
            "url": "https://people.googleapis.com/v1/{{parameters.resourcename_id}}:deleteContact",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.status}}"
            },
            "transform": {
                "output": "return { message: 'contact deleted successfully' };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "google_contacts",
                            "secret": "{{parameters.secret}}",
                            "resource": "contact",
                            "operation": "contact.deleteContact",
                            "loadOptionsMethod": "loadContacts"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "resourceName"
                    },
                    "htmlProps": {
                        "allowDynamic": false
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Choose a contact to delete",
                    "displayName": "Contacts",
                    "displayType": "autocomplete",
                    "placeholder": "Select a contact"
                },
                "name": "resourcename_id"
            }
        ]
    },
