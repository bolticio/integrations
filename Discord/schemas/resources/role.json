{
    "getRoles": {
        "definition": {
            "url": "https://discord.com/api/v10/guilds/{{parameters.guild_id}}/roles",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "output": "var res=[]; for (var i=0;i<(output||[]).length;i++){ var r=output[i]; if (r && r.name !== '@everyone' && r.name !== 'Boltic') res.push(r); } return res;"
            }
        }
    },
    "getUsers": {
        "definition": {
            "qs": {
                "limit": 1000
            },
            "url": "https://discord.com/api/v10/guilds/{{parameters.guild_id}}/members",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{ response.data }}"
            },
            "transform": {
                "output": "var list = output; if (list && list.data) list = list.data; var res=[]; for (var i=0;i<(list||[]).length;i++){ var x = list[i]; while (x && x.d) x = x.d; res.push(x && x.user ? x.user : x); } return res;"
            }
        }
    },
    "getGuilds": {
        "definition": {
            "url": "https://discord.com/api/v10/users/@me/guilds",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "pagination": {
                "qs": {
                    "after": "{{response.data[response.data.length - 1].id}}",
                    "limit": 200
                },
                "type": "cursor",
                "default": {
                    "after": null,
                    "limit": 200
                },
                "condition": "{{response.data.length}} === 200"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Role",
                        "value": "role.createrole",
                        "description": "Create a new role in a server."
                    },
                    {
                        "label": "Delete Role",
                        "value": "role.deleterole",
                        "description": "Delete an existing role from a server."
                    },
                    {
                        "label": "Add Role to User",
                        "value": "role.addrole",
                        "description": "Assign a role to the server member."
                    },
                    {
                        "label": "Remove Role from user",
                        "value": "role.removerole",
                        "description": "Remove a role from the server member."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "role",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "createrole": {
        "definition": {
            "url": "https://discord.com/api/v10/guilds/{{parameters.server_id}}/roles",
            "body": {
                "name": "{{parameters.rolename}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "resource": "role",
                            "operation": "role.addrole",
                            "loadOptionsMethod": "getGuilds"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the server.",
                    "displayName": "Server",
                    "displayType": "autocomplete",
                    "placeholder": "Select the server"
                },
                "name": "server_id"
            },
            {
                "meta": {
                    "validation": {
                        "max": 100,
                        "min": 1,
                        "required": true
                    },
                    "description": "Enter role name, max 100 characters.",
                    "displayName": "Role Name",
                    "displayType": "text",
                    "placeholder": "e.g. Moderator",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "server_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "rolename"
            }
        ]
    },
