{
    "getGuilds": {
        "definition": {
            "url": "https://discord.com/api/v10/users/@me/guilds",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "pagination": {
                "qs": {
                    "after": "{{response.data[response.data.length - 1].id}}",
                    "limit": 200
                },
                "type": "cursor",
                "default": {
                    "after": null,
                    "limit": 200
                },
                "condition": "{{response.data.length}} === 200"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get Current User Servers",
                        "value": "user.currentuserguilds",
                        "description": "List the servers the current user is in."
                    },
                    {
                        "label": "Get Current User's Server Details",
                        "value": "user.currentuserguildmember",
                        "description": "Get the current user's server details."
                    },
                    {
                        "label": "Get User by ID",
                        "value": "user.getuserdetailsbyid",
                        "description": "Get a user by ID."
                    },
                    {
                        "label": "Search Server Users",
                        "value": "user.searchserverusers",
                        "description": "Get a list of users whose username or nickname starts with a provided string."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "user",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getuserdetailsbyid": {
        "definition": {
            "url": "https://discord.com/api/v10/users/{{parameters.user_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "url": "function transformURL(){var uid=(typeof parameters!=='undefined'&&parameters&&parameters.user_id!=null)?parameters.user_id:'{{parameters.user_id}}';uid=String(uid).trim().replace(/\\s+/g,'').replace(/^\\\"|\\\"$/g,'');if(!uid)throw new Error('Invalid user_id');return 'https://discord.com/api/v10/users/'+encodeURIComponent(uid);}return transformURL();"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Discord user ID.",
                    "displayName": "User ID",
                    "displayType": "text",
                    "placeholder": "e.g. 368105370532577280"
                },
                "name": "user_id"
            }
        ]
    },
    "currentuserguilds": {
        "definition": {
            "url": "https://discord.com/api/v10/users/@me/guilds",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    },
    "currentuserguildmember": {
        "definition": {
            "url": "https://discord.com/api/v10/users/@me/guilds/{{parameters.server_id}}/member",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "resource": "user",
                            "operation": "user.currentuserguildmember",
                            "loadOptionsMethod": "getGuilds"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the server.",
                    "displayName": "Server",
                    "displayType": "autocomplete",
                    "placeholder": "Select the server"
                },
                "name": "server_id"
            }
        ]
    },
    "searchserverusers": {
        "definition": {
            "qs": {
                "limit": 1000,
                "query": "{{parameters.username}}"
            },
            "url": "https://discord.com/api/v10/guilds/{{parameters.server_id}}/members/search",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "resource": "user",
                            "operation": "user.searchserverusers",
                            "loadOptionsMethod": "getGuilds"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the server.",
                    "displayName": "Server",
                    "displayType": "autocomplete",
                    "placeholder": "Select the server"
                },
                "name": "server_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Search by username or nickname prefix.",
                    "displayName": "Username Prefix",
                    "displayType": "text",
                    "placeholder": "e.g. alex"
                },
                "name": "username"
            }
        ]
    }
}
