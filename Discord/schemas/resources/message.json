{
    "getUsers": {
        "definition": {
            "qs": {
                "limit": 1000
            },
            "url": "https://discord.com/api/v10/guilds/{{parameters.guild_id}}/members",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{ response.data }}"
            },
            "transform": {
                "output": "var list = output; if (list && list.data) list = list.data; var res=[]; for (var i=0;i<(list||[]).length;i++){ var x = list[i]; while (x && x.d) x = x.d; res.push(x && x.user ? x.user : x); } return res;"
            }
        }
    },
    "getGuilds": {
        "definition": {
            "url": "https://discord.com/api/v10/users/@me/guilds",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "pagination": {
                "qs": {
                    "after": "{{response.data[response.data.length - 1].id}}",
                    "limit": 200
                },
                "type": "cursor",
                "default": {
                    "after": null,
                    "limit": 200
                },
                "condition": "{{response.data.length}} === 200"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Send Channel Message",
                        "value": "message.sendchannelmessage",
                        "description": "Send a message to a channel."
                    },
                    {
                        "label": "Get Channel Messages",
                        "value": "message.getchannelmessages",
                        "description": "List messages in a channel."
                    },
                    {
                        "label": "Get Channel Message by ID",
                        "value": "message.getchannelmessagebyid",
                        "description": "Get a message by ID."
                    },
                    {
                        "label": "Delete Channel Message by ID",
                        "value": "message.deletemessagebyid",
                        "description": "Delete a message by ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "message",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getChannels": {
