                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const content = `{{parameters.content}}`;\nconst ttsRaw = `{{parameters.tts}}`;\nconst pingRaw = `{{parameters.allowed_mentions}}`;\n\nconst tts = (ttsRaw === 'true' || ttsRaw === '1' || ttsRaw === true);\nconst ping = (pingRaw === 'true' || pingRaw === '1' || pingRaw === true );\n\nreturn {\n  content,\n  tts,\n  allowed_mentions: ping ? { parse: ['users','roles','everyone'] } : { parse: [] }\n};"
            }
        },
