    "sendchannelmessage": {
        "definition": {
            "url": "https://discord.com/api/v10/channels/{{parameters.channel_id}}/messages",
            "body": "{{transform.body}}",
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const content = `{{parameters.content}}`;\nconst ttsRaw = `{{parameters.tts}}`;\nconst pingRaw = `{{parameters.allowed_mentions}}`;\n\nconst tts = (ttsRaw === 'true' || ttsRaw === '1' || ttsRaw === true);\nconst ping = (pingRaw === 'true' || pingRaw === '1' || pingRaw === true );\n\nreturn {\n  content,\n  tts,\n  allowed_mentions: ping ? { parse: ['users','roles','everyone'] } : { parse: [] }\n};"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "resource": "channel",
                            "operation": "channel.renamechannel",
                            "loadOptionsMethod": "getGuilds"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the server.",
                    "displayName": "Server",
                    "displayType": "autocomplete",
                    "placeholder": "Select the server"
                },
                "name": "server_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "guild_id": "{{parameters.server_id}}",
                            "resource": "message",
                            "operation": "message.sendchannelmessage",
                            "loadOptionsMethod": "getChannels"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id",
                        "condition": "{{parameters.server_id}}"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the channel.",
                    "displayName": "Channel",
                    "displayType": "autocomplete",
                    "placeholder": "Select the channel",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "server_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "channel_id"
            },
            {
                "meta": {
                    "htmlProps": {
                        "maxRows": 4,
                        "minRows": 4
                    },
                    "validation": {
                        "required": true,
                        "maxLength": 2000,
                        "minLength": 1,
                        "requiredDetail": {
                            "errorMsg": "Message Text is required"
                        }
                    },
                    "description": "Message content (up to 2000 characters).",
                    "displayName": "Message Content",
                    "displayType": "textarea",
                    "placeholder": "Type your message"
                },
                "name": "content"
            },
            {
                "meta": {
                    "value": false,
                    "readOnly": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "disabled": false
                    },
                    "description": "Send this message using text-to-speech.",
                    "displayName": "Text-to-Speech (TTS)",
                    "displayType": "toggle",
                    "placeholder": "Enable text-to-speech"
                },
                "name": "tts"
            },
            {
                "meta": {
                    "value": false,
                    "readOnly": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "disabled": false
                    },
                    "description": "Users, roles and everyone/here mentions will be pinged if you choose true. Enter the user ID to mention in the message content (format: <@1465925708093329503>).",
                    "displayName": "Ping Username, Role and Everyone Mentions",
                    "displayType": "toggle",
                    "placeholder": "Allow mentions"
                },
                "name": "allowed_mentions"
            }
        ]
    }
