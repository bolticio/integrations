                            "name": "discord",
                            "guild_id": "{{parameters.server_id}}",
                            "resource": "channel",
                            "bot_token": "{{parameters.bot_token}}",
                            "operation": "channel.renamechannel",
                            "loadOptionsMethod": "getChannels"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id",
                        "condition": "{{parameters.server_id}}"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the channel to rename.",
                    "displayName": "Channel",
                    "displayType": "autocomplete",
                    "placeholder": "Select the channel to rename",
