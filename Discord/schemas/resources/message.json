    "custom_api": {
        "definition": {
            "qs": "{{parameters.query_params}}",
            "url": "{{parameters.base_url}}",
            "body": "{{parameters.body}}",
            "method": "{{parameters.method}}",
            "headers": "{{parameters.headers}}",
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "url": "function transformURL(){var u=(typeof parameters!=='undefined'&&parameters&&parameters.base_url!=null)?parameters.base_url:'{{parameters.base_url}}';u=String(u).trim().replace(/\\s+/g,'').replace(/^\\\"|\\\"$/g,'');if(!u)throw new Error('Invalid base_url');return u;}return transformURL();",
                "headers": "function transformHeaders(){var h=(typeof parameters!=='undefined'&&parameters&&parameters.headers!=null)?parameters.headers:'{{parameters.headers}}';if(typeof h==='string'){try{h=JSON.parse(h);}catch(e){h={};}}if(!h||typeof h!=='object')h={};if(!h.Accept)h.Accept='application/json';if(!h['Content-Type'])h['Content-Type']='application/json';if(!h.Authorization)h.Authorization='Bearer {{secrets.access_token}}';return h;}return transformHeaders();"
            }
        },
