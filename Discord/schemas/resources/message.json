    "getchannelmessagebyid": {
        "definition": {
            "url": "https://discord.com/api/v10/channels/{{parameters.channel_id}}/messages/{{parameters.message_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "url": "function transformURL(){var cid=(typeof parameters!=='undefined'&&parameters&&parameters.channel_id!=null)?parameters.channel_id:'{{parameters.channel_id}}';var mid=(typeof parameters!=='undefined'&&parameters&&parameters.message_id!=null)?parameters.message_id:'{{parameters.message_id}}';mid=String(mid).trim().replace(/\\s+/g,'').replace(/^\\\"|\\\"$/g,'');if(!cid)throw new Error('Invalid channel_id');if(!mid)throw new Error('Invalid message_id');return 'https://discord.com/api/v10/channels/'+encodeURIComponent(cid)+'/messages/'+encodeURIComponent(mid);}return transformURL();"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "resource": "message",
                            "operation": "message.getchannelmessagebyid",
                            "loadOptionsMethod": "getGuilds"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the server.",
                    "displayName": "Server",
                    "displayType": "autocomplete",
                    "placeholder": "Select the server"
                },
                "name": "server_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "guild_id": "{{parameters.server_id}}",
                            "resource": "message",
                            "operation": "message.getchannelmessagebyid",
                            "loadOptionsMethod": "getChannels"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id",
                        "condition": "{{parameters.server_id}}"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the channel.",
                    "displayName": "Channel",
                    "displayType": "autocomplete",
                    "placeholder": "Select the channel",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "server_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "channel_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the Message ID.",
                    "displayName": "Message ID",
                    "displayType": "text",
                    "placeholder": "e.g. 1467639497096433736",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "server_id",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "channel_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "message_id"
            }
        ]
    },
