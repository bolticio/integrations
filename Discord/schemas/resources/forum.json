{
    "getForums": {
        "definition": {
            "url": "https://discord.com/api/v10/guilds/{{parameters.guild_id}}/channels",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "output": "const arr = Array.isArray(output) ? output : []; return arr.filter(ch => ch && ch.type === 15);"
            }
        }
    },
    "getGuilds": {
        "definition": {
            "url": "https://discord.com/api/v10/users/@me/guilds",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "pagination": {
                "qs": {
                    "after": "{{response.data[response.data.length - 1].id}}",
                    "limit": 200
                },
                "type": "cursor",
                "default": {
                    "after": null,
                    "limit": 200
                },
                "condition": "{{response.data.length}} === 200"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create New Forum Post",
                        "value": "forum.createforumpost",
                        "description": "Create a new post in a forum channel."
                    },
                    {
                        "label": "Send Message in Forum Post",
                        "value": "forum.sendmessageinforumpost",
                        "description": "Send a new message in forum post."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "forum",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getChannels": {
        "definition": {
            "url": "https://discord.com/api/v10/guilds/{{parameters.guild_id}}/channels",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        }
    },
    "getForumThreads": {
        "definition": {
            "url": "https://discord.com/api/v10/guilds/{{parameters.guild_id}}/threads/active",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.threads}}"
            }
        }
    },
    "createforumpost": {
        "definition": {
            "url": "https://discord.com/api/v10/channels/{{parameters.forum_id}}/threads",
            "body": "{{transform.body}}",
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const name = `{{parameters.name}}`; const content = `{{parameters.content}}`;  return { name, message: { content } };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "resource": "forum",
                            "operation": "forum.createforumpost",
                            "loadOptionsMethod": "getGuilds"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select a server.",
                    "displayName": "Server",
                    "displayType": "autocomplete",
                    "placeholder": "Select a server"
                },
                "name": "server_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "forum_id": "{{parameters.forum_id}}",
                            "guild_id": "{{parameters.server_id}}",
                            "resource": "forum",
                            "operation": "forum.createforumpost",
                            "loadOptionsMethod": "getForums"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id",
                        "condition": "{{parameters.server_id}}"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the forum channel to post in.",
                    "displayName": "Forum Channel",
                    "displayType": "autocomplete",
                    "placeholder": "Select a forum channel",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "server_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "forum_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Title for the new forum post.",
                    "displayName": "Post Title",
                    "displayType": "text",
                    "placeholder": "Enter a post title"
                },
                "name": "name"
            },
            {
                "meta": {
                    "htmlProps": {
                        "maxRows": 4,
                        "minRows": 4
                    },
                    "validation": {
                        "required": true,
                        "maxLength": 2000,
                        "minLength": 1,
                        "requiredDetail": {
                            "errorMsg": "Post Message is required."
                        }
                    },
                    "description": "Content of the first message (1-2000 characters).",
                    "displayName": "Post Message",
                    "displayType": "textarea",
                    "placeholder": "Write your message"
                },
                "name": "content"
            }
        ]
    },
    "sendmessageinforumpost": {
        "definition": {
            "url": "https://discord.com/api/v10/channels/{{parameters.thread_id}}/messages",
            "body": "{{transform.body}}",
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const content = `{{parameters.content}}`; const ttsRaw = `{{parameters.tts}}`; const pingRaw = `{{parameters.allowed_mentions}}`; const tts = (ttsRaw === 'true' || ttsRaw === '1' || ttsRaw === true); const ping = (pingRaw === 'true' || pingRaw === '1' || pingRaw === true); return { content, tts, allowed_mentions: ping ? { parse: ['users','roles','everyone'] } : { parse: [] } };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "resource": "forum",
                            "operation": "forum.sendmessageinforumpost",
                            "loadOptionsMethod": "getGuilds"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select a server.",
                    "displayName": "Server",
                    "displayType": "autocomplete",
                    "placeholder": "Select a server"
                },
                "name": "server_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "forum_id": "{{parameters.forum_id}}",
                            "guild_id": "{{parameters.server_id}}",
                            "resource": "forum",
                            "operation": "forum.sendmessageinforumpost",
                            "loadOptionsMethod": "getForumThreads"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id",
                        "condition": "{{parameters.server_id}}"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the forum post (thread) to reply to.",
                    "displayName": "Forum Post",
                    "displayType": "autocomplete",
                    "placeholder": "Select a forum post",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "server_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "thread_id"
            },
            {
                "meta": {
                    "htmlProps": {
                        "maxRows": 4,
                        "minRows": 4
                    },
                    "validation": {
                        "required": true,
                        "maxLength": 2000,
                        "minLength": 1,
                        "requiredDetail": {
                            "errorMsg": "Message is required."
                        }
                    },
                    "description": "Message content (1-2000 characters).",
                    "displayName": "Message",
                    "displayType": "textarea",
                    "placeholder": "Write your reply"
                },
                "name": "content"
            },
            {
                "meta": {
                    "value": false,
                    "readOnly": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "disabled": false
                    },
                    "description": "Send this message using text-to-speech.",
                    "displayName": "Text-to-Speech (TTS)",
                    "displayType": "toggle",
                    "placeholder": "Enable text-to-speech"
                },
                "name": "tts"
            },
            {
                "meta": {
                    "value": false,
                    "readOnly": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "disabled": false
                    },
                    "description": "Users, roles and everyone/here mentions will be pinged if you choose true. Enter the user ID to mention in the message content (format: <@1465925708093329503>).",
                    "displayName": "Ping Username, Role and Everyone Mentions",
                    "displayType": "toggle",
                    "placeholder": "Allow mentions"
                },
                "name": "allowed_mentions"
            }
        ]
    }
}
