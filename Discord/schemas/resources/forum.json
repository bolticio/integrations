    "custom_api": {
        "definition": {
            "qs": "{{parameters.query_params}}",
            "url": "{{parameters.base_url}}",
            "body": "{{parameters.body}}",
            "method": "{{parameters.method}}",
            "headers": "{{parameters.headers}}",
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "url": "function transformURL(){var u=(typeof parameters!=='undefined'&&parameters&&parameters.base_url!=null)?parameters.base_url:'{{parameters.base_url}}';u=String(u).trim().replace(/\\s+/g,'').replace(/^\\\"|\\\"$/g,'');if(!u)throw new Error('Invalid base_url');return u;}return transformURL();",
                "headers": "function transformHeaders(){var h=(typeof parameters!=='undefined'&&parameters&&parameters.headers!=null)?parameters.headers:'{{parameters.headers}}';if(typeof h==='string'){try{h=JSON.parse(h);}catch(e){h={};}}if(!h||typeof h!=='object')h={};if(!h.Accept)h.Accept='application/json';if(!h['Content-Type'])h['Content-Type']='application/json';if(!h.Authorization)h.Authorization='Bearer {{secrets.access_token}}';return h;}return transformHeaders();"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": "get",
                    "options": [
                        {
                            "label": "GET",
                            "value": "get"
                        },
                        {
                            "label": "PUT",
                            "value": "put"
                        },
                        {
                            "label": "POST",
                            "value": "post"
                        },
                        {
                            "label": "PATCH",
                            "value": "patch"
                        },
                        {
                            "label": "DELETE",
                            "value": "delete"
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": "The HTTP Method to be used for the request.",
                    "displayName": "Method",
                    "displayType": "select",
                    "placeholder": "Select HTTP method"
                },
                "name": "method"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The URL of the HTTP Request.",
                    "displayName": "Base URL",
                    "displayType": "text",
                    "placeholder": "Eg. https://discord.com/api/v10/channels/112121343201340"
                },
                "name": "base_url"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": true,
                                    "requiredDetail": {
                                        "errorMsg": "Key is required"
                                    }
                                },
                                "displayName": "key",
                                "displayType": "text"
                            },
                            "name": "key"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true,
                                    "requiredDetail": {
                                        "errorMsg": "Value is required"
                                    }
                                },
                                "displayName": "value",
                                "displayType": "text"
                            },
                            "name": "value"
                        }
                    ],
                    "htmlProps": {
                        "allowAdd": true
                    },
                    "description": "You don't have to add authorization headers, we already did that for you.",
                    "displayName": "Headers",
                    "displayType": "keyvalue",
                    "placeholder": "Add header key–value pairs"
                },
                "name": "headers"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": true,
                                    "requiredDetail": {
                                        "errorMsg": "Key is required"
                                    }
                                },
                                "displayName": "key",
                                "displayType": "text"
                            },
                            "name": "key"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true,
                                    "requiredDetail": {
                                        "errorMsg": "Value is required"
                                    }
                                },
                                "displayName": "value",
                                "displayType": "text"
                            },
                            "name": "value"
                        }
                    ],
                    "htmlProps": {
                        "allowAdd": true
                    },
                    "description": "Optional query string parameters to be sent with the request.",
                    "displayName": "Query String",
                    "displayType": "keyvalue",
                    "placeholder": "Add query string key–value pairs"
                },
                "name": "query_params"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "md",
                        "language": "json",
                        "fullscreen": true,
                        "showSuggestions": true
                    },
                    "description": "The payload (body) of the HTTP request.",
                    "displayName": "Body",
                    "displayType": "code",
                    "placeholder": "Enter JSON body (optional)"
                },
                "name": "body"
            }
        ]
    },
    "renamechannel": {
        "definition": {
            "url": "https://discord.com/api/v10/channels/{{parameters.channel_id}}",
            "body": {
                "name": "{{parameters.name}}"
            },
            "method": "patch",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
