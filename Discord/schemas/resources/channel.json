{
    "getGuilds": {
        "definition": {
            "url": "https://discord.com/api/v10/users/@me/guilds",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "pagination": {
                "qs": {
                    "after": "{{response.data[response.data.length - 1].id}}",
                    "limit": 200
                },
                "type": "cursor",
                "default": {
                    "after": null,
                    "limit": 200
                },
                "condition": "{{response.data.length}} === 200"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Rename Channel",
                        "value": "channel.renamechannel",
                        "description": "Rename a channel."
                    },
                    {
                        "label": "Delete Channel",
                        "value": "channel.deletechannel",
                        "description": "Delete a channel."
                    },
                    {
                        "label": "Search Channel by Name",
                        "value": "channel.searchchannelbyname",
                        "description": "Search a channel by it's name."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "channel",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getChannels": {
        "definition": {
            "url": "https://discord.com/api/v10/guilds/{{parameters.guild_id}}/channels",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        }
    },
    "getForumThreads": {
        "definition": {
            "url": "https://discord.com/api/v10/guilds/{{parameters.guild_id}}/threads/active",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.threads}}"
            }
        }
    },
    "getTextChannels": {
        "definition": {
            "url": "https://discord.com/api/v10/guilds/{{parameters.guild_id}}/channels",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "output": "const arr = Array.isArray(output) ? output : []; return arr.filter(ch => ch && ch.type === 0);"
            }
        }
    },
    "renamechannel": {
        "definition": {
            "url": "https://discord.com/api/v10/channels/{{parameters.channel_id}}",
            "body": {
                "name": "{{parameters.name}}"
            },
            "method": "patch",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "resource": "channel",
                            "operation": "channel.renamechannel",
                            "loadOptionsMethod": "getGuilds"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the server.",
                    "displayName": "Server",
                    "displayType": "autocomplete",
                    "placeholder": "Select the server"
                },
                "name": "server_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "guild_id": "{{parameters.server_id}}",
                            "resource": "channel",
                            "operation": "channel.renamechannel",
                            "loadOptionsMethod": "getChannels"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id",
                        "condition": "{{parameters.server_id}}"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the channel to rename.",
                    "displayName": "Channel",
                    "displayType": "autocomplete",
                    "placeholder": "Select the channel to rename",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "server_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "channel_id"
            },
            {
                "meta": {
                    "validation": {
                        "max": 100,
                        "min": 1,
                        "required": true
                    },
                    "description": "Enter new channel name (1-100 characters).",
                    "displayName": "New Channel Name",
                    "displayType": "text",
                    "placeholder": "e.g. announcements",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "channel_id",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "server_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "name"
            }
        ]
    },
    "deletechannel": {
        "definition": {
            "url": "https://discord.com/api/v10/channels/{{parameters.channel_id}}",
            "method": "delete",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "resource": "channel",
                            "operation": "channel.renamechannel",
                            "loadOptionsMethod": "getGuilds"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the server.",
                    "displayName": "Server",
                    "displayType": "autocomplete",
                    "placeholder": "Select the server"
                },
                "name": "server_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "guild_id": "{{parameters.server_id}}",
                            "resource": "channel",
                            "operation": "channel.deletechannel",
                            "loadOptionsMethod": "getChannels"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id",
                        "condition": "{{parameters.server_id}}"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the channel to delete.",
                    "displayName": "Channel",
                    "displayType": "autocomplete",
                    "placeholder": "Select the channel",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "server_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "channel_id"
            }
        ]
    },
    "searchchannelbyname": {
        "definition": {
            "url": "https://discord.com/api/v10/guilds/{{parameters.server_id}}/channels",
            "body": {
                "value": "{{parameters.channelname}}"
            },
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bot {{secrets.bot_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{ response.data }}"
            },
            "transform": {
                "url": "function transformURL(){var sid=(typeof parameters!=='undefined'&&parameters&&parameters.server_id!=null)?parameters.server_id:'{{parameters.server_id}}';sid=String(sid).trim().replace(/\\s+/g,'').replace(/^\\\"|\\\"$/g,'');if(!sid)throw new Error('Invalid server_id');return 'https://discord.com/api/v10/guilds/'+encodeURIComponent(sid)+'/channels';}return transformURL();",
                "output": "var q = String('{{parameters.channelname}}').toLowerCase(); var res = []; for (var i=0; i<(output||[]).length; i++){ var c = output[i]; var n = c && c.name ? String(c.name).toLowerCase() : ''; if (n.indexOf(q) !== -1) res.push(c); } return res;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "discord",
                            "secret": "{{parameters.secret}}",
                            "resource": "channel",
                            "operation": "channel.renamechannel",
                            "loadOptionsMethod": "getGuilds"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the server.",
                    "displayName": "Server",
                    "displayType": "autocomplete",
                    "placeholder": "Select the server"
                },
                "name": "server_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter channel name to search.",
                    "displayName": "Channel Name",
                    "displayType": "text",
                    "placeholder": "e.g. announcements",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "server_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "channelname"
            }
        ]
    }
}
