{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get Agent",
                        "value": "agent.get"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "agent",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "get": {
        "definition": {
            "qs": {},
            "url": "https://{{secrets.domain}}.freshchat.com/v2/agents/{{parameters.agent_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.code}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "ID of the agent to retrieve",
                    "displayName": "Agent ID",
                    "displayType": "number",
                    "placeholder": "Enter the Agent ID"
                },
                "name": "agent_id"
            }
        ]
    }
}
