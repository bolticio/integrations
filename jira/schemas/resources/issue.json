            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Issue Id or Key is required."
                        }
                    },
                    "description": "The unique ID or key of the Jira issue, e.g., 'PROJ-123'.",
                    "displayName": "Issue Id or Key",
                    "displayType": "text",
                    "placeholder": "Enter issue id or key here"
                },
                "name": "issueIdOrKey"
            }
        ]
    },
    "searchissuestext": {
        "definition": {
            "qs": {
                "query": "{{parameters.query}}",
                "maxResults": "{{parameters.maxResults}}"
            },
            "url": "https://{{secrets.domain}}/rest/api/3/issue/picker",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}:{{secrets.access_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errorMessages[0]}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Text query is required."
                        }
                    },
                    "description": "A string to search for issues.",
                    "displayName": "Text Query",
                    "displayType": "text",
                    "placeholder": "Enter text search query here"
                },
                "name": "query"
            },
            {
                "meta": {
                    "value": 50,
                    "validation": {
                        "max": 1000,
                        "min": 1,
                        "required": false
                    },
                    "description": "The maximum number of items to return. Max is 1000.",
                    "displayName": "Max Results",
                    "displayType": "number",
                    "placeholder": "Enter max results"
                },
                "name": "maxResults"
            }
        ]
    },
    "createissue": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/api/3/issue",
            "body": {
                "fields": {
                    "project": {
                        "key": "{{parameters.project_key}}"
                    },
                    "summary": "{{parameters.summary}}",
                    "assignee": {
                        "accountId": "{{parameters.assignee_account_id}}"
                    },
                    "priority": {
                        "name": "{{parameters.priority_name}}"
                    },
                    "issuetype": {
                        "name": "{{parameters.issue_type_name}}"
                    },
                    "description": {
                        "type": "doc",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "text": "{{parameters.description}}",
                                        "type": "text"
                                    }
                                ]
                            }
                        ],
                        "version": 1
                    }
                }
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}:{{secrets.access_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            },
            "transformation": {
                "body": "function transformBody(){try{if(body&&body.fields){delete body.fields.priority;}}catch(e){}const f=body&&body.fields?body.fields:{};const out={project:f.project,summary:f.summary,issuetype:f.issuetype};const has=v=>v!=null&&String(v).trim()!=='';const desc=(parameters.description??parameters.descripiton);if(has(desc)){out.description={type:'doc',version:1,content:[{type:'paragraph',content:[{type:'text',text:String(desc).trim()}]}]};}if(has(parameters.priority)&&has(parameters.priority_name)){out.priority=String(parameters.priority_name).trim();}if(has(parameters.assignee_account_id)){out.assignee={accountId:String(parameters.assignee_account_id).trim()};}return {...body,fields:out};}return transformBody();"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "jira",
                            "secret": "{{parameters.secret}}",
                            "resource": "issue",
                            "operation": "issue.createIssue",
                            "loadOptionsMethod": "getAllProjects"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "key"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The Jira project key where the issue will be created e.g., Support",
                    "displayName": "Project Key",
                    "displayType": "select",
                    "placeholder": "Select Project Key",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "secret",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "resource",
                                "value": "issue",
                                "operator": "EQUALS"
                            },
                            {
                                "field": "operation",
                                "value": "issue.createIssue",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "project_key"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "jira",
                            "secret": "{{parameters.secret}}",
                            "resource": "issue",
                            "operation": "issue.createIssue",
                            "project_key": "{{parameters.project_key}}",
                            "loadOptionsMethod": "getAllAccounts"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
