            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "A short, descriptive summary of the issue.",
                    "displayName": "Summary",
                    "displayType": "text",
                    "placeholder": "Enter issue summary"
                },
                "name": "summary"
            },
            {
                "meta": {
