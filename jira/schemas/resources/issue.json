{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get Issue",
                        "value": "issue.getIssue",
                        "description": "Retrieve a single issue by ID or key"
                    },
                    {
                        "label": "Add Comment to Issue",
                        "value": "issue.addCommentToIssue",
                        "description": "Add a comment to an issue"
                    },
                    {
                        "label": "Search Issues",
                        "value": "issue.searchIssuesText",
                        "description": "Search issues by text query"
                    },
                    {
                        "label": "Create Issue",
                        "value": "issue.createIssue",
                        "description": "Create a new issue"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "issue",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getProjects": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/api/3/project/search",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}:{{secrets.access_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errorMessages[0]}}"
                },
                "output": "{{response.data.values}}"
            }
        }
    },
    "getAllIssues": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/api/3/issuetype",
