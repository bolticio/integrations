                                "field": "project_key",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "assignee_account_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "jira",
                            "secret": "{{parameters.secret}}",
                            "resource": "issue",
                            "operation": "issue.createIssue",
                            "loadOptionsMethod": "getAllIssues"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "name"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the Jira issue type available for the chosen project.",
                    "displayName": "Issue Type",
                    "displayType": "select",
                    "placeholder": "Select Issue Type",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "secret",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "resource",
                                "value": "issue",
                                "operator": "EQUALS"
                            },
                            {
                                "field": "operation",
                                "value": "issue.createIssue",
                                "operator": "EQUALS"
                            },
                            {
                                "field": "project_key",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
