                    "placeholder": "Enter description..."
                },
                "name": "description"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "jira",
                            "secret": "{{parameters.secret}}",
                            "resource": "issue",
                            "operation": "issue.createIssue",
                            "loadOptionsMethod": "getAllPriorities"
                        },
                        "method": "post",
                        "urlType": "options",
