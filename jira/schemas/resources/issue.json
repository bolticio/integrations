                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The Atlassian accountId of the assignee.",
                    "displayName": "Assignee Account ID",
                    "displayType": "select",
                    "placeholder": "Select Assignee Account ID",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "secret",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "resource",
                                "value": "issue",
                                "operator": "EQUALS"
                            },
                            {
                                "field": "operation",
                                "value": "issue.createIssue",
                                "operator": "EQUALS"
                            },
