{
    "getAssets": {
        "definition": {
            "url": "https://fsm.zoho.in/fsm/v1/Assets",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.code}}",
                    "message": "{{response.message}}"
                },
                "output": "{{response.data.data}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Request",
                        "value": "fsm_requests.create",
                        "description": "Create a new service request in Zoho FSM"
                    },
                    {
                        "label": "Update Request",
                        "value": "fsm_requests.update",
                        "description": "Update an existing service request in Zoho FSM"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select an operation",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "fsm_requests",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getContacts": {
        "definition": {
            "url": "https://fsm.zoho.in/fsm/v1/Contacts",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.code}}",
                    "message": "{{response.message}}"
                },
                "output": "{{response.data.data}}"
            },
            "transform": {
                "output": "return output.map(contact => ({ ...contact, DisplayName: `${contact.FirstName} ${contact.LastName}` }));"
            }
        }
    },
