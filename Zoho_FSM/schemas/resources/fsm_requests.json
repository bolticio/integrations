    "getContactDetails": {
        "definition": {
            "url": "https://fsm.zoho.in/fsm/v1/Contacts/{{parameters.contact_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
