                "error": {
                    "code": "{{response.code}}",
                    "message": "{{response.message}}"
                },
                "output": "{{response.data.data}}"
            },
            "transform": {
                "output": "return output.map(contact => ({ ...contact, 'ServiceAddressName': contact.Service_Address.name, 'ServiceAddressId': contact.Service_Address.id, 'BillingAddressName': contact.Billing_Address.name, 'BillingAddressId': contact.Billing_Address.id }));"
            }
        }
    },
