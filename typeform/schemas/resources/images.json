{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Image",
                        "value": "images.create"
                    },
                    {
                        "label": "Delete Image",
                        "value": "images.delete"
                    },
                    {
                        "label": "List Images",
                        "value": "images.list"
                    },
                    {
                        "label": "Get Image",
                        "value": "images.get"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "images",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "qs": {},
            "url": "https://api.typeform.com/images",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.description}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the image file to upload.",
                    "displayName": "File Name",
                    "displayType": "text",
                    "placeholder": "Enter the file name"
                },
                "name": "file_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Encode base64 image data using <a href=\"https://base64.guru/converter/encode/image\" target=\"_blank\">this link</a>.",
                    "displayName": "Image Data",
                    "displayType": "text",
                    "placeholder": "Enter the base64 encoded image"
                },
                "name": "image"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "URL of the image.",
                    "displayName": "Image URL",
                    "displayType": "text",
                    "placeholder": "Enter URL of the image"
                },
                "name": "url"
            }
        ]
    },
    "delete": {
        "definition": {
            "qs": {},
            "url": "https://api.typeform.com/images/{{parameters.id}}",
            "method": "delete",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.description}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the image.",
                    "displayName": "Image ID",
                    "displayType": "text",
                    "placeholder": "Enter the Image ID"
                },
                "name": "id"
            }
        ]
    },
    "list": {
        "definition": {
            "qs": {},
            "url": "https://api.typeform.com/images",
            "method": "get",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.description}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    },
    "get": {
        "definition": {
            "url": "https://api.typeform.com/images/{{parameters.id}}",
            "method": "get",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.description}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the form.",
                    "displayName": "Image ID",
                    "displayType": "text",
                    "placeholder": "Enter the Image ID"
                },
                "name": "id"
            }
        ]
    }
}
