{
    "getForms": {
        "definition": {
            "qs": {},
            "url": "https://api.typeform.com/forms",
            "method": "get",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.description}}"
                },
                "output": "{{response.data.items}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create/Update Webhook",
                        "value": "webhooks.create"
                    },
                    {
                        "label": "Delete Webhook",
                        "value": "webhooks.delete"
                    },
                    {
                        "label": "List Webhooks",
                        "value": "webhooks.list"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation"
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://api.typeform.com/forms/{{parameters.form_id}}/webhooks/{{parameters.tag}}",
            "body": "{{parameters}}",
            "method": "put",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.description}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "typeform",
                            "secret": "{{parameters.secret}}",
                            "resource": "webhooks",
                            "operation": "webhooks.create",
                            "loadOptionsMethod": "getForms"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "title",
                        "valueKey": "id"
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID of the form.",
                    "displayName": "Form ID",
                    "displayType": "select",
                    "placeholder": "Select the Form ID",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "secret",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "resource",
                                "value": "webhooks",
                                "operator": "EQUALS"
                            },
                            {
                                "field": "operation",
                                "value": "webhooks.create",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "form_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Unique identifier for the webhook.",
                    "displayName": "Webhook Tag",
                    "displayType": "text",
                    "placeholder": "Enter the Webhook Tag"
                },
                "name": "tag"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The URL the webhook will send requests to.",
                    "displayName": "Webhook URL",
                    "displayType": "text",
                    "placeholder": "Enter the Webhook URL"
                },
                "name": "url"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Whether the webhook is enabled or disabled.",
                    "displayName": "Enabled",
                    "displayType": "toggle",
                    "placeholder": "Enable or disable the webhook"
                },
                "name": "enabled"
            }
        ]
    },
