{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create an Event",
                        "value": "events.create",
                        "description": "Create a new event in your Zoho CRM"
                    },
                    {
                        "label": "Get list of Events",
                        "value": "events.get_list",
                        "description": "Get a list of events in your Zoho CRM"
                    },
                    {
                        "label": "Get an Event",
                        "value": "events.get",
                        "description": "Get details of a specific event in your Zoho CRM"
                    },
                    {
                        "label": "Update an Event",
                        "value": "events.update",
                        "description": "Update details of a specific event in your Zoho CRM"
                    },
                    {
                        "label": "Delete an Event",
                        "value": "events.delete",
                        "description": "Delete a specific event in your Zoho CRM"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "events",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "delete": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Events/{{parameters.event_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the event to delete.",
                    "displayName": "Event ID",
                    "displayType": "text",
                    "placeholder": "Enter the event ID"
                },
                "name": "event_id"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Events/{{parameters.event_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the event to retrieve.",
                    "displayName": "Event ID",
                    "displayType": "text",
                    "placeholder": "Enter the event ID"
                },
                "name": "event_id"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Events",
            "body": {
                "data": [
                    {
                        "Location": "{{parameters.location}}",
                        "Event_Title": "{{parameters.subject}}",
                        "End_DateTime": "{{parameters.end_datetime}}",
                        "Start_DateTime": "{{parameters.start_datetime}}"
                    }
                ]
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The subject of the event.",
                    "displayName": "Subject",
                    "displayType": "text",
                    "placeholder": "Enter the subject"
                },
                "name": "subject"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DDTHH:mm:ssZ",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Start date and time of the event in ISO format.",
                    "displayName": "Start Date & Time",
                    "displayType": "datetime",
                    "placeholder": "YYYY-MM-DDTHH:MM:SS+05:30"
                },
                "name": "start_datetime"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DDTHH:mm:ssZ",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "End date and time of the event in ISO format.",
                    "displayName": "End Date & Time",
                    "displayType": "datetime",
                    "placeholder": "YYYY-MM-DDTHH:MM:SS+05:30"
                },
                "name": "end_datetime"
            },
            {
                "meta": {
                    "description": "Location of the event.",
                    "displayName": "Location",
                    "displayType": "text",
                    "placeholder": "Enter location"
                },
                "name": "location"
            }
        ]
    },
    "get_list": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Events",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.info.more_records}} != false"
            }
        },
        "parameters": []
    },
    "update": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Events/{{parameters.event_id}}",
            "body": {
                "data": [
                    {
                        "Subject": "{{parameters.subject}}",
                        "Location": "{{parameters.location}}",
                        "End_DateTime": "{{parameters.end_datetime}}",
                        "Start_DateTime": "{{parameters.start_datetime}}"
                    }
                ]
            },
            "method": "put",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the event to update.",
                    "displayName": "Event ID",
                    "displayType": "text",
                    "placeholder": "Enter the event ID"
                },
                "name": "event_id"
            },
            {
                "meta": {
                    "description": "The subject of the event.",
                    "displayName": "Subject",
                    "displayType": "text",
                    "placeholder": "Enter the subject"
                },
                "name": "subject"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DDTHH:mm:ssZ",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "description": "Start date and time of the event in ISO format.",
                    "displayName": "Start Date & Time",
                    "displayType": "datetime",
                    "placeholder": "YYYY-MM-DDTHH:MM:SS+05:30"
                },
                "name": "start_datetime"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DDTHH:mm:ssZ",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "description": "End date and time of the event in ISO format.",
                    "displayName": "End Date & Time",
                    "displayType": "datetime",
                    "placeholder": "YYYY-MM-DDTHH:MM:SS+05:30"
                },
                "name": "end_datetime"
            },
            {
                "meta": {
                    "description": "Location of the event.",
                    "displayName": "Location",
                    "displayType": "text",
                    "placeholder": "Enter location"
                },
                "name": "location"
            }
        ]
    }
}
