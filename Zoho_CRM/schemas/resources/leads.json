{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create a Lead",
                        "value": "leads.create",
                        "description": "Create a new lead in Zoho CRM."
                    },
                    {
                        "label": "Update a Lead",
                        "value": "leads.update",
                        "description": "Update details of an existing lead."
                    },
                    {
                        "label": "Get Lead Details",
                        "value": "leads.get",
                        "description": "Retrieve details of a specific lead by ID."
                    },
                    {
                        "label": "List Leads",
                        "value": "leads.list",
                        "description": "List all leads in Zoho CRM."
                    },
                    {
                        "label": "Delete a Lead",
                        "value": "leads.delete",
                        "description": "Delete a specific lead in your Zoho CRM."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "leads",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "delete": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Leads/{{parameters.lead_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the lead to delete.",
                    "displayName": "Lead ID",
                    "displayType": "text",
                    "placeholder": "Enter the lead ID"
                },
                "name": "lead_id"
            }
        ]
    },
    "update": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Leads/{{parameters.lead_id}}",
            "body": {
                "data": [
                    {
                        "Email": "{{parameters.email}}"
                    }
                ]
            },
            "method": "put",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the lead to update.",
                    "displayName": "Lead ID",
                    "displayType": "text",
                    "placeholder": "Enter the lead ID"
                },
                "name": "lead_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The updated email address of the lead.",
                    "displayName": "Email",
                    "displayType": "email",
                    "placeholder": "Enter the new email address"
                },
                "name": "email"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Leads",
            "body": {
                "data": [
                    {
                        "Email": "{{parameters.email}}",
                        "Last_Name": "{{parameters.last_name}}",
                        "First_Name": "{{parameters.first_name}}"
                    }
                ]
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The first name of the lead.",
                    "displayName": "First Name",
                    "displayType": "text",
                    "placeholder": "Enter the lead's first name"
                },
                "name": "first_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The last name of the lead.",
                    "displayName": "Last Name",
                    "displayType": "text",
                    "placeholder": "Enter the lead's last name"
                },
                "name": "last_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The email address of the lead.",
                    "displayName": "Email",
                    "displayType": "email",
                    "placeholder": "Enter the lead's email"
                },
                "name": "email"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Leads",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.info.more_records}} != false"
            }
        },
        "parameters": []
    },
    "get": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Leads/{{parameters.lead_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the lead to retrieve.",
                    "displayName": "Lead ID",
                    "displayType": "text",
                    "placeholder": "Enter the lead ID"
                },
                "name": "lead_id"
            }
        ]
    }
}
