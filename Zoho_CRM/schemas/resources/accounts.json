{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create an Account",
                        "value": "accounts.create",
                        "description": "Create a new account in Zoho CRM."
                    },
                    {
                        "label": "Get Account List",
                        "value": "accounts.get_list",
                        "description": "Retrieve a list of accounts from Zoho CRM."
                    },
                    {
                        "label": "Get an Account",
                        "value": "accounts.get",
                        "description": "Retrieve details of a specific account by ID."
                    },
                    {
                        "label": "Update an Account",
                        "value": "accounts.update",
                        "description": "Update details of an existing account."
                    },
                    {
                        "label": "Delete an Account",
                        "value": "accounts.delete",
                        "description": "Delete an account by ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "accounts",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Accounts",
            "body": {
                "data": [
                    {
                        "Website": "{{parameters.website}}",
                        "Account_Name": "{{parameters.account_name}}",
                        "Account_Number": "{{parameters.account_number}}"
                    }
                ]
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the company or organization.",
                    "displayName": "Account Name",
                    "displayType": "text",
                    "placeholder": "Enter the account name"
                },
                "name": "account_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The website URL for the organization.",
                    "displayName": "Website",
                    "displayType": "url",
                    "placeholder": "Enter the website URL"
                },
                "name": "website"
            }
        ]
    },
    "get_list": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Accounts",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.info.more_records}} != false"
            }
        },
        "parameters": []
    },
    "update": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Accounts/{{parameters.account_id}}",
            "body": {
                "data": [
                    {
                        "Website": "{{parameters.website}}",
                        "Account_Name": "{{parameters.account_name}}",
                        "Account_Number": "{{parameters.account_number}}"
                    }
                ]
            },
            "method": "put",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the account to update.",
                    "displayName": "Account ID",
                    "displayType": "text",
                    "placeholder": "Enter the account ID"
                },
                "name": "account_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the company or organization.",
                    "displayName": "Account Name",
                    "displayType": "text",
                    "placeholder": "Enter the account name"
                },
                "name": "account_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The account number for the organization.",
                    "displayName": "Account Number",
                    "displayType": "text",
                    "placeholder": "Enter the account number"
                },
                "name": "account_number"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The website URL for the organization.",
                    "displayName": "Website URL",
                    "displayType": "url",
                    "placeholder": "Enter the website URL"
                },
                "name": "website"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Accounts/{{parameters.account_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the account to retrieve.",
                    "displayName": "Account ID",
                    "displayType": "text",
                    "placeholder": "Enter the account ID"
                },
                "name": "account_id"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Accounts/{{parameters.account_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the account to delete.",
                    "displayName": "Account ID",
                    "displayType": "text",
                    "placeholder": "Enter the account ID"
                },
                "name": "account_id"
            }
        ]
    }
}
