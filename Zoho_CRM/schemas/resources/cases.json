{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create a Case",
                        "value": "cases.create",
                        "description": "Create a new customer support case in Zoho CRM."
                    },
                    {
                        "label": "Get a Case",
                        "value": "cases.get",
                        "description": "Retrieve details of a specific case by ID."
                    },
                    {
                        "label": "Get list of Cases",
                        "value": "cases.get_list",
                        "description": "Fetch a list of all customer support cases."
                    },
                    {
                        "label": "Update a Case",
                        "value": "cases.update",
                        "description": "Modify the details of an existing support case."
                    },
                    {
                        "label": "Delete a Case",
                        "value": "cases.delete",
                        "description": "Remove a support case from Zoho CRM."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Choose the operation to perform on Cases.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "cases",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "delete": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Cases/{{parameters.case_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the case to delete.",
                    "displayName": "Case ID",
                    "displayType": "text",
                    "placeholder": "Enter the case ID"
                },
                "name": "case_id"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Cases",
            "body": {
                "data": [
                    {
                        "Status": "{{parameters.status}}",
                        "Subject": "{{parameters.subject}}",
                        "Priority": "{{parameters.priority}}",
                        "Description": "{{parameters.description}}"
                    }
                ]
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The subject of the case.",
                    "displayName": "Subject",
                    "displayType": "text",
                    "placeholder": "Enter case subject"
                },
                "name": "subject"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "New",
                            "value": "New"
                        },
                        {
                            "label": "Open",
                            "value": "Open"
                        },
                        {
                            "label": "Closed",
                            "value": "Closed"
                        },
                        {
                            "label": "On Hold",
                            "value": "On Hold"
                        }
                    ],
                    "description": "The current status of the case.",
                    "displayName": "Status",
                    "displayType": "select",
                    "placeholder": "Select a status"
                },
                "name": "status"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "High",
                            "value": "High"
                        },
                        {
                            "label": "Medium",
                            "value": "Medium"
                        },
                        {
                            "label": "Low",
                            "value": "Low"
                        }
                    ],
                    "description": "The priority level of the case.",
                    "displayName": "Priority",
                    "displayType": "select",
                    "placeholder": "Select a priority"
                },
                "name": "priority"
            },
            {
                "meta": {
                    "description": "Detailed description of the case.",
                    "displayName": "Description",
                    "displayType": "textarea",
                    "placeholder": "Enter the description"
                },
                "name": "description"
            }
        ]
    },
    "update": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Cases/{{parameters.case_id}}",
            "body": {
                "data": [
                    {
                        "Status": "{{parameters.status}}",
                        "Subject": "{{parameters.subject}}",
                        "Priority": "{{parameters.priority}}",
                        "Description": "{{parameters.description}}"
                    }
                ]
            },
            "method": "put",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the case to update.",
                    "displayName": "Case ID",
                    "displayType": "text",
                    "placeholder": "Enter the case ID"
                },
                "name": "case_id"
            },
            {
                "meta": {
                    "description": "Updated subject of the case.",
                    "displayName": "Subject",
                    "displayType": "text",
                    "placeholder": "Enter the subject"
                },
                "name": "subject"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "New",
                            "value": "New"
                        },
                        {
                            "label": "Open",
                            "value": "Open"
                        },
                        {
                            "label": "Closed",
                            "value": "Closed"
                        },
                        {
                            "label": "On Hold",
                            "value": "On Hold"
                        }
                    ],
                    "description": "Choose the Status",
                    "displayName": "Status",
                    "displayType": "select",
                    "placeholder": "Select a status"
                },
                "name": "status"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "High",
                            "value": "High"
                        },
                        {
                            "label": "Medium",
                            "value": "Medium"
                        },
                        {
                            "label": "Low",
                            "value": "Low"
                        }
                    ],
                    "description": "Choose the operation to perform on Cases.",
                    "displayName": "Priority",
                    "displayType": "select",
                    "placeholder": "Select a priority"
                },
                "name": "priority"
            },
            {
                "meta": {
                    "description": "description",
                    "displayName": "Description",
                    "displayType": "textarea",
                    "placeholder": "Enter the description"
                },
                "name": "description"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Cases/{{parameters.case_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the case to retrieve.",
                    "displayName": "Case ID",
                    "displayType": "text",
                    "placeholder": "Enter the case ID"
                },
                "name": "case_id"
            }
        ]
    },
    "get_list": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Cases",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.info.more_records}} != false"
            }
        },
        "parameters": []
    }
}
