{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create a Campaign",
                        "value": "campaigns.create",
                        "description": "Create a new campaign in Zoho CRM."
                    },
                    {
                        "label": "Get list of Campaigns",
                        "value": "campaigns.get_list",
                        "description": "Retrieve a list of campaigns from Zoho CRM."
                    },
                    {
                        "label": "Get a Campaign",
                        "value": "campaigns.get",
                        "description": "Retrieve details of a specific campaign by ID."
                    },
                    {
                        "label": "Update a Campaign",
                        "value": "campaigns.update",
                        "description": "Update details of an existing campaign."
                    },
                    {
                        "label": "Delete a Campaign",
                        "value": "campaigns.delete",
                        "description": "Delete a campaign by ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "campaigns",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Campaigns",
            "body": {
                "data": [
                    {
                        "Type": "{{parameters.type}}",
                        "Status": "{{parameters.status}}",
                        "Campaign_Name": "{{parameters.campaign_name}}"
                    }
                ]
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the campaign.",
                    "displayName": "Campaign Name",
                    "displayType": "text",
                    "placeholder": "Enter the campaign name"
                },
                "name": "campaign_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The type of the campaign (e.g., Email, Webinar).",
                    "displayName": "Campaign Type",
                    "displayType": "text",
                    "placeholder": "Enter the campaign type"
                },
                "name": "type"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The current status of the campaign (e.g., Planned, Active).",
                    "displayName": "Campaign Status",
                    "displayType": "text",
                    "placeholder": "Enter the campaign status"
                },
                "name": "status"
            }
        ]
    },
    "get_list": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Campaigns",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.info.more_records}} != false"
            }
        },
        "parameters": []
    },
    "get": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Campaigns/{{parameters.campaign_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the campaign to retrieve.",
                    "displayName": "Campaign ID",
                    "displayType": "text",
                    "placeholder": "Enter the campaign ID"
                },
                "name": "campaign_id"
            }
        ]
    },
    "update": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Campaigns/{{parameters.campaign_id}}",
            "body": {
                "data": [
                    {
                        "Type": "{{parameters.type}}",
                        "Status": "{{parameters.status}}",
                        "Campaign_Name": "{{parameters.campaign_name}}"
                    }
                ]
            },
            "method": "put",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the campaign to update.",
                    "displayName": "Campaign ID",
                    "displayType": "text",
                    "placeholder": "Enter the campaign ID"
                },
                "name": "campaign_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the campaign.",
                    "displayName": "Campaign Name",
                    "displayType": "text",
                    "placeholder": "Enter the campaign name"
                },
                "name": "campaign_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The type of the campaign (e.g., Email, Webinar).",
                    "displayName": "Campaign Type",
                    "displayType": "text",
                    "placeholder": "Enter the campaign type"
                },
                "name": "type"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The current status of the campaign (e.g., Planned, Active).",
                    "displayName": "Campaign Status",
                    "displayType": "text",
                    "placeholder": "Enter the campaign status"
                },
                "name": "status"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Campaigns/{{parameters.campaign_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the campaign to delete.",
                    "displayName": "Campaign ID",
                    "displayType": "text",
                    "placeholder": "Enter the campaign ID"
                },
                "name": "campaign_id"
            }
        ]
    }
}
