{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create a Call",
                        "value": "calls.create",
                        "description": "The subject of the call."
                    },
                    {
                        "label": "Get a Call",
                        "value": "calls.get",
                        "description": "Retrieve a specific call by its ID."
                    },
                    {
                        "label": "Get list of Calls",
                        "value": "calls.get_list",
                        "description": "Retrieve a list of calls."
                    },
                    {
                        "label": "Update a Call",
                        "value": "calls.update",
                        "description": "Update an existing call by its ID."
                    },
                    {
                        "label": "Delete a Call",
                        "value": "calls.delete",
                        "description": "Delete a specific call by its ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "calls",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Calls",
            "body": {
                "data": [
                    {
                        "Subject": "{{parameters.subject}}",
                        "Call_Type": "{{parameters.call_type}}",
                        "Call_Purpose": "{{parameters.call_purpose}}",
                        "Call_Duration": "{{parameters.call_duration}}",
                        "Call_Start_Time": "{{parameters.call_start_time}}"
                    }
                ]
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The subject of the call.",
                    "displayName": "Subject",
                    "displayType": "text",
                    "placeholder": "Enter the subject"
                },
                "name": "subject"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Inbound",
                            "value": "Inbound"
                        },
                        {
                            "label": "Outbound",
                            "value": "Outbound"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The type of the call.",
                    "displayName": "Call Type",
                    "displayType": "select",
                    "placeholder": "Select call type"
                },
                "name": "call_type"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DDTHH:mm:ssZ",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The start time of the call.",
                    "displayName": "Start Date & Time",
                    "displayType": "datetime",
                    "placeholder": "YYYY-MM-DDTHH:mm:ssZ"
                },
                "name": "call_start_time"
            },
            {
                "meta": {
                    "description": "Duration of the call in minutes.",
                    "displayName": "Duration (minutes)",
                    "displayType": "text",
                    "placeholder": "Enter duration in minutes"
                },
                "name": "call_duration"
            },
            {
                "meta": {
                    "description": "Purpose of the call.",
                    "displayName": "Purpose",
                    "displayType": "text",
                    "placeholder": "Enter the purpose"
                },
                "name": "call_purpose"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Calls/{{parameters.call_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the call to retrieve.",
                    "displayName": "Call ID",
                    "displayType": "text",
                    "placeholder": "Enter the call ID"
                },
                "name": "call_id"
            }
        ]
    },
    "get_list": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Calls",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.info.more_records}} != false"
            }
        },
        "parameters": []
    },
    "update": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Calls/{{parameters.call_id}}",
            "body": {
                "data": [
                    {
                        "Subject": "{{parameters.subject}}",
                        "Call_Type": "{{parameters.call_type}}",
                        "Call_Purpose": "{{parameters.call_purpose}}",
                        "Call_Duration": "{{parameters.call_duration}}",
                        "Call_Start_Time": "{{parameters.call_start_time}}"
                    }
                ]
            },
            "method": "put",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the call to update.",
                    "displayName": "Call ID",
                    "displayType": "text",
                    "placeholder": "Enter the call ID"
                },
                "name": "call_id"
            },
            {
                "meta": {
                    "description": "Updated subject of the call.",
                    "displayName": "Subject",
                    "displayType": "text",
                    "placeholder": "Enter the subject"
                },
                "name": "subject"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Inbound",
                            "value": "Inbound"
                        },
                        {
                            "label": "Outbound",
                            "value": "Outbound"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "description": "Updated type of the call.",
                    "displayName": "Call Type",
                    "displayType": "select",
                    "placeholder": "Select call type"
                },
                "name": "call_type"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DDTHH:mm:ssZ",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The start time of the call.",
                    "displayName": "Start Date & Time",
                    "displayType": "datetime",
                    "placeholder": "YYYY-MM-DDTHH:mm:ssZ"
                },
                "name": "call_start_time"
            },
            {
                "meta": {
                    "description": "Updated duration of the call in minutes.",
                    "displayName": "Duration (minutes)",
                    "displayType": "text",
                    "placeholder": "Enter duration in minutes"
                },
                "name": "call_duration"
            },
            {
                "meta": {
                    "description": "Updated purpose of the call.",
                    "displayName": "Purpose",
                    "displayType": "text",
                    "placeholder": "Enter the purpose"
                },
                "name": "call_purpose"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Calls/{{parameters.call_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the call to delete.",
                    "displayName": "Call ID",
                    "displayType": "text",
                    "placeholder": "Enter the call ID"
                },
                "name": "call_id"
            }
        ]
    }
}
