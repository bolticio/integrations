                    "description": "The name of the potential sale or business deal.",
                    "displayName": "Deal Name",
                    "displayType": "text",
                    "placeholder": "Enter the deal name"
                },
                "name": "deal_name"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Prospecting",
                            "value": "Prospecting"
                        },
                        {
                            "label": "Qualification",
                            "value": "Qualification"
                        },
                        {
                            "label": "Proposal",
                            "value": "Proposal"
                        },
                        {
                            "label": "Negotiation",
                            "value": "Negotiation"
                        },
                        {
                            "label": "Closed Won",
                            "value": "Closed Won"
                        },
                        {
                            "label": "Closed Lost",
                            "value": "Closed Lost"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The current stage of the deal.",
                    "displayName": "Deal Stage",
                    "displayType": "select",
                    "placeholder": "Select the deal stage"
                },
                "name": "stage"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The estimated value of the deal.",
                    "displayName": "Amount",
                    "displayType": "text",
                    "placeholder": "Enter the deal amount"
                },
                "name": "amount"
            },
            {
                "meta": {
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The expected closing date for the deal.",
                    "displayName": "Close Date",
                    "displayType": "date",
                    "placeholder": "Select the expected close date"
                },
                "name": "close_date"
            }
        ]
    },
    "get_list": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Deals",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.info.more_records}} != false"
            }
        },
        "parameters": []
    },
    "get": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Deals/{{parameters.deal_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the deal to retrieve.",
                    "displayName": "Deal ID",
                    "displayType": "text",
                    "placeholder": "Enter the deal ID"
                },
                "name": "deal_id"
            }
        ]
    }
}
