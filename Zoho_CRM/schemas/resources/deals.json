{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create a Deal",
                        "value": "deals.create",
                        "description": "Create a new deal in your Zoho CRM"
                    },
                    {
                        "label": "Get Deal List",
                        "value": "deals.get_list",
                        "description": "Get a list of deals in your Zoho CRM"
                    },
                    {
                        "label": "Get a Deal",
                        "value": "deals.get",
                        "description": "Get details of a specific deal in your Zoho CRM"
                    },
                    {
                        "label": "Update a Deal",
                        "value": "deals.update",
                        "description": "Update details of a specific deal in your Zoho CRM"
                    },
                    {
                        "label": "Delete a Deal",
                        "value": "deals.delete",
                        "description": "Delete a specific deal in your Zoho CRM"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "deals",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "update": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Deals/{{parameters.deal_id}}",
            "body": {
                "data": [
                    {
                        "Stage": "{{parameters.stage}}",
                        "Amount": "{{parameters.amount}}",
                        "Deal_name": "{{parameters.deal_name}}",
                        "Closing_Date": "{{parameters.close_date}}"
                    }
                ]
            },
            "method": "put",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the deal to update.",
                    "displayName": "Deal ID",
                    "displayType": "text",
                    "placeholder": "Enter the deal ID"
                },
                "name": "deal_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the potential sale or business deal.",
                    "displayName": "Deal Name",
                    "displayType": "text",
                    "placeholder": "Enter the deal name"
                },
                "name": "deal_name"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Prospecting",
                            "value": "Prospecting"
                        },
                        {
                            "label": "Qualification",
                            "value": "Qualification"
                        },
                        {
                            "label": "Proposal",
                            "value": "Proposal"
                        },
                        {
                            "label": "Negotiation",
                            "value": "Negotiation"
                        },
                        {
                            "label": "Closed Won",
                            "value": "Closed Won"
                        },
                        {
                            "label": "Closed Lost",
                            "value": "Closed Lost"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The current stage of the deal.",
                    "displayName": "Deal Stage",
                    "displayType": "select",
                    "placeholder": "Select the deal stage"
                },
                "name": "stage"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The estimated value of the deal.",
                    "displayName": "Amount",
                    "displayType": "text",
                    "placeholder": "Enter the deal amount"
                },
                "name": "amount"
            },
            {
                "meta": {
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The expected closing date for the deal.",
                    "displayName": "Close Date",
                    "displayType": "date",
                    "placeholder": "Select the expected close date"
                },
                "name": "close_date"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v2/Deals/{{parameters.deal_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+$",
                        "required": true
                    },
                    "description": "The ID of the deal to delete.",
                    "displayName": "Deal ID",
                    "displayType": "text",
                    "placeholder": "Enter the deal ID"
                },
                "name": "deal_id"
            }
        ]
    },
