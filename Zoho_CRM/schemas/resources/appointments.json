{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create an Appointment",
                        "value": "appointments.create",
                        "description": "Create a new appointment in Zoho CRM."
                    },
                    {
                        "label": "Get an Appointment",
                        "value": "appointments.get",
                        "description": "Retrieve details of a specific appointment by ID."
                    },
                    {
                        "label": "Get list of Appointments",
                        "value": "appointments.get_list",
                        "description": "Retrieve a list of appointments from Zoho CRM."
                    },
                    {
                        "label": "Update an Appointment",
                        "value": "appointments.update",
                        "description": "Update details of an existing appointment."
                    },
                    {
                        "label": "Delete an Appointment",
                        "value": "appointments.delete",
                        "description": "Delete an appointment by ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform on appointments.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "appointments",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v8/Appointments__s",
            "body": {
                "data": [
                    {
                        "Owner": {
                            "id": "{{parameters.owner_id}}"
                        },
                        "Status": "{{parameters.status}}",
                        "Address": "{{parameters.address}}",
                        "Location": "{{parameters.location}}",
                        "Service_Name": "{{parameters.service_name}}",
                        "Appointment_For": {
                            "id": "{{parameters.appointment_for_id}}",
                            "module": "{{parameters.appointment_for_module}}"
                        },
                        "Appointment_Name": "{{parameters.appointment_name}}",
                        "Additional_Information": "{{parameters.additional_information}}",
                        "Appointment_Start_Time": "{{parameters.appointment_start_time}}"
                    }
                ]
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the appointment.",
                    "displayName": "Appointment Name",
                    "displayType": "text",
                    "placeholder": "Enter appointment name"
                },
                "name": "appointment_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the service for the appointment.",
                    "displayName": "Service Name",
                    "displayType": "text",
                    "placeholder": "Enter service name"
                },
                "name": "service_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the customer for whom the appointment is scheduled.",
                    "displayName": "Appointment For ID",
                    "displayType": "text",
                    "placeholder": "Enter customer record ID"
                },
                "name": "appointment_for_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The API name of the module (e.g., Contacts, Leads) the customer belongs to.",
                    "displayName": "Appointment For Module",
                    "displayType": "text",
                    "placeholder": "Enter module API name"
                },
                "name": "appointment_for_module"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the service member who will provide the service.",
                    "displayName": "Owner ID",
                    "displayType": "text",
                    "placeholder": "Enter owner ID"
                },
                "name": "owner_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Start date and time of the appointment in ISO 8601 format.",
                    "displayName": "Appointment Start Time",
                    "displayType": "datetime",
                    "placeholder": "Select start date & time"
                },
                "name": "appointment_start_time"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Client Address",
                            "value": "Client Address"
                        },
                        {
                            "label": "Business Address",
                            "value": "Business Address"
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": "Location where the service is offered.",
                    "displayName": "Location",
                    "displayType": "select",
                    "placeholder": "Select location"
                },
                "name": "location"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Address of the customer, required if location is Client Address.",
                    "displayName": "Address",
                    "displayType": "text",
                    "placeholder": "Enter address"
                },
                "name": "address"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Any additional information about the appointment.",
                    "displayName": "Additional Information",
                    "displayType": "text",
                    "placeholder": "Enter additional information"
                },
                "name": "additional_information"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Scheduled",
                            "value": "Scheduled"
                        },
                        {
                            "label": "Completed",
                            "value": "Completed"
                        },
                        {
                            "label": "Cancelled",
                            "value": "Cancelled"
                        },
                        {
                            "label": "Overdue",
                            "value": "Overdue"
                        }
                    ],
                    "validation": {
                        "required": false
                    },
                    "description": "Status of the appointment.",
                    "displayName": "Status",
                    "displayType": "select",
                    "placeholder": "Select status"
                },
                "name": "status"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v8/Appointments__s/{{parameters.appointment_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the appointment to retrieve.",
                    "displayName": "Appointment ID",
                    "displayType": "text",
                    "placeholder": "Enter appointment ID"
                },
                "name": "appointment_id"
            }
        ]
    },
    "get_list": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v8/Appointments__s",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.info.more_records}} != false"
            }
        },
        "parameters": []
    },
    "update": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v8/Appointments__s/{{parameters.appointment_id}}",
            "body": {
                "data": [
                    {
                        "Status": "{{parameters.status}}",
                        "Appointment_Name": "{{parameters.appointment_name}}",
                        "Appointment_Start_Time": "{{parameters.appointment_start_time}}"
                    }
                ]
            },
            "method": "put",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the appointment to update.",
                    "displayName": "Appointment ID",
                    "displayType": "text",
                    "placeholder": "Enter appointment ID"
                },
                "name": "appointment_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The name of the appointment.",
                    "displayName": "Appointment Name",
                    "displayType": "text",
                    "placeholder": "Enter appointment name"
                },
                "name": "appointment_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Start date and time of the appointment in ISO 8601 format.",
                    "displayName": "Appointment Start Time",
                    "displayType": "datetime",
                    "placeholder": "Select start date & time"
                },
                "name": "appointment_start_time"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Scheduled",
                            "value": "Scheduled"
                        },
                        {
                            "label": "Completed",
                            "value": "Completed"
                        },
                        {
                            "label": "Cancelled",
                            "value": "Cancelled"
                        },
                        {
                            "label": "Overdue",
                            "value": "Overdue"
                        }
                    ],
                    "validation": {
                        "required": false
                    },
                    "description": "Status of the appointment.",
                    "displayName": "Status",
                    "displayType": "select",
                    "placeholder": "Select status"
                },
                "name": "status"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://www.zohoapis.in/crm/v8/Appointments__s/{{parameters.appointment_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the appointment to delete.",
                    "displayName": "Appointment ID",
                    "displayType": "text",
                    "placeholder": "Enter appointment ID"
                },
                "name": "appointment_id"
            }
        ]
    }
}
