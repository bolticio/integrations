{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Text File",
                        "value": "file.createTextFile",
                        "description": "Create a new text file in OneDrive."
                    },
                    {
                        "label": "Find File by Name",
                        "value": "file.findFile",
                        "description": "Find a file in OneDrive."
                    },
                    {
                        "label": "Find File by ID",
                        "value": "file.findItemById",
                        "description": "Find a file in OneDrive by ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "file",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "createtextfile": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/drive/root:/{{parameters.fileName}}.txt:/content",
            "body": {
                "fileContent": "{{parameters.fileContent}}"
            },
            "method": "PUT",
            "headers": {
                "Content-Type": "text/plain",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const text = body.fileContent; return text;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The base name of the text file to create in OneDrive",
                    "displayName": "File Name",
                    "displayType": "text",
                    "placeholder": "Enter file name (without .txt)"
                },
                "name": "fileName"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The plain text content for the file",
                    "displayName": "File Content",
                    "displayType": "textarea",
                    "placeholder": "Enter the text you want inside the file"
                },
                "name": "fileContent"
            }
        ]
    },
    "findfile": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/drive/root/children?$filter=name%20eq%20%27{{parameters.fileName}}%27",
            "method": "GET",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the file you want to find in OneDrive",
                    "displayName": "File Name",
                    "displayType": "text",
                    "placeholder": "Enter the file name to search with extension"
                },
                "name": "fileName"
            }
        ]
    },
    "finditembyid": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/drive/items/{{parameters.itemId}}",
            "method": "GET",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID of the OneDrive file",
                    "displayName": "Item ID",
                    "displayType": "text",
                    "placeholder": "Enter file ID"
                },
                "name": "itemId"
            }
        ]
    }
}
