{
    "api_key": {
        "validate": {
            "url": "https://public-api.granola.ai/v1/notes",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Granola API Key is required"
                        }
                    },
                    "description": "Enter the API key from your Granola workspace to authenticate this connection.",
                    "displayName": "Granola API Key",
                    "displayType": "password",
                    "placeholder": "Enter Granola API Key"
                },
                "name": "api_key"
            }
        ]
    },
    "parameters": [
        {
            "meta": {
                "value": "api_key",
                "options": [
                    {
                        "label": "Granola API Key",
                        "value": "api_key"
                    }
                ],
                "isDisabled": true,
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Granola authentication type is required"
                    }
                },
                "description": "Authenticate Granola account using an API key.",
                "displayName": "Granola Authentication Type",
                "displayType": "select",
                "placeholder": "Select a Granola authentication type"
            },
            "name": "type"
        }
    ]
}
