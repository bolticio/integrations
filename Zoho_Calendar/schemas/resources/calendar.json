{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Calendar",
                        "value": "calendar.create",
                        "description": "Create a new calendar in Zoho Calendar."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "calendar",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "qs": {
                "calendarData": "{ \"name\": \"{{parameters.name}}\", \"color\": \"{{parameters.color}}\", \"textcolor\": \"{{parameters.textcolor}}\", \"include_infreebusy\": {{parameters.include_infreebusy}}, \"timezone\": \"{{parameters.timezone}}\", \"description\": \"{{parameters.description}}\", \"private\": \"{{parameters.private}}\", \"status\": {{parameters.status}}, \"public\": \"{{parameters.public}}\", \"reminders\": {{parameters.reminders}} }"
            },
            "url": "https://calendar.zoho.in/api/v1/calendars",
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Name of the calendar to be created",
                    "displayName": "Calendar Name",
                    "displayType": "text",
                    "placeholder": "Enter calendar name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
                        "required": true
                    },
                    "description": "Color code for the calendar (hex format). Example: #000000 for black, #FFFFFF for white.",
                    "displayName": "Color",
                    "displayType": "text",
                    "placeholder": "#8cbf40"
                },
                "name": "color"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Busy",
                            "value": true
                        },
                        {
                            "label": "Free",
                            "value": false
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "description": "Include this calendar in freebusy response and supported values [true, false]",
                    "displayName": "Include in freebusy",
                    "displayType": "select",
                    "placeholder": "Select an option"
                },
                "name": "include_infreebusy",
                "prop": "personalInfo"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Yes",
                            "value": "enable"
                        },
                        {
                            "label": "No",
                            "value": "disable"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "description": "Make this calendar private and supported values [enable, disable]",
                    "displayName": "Private",
                    "displayType": "select",
                    "placeholder": "Select an option"
                },
                "name": "private",
                "prop": "personalInfo"
            },
            {
                "meta": {
                    "description": "Timezone for the calendar, use Asia/Kolkata",
                    "displayName": "Timezone",
                    "displayType": "text",
                    "placeholder": "Asia/Kolkata"
                },
                "name": "timezone"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "OFF",
                            "value": "disable"
                        },
                        {
                            "label": "View only Free/Busy",
                            "value": "freebusy"
                        },
                        {
                            "label": "View event details",
                            "value": "view"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "description": "Make this calendar public and supported values [default: disable, view, freebusy]",
                    "displayName": "Public",
                    "displayType": "select",
                    "placeholder": "Select an option"
                },
                "name": "public",
                "prop": "personalInfo"
            },
            {
                "meta": {
                    "value": "",
                    "description": "Specifies the description of the calendar.",
