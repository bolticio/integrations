{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get Inventory Levels by Location",
                        "value": "inventory.get",
                        "description": "Get inventory levels by location."
                    },
                    {
                        "label": "Get Locations",
                        "value": "inventory.getLocations",
                        "description": "Get locations."
                    },
                    {
                        "label": "Update Inventory Levels",
                        "value": "inventory.updateInventory",
                        "description": "Update inventory levels."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "inventory",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "get": {
        "definition": {
            "qs": {
                "location_ids": "{{parameters.location_id}}"
            },
            "url": "https://{{secrets.domain}}.myshopify.com/admin/api/2024-01/inventory_levels.json",
            "method": "get",
            "headers": {
                "Content-Type": "application/json",
                "X-shopify-access-token": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "shopify",
                            "secret": "{{parameters.secret}}",
                            "resource": "inventory",
                            "operation": "inventory.get",
                            "loadOptionsMethod": "getLocations"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the location for which you want to retrieve inventory levels.",
                    "displayName": "Location ID",
                    "displayType": "select",
                    "placeholder": "Enter Location ID"
                },
                "name": "location_id"
            }
        ]
    },
    "getlocations": {
        "definition": {
            "qs": {},
            "url": "https://{{secrets.domain}}.myshopify.com/admin/api/2024-01/locations.json",
            "method": "get",
            "headers": {
                "Content-Type": "application/json",
                "X-shopify-access-token": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors}}"
                },
                "output": "{{response.data.locations}}"
            }
        },
        "parameters": []
    },
    "updateinventory": {
        "definition": {
            "url": "https://{{secrets.domain}}.myshopify.com/admin/api/2024-01/inventory_levels/set.json",
            "body": {
                "available": "{{parameters.available}}",
                "location_id": "{{parameters.location_id}}",
                "inventory_item_id": "{{parameters.inventory_item_id}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "X-shopify-access-token": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "shopify",
                            "secret": "{{parameters.secret}}",
                            "resource": "inventory",
                            "operation": "inventory.get",
                            "loadOptionsMethod": "getLocations"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the location for which you want to retrieve inventory levels.",
                    "displayName": "Location ID",
                    "displayType": "select",
                    "placeholder": "Enter Location ID"
                },
                "name": "location_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the inventory item to update.",
                    "displayName": "Inventory Item ID",
                    "displayType": "text",
                    "placeholder": "Enter the  ID"
                },
                "name": "inventory_item_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The count of inventory item to updated.",
                    "displayName": "Stock Value",
                    "displayType": "number",
                    "placeholder": "Enter the  Value"
                },
                "name": "available"
            }
        ]
    }
}
