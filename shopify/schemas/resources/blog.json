{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get Blog Listing",
                        "value": "blog.get_list",
                        "description": "Get Blogs Listing"
                    },
                    {
                        "label": "Create Blog",
                        "value": "blog.create",
                        "description": "Create a new blog"
                    },
                    {
                        "label": "Create Blog Entry",
                        "value": "blog.create_entry",
                        "description": "Create a new blog entry"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "blog",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create_entry": {
        "definition": {
            "url": "https://{{secrets.domain}}.myshopify.com/admin/api/2024-07/blogs/{{parameters.blog_id}}/articles.json",
            "body": {
                "article": {
                    "title": "{{parameters.title}}",
                    "author": "{{parameters.author}}",
                    "body_html": "{{parameters.body_html}}",
                    "published": "{{parameters.published}}"
                }
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "X-Shopify-Access-Token": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the blog where the entry will be created.",
                    "displayName": "Blog ID",
                    "displayType": "text",
                    "placeholder": "Enter blog ID"
                },
                "name": "blog_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "shopify",
                            "secret": "{{parameters.secret}}",
                            "resource": "blog",
                            "operation": "blog.create_entry",
                            "loadOptionsMethod": "get_list"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "title",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the blog where the entry will be created.",
                    "displayName": "Blog ID",
                    "displayType": "select",
                    "placeholder": "Enter blog ID"
                },
                "name": "blog_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The title of the new blog entry.",
                    "displayName": "Title",
                    "displayType": "text",
                    "placeholder": "Enter article title"
                },
                "name": "title"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The HTML content of the blog entry.",
                    "displayName": "Content",
                    "displayType": "textarea",
                    "placeholder": "Enter article content"
                },
                "name": "body_html"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The author of the blog entry.",
                    "displayName": "Author",
                    "displayType": "text",
                    "placeholder": "Enter author name"
                },
                "name": "author"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Yes",
                            "value": true
                        },
                        {
                            "label": "No",
                            "value": false
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Set to true to publish the article immediately.",
                    "displayName": "Published",
                    "displayType": "select",
                    "placeholder": "Select publish status"
                },
                "name": "published"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://{{secrets.domain}}.myshopify.com/admin/api/2024-07/blogs.json",
            "body": {
                "blog": {
                    "title": "{{parameters.title}}",
                    "handle": "{{parameters.handle}}"
                }
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "X-Shopify-Access-Token": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The title of the new blog.",
                    "displayName": "Title",
                    "displayType": "text",
                    "placeholder": "Enter blog title"
                },
                "name": "title"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The handle for the blog URL.",
                    "displayName": "Handle",
                    "displayType": "text",
                    "placeholder": "Enter blog handle"
                },
                "name": "handle"
            }
        ]
    },
    "get_list": {
        "definition": {
            "url": "https://{{secrets.domain}}.myshopify.com/admin/api/2024-07/blogs.json?limit=250",
            "method": "get",
            "headers": {
                "X-Shopify-Access-Token": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors}}"
                },
                "output": "{{response.data.blogs}}"
            }
        },
        "parameters": []
    }
}
