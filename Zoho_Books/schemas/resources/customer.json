{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Customer",
                        "value": "customer.create",
                        "description": "Create a new customer in Zoho Books."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is required"
                    }
                },
                "description": "Choose the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "customer",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getCurrency": {
        "definition": {
            "qs": {},
            "url": "https://www.zohoapis.in/books/v3/settings/currencies?organization_id={{parameters.organization_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.currencies}}"
            }
        }
    },
    "getLocations": {
        "definition": {
            "url": "https://www.zohoapis.in/books/v3/locations?organization_id={{parameters.organization_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.locations}}"
            }
        }
    },
    "getOrganizations": {
        "definition": {
            "url": "https://www.zohoapis.in/books/v3/organizations",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.organizations}}"
            }
        }
    },
    "create": {
        "definition": {
            "url": "https://www.zohoapis.in/books/v3/contacts?organization_id={{parameters.organization_id}}",
            "body": {
                "email": "{{parameters.email}}",
                "notes": "{{parameters.notes}}",
                "twitter": "{{parameters.twitter}}",
                "website": "{{parameters.website}}",
                "facebook": "{{parameters.facebook}}",
                "currency_id": "{{parameters.currency_id}}",
                "company_name": "{{parameters.company_name}}",
                "contact_name": "{{parameters.contact_name}}",
                "contact_type": "{{parameters.contact_type}}",
                "credit_limit": "{{parameters.credit_limit}}",
                "language_code": "{{parameters.language_code}}",
                "payment_terms": "{{parameters.payment_terms}}",
                "billing_address": "{{parameters.billing_address}}",
                "contact_persons": "{{parameters.contact_persons}}",
                "opening_balances": "{{parameters.opening_balances}}",
                "shipping_address": "{{parameters.shipping_address}}",
                "customer_sub_type": "{{parameters.customer_sub_type}}",
                "is_portal_enabled": "{{parameters.is_portal_enabled}}",
                "payment_terms_label": "{{parameters.payment_terms_label}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.code}}",
                    "error": "{{response.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
