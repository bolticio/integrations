{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Custom API",
                        "value": "custom.custom_api",
                        "description": "Work with custom modules in your Zoho Desk"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "custom",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "custom_api": {
        "definition": {
            "qs": "{{parameters.query_params}}",
            "url": "{{parameters.base_url}}",
            "body": "{{parameters.body}}",
            "method": "{{parameters.method}}",
            "headers": {
                "orgId": "{{parameters.org_id}}",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": "get",
                    "options": [
                        {
                            "label": "GET",
                            "value": "get"
                        },
                        {
                            "label": "PUT",
                            "value": "put"
                        },
                        {
                            "label": "POST",
                            "value": "post"
                        },
                        {
                            "label": "PATCH",
                            "value": "patch"
                        },
                        {
                            "label": "DELETE",
                            "value": "delete"
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": "The HTTP Method to be used for the request.",
                    "displayName": "Method",
                    "displayType": "select",
                    "placeholder": "Select HTTP method"
                },
                "name": "method"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The URL of the HTTP Request.",
                    "displayName": "Base URL",
                    "displayType": "text",
                    "placeholder": "Eg. https://www.example.com"
                },
                "name": "base_url"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The Org ID of the Zoho Desk account.",
                    "displayName": "Organization ID",
                    "displayType": "text",
                    "placeholder": "Enter Organization ID"
                },
                "name": "org_id"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "md",
                        "language": "json",
                        "fullscreen": true,
                        "showSuggestions": true
                    },
                    "description": "The headers to be sent with the request.",
                    "displayName": "Headers",
                    "displayType": "code",
                    "placeholder": "Add custom headers"
                },
                "name": "headers"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "md",
                        "language": "json",
                        "fullscreen": true,
                        "showSuggestions": true
                    },
                    "description": "The query parameters to be sent with the request.",
                    "displayName": "Query Params",
                    "displayType": "code",
                    "placeholder": "Add query parameters"
                },
                "name": "query_params"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "md",
                        "language": "json",
                        "fullscreen": true,
                        "showSuggestions": true
                    },
                    "description": "The Payload (Body) of the HTTP Request.",
                    "displayName": "Body",
                    "displayType": "code",
                    "placeholder": "Add payload"
                },
                "name": "body"
            }
        ]
    }
}
