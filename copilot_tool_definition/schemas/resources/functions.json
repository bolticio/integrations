{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Add Tool Definition",
                        "value": "functions.toolDefinition",
                        "description": "Create a Copilot tool definition."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "functions",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "tooldefinition": {
        "definition": {
            "url": "https://integrations.copilot.live/_cloudintegrationz",
            "body": {
                "parameters": "{{parameters}}",
                "copilotInputArgs": "{{payload.copilotInputArgs}}"
            },
            "method": "post",
            "filters": {
                "body": {
                    "allowEmptyArray": true,
                    "allowEmptyValue": true,
                    "allowEmptyObject": true
                }
            },
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "By activating the tool, you can use it in your copilot",
                    "displayName": "Activate Tool",
                    "displayType": "toggle",
                    "placeholder": "Activate tool"
                },
                "name": "isToolActive"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Enable this option to require users to be authenticated before accessing the tool.",
                    "displayName": "Authenticated Access Only",
                    "displayType": "toggle",
                    "placeholder": "Require authentication"
                },
                "name": "requiresAuthentication"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Tool description is required"
                        }
                    },
                    "description": "Provide a description of the tool",
                    "displayName": "Tool Description",
                    "displayType": "text",
                    "placeholder": "E.g. This tool will return a list of products"
                },
                "name": "toolDescription"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": true,
                                    "requiredDetail": {
                                        "errorMsg": "Parameter name is required"
                                    }
                                },
                                "description": "Enter the name of the parameter",
                                "displayName": "Name",
                                "displayType": "text",
                                "placeholder": "E.g. product_id"
                            },
                            "name": "name"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true,
                                    "requiredDetail": {
                                        "errorMsg": "Parameter name is required"
                                    }
                                },
                                "description": "Enter the description of the parameter",
                                "displayName": "Description",
                                "displayType": "text",
                                "placeholder": "E.g. ID of the product"
                            },
                            "name": "description"
                        },
                        {
                            "meta": {
                                "options": [
                                    {
                                        "label": "String",
                                        "value": "string",
                                        "description": "Text value."
                                    },
                                    {
                                        "label": "Number",
                                        "value": "number",
                                        "description": "Numeric value."
                                    },
                                    {
                                        "label": "Boolean",
                                        "value": "boolean",
                                        "description": "True or false value."
                                    }
                                ],
                                "validation": {
                                    "required": true,
                                    "requiredDetail": {
                                        "errorMsg": "Data type selection is required"
                                    }
                                },
                                "description": "Data Type of the parameter",
                                "displayName": "Data Type",
                                "displayType": "select",
                                "placeholder": "Select one"
                            },
                            "name": "dataType"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "This will make the parameter mandatory",
                                "displayName": "Is Required?",
                                "displayType": "toggle",
                                "placeholder": "Mark as required"
                            },
                            "name": "required"
                        }
                    ],
                    "htmlProps": {
                        "allowAdd": true
                    },
                    "validation": {
                        "max": 20,
                        "required": false
                    },
                    "description": "Parameters for the tool",
                    "displayName": "Parameter",
                    "displayType": "array"
                },
                "name": "toolParams"
            },
            {
                "meta": {
                    "value": "web",
                    "options": [
                        {
                            "label": "Phone Call",
                            "value": "call",
                            "description": "Make the tool available during phone calls."
                        },
                        {
                            "label": "Public Webpage",
                            "value": "hosted-web",
                            "description": "Make the tool available on public webpages."
                        },
                        {
                            "label": "Web Widget",
                            "value": "web",
                            "description": "Make the tool available in the web widget."
                        },
                        {
                            "label": "WhatsApp",
                            "value": "whatsapp",
                            "description": "Make the tool available in WhatsApp."
                        },
                        {
                            "label": "Mobile",
                            "value": "mobile",
                            "description": "Make the tool available in mobile apps."
                        },
                        {
                            "label": "Slack",
                            "value": "slack",
                            "description": "Make the tool available in Slack."
                        },
                        {
                            "label": "Telegram",
                            "value": "telegram",
                            "description": "Make the tool available in Telegram."
                        },
                        {
                            "label": "Facebook Messenger",
                            "value": "facebook-messenger",
                            "description": "Make the tool available in Facebook Messenger."
                        },
                        {
                            "label": "X (Twitter)",
                            "value": "twitter",
                            "description": "Make the tool available in Twitter."
                        },
                        {
                            "label": "Email",
                            "value": "email",
                            "description": "Make the tool available in Email."
                        },
                        {
                            "label": "Instagram",
                            "value": "instagram",
                            "description": "Make the tool available in Instagram."
                        }
                    ],
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Please select at least 1 surface where the workflow can be used"
                        }
                    },
                    "description": "Select one or more surfaces where the workflow can be used",
                    "displayName": "Supported Surfaces",
                    "displayType": "multiselect",
                    "placeholder": "Select supported surfaces"
                },
                "name": "toolSurfaces"
            },
            {
                "meta": {
                    "value": "15",
                    "validation": {
                        "max": 120,
                        "min": 5,
                        "required": true
                    },
                    "description": "This is the maximum time Copilot agent will wait for tool to respond.",
                    "displayName": "Execution Timeout",
                    "displayType": "number",
                    "placeholder": "15"
                },
                "name": "pollTimeout"
            }
        ]
    }
}
