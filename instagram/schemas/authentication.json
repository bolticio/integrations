{
    "oauth2": {
        "token": {
            "qs": {
                "grant_type": "ig_exchange_token",
                "access_token": "{{secrets.access_token}}",
                "client_secret": "{{secrets.client_secret}}"
            },
            "url": "https://graph.instagram.com/access_token",
            "method": "get",
            "headers": {
                "Content-Type": "application/x-www-form-urlencoded"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error}}",
                    "message": "{{response.data.error_description}}"
                },
                "output": {
                    "expires_in": "{{response.data.expires_in}}",
                    "token_type": "bearer",
                    "access_token": "{{response.data.access_token}}",
                    "refresh_token": "{{response.data.access_token}}"
                }
            }
        },
        "refresh": {
            "qs": {
                "grant_type": "ig_refresh_token",
                "access_token": "{{secrets.access_token}}",
                "client_secret": "{{secrets.client_secret}}"
            },
            "url": "https://graph.instagram.com/refresh_access_token",
            "method": "get",
            "headers": {
                "Content-Type": "application/x-www-form-urlencoded"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error}}",
                    "message": "{{response.data.error_description}}"
                },
                "output": {
                    "expires_in": "{{response.data.expires_in}}",
                    "token_type": "bearer",
                    "access_token": "{{response.data.access_token}}",
                    "refresh_token": "{{response.data.access_token}}"
                }
            }
        },
        "validate": {
            "url": "https://graph.instagram.com/v21.0/me",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "authorize": {
            "qs": {
                "scope": "instagram_business_basic,instagram_business_manage_messages",
                "state": "{{uuidv4()}}",
                "client_id": "{{secrets.client_id}}",
                "force_reauth": "true",
                "redirect_uri": "{{secrets.redirect_uri}}",
                "response_type": "code"
            },
            "url": "https://www.instagram.com/oauth/authorize",
            "method": "get",
            "response": {
                "output": "{{response.data}}"
            }
        },
        "pre_token": {
            "url": "https://api.instagram.com/oauth/access_token",
            "body": {
                "code": "{{code}}",
                "client_id": "{{secrets.client_id}}",
                "grant_type": "authorization_code",
                "redirect_uri": "{{secrets.redirect_uri}}",
                "client_secret": "{{secrets.client_secret}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/x-www-form-urlencoded"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error}}",
                    "message": "{{response.data.error_description}}"
                },
                "output": {
                    "expires_in": 3600,
                    "token_type": "bearer",
                    "access_token": "{{response.data.access_token}}",
                    "refresh_token": "{{response.data.access_token}}"
                }
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": "v1/instagram/oauth2/callback",
                    "displayName": "Redirect URI",
                    "displayType": "hidden",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "redirect_uri"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "small",
                        "style": {
                            "color": "#ffffff",
                            "height": "40px",
                            "padding": "16px",
                            "fontSize": "14px",
                            "fontWeight": 700,
                            "backgroundColor": "#ff592f"
                        },
                        "variant": "contained"
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Please connect your Instagram account first"
                        }
                    },
                    "description": "Connect your Instagram account to get started",
                    "displayName": "Connect Instagram Account",
                    "displayType": "button",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "refresh_token",
                                "operator": "EMPTY"
                            },
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "oauth2"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "small",
                        "style": {
                            "color": "#ffffff",
                            "backgroundColor": "#28A745"
                        },
                        "variant": "contained"
                    },
                    "description": "Your Instagram account is connected.",
                    "displayName": "Instagram Account Connected",
                    "displayType": "button",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "refresh_token",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "expires_in",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "oauth2_connected"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "small",
                        "variant": "contained"
                    },
                    "description": "Reconnect your Instagram account.",
                    "displayName": "Reconnect Instagram",
                    "displayType": "button",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "refresh_token",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            },
                            {
                                "field": "meta.auth_status",
                                "value": "REVOKED",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "oauth2_reconnect"
            },
            {
                "meta": {
                    "displayName": "Refresh Token",
                    "displayType": "hidden",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "refresh_token"
            },
            {
                "meta": {
                    "displayName": "Access Token",
                    "displayType": "hidden",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "access_token"
            },
            {
                "meta": {
                    "displayName": "Expires In",
                    "displayType": "hidden",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "expires_in"
            }
        ]
    },
    "parameters": [
        {
            "meta": {
                "value": "oauth2",
                "options": [
                    {
                        "label": "OAuth2",
                        "value": "oauth2"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Choose the type of authentication you want to use.",
                "displayName": "Authentication Type",
                "displayType": "select",
                "placeholder": "Select an authentication type"
            },
            "name": "type"
        }
    ]
}
