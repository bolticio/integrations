{
    "api_key": {
        "validate": {
            "url": "https://api.aipim.sit.fyndx1.de/public/organization/v1.0/token/verify",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Please go to tokens page on Catalog Cloud console to get API token.",
                    "displayName": "API Key",
                    "displayType": "password",
                    "placeholder": "Enter API Key"
                },
                "name": "api_key"
            }
        ]
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "API Key",
                        "value": "api_key",
                        "description": "Authenticate using an API key."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Choose the type of authentication you want to use.",
                "displayName": "Authentication Type",
                "displayType": "select",
                "placeholder": "Select an authentication type"
            },
            "name": "type"
        }
    ]
}
