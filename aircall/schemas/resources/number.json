{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Numbers",
                        "value": "number.list"
                    },
                    {
                        "label": "Get Number",
                        "value": "number.get"
                    },
                    {
                        "label": "Update Number",
                        "value": "number.update"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "number",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "get": {
        "definition": {
            "url": "https://api.aircall.io/v1/numbers/{{parameters.number_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the number.",
                    "displayName": "Number ID",
                    "displayType": "text",
                    "placeholder": "Enter the Number ID"
                },
                "name": "number_id"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://api.aircall.io/v1/numbers",
            "method": "get",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.numbers}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{response.data.meta.current_page}} + 1",
                    "per_page": "20"
                },
                "type": "page",
                "default": {
                    "page": 1,
                    "per_page": 20
                },
                "condition": "{{response.data.meta.total}} < {{response.data.meta.current_page}} * {{response.data.meta.per_page}}"
            }
        },
        "parameters": []
    },
    "update": {
        "definition": {
            "url": "https://api.aircall.io/v1/numbers/{{parameters.number_id}}",
            "body": {
                "name": "{{parameters.name}}"
            },
            "method": "put",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the number.",
                    "displayName": "Number ID",
                    "displayType": "text",
                    "placeholder": "Enter the Number ID"
                },
                "name": "number_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The updated name for the number.",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter the name"
                },
                "name": "name"
            }
        ]
    }
}
