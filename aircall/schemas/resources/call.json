{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Calls",
                        "value": "call.list"
                    },
                    {
                        "label": "Get Call",
                        "value": "call.get"
                    },
                    {
                        "label": "Search Call",
                        "value": "call.search"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "call",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "search": {
        "definition": {
            "qs": {
                "to": "{{parameters.to}}",
                "from": "{{parameters.from}}",
                "user_id": "{{parameters.user_id}}",
                "phone_number": "{{parameters.phone_number}}",
                "fetch_contact": "{{parameters.fetch_contact}}"
            },
            "url": "https://api.aircall.io/v1/calls/search",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.calls}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "readOnly": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Set a minimal creation date for calls.",
                    "displayName": "From (Timestamp)",
                    "displayType": "datetime",
                    "placeholder": "Enter the minimal creation date (UNIX timestamp)"
                },
                "name": "from"
            },
            {
                "meta": {
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "readOnly": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Set a maximal creation date for calls.",
                    "displayName": "To (Timestamp)",
                    "displayType": "datetime",
                    "placeholder": "Enter the maximal creation date (UNIX timestamp)"
                },
                "name": "to"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Unique ID of the user who made or received calls.",
                    "displayName": "User ID",
                    "displayType": "number",
                    "placeholder": "Enter the User ID"
                },
                "name": "user_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "When set to true, adds contact details in the response.",
                    "displayName": "Fetch Contact",
                    "displayType": "boolean"
                },
                "name": "fetch_contact"
            },
            {
                "meta": {
                    "value": "+91",
                    "htmlProps": {
                        "disabled": false,
                        "readOnly": false,
                        "onlyCountries": [
                            "IN"
                        ],
                        "defaultCountry": "IN",
                        "preferredCountries": [
                            "IN"
                        ]
                    },
                    "validation": {
                        "required": true,
                        "matchIsValidTel": true
                    },
                    "description": "The calling or receiving phone number of the calls.",
                    "displayName": "Phone Number",
                    "displayType": "phone",
                    "placeholder": "Enter the phone number"
                },
                "name": "phone_number"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://api.aircall.io/v1/calls",
            "method": "get",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.calls}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{response.data.meta.current_page}} + 1",
                    "per_page": "20"
                },
                "type": "page",
                "default": {
                    "page": 1,
                    "per_page": 20
                },
                "condition": "{{response.data.meta.total}} < {{response.data.meta.current_page}} * {{response.data.meta.per_page}}"
            }
        },
        "parameters": []
    },
    "get": {
        "definition": {
            "url": "https://api.aircall.io/v1/calls/{{parameters.call_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the call.",
                    "displayName": "Call ID",
                    "displayType": "text",
                    "placeholder": "Enter the Call ID"
                },
                "name": "call_id"
            }
        ]
    }
}
