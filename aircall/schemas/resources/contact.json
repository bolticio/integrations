{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Contacts",
                        "value": "contact.list"
                    },
                    {
                        "label": "Get Contact",
                        "value": "contact.get"
                    },
                    {
                        "label": "Create Contact",
                        "value": "contact.create"
                    },
                    {
                        "label": "Delete Contact",
                        "value": "contact.delete"
                    },
                    {
                        "label": "Add Phone Number",
                        "value": "contact.addphone"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "contact",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "list": {
        "definition": {
            "url": "https://api.aircall.io/v1/contacts",
            "method": "get",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.contacts}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{response.data.meta.current_page}} + 1",
                    "per_page": "20"
                },
                "type": "page",
                "default": {
                    "page": 1,
                    "per_page": 20
                },
                "condition": "{{response.data.meta.total}} < {{response.data.meta.current_page}} * {{response.data.meta.per_page}}"
            }
        },
        "parameters": []
    },
    "get": {
        "definition": {
            "url": "https://api.aircall.io/v1/contacts/{{parameters.contact_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the contact.",
                    "displayName": "Contact ID",
                    "displayType": "text",
                    "placeholder": "Enter the Contact ID"
                },
                "name": "contact_id"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://api.aircall.io/v1/contacts",
            "body": {
                "emails": [
                    {
                        "label": "{{parameters.emails[0].label}}",
                        "value": "{{parameters.emails[0].value}}"
                    }
                ],
                "last_name": "{{parameters.last_name}}",
                "first_name": "{{parameters.first_name}}",
                "information": "{{parameters.information}}",
                "phone_numbers": [
                    {
                        "label": "{{parameters.phone_numbers[0].label}}",
                        "value": "{{parameters.phone_numbers[0].value}}"
                    }
                ]
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The contact's first name.",
                    "displayName": "First Name",
                    "displayType": "text",
                    "placeholder": "Enter the first name"
                },
                "name": "first_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The contact's last name.",
                    "displayName": "Last Name",
                    "displayType": "text",
                    "placeholder": "Enter the last name"
                },
                "name": "last_name"
            },
            {
                "meta": {
                    "description": "Additional information about the contact (e.g., external_custom_id).",
                    "displayName": "Information",
                    "displayType": "text",
                    "placeholder": "Enter additional contact information"
                },
                "name": "information"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "displayName": "Phone Label",
                                "displayType": "text",
                                "placeholder": "Enter the label for the phone number (e.g., Work, Home)"
                            },
                            "name": "label"
                        },
                        {
                            "meta": {
                                "value": "+91",
                                "htmlProps": {
                                    "disabled": false,
                                    "readOnly": false,
                                    "onlyCountries": [
                                        "IN"
                                    ],
                                    "defaultCountry": "IN",
                                    "preferredCountries": [
                                        "IN"
                                    ]
                                },
                                "validation": {
                                    "pattern": "^\\+\\d{1,15}$",
                                    "required": true,
                                    "errorMessage": "Phone number must be in format starting with +91 followed by digits",
                                    "matchIsValidTel": true
                                },
                                "displayName": "Phone Number",
                                "displayType": "phone",
                                "placeholder": "Enter the phone number in  format (e.g., +919234567890)"
                            },
                            "name": "value"
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": "An array of phone number objects. Each object should have a label and value.",
                    "displayName": "Phone Numbers",
                    "displayType": "array"
                },
                "name": "phone_numbers"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "displayName": "Email Label",
                                "displayType": "text",
                                "placeholder": "Enter the label for the email address (e.g., Office, Personal)"
                            },
                            "name": "label"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "displayName": "Email Address",
                                "displayType": "email",
                                "placeholder": "Enter the email address"
                            },
                            "name": "value"
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": "An array of email objects. Each object should have a label and value.",
                    "displayName": "Emails",
                    "displayType": "array"
                },
                "name": "emails"
            }
        ]
    },
    "addphone": {
        "definition": {
            "url": "https://api.aircall.io/v1/contacts/{{parameters.contact_id}}/phone_details",
            "body": {
                "label": "{{parameters.label}}",
                "value": "{{parameters.value}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the contact.",
                    "displayName": "Contact ID",
                    "displayType": "text",
                    "placeholder": "Enter the Contact ID"
                },
                "name": "contact_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The label associated with the phone number.",
                    "displayName": "Label",
                    "displayType": "text",
                    "placeholder": "Enter the label for the phone number (e.g., Work, Home)"
                },
                "name": "label"
            },
            {
                "meta": {
                    "value": "+91",
                    "htmlProps": {
                        "disabled": false,
                        "readOnly": false,
                        "onlyCountries": [
                            "IN"
                        ],
                        "defaultCountry": "IN",
                        "preferredCountries": [
                            "IN"
                        ]
                    },
                    "validation": {
                        "required": true,
                        "matchIsValidTel": true
                    },
                    "description": "The phone number to be added. Ensure it's a valid phone number.",
                    "displayName": "Phone Number",
                    "displayType": "phone",
                    "placeholder": "Enter the phone number with prefix +91"
                },
                "name": "value"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://api.aircall.io/v1/contacts/{{parameters.contact_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the contact.",
                    "displayName": "Contact ID",
                    "displayType": "text",
                    "placeholder": "Enter the Contact ID"
                },
                "name": "contact_id"
            }
        ]
    }
}
