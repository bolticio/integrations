{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Teams",
                        "value": "team.list"
                    },
                    {
                        "label": "Get Team",
                        "value": "team.get"
                    },
                    {
                        "label": "Create Team",
                        "value": "team.create"
                    },
                    {
                        "label": "Delete Team",
                        "value": "team.delete"
                    },
                    {
                        "label": "Add User to Team",
                        "value": "team.addUser"
                    },
                    {
                        "label": "Remove User from Team",
                        "value": "team.removeUser"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "team",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://api.aircall.io/v1/teams",
            "body": {
                "name": "{{parameters.name}}",
                "description": "{{parameters.description}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the team.",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter team name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "description": "A brief description of the team.",
                    "displayName": "Description",
                    "displayType": "text",
                    "placeholder": "Enter team description"
                },
                "name": "description"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://api.aircall.io/v1/teams",
            "method": "get",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.teams}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{response.data.meta.current_page}} + 1",
                    "per_page": "20"
                },
                "type": "page",
                "default": {
                    "page": 1,
                    "per_page": 20
                },
                "condition": "{{response.data.meta.total}} < {{response.data.meta.current_page}} * {{response.data.meta.per_page}}"
            }
        },
        "parameters": []
    },
    "get": {
        "definition": {
            "url": "https://api.aircall.io/v1/teams/{{parameters.team_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the team.",
                    "displayName": "Team ID",
                    "displayType": "text",
                    "placeholder": "Enter the Team ID"
                },
                "name": "team_id"
            }
        ]
    },
    "removeuser": {
        "definition": {
            "url": "https://api.aircall.io/v1/teams/{{parameters.team_id}}/users/{{parameters.user_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the team.",
                    "displayName": "Team ID",
                    "displayType": "text",
                    "placeholder": "Enter the Team ID"
                },
                "name": "team_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the user.",
                    "displayName": "User ID",
                    "displayType": "text",
                    "placeholder": "Enter the User ID"
                },
                "name": "user_id"
            }
        ]
    },
    "adduser": {
        "definition": {
            "url": "https://api.aircall.io/v1/teams/{{parameters.team_id}}/users/{{parameters.user_id}}",
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the team.",
                    "displayName": "Team ID",
                    "displayType": "text",
                    "placeholder": "Enter the Team ID"
                },
                "name": "team_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the user.",
                    "displayName": "User ID",
                    "displayType": "text",
                    "placeholder": "Enter the User ID"
                },
                "name": "user_id"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://api.aircall.io/v1/teams/{{parameters.team_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_id}}:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique ID for the team.",
                    "displayName": "Team ID",
                    "displayType": "text",
                    "placeholder": "Enter the Team ID"
                },
                "name": "team_id"
            }
        ]
    }
}
