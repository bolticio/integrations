{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Update Bulk Quantities",
                        "value": "productQuantity.updatebulkquantities",
                        "description": "Bulk update product quantities by ID or SKU."
                    },
                    {
                        "label": "List Product Quantities",
                        "value": "productQuantity.getproductquantities",
                        "description": "List product quantities."
                    },
                    {
                        "label": "List Quantity Change Reasons",
                        "value": "productQuantity.getquantitychangereasons",
                        "description": "List reasons for inventory quantity changes."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "productQuantity",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getquantitychangereasons": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/products/quantities/quantity-change-reason",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": []
    },
    "updatebulkquantities": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/products/quantities/bulk",
            "body": {
                "products": "{{parameters.products}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "value": "",
                                "options": [
                                    {
                                        "label": "ID",
                                        "value": "id",
                                        "description": "for dynamic input, enter 'id'"
                                    },
                                    {
                                        "label": "Variant Id",
                                        "value": "variant_id",
                                        "description": "for dynamic input, enter 'variant_id'"
                                    },
                                    {
                                        "label": "SKU",
                                        "value": "sku",
                                        "description": "for dynamic input, enter 'sku'"
                                    }
                                ],
                                "htmlProps": {
                                    "allowDynamic": true
                                },
                                "validation": {
                                    "required": true
                                },
                                "description": "Identifier Type. Value can either be id, variant_id or sku.",
                                "displayName": "ID Type",
                                "displayType": "autocomplete",
                                "placeholder": "Select the type of ID"
                            },
                            "name": "identifer_type"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "Identifier value (product ID, variant ID, or SKU).",
                                "displayName": "Id",
                                "displayType": "text",
                                "placeholder": "Enter product, variant or SKU ID"
                            },
                            "name": "identifer"
                        },
                        {
                            "meta": {
                                "value": "",
                                "options": [
                                    {
                                        "label": "overwrite",
                                        "value": "overwrite",
                                        "description": "Overwrite current quantity"
                                    },
                                    {
                                        "label": "increment",
                                        "value": "increment",
                                        "description": "Increment current quantity"
                                    },
                                    {
                                        "label": "decrement",
                                        "value": "decrement",
                                        "description": "Decrement current quantity"
                                    }
                                ],
                                "htmlProps": {
                                    "allowDynamic": true
                                },
                                "validation": {
                                    "required": false
                                },
                                "description": "Mode of quantity update.",
                                "displayName": "Update Mode",
                                "displayType": "autocomplete",
                                "placeholder": "Select the mode of quantity update"
                            },
                            "name": "mode"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Branch ID.",
                                "displayName": "Branch ID",
                                "displayType": "number",
                                "placeholder": "Enter branch ID"
                            },
                            "name": "branch"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Reason ID for the change.",
                                "displayName": "Reason ID",
                                "displayType": "number",
                                "placeholder": "Enter reason ID"
                            },
                            "name": "reason_id"
                        },
                        {
                            "meta": {
                                "value": true,
                                "readOnly": false,
                                "htmlProps": {
                                    "allowDynamic": true
                                },
                                "validation": {
                                    "disabled": false
                                },
                                "description": "Set to allow unlimited quantity. If unlimited quantity is set to No, you must specify the Quantity.",
                                "displayName": "Unlimited Quantity",
                                "displayType": "toggle",
                                "placeholder": "Enable for unlimited quantity"
                            },
                            "name": "unlimited_quantity"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter quantity value to bulk update. If unlimited quantity is set to No, you must specify the Quantity.",
                                "displayName": "Quantity",
                                "displayType": "number",
                                "placeholder": "Enter quantity"
                            },
                            "name": "quantity"
                        }
                    ],
                    "htmlProps": {
                        "allowAdd": true
                    },
                    "description": "Products to update.",
                    "displayName": "Products",
                    "displayType": "array"
                },
                "name": "products"
            }
        ]
    },
    "getproductquantities": {
        "definition": {
            "qs": {
                "perPage": 100
            },
            "url": "https://api.salla.dev/admin/v2/products/quantities",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.pagination.totalPages}} >= {{pagination.page}}"
            }
        },
        "parameters": []
    }
}
