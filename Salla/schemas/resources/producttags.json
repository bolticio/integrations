{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Product Tags",
                        "value": "productTags.getproducttags",
                        "description": "List product tags in the store."
                    },
                    {
                        "label": "Create Product Tag",
                        "value": "productTags.createproducttag",
                        "description": "Create a new product tag."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "productTags",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "createproducttag": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/products/tags",
            "body": {
                "tag_name": "{{parameters.tag_name}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Name for the new tag.",
                    "displayName": "Tag Name",
                    "displayType": "text",
                    "placeholder": "Enter the tag name"
                },
                "name": "tag_name"
            }
        ]
    },
    "getproducttags": {
        "definition": {
            "qs": {
                "perPage": 100
            },
            "url": "https://api.salla.dev/admin/v2/products/tags",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.pagination.totalPages}} >= {{pagination.page}}"
            }
        },
        "parameters": []
    }
}
