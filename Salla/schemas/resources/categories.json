    "createcategory": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/categories",
            "body": {
                "name": "{{parameters.name}}",
                "status": "{{parameters.status}}",
                "metadata_title": "{{parameters.metadata_title}}",
                "metadata_description": "{{parameters.metadata_description}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The title or label assigned to a specific grouping or classification of items, products, or content.",
                    "displayName": "Category Name",
                    "displayType": "text",
                    "placeholder": "Enter the category name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "active",
                            "value": "active"
                        },
                        {
                            "label": "hidden",
                            "value": "hidden"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "The status of the category, whether or not it is active or hidden.",
                    "displayName": "Status",
                    "displayType": "autocomplete",
                    "placeholder": "Select the status of the category"
                },
                "name": "status"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "SEO Metadata Title which is a label used to optimize search engine results and enhance the visibility of a category page.",
                    "displayName": "Metadata Title",
                    "displayType": "text",
                    "placeholder": "Enter metadata title"
                },
                "name": "metadata_title"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Metadata description to enhance search engine optimization and spotlight a brand's attributes within a category.",
                    "displayName": "Metadata Description",
                    "displayType": "textarea",
                    "placeholder": "Enter metadata description"
                },
                "name": "metadata_description"
            }
        ]
    },
