{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Category",
                        "value": "categories.createcategory",
                        "description": "Create a new category."
                    },
                    {
                        "label": "List Categories",
                        "value": "categories.getcategories",
                        "description": "List categories in the store."
                    },
                    {
                        "label": "Get Category Details",
                        "value": "categories.getcategorydetails",
                        "description": "Get details for a category."
                    },
                    {
                        "label": "List Category Products",
                        "value": "categories.getcategoryproducts",
                        "description": "List products in a category."
                    },
                    {
                        "label": "Delete Category",
                        "value": "categories.deletecategory",
                        "description": "Delete a category."
                    },
                    {
                        "label": "List Child Categories of Category",
                        "value": "categories.categorychildren",
                        "description": "List child categories of a category."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "categories",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getCategoriesOptions": {
        "definition": {
            "qs": {
                "status": "{{parameters.status}}",
                "keyword": "{{parameters.keyword}}",
                "perPage": 100
            },
            "url": "https://api.salla.dev/admin/v2/categories",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.pagination.totalPages}} >= {{pagination.page}}"
            }
        }
    },
    "deletecategory": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/categories/{{parameters.categoryId}}",
            "method": "delete",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "salla",
                            "secret": "{{parameters.secret}}",
                            "resource": "categories",
                            "operation": "categories.getCategoryDetails",
                            "loadOptionsMethod": "getCategoriesOptions"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the category. For dynamic input enter category ID.",
                    "displayName": "Category",
                    "displayType": "autocomplete",
                    "placeholder": "Select the category"
                },
                "name": "categoryId"
            }
        ]
    },
