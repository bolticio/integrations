    "createcustomer": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/customers",
            "body": {
                "email": "{{parameters.email}}",
                "gender": "{{parameters.gender}}",
                "mobile": "{{parameters.mobile}}",
                "birthday": "{{parameters.birthday}}",
                "last_name": "{{parameters.last_name}}",
                "first_name": "{{parameters.first_name}}",
                "mobile_code_country": "{{parameters.mobile_code_country}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Customer first name.",
                    "displayName": "First Name",
                    "displayType": "text",
                    "placeholder": "Enter first name"
                },
                "name": "first_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Customer last name.",
                    "displayName": "Last Name",
                    "displayType": "text",
                    "placeholder": "Enter last name"
                },
                "name": "last_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Customer email address.",
                    "displayName": "Email",
                    "displayType": "email",
                    "placeholder": "Enter email ID"
                },
                "name": "email"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Customer mobile country code.",
                    "displayName": "Mobile Country Code",
                    "displayType": "number",
                    "placeholder": "+91"
                },
                "name": "mobile_code_country"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Customer mobile number.",
                    "displayName": "Mobile Number",
                    "displayType": "number",
                    "placeholder": "Enter mobile number"
                },
                "name": "mobile"
            },
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "male",
                            "value": "male"
                        },
                        {
                            "label": "female",
                            "value": "female"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Select the customer gender.",
                    "displayName": "Gender",
                    "displayType": "autocomplete",
