    "getCustomerOptions": {
        "definition": {
            "qs": {
                "perPage": 100
            },
            "url": "https://api.salla.dev/admin/v2/customers",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.pagination.totalPages}} >= {{pagination.page}}"
            }
        }
    },
    "getcustomers": {
        "definition": {
            "qs": {
                "date_to": "{{parameters.date_to}}",
                "keyword": "{{parameters.keyword}}",
                "perPage": 100,
                "date_from": "{{parameters.date_from}}"
            },
            "url": "https://api.salla.dev/admin/v2/customers",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.pagination.totalPages}} >= {{pagination.page}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Filter by customer name.",
                    "displayName": "Customer name",
                    "displayType": "text",
                    "placeholder": "Enter customer name"
                },
                "name": "keyword"
            },
            {
                "meta": {
                    "value": "",
                    "readOnly": false,
                    "htmlProps": {
                        "views": [
                            "year",
                            "month",
                            "day"
                        ],
                        "format": "YYYY-MM-DD",
                        "disabled": false,
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Get a list of customers created on or after this date (required for date-based filtering).",
                    "displayName": "From Date",
                    "displayType": "date",
                    "placeholder": "Select the from date"
                },
                "name": "date_from"
            },
            {
                "meta": {
                    "value": "",
                    "readOnly": false,
                    "htmlProps": {
                        "views": [
                            "year",
                            "month",
                            "day"
                        ],
                        "format": "YYYY-MM-DD",
                        "disabled": false,
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Get a list of customers created on or before this date (required for date-based filtering).",
                    "displayName": "To Date",
                    "displayType": "date",
                    "placeholder": "Select the to date"
                },
                "name": "date_to"
            }
        ]
    },
