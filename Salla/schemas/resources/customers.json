    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Customer",
                        "value": "customers.createcustomer",
                        "description": "Create a new customer."
                    },
                    {
                        "label": "List Customers",
                        "value": "customers.getcustomers",
                        "description": "List customers."
                    },
                    {
                        "label": "Get Customer Details",
                        "value": "customers.getcustomerdetails",
                        "description": "Get customer details."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "customers",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "banCustomer": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/customers/blacklist/{{parameters.customerId}}",
            "body": {
                "reason": "{{parameters.reason}}"
            },
            "method": "put",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "salla",
                            "secret": "{{parameters.secret}}",
                            "resource": "customers",
                            "operation": "customers.getCustomerDetails",
                            "loadOptionsMethod": "getCustomerOptions"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "full_name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select a customer. For dynamic input enter customer ID.",
                    "displayName": "Customer",
                    "displayType": "autocomplete",
                    "placeholder": "Select a customer"
                },
                "name": "customerId"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Reason for banning the customer.",
                    "displayName": "Ban Reason",
                    "displayType": "textarea",
                    "placeholder": "Fraudulent orders",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "customerId",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "reason"
            }
        ]
    },
