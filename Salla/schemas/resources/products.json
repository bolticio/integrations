{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Product",
                        "value": "products.create",
                        "description": "Create a new product."
                    },
                    {
                        "label": "List Products",
                        "value": "products.getproducts",
                        "description": "List products in the store."
                    },
                    {
                        "label": "Get Product Details",
                        "value": "products.getproductdetails",
                        "description": "Get product details."
                    },
                    {
                        "label": "Delete Product",
                        "value": "products.deleteproduct",
                        "description": "Delete a product."
                    },
                    {
                        "label": "Change Product Status",
                        "value": "products.changeproductstatus",
                        "description": "Change a product's status."
                    },
                    {
                        "label": "Update Bulk Product Prices",
                        "value": "products.updatebulkproductprices",
                        "description": "Bulk update product prices."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "products",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/products",
            "body": {
                "sku": "{{parameters.sku}}",
                "name": "{{parameters.name}}",
                "price": "{{parameters.price}}",
                "images": "{{parameters.images}}",
                "status": "{{parameters.status}}",
                "quantity": "{{parameters.quantity}}",
                "description": "{{parameters.description}}",
                "product_type": "{{parameters.product_type}}",
                "unlimited_quantity": "{{parameters.unlimited_quantity}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the name of the product.",
                    "displayName": "Product Name",
                    "displayType": "text",
                    "placeholder": "Enter product name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the product price.",
                    "displayName": "Price",
                    "displayType": "number",
                    "placeholder": "Enter product price"
                },
                "name": "price"
            },
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "product",
                            "value": "product"
                        },
                        {
                            "label": "service",
                            "value": "service"
                        },
                        {
                            "label": "group_products",
                            "value": "group_products"
                        },
                        {
                            "label": "codes",
                            "value": "codes"
                        },
                        {
                            "label": "digital",
                            "value": "digital"
                        },
                        {
                            "label": "food",
                            "value": "food"
                        },
                        {
                            "label": "booking",
                            "value": "booking"
                        },
                        {
                            "label": "donating",
                            "value": "donating"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Product type. This value cannot be changed after creation.",
                    "displayName": "Product Type",
                    "displayType": "autocomplete",
                    "placeholder": "Select the product type"
                },
                "name": "product_type"
            },
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "sale",
                            "value": "sale"
                        },
                        {
                            "label": "out",
                            "value": "out"
                        },
                        {
                            "label": "hidden",
                            "value": "hidden"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Select product status.",
                    "displayName": "Status",
                    "displayType": "autocomplete",
                    "placeholder": "Select the status of the product"
                },
                "name": "status"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Available quantity. If not provided, created products are set to \"out\".",
                    "displayName": "Quantity",
                    "displayType": "number",
                    "placeholder": "Enter product quantity"
                },
                "name": "quantity"
            },
            {
                "meta": {
                    "value": false,
                    "readOnly": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "disabled": false
                    },
                    "description": "Set to allow unlimited quantity.",
                    "displayName": "Unlimited Quantity",
                    "displayType": "toggle",
                    "placeholder": "Enable for unlimited quantity"
                },
                "name": "unlimited_quantity"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Enter the product description.",
                    "displayName": "Description",
                    "displayType": "textarea",
                    "placeholder": "Enter the product description"
                },
                "name": "description"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Enter the SKU (Stock keeping unit).",
                    "displayName": "SKU",
                    "displayType": "text",
                    "placeholder": "Enter the SKU name"
                },
                "name": "sku"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "htmlProps": {
                                    "allowDynamic": true
                                },
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the original image URL.",
                                "displayName": "Original Image URL",
                                "displayType": "url",
                                "placeholder": "Enter the image url"
                            },
                            "name": "original"
                        },
                        {
                            "meta": {
                                "htmlProps": {
                                    "allowDynamic": true
                                },
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the thumbnail image URL.",
                                "displayName": "Thumbnail Image URL",
                                "displayType": "url",
                                "placeholder": "Enter the thumbnail image url"
                            },
                            "name": "thumbnail"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Alternative text for the image.",
                                "displayName": "Alt Text",
                                "displayType": "text",
                                "placeholder": "Enter alternative text for the image"
                            },
                            "name": "alt"
                        },
                        {
                            "meta": {
                                "value": false,
                                "readOnly": false,
                                "htmlProps": {
                                    "allowDynamic": true
                                },
                                "validation": {
                                    "disabled": false
                                },
                                "description": "Whether this image is the default one for the product.",
                                "displayName": "Default Image",
                                "displayType": "toggle",
                                "placeholder": "true"
                            },
                            "name": "default"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Image position in the product images list (starting from 1).",
                                "displayName": "Sort Order",
                                "displayType": "number",
                                "placeholder": "Enter the image position"
                            },
                            "name": "sort"
                        }
                    ],
                    "htmlProps": {
                        "allowAdd": true
                    },
                    "description": "Product images. At least one image is required to avoid status being set to \"hidden\".",
                    "displayName": "Images",
                    "displayType": "array"
                },
                "name": "images"
            }
        ]
    },
    "updatebulkproductprices": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/products/prices/bulkPrice",
            "body": {
                "products": "{{parameters.products}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "Enter the product ID.",
                                "displayName": "Product ID",
                                "displayType": "number",
                                "placeholder": "Enter the product ID"
                            },
                            "name": "id"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "Enter the new price.",
                                "displayName": "Price",
                                "displayType": "number",
                                "placeholder": "Enter the new price"
                            },
                            "name": "price"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the cost price.",
                                "displayName": "Cost Price",
                                "displayType": "number",
                                "placeholder": "Enter the cost price"
                            },
                            "name": "cost_price"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the sale price.",
                                "displayName": "Sale Price",
                                "displayType": "number",
                                "placeholder": "Enter the sale price"
                            },
                            "name": "sale_price"
                        },
                        {
                            "meta": {
                                "value": "",
                                "readOnly": false,
                                "htmlProps": {
                                    "views": [
                                        "year",
                                        "month",
                                        "day"
                                    ],
                                    "format": "YYYY-MM-DD",
                                    "disabled": false,
                                    "allowDynamic": true
                                },
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the sale end date.",
                                "displayName": "Sale End Date",
                                "displayType": "date",
                                "placeholder": "Select the sale end date"
                            },
                            "name": "sale_end"
                        }
                    ],
                    "htmlProps": {
                        "allowAdd": true
                    },
                    "description": "Enter product details to bulk update product prices.",
                    "displayName": "Products",
                    "displayType": "array"
                },
                "name": "products"
            }
        ]
    },
    "deleteproduct": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/products/{{parameters.productId}}",
            "method": "delete",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Product ID to delete.",
                    "displayName": "Product ID",
                    "displayType": "number",
                    "placeholder": "Enter the product ID"
                },
                "name": "productId"
            }
        ]
    },
    "changeproductstatus": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/products/{{parameters.productId}}/status",
            "body": {
                "status": "{{parameters.status}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Product ID to update.",
                    "displayName": "Product ID",
                    "displayType": "number",
                    "placeholder": "Enter the product ID"
                },
                "name": "productId"
            },
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "sale",
                            "value": "sale"
                        },
                        {
                            "label": "out",
                            "value": "out"
                        },
                        {
                            "label": "hidden",
                            "value": "hidden"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "New product status.",
                    "displayName": "Status",
                    "displayType": "autocomplete",
                    "placeholder": "Select the status"
                },
                "name": "status"
            }
        ]
    },
    "getproductdetails": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/products/{{parameters.productId}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Product ID to retrieve.",
                    "displayName": "Product ID",
                    "displayType": "number",
                    "placeholder": "Enter the product ID"
                },
                "name": "productId"
            }
        ]
    },
    "getproducts": {
        "definition": {
            "qs": {
                "status": "{{parameters.status}}",
                "keyword": "{{parameters.keyword}}",
                "perPage": 100,
                "category": "{{parameters.category}}"
            },
            "url": "https://api.salla.dev/admin/v2/products",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.pagination.totalPages}} >= {{pagination.page}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Filter by product name or SKU.",
                    "displayName": "Keyword",
                    "displayType": "text",
                    "placeholder": "Enter the product name or SKU name"
                },
                "name": "keyword"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Filter by category name.",
                    "displayName": "Category",
                    "displayType": "text",
                    "placeholder": "Enter the category name"
                },
                "name": "category"
            },
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "sale",
                            "value": "sale"
                        },
                        {
                            "label": "out",
                            "value": "out"
                        },
                        {
                            "label": "hidden",
                            "value": "hidden"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Filter by product status.",
                    "displayName": "Status",
                    "displayType": "autocomplete",
                    "placeholder": "Select product status"
                },
                "name": "status"
            }
        ]
    }
}
