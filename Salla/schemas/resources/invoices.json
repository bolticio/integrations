{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Order Invoices",
                        "value": "invoices.getorderinvoices",
                        "description": "List invoices for orders."
                    },
                    {
                        "label": "Get Invoice Details",
                        "value": "invoices.getorderinvoicedetails",
                        "description": "Get details for an invoice."
                    },
                    {
                        "label": "Send Order Invoice to Customer",
                        "value": "invoices.sendorderinvoice",
                        "description": "Email the order invoice to the customer."
                    },
                    {
                        "label": "Create Order Invoice",
                        "value": "invoices.createorderinvoice",
                        "description": "Create an invoice for an order."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "invoices",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getorderinvoicedetails": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/orders/invoices/{{parameters.invoice_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Invoice ID to retrieve.",
                    "displayName": "Invoice ID",
                    "displayType": "number",
                    "placeholder": "Enter the invoice ID"
                },
                "name": "invoice_id"
            }
        ]
    },
    "createorderinvoice": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/orders/{{parameters.order_id}}/print-invoice",
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Order ID to create the invoice for.",
                    "displayName": "Order ID",
                    "displayType": "number",
                    "placeholder": "Enter the order ID"
                },
                "name": "order_id"
            }
        ]
    },
    "getorderinvoices": {
        "definition": {
            "qs": {
                "perPage": 100,
                "to_date": "{{parameters.to_date}}",
                "order_id": "{{parameters.order_id}}",
                "from_date": "{{parameters.from_date}}"
            },
            "url": "https://api.salla.dev/admin/v2/orders/invoices",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "page": "{{pagination.page}} + 1"
                },
                "type": "page",
                "default": {
                    "page": 1
                },
                "condition": "{{response.data.pagination.totalPages}} >= {{pagination.page}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": "",
                    "readOnly": false,
                    "htmlProps": {
                        "views": [
                            "year",
                            "month",
                            "day"
                        ],
                        "format": "YYYY-MM-DD",
                        "disabled": false,
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Get a list of order invoices created on or after this date (required for date-based filtering).",
                    "displayName": "From Date",
                    "displayType": "date",
                    "placeholder": "Select the from date"
                },
                "name": "from_date"
            },
            {
                "meta": {
                    "value": "",
                    "readOnly": false,
                    "htmlProps": {
                        "views": [
                            "year",
                            "month",
                            "day"
                        ],
                        "format": "YYYY-MM-DD",
                        "disabled": false,
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Get a list of order invoices created on or before this date (required for date-based filtering).",
                    "displayName": "To Date",
                    "displayType": "date",
                    "placeholder": "Select the to date"
                },
                "name": "to_date"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Filter invoices by order ID.",
                    "displayName": "Order ID",
                    "displayType": "number",
                    "placeholder": "Enter the order ID"
                },
                "name": "order_id"
            }
        ]
    },
    "sendorderinvoice": {
        "definition": {
            "url": "https://api.salla.dev/admin/v2/orders/{{parameters.order_id}}/send-invoice",
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter Order ID to email the invoice to the customer.",
                    "displayName": "Order ID",
                    "displayType": "number",
                    "placeholder": "Enter the order ID"
                },
                "name": "order_id"
            }
        ]
    }
}
