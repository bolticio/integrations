{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List CMS Blocks",
                        "value": "cmsBlock.list",
                        "description": "Retrieve a list of CMS blocks."
                    },
                    {
                        "label": "Create CMS Block",
                        "value": "cmsBlock.create",
                        "description": "Create a new CMS block."
                    },
                    {
                        "label": "Get CMS Block",
                        "value": "cmsBlock.get",
                        "description": "Retrieve a CMS block by its ID."
                    },
                    {
                        "label": "Delete CMS Block",
                        "value": "cmsBlock.delete",
                        "description": "Delete a CMS block by its ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "cmsBlock",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/cmsBlock",
            "body": {
                "block": {
                    "id": "{{parameters.id}}",
                    "title": "{{parameters.title}}",
                    "active": "{{parameters.active}}",
                    "content": "{{parameters.content}}",
                    "identifier": "{{parameters.identifier}}",
                    "update_time": "{{parameters.update_time}}",
                    "creation_time": "{{parameters.creation_time}}"
                }
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The ID of the CMS block.",
                    "displayName": "ID",
                    "displayType": "number",
                    "placeholder": "Enter the block ID (optional for new blocks)"
                },
                "name": "id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "A unique string identifier for the CMS block.",
                    "displayName": "Identifier",
                    "displayType": "text",
                    "placeholder": "Enter the block identifier"
                },
                "name": "identifier"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The title of the CMS block.",
                    "displayName": "Title",
                    "displayType": "text",
                    "placeholder": "Enter the block title"
                },
                "name": "title"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The HTML/text content of the CMS block.",
                    "displayName": "Content",
                    "displayType": "textarea",
                    "placeholder": "Enter the block content"
                },
                "name": "content"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 1,
                            "seconds": 1
                        }
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "The creation timestamp of the CMS block.",
                    "displayName": "Creation Time",
                    "displayType": "datetime",
                    "placeholder": "Enter creation time (YYYY-MM-DD HH:MM:SS)"
                },
                "name": "creation_time"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 1,
                            "seconds": 1
                        }
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "The update timestamp of the CMS block.",
                    "displayName": "Update Time",
                    "displayType": "datetime",
                    "placeholder": "Enter update time (YYYY-MM-DD HH:MM:SS)"
                },
                "name": "update_time"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Whether the CMS block is active.",
                    "displayName": "Active",
                    "displayType": "toggle"
                },
                "name": "active"
            }
        ]
    },
    "list": {
        "definition": {
            "qs": {
                "searchCriteria[pageSize]": "{{parameters.pageSize}}"
            },
            "url": "https://{{secrets.domain}}/rest/default/V1/cmsBlock/search",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": 1,
                    "validation": {
                        "min": 1,
                        "required": true
                    },
                    "displayName": "Page Size",
                    "displayType": "number",
                    "placeholder": "Enter the number of records per page"
                },
                "name": "pageSize"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/cmsBlock/{{parameters.id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the CMS block to delete.",
                    "displayName": "Block ID",
                    "displayType": "text",
                    "placeholder": "Enter the Block ID"
                },
                "name": "id"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/cmsBlock/{{parameters.block_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the CMS block to retrieve.",
                    "displayName": "Block ID",
                    "displayType": "text",
                    "placeholder": "Enter the Block ID"
                },
                "name": "block_id"
            }
        ]
    }
}
