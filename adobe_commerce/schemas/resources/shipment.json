{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Track Shipment",
                        "value": "shipment.track",
                        "description": "Track a shipment."
                    },
                    {
                        "label": "Get Shipment by ID",
                        "value": "shipment.getById",
                        "description": "Retrieve a shipment by its ID."
                    },
                    {
                        "label": "Add Comment to Shipment",
                        "value": "shipment.addComment",
                        "description": "Add a comment to a specific shipment."
                    },
                    {
                        "label": "Send Email for Shipment",
                        "value": "shipment.sendEmail",
                        "description": "Send an email for a specific shipment."
                    },
                    {
                        "label": "Generate Shipment Label",
                        "value": "shipment.generateLabel",
                        "description": "Generate a label for a specific shipment."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "shipment",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "track": {
        "definition": {
            "qs": {
                "searchCriteria[pageSize]": "{{parameters.pageSize}}"
            },
            "url": "https://{{secrets.domain}}/rest/default/V1/shipments",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": 1,
                    "validation": {
                        "min": 1,
                        "required": true
                    },
                    "description": "The number of records to retrieve per page.",
                    "displayName": "Page Size",
                    "displayType": "number",
                    "placeholder": "Enter the number of records per page"
                },
                "name": "pageSize"
            }
        ]
    },
    "sendemail": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/shipment/{{parameters.id}}/emails",
            "body": {
                "email": "{{parameters.email}}"
            },
            "method": "post",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the shipment to send an email for.",
                    "displayName": "Shipment ID",
                    "displayType": "text",
                    "placeholder": "Enter the shipment ID"
                },
                "name": "id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The email address to send the shipment details to.",
                    "displayName": "Email",
                    "displayType": "text",
                    "placeholder": "Enter the email address"
                },
                "name": "email"
            }
        ]
    },
    "getbyid": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/shipment/{{parameters.id}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the shipment to retrieve.",
                    "displayName": "Shipment ID",
                    "displayType": "text",
                    "placeholder": "Enter the shipment ID"
                },
                "name": "id"
            }
        ]
    },
    "addcomment": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/shipment/{{parameters.id}}/comments",
            "body": {
                "entity": {
                    "comment": "{{parameters.comment}}",
                    "entity_id": "{{parameters.id}}",
                    "parent_id": "{{parameters.id}}"
                }
            },
            "method": "post",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the shipment to add a comment to.",
                    "displayName": "Shipment ID",
                    "displayType": "text",
                    "placeholder": "Enter the shipment ID"
                },
                "name": "id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The comment to add to the shipment.",
                    "displayName": "Comment",
                    "displayType": "textarea",
                    "placeholder": "Enter your comment"
                },
                "name": "comment"
            }
        ]
    },
    "generatelabel": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/shipment/{{parameters.id}}/label",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the shipment to generate a label for.",
                    "displayName": "Shipment ID",
                    "displayType": "text",
                    "placeholder": "Enter the shipment ID"
                },
                "name": "id"
            }
        ]
    }
}
