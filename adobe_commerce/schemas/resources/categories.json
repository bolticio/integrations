{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get Category Tree",
                        "value": "categories.get",
                        "description": "Retrieve the full category tree."
                    },
                    {
                        "label": "List Category Attributes",
                        "value": "categories.attributesList",
                        "description": "Retrieve all category attributes."
                    },
                    {
                        "label": "Get Specific Category Attribute",
                        "value": "categories.attributesAttributeGet",
                        "description": "Retrieve details for a specific category attribute."
                    },
                    {
                        "label": "List Options for Attribute",
                        "value": "categories.attributeOptionsList",
                        "description": "Retrieve options for a specific attribute."
                    },
                    {
                        "label": "List Categories",
                        "value": "categories.list",
                        "description": "Retrieve a list of categories."
                    },
                    {
                        "label": "Get Category by ID",
                        "value": "categories.categoryGet",
                        "description": "Retrieve a single category by ID."
                    },
                    {
                        "label": "Get Category Products",
                        "value": "categories.categoryProductsList",
                        "description": "Retrieve products assigned to a category."
                    },
                    {
                        "label": "Delete Category",
                        "value": "categories.categoryDelete",
                        "description": "Delete a category by ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform on Categories.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "categories",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "attributeslist": {
        "definition": {
            "qs": {
                "searchCriteria[pageSize]": "{{parameters.pageSize}}"
            },
            "url": "https://{{secrets.domain}}/rest/V1/categories/attributes",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": 1,
                    "validation": {
                        "required": false
                    },
                    "description": "The number of records to retrieve per page.",
                    "displayName": "Page Size",
                    "displayType": "number",
                    "placeholder": "Enter the number of records per page"
                },
                "name": "pageSize"
            }
        ]
    },
