{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Search Tax Classes",
                        "value": "taxClasses.searchTaxClasses",
                        "description": "Search for specific tax classes."
                    },
                    {
                        "label": "Get Tax Class by ID",
                        "value": "taxClasses.getTaxClassById",
                        "description": "Retrieve a specific tax class by its ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "taxClasses",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getTaxClasses": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/taxClasses",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    },
    "getTaxClassByTaxClassId": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/taxClasses/{taxClassId}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    },
    "searchtaxclasses": {
        "definition": {
            "qs": {
                "searchCriteria[pageSize]": "{{parameters.pageSize}}"
            },
            "url": "https://{{secrets.domain}}/rest/default/V1/taxClasses/search",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": 1,
                    "validation": {
                        "required": false
                    },
                    "description": "The number of products to retrieve per page.",
                    "displayName": "Page Size",
                    "displayType": "number",
                    "placeholder": "Enter the number of products per page"
                },
                "name": "pageSize"
            }
        ]
    },
    "gettaxclassbyid": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/taxClasses/{{parameters.classId}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The Class ID to check against.",
                    "displayName": "Class ID",
                    "displayType": "number",
                    "placeholder": "Enter the Class ID"
                },
                "name": "classId"
            }
        ]
    }
}
