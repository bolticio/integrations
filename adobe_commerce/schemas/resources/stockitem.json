{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get Stock Item by SKU",
                        "value": "stockItem.getBySku",
                        "description": "Get stock item details for a specific product SKU."
                    },
                    {
                        "label": "Get Low Stock Items",
                        "value": "stockItem.lowStock",
                        "description": "Get items with low stock."
                    },
                    {
                        "label": "Get Stock Status by SKU",
                        "value": "stockItem.getStockStatusBySku",
                        "description": "Get stock status details for a specific product SKU."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "stockItem",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getbysku": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/stockItems/{{parameters.productSku}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The SKU of the product to retrieve stock information for.",
                    "displayName": "Product SKU",
                    "displayType": "text",
                    "placeholder": "Enter the product SKU"
                },
                "name": "productSku"
            }
        ]
    },
    "lowstock": {
        "definition": {
            "qs": {
                "qty": "{{parameters.qty}}",
                "scopeId": "{{parameters.scopeId}}"
            },
            "url": "https://{{secrets.domain}}/rest/default/V1/stockItems/lowStock",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The quantity of the product to retrieve stock information for.",
                    "displayName": "Product Quantity",
                    "displayType": "number",
                    "placeholder": "Enter the product quantity"
                },
                "name": "qty"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The Scope ID of the product to retrieve stock information for.",
                    "displayName": "Scope ID",
                    "displayType": "number",
                    "placeholder": "Enter the Scope ID "
                },
                "name": "scopeId"
            }
        ]
    },
    "getstockstatusbysku": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/stockStatuses/{{parameters.productSku}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The SKU of the product to retrieve stock status information for.",
                    "displayName": "Product SKU",
                    "displayType": "text",
                    "placeholder": "Enter the product SKU"
                },
                "name": "productSku"
            }
        ]
    }
}
