{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Search Tax Rules",
                        "value": "taxRules.searchTaxRules",
                        "description": "Search for specific tax rules."
                    },
                    {
                        "label": "Get Tax Rule by ID",
                        "value": "taxRules.getTaxRuleById",
                        "description": "Retrieve a specific tax rule by its ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "taxRules",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getTaxRules": {
        "definition": {
            "qs": {
                "searchCriteria[pageSize]": "{{parameters.pageSize}}"
            },
            "url": "https://{{secrets.domain}}/rest/default/V1/taxRules/search",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": 1,
                    "validation": {
                        "required": false
                    },
                    "description": "The number of products to retrieve per page.",
                    "displayName": "Page Size",
                    "displayType": "number",
                    "placeholder": "Enter the number of products per page"
                },
                "name": "pageSize"
            }
        ]
    },
    "searchtaxrules": {
        "definition": {
            "qs": {
                "searchCriteria[pageSize]": "{{parameters.pageSize}}"
            },
            "url": "https://{{secrets.domain}}/rest/default/V1/taxRules/search",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": 1,
                    "validation": {
                        "required": false
                    },
                    "description": "The number of products to retrieve per page.",
                    "displayName": "Page Size",
                    "displayType": "number",
                    "placeholder": "Enter the number of products per page"
                },
                "name": "pageSize"
            }
        ]
    },
    "gettaxrulebyid": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/taxRules/{{parameters.ruleId}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The rule ID to check against.",
                    "displayName": "Rule ID",
                    "displayType": "number",
                    "placeholder": "Enter the rule ID"
                },
                "name": "ruleId"
            }
        ]
    }
