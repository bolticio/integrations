                    "method": "{{parameters.paymentMethod}}"
                }
            },
            "method": "put",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The internal cart/quote ID for which the order will be placed.",
                    "displayName": "Cart ID",
                    "displayType": "text",
                    "placeholder": "Enter the Cart ID"
                },
                "name": "quoteId"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Adobe Commerce payment method code like 'checkmo', 'banktransfer', etc.",
                    "displayName": "Payment Method",
                    "displayType": "text",
                    "placeholder": "Enter the payment method code."
                },
                "name": "paymentMethod"
            }
        ]
    }
}
