{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Guest Cart",
                        "value": "cart.createGuestCart",
                        "description": "Create a guest cart for the user."
                    },
                    {
                        "label": "Create Cart",
                        "value": "cart.create",
                        "description": "Create a new cart."
                    },
                    {
                        "label": "Add Cart Item",
                        "value": "cart.addItem",
                        "description": "Add an item to the cart."
                    },
                    {
                        "label": "Set Shipping Address",
                        "value": "cart.setShippingInformation",
                        "description": "Set the shipping address and method for the cart."
                    },
                    {
                        "label": "Get Cart Info",
                        "value": "cart.get",
                        "description": "Retrieve information about a specific cart."
                    },
                    {
                        "label": "Get Cart Licenses",
                        "value": "cart.getLicense",
                        "description": "Retrieve the licenses associated with the cart."
                    },
                    {
                        "label": "List Cart Licenses",
                        "value": "cart.listLicenses",
                        "description": "Retrieve a list of licenses associated with carts."
                    },
                    {
                        "label": "List Carts",
                        "value": "cart.searchCarts",
                        "description": "Search for carts based on criteria."
                    },
                    {
                        "label": "Place Order from Cart",
                        "value": "cart.placeOrder",
                        "description": "Place an order based on the cart."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "cart",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://{{secrets.domain}}/rest/default/V1/carts",
            "body": {
                "currency": {
                    "base_currency_code": "{{parameters.base_currency_code}}",
                    "base_to_quote_rate": 1,
                    "store_to_base_rate": 0,
                    "base_to_global_rate": 1,
                    "quote_currency_code": "{{parameters.quote_currency_code}}",
                    "store_currency_code": "{{parameters.store_currency_code}}",
                    "store_to_quote_rate": 0,
                    "global_currency_code": "{{parameters.global_currency_code}}"
                },
                "customer": {
                    "email": "{{parameters.customer_email}}",
                    "lastname": "{{parameters.customer_lastname}}",
                    "firstname": "{{parameters.customer_firstname}}"
                },
                "store_id": "{{parameters.store_id}}",
                "is_active": "{{parameters.is_active}}",
                "items_qty": "{{parameters.items_qty}}",
                "is_virtual": "{{parameters.is_virtual}}",
                "items_count": "{{parameters.items_count}}",
                "orig_order_id": 0,
                "billing_address": {
                    "id": "{{parameters.billing_id}}",
                    "city": "{{parameters.billing_city}}",
                    "email": "{{parameters.billing_email}}",
                    "region": "{{parameters.billing_region}}",
                    "street": [
                        "{{parameters.billing_street}}"
                    ],
                    "lastname": "{{parameters.billing_lastname}}",
                    "postcode": "{{parameters.billing_postcode}}",
                    "firstname": "{{parameters.billing_firstname}}",
                    "region_id": "{{parameters.billing_region_id}}",
                    "telephone": "{{parameters.billing_telephone}}",
                    "country_id": "{{parameters.billing_country_id}}",
                    "region_code": "{{parameters.billing_region_code}}",
                    "same_as_billing": 0,
                    "save_in_address_book": 0
                },
                "customer_is_guest": "{{parameters.customer_is_guest}}",
                "customer_note_notify": "{{parameters.customer_note_notify}}",
                "customer_tax_class_id": "{{parameters.customer_tax_class_id}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
