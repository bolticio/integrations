                },
                "output": "{{response.data.sites}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Items",
                        "value": "items.list",
                        "description": "List items for a selected collection."
                    },
                    {
                        "label": "Get Item",
                        "value": "items.get",
                        "description": "Retrieve a selected collection item."
                    },
                    {
                        "label": "Create Item",
                        "value": "items.create",
                        "description": "Create a new item in a collection."
                    },
                    {
                        "label": "Update Item",
                        "value": "items.update",
                        "description": "Update an existing collection item."
                    },
                    {
                        "label": "Publish Item",
                        "value": "items.publish",
                        "description": "Publish one or more collection items."
                    },
                    {
                        "label": "Delete Item",
                        "value": "items.delete",
                        "description": "Delete an existing collection item."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is required"
                    }
                },
                "description": "Select the item operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation"
            },
            "name": "operation"
        }
    ],
    "getCollections": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}/collections",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.collections}}"
            },
            "transform": {
                "output": "return (Array.isArray(output)?output:[]).filter((x)=>{const slug=x&&x.slug?String(x.slug).toLowerCase():'';const singularName=x&&x.singularName?String(x.singularName).toLowerCase():'';const displayName=x&&x.displayName?String(x.displayName).toLowerCase():'';return !(slug==='product'||slug==='category'||slug==='sku'||singularName==='product'||singularName==='category'||singularName==='sku'||displayName==='products'||displayName==='categories'||displayName==='skus');});"
            }
        }
    },
