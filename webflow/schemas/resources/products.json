                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.sites}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Products",
                        "value": "products.list",
                        "description": "List products for a selected site."
                    },
                    {
                        "label": "Get Product",
                        "value": "products.get",
                        "description": "Retrieve a selected product."
                    },
                    {
                        "label": "Create Product",
                        "value": "products.create",
                        "description": "Create a new product."
                    },
                    {
                        "label": "Update Product",
                        "value": "products.update",
                        "description": "Update an existing product."
                    },
                    {
                        "label": "Update Product SKU",
                        "value": "products.update_sku",
                        "description": "Update a specific SKU of a product."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is required"
                    }
                },
                "description": "Select the product operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation"
            },
            "name": "operation"
        }
    ],
    "getProductSkus": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}/products/{{parameters.product_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.skus}}"
            },
            "transform": {
                "output": "return (Array.isArray(output)?output:[]).map((x)=>{const id=x&&x.id?x.id:null;const fieldData=x&&x.fieldData?x.fieldData:(x&&x.field_data?x.field_data:{});const skuValues=fieldData&&fieldData['sku-values']&&typeof fieldData['sku-values']==='object'?Object.values(fieldData['sku-values']).filter((v)=>v!=null&&String(v).trim()!=='').join(' / '):null;const displayName=fieldData&&fieldData.name?fieldData.name:(x&&x.name?x.name:(x&&x.displayName?x.displayName:(skuValues||(fieldData&&fieldData.slug?fieldData.slug:id))));return id?{id,displayName}:null;}).filter(Boolean);"
            }
        }
    },
    "getProductsForOptions": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}/products",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.items}}"
            },
            "transform": {
                "output": "return (Array.isArray(output)?output:[]).map((x)=>{const product=x&&x.product?x.product:x;const fieldData=product&&product.fieldData?product.fieldData:(x&&x.fieldData?x.fieldData:{});const id=product&&product.id?product.id:(x&&x.id?x.id:null);const displayName=fieldData&&fieldData.name?fieldData.name:(product&&product.name?product.name:(x&&x.name?x.name:(product&&product.displayName?product.displayName:(x&&x.displayName?x.displayName:(fieldData&&fieldData.slug?fieldData.slug:id)))));return id?{id,displayName}:null;}).filter(Boolean);"
            },
            "pagination": {
                "qs": {
                    "limit": 100,
                    "offset": "{{response.data.pagination.limit}} + {{response.data.pagination.offset}}"
                },
                "type": "offset",
                "default": {
                    "limit": 100,
                    "offset": 0
                },
                "condition": "{{response.data.pagination.offset}} < {{response.data.pagination.total}}"
            }
        }
    },
