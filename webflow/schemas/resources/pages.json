{
    "getPages": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}/pages",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.pages}}"
            },
            "transform": {
                "output": "const pages=Array.isArray(output)?output:(output&&Array.isArray(output.pages)?output.pages:[]);return pages.map((x)=>{const id=x&&x.id?x.id:null;const label=x&&x.title?x.title:(x&&x.publishedPath?x.publishedPath:(x&&x.slug?x.slug:id));return id?{...x,title:label,displayName:label}:null;}).filter(Boolean);"
            },
            "pagination": {
                "qs": {
                    "limit": 100,
                    "offset": "{{response.data.pagination.limit}} + {{response.data.pagination.offset}}"
                },
                "type": "offset",
                "default": {
                    "limit": 100,
                    "offset": 0
                },
                "condition": "{{response.data.pagination.offset}} < {{response.data.pagination.total}}"
            }
        }
    },
    "getSites": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.sites}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Pages",
                        "value": "pages.list",
                        "description": "List pages for a selected site."
                    },
                    {
                        "label": "Get Page",
                        "value": "pages.get",
                        "description": "Retrieve metadata for a selected page."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is required"
                    }
                },
                "description": "Select the page operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation"
            },
            "name": "operation"
        }
    ],
    "get": {
        "definition": {
            "url": "https://api.webflow.com/v2/pages/{{parameters.page_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "webflow",
                            "secret": "{{parameters.secret}}",
                            "resource": "pages",
                            "operation": "pages.get",
                            "loadOptionsMethod": "getSites"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Site is required"
                        }
                    },
                    "description": "Select the site that contains the page.",
                    "displayName": "Site",
                    "displayType": "select",
                    "placeholder": "Select a site",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "pages.get",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "site_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "webflow",
                            "secret": "{{parameters.secret}}",
                            "site_id": "{{parameters.site_id}}",
                            "resource": "pages",
                            "operation": "pages.get",
                            "loadOptionsMethod": "getPages"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "title",
                        "valueKey": "id",
                        "condition": "{{parameters.site_id}}"
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Page is required"
                        }
                    },
                    "description": "Select the page you want to retrieve.",
                    "displayName": "Page",
                    "displayType": "select",
                    "placeholder": "Select a page",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "pages.get",
                                "operator": "EQUALS"
                            },
                            {
                                "field": "site_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "page_id"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}/pages",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.pages}}"
            },
            "pagination": {
                "qs": {
                    "limit": 100,
                    "offset": "{{response.data.pagination.limit}} + {{response.data.pagination.offset}}"
                },
                "type": "offset",
                "default": {
                    "limit": 100,
                    "offset": 0
                },
                "condition": "{{response.data.pagination.offset}} < {{response.data.pagination.total}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "webflow",
                            "secret": "{{parameters.secret}}",
                            "resource": "pages",
                            "operation": "pages.list",
                            "loadOptionsMethod": "getSites"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Site is required"
                        }
                    },
                    "description": "Select the site whose pages you want to list.",
                    "displayName": "Site",
                    "displayType": "select",
                    "placeholder": "Select a site",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "pages.list",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "site_id"
            }
        ]
    }
}
