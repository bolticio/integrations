                "inventoryType": "{{parameters.inventory_type}}",
                "updateQuantity": "{{parameters.update_quantity}}"
            },
            "method": "patch",
            "filters": {
                "body": {
                    "allowEmptyArray": false,
                    "allowEmptyValue": false,
                    "allowEmptyObject": false
