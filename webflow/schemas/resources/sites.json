{
    "getSites": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.sites}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Sites",
                        "value": "sites.list",
                        "description": "List all accessible Webflow sites."
                    },
                    {
                        "label": "Get Site",
                        "value": "sites.get",
                        "description": "Retrieve details for a specific site."
                    },
                    {
                        "label": "Get Custom Domains",
                        "value": "sites.custom_domains",
                        "description": "List custom domains configured for a specific site."
                    },
                    {
                        "label": "Publish Site",
                        "value": "sites.publish",
                        "description": "Publish a site to its domains and optional Webflow subdomain."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the site operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation"
            },
            "name": "operation"
        }
    ],
    "getCustomDomains": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}/custom_domains",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.customDomains}}"
            }
        }
    },
    "publish": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}/publish",
            "body": {
                "customDomains": "{{parameters.custom_domains}}",
                "publishToWebflowSubdomain": "{{parameters.publish_to_webflow_subdomain}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "webflow",
                            "secret": "{{parameters.secret}}",
                            "resource": "sites",
                            "operation": "sites.publish",
                            "loadOptionsMethod": "getSites"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the site you want to publish.",
                    "displayName": "Site",
                    "displayType": "select",
                    "placeholder": "Select a site",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "sites.publish",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "site_id"
            },
            {
                "meta": {
                    "value": [],
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "webflow",
                            "secret": "{{parameters.secret}}",
                            "site_id": "{{parameters.site_id}}",
                            "resource": "sites",
                            "operation": "sites.publish",
                            "loadOptionsMethod": "getCustomDomains"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "url",
                        "valueKey": "id",
                        "condition": "{{parameters.site_id}}"
                    },
                    "description": "Optional. Select specific custom domains to publish to. Leave empty to publish to all custom domains.",
                    "displayName": "Custom Domains",
                    "displayType": "multiselect",
                    "placeholder": "Select custom domains",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "sites.publish",
                                "operator": "EQUALS"
                            },
                            {
                                "field": "site_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "custom_domains"
            },
            {
                "meta": {
                    "value": false,
                    "description": "Optional. Enable this to also publish to the default Webflow subdomain.",
                    "displayName": "Publish To Webflow Subdomain",
                    "displayType": "toggle",
                    "placeholder": "Enable or disable subdomain publish",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "sites.publish",
                                "operator": "EQUALS"
                            },
                            {
                                "field": "site_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "publish_to_webflow_subdomain"
            }
        ]
    },
    "custom_domains": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}/custom_domains",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.customDomains}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "webflow",
                            "secret": "{{parameters.secret}}",
                            "resource": "sites",
                            "operation": "sites.custom_domains",
                            "loadOptionsMethod": "getSites"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the site whose custom domains you want to retrieve.",
                    "displayName": "Site",
                    "displayType": "select",
                    "placeholder": "Select a site",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "sites.custom_domains",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "site_id"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "webflow",
                            "secret": "{{parameters.secret}}",
                            "resource": "sites",
                            "operation": "sites.get",
                            "loadOptionsMethod": "getSites"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the site you want to retrieve.",
                    "displayName": "Site",
                    "displayType": "select",
                    "placeholder": "Select a site",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "sites.get",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "site_id"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.sites}}"
            }
        },
        "parameters": []
    }
}
