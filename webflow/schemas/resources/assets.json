                            "errorMsg": "Site is required"
                        }
                    },
                    "description": "Select the site in which to create the asset folder.",
                    "displayName": "Site",
                    "displayType": "select",
                    "placeholder": "Select a site",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "assets.create_folder",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "site_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Folder Name is required"
                        }
                    },
                    "description": "Display name for the new asset folder.",
                    "displayName": "Folder Name",
                    "displayType": "text",
                    "placeholder": "Marketing Assets",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "assets.create_folder",
                                "operator": "EQUALS"
                            },
                            {
