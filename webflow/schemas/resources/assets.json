{
    "getSites": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.sites}}"
            }
        }
    },
    "getAssets": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}/assets",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.assets}}"
            },
            "pagination": {
                "qs": {
                    "limit": 100,
                    "offset": "{{response.data.pagination.limit}} + {{response.data.pagination.offset}}"
                },
                "type": "offset",
                "default": {
                    "limit": 100,
                    "offset": 0
                },
                "condition": "{{response.data.pagination.offset}} < {{response.data.pagination.total}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Assets",
                        "value": "assets.list",
                        "description": "List assets for a selected site."
                    },
                    {
                        "label": "Get Asset",
                        "value": "assets.get",
                        "description": "Retrieve metadata for a selected asset."
                    },
                    {
                        "label": "Delete Asset",
                        "value": "assets.delete",
                        "description": "Delete a selected asset."
                    },
                    {
                        "label": "Create Asset Folder",
                        "value": "assets.create_folder",
                        "description": "Create an asset folder in a site."
                    },
                    {
                        "label": "Get Asset Folder",
                        "value": "assets.get_folder",
                        "description": "Retrieve details for a specific asset folder."
                    },
                    {
                        "label": "List Asset Folders",
                        "value": "assets.list_folders",
                        "description": "List asset folders for a selected site."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is required"
                    }
                },
                "description": "Select the asset operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation"
            },
            "name": "operation"
        }
    ],
    "getAssetFolders": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}/asset_folders",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.assetFolders}}"
            },
            "pagination": {
                "qs": {
                    "limit": 100,
                    "offset": "{{response.data.pagination.limit}} + {{response.data.pagination.offset}}"
                },
                "type": "offset",
                "default": {
                    "limit": 100,
                    "offset": 0
                },
                "condition": "{{response.data.pagination.offset}} < {{response.data.pagination.total}}"
            }
        }
    },
    "get": {
        "definition": {
            "url": "https://api.webflow.com/v2/assets/{{parameters.asset_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "webflow",
                            "secret": "{{parameters.secret}}",
                            "resource": "assets",
                            "operation": "assets.get",
                            "loadOptionsMethod": "getSites"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Site is required"
                        }
                    },
                    "description": "Select the site that contains the asset.",
                    "displayName": "Site",
                    "displayType": "select",
                    "placeholder": "Select a site",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "assets.get",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "site_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "webflow",
                            "secret": "{{parameters.secret}}",
                            "site_id": "{{parameters.site_id}}",
                            "resource": "assets",
                            "operation": "assets.get",
                            "loadOptionsMethod": "getAssets"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id",
                        "condition": "{{parameters.site_id}}"
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Asset is required"
                        }
                    },
                    "description": "Select the asset you want to retrieve.",
                    "displayName": "Asset",
                    "displayType": "select",
                    "placeholder": "Select an asset",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "assets.get",
                                "operator": "EQUALS"
                            },
                            {
                                "field": "site_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "asset_id"
            }
        ]
    },
