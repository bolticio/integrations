                        "labelKey": "displayName",
                        "valueKey": "id",
                        "condition": "{{parameters.site_id}}"
                    },
                    "description": "Optional. Select a parent folder to nest the new folder under.",
                    "displayName": "Parent Folder",
                    "displayType": "select",
                    "placeholder": "Select parent folder (optional)",
                    "dependencies": {
                        "conditions": [
