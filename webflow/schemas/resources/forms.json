{
    "getForms": {
        "definition": {
            "url": "https://api.webflow.com/v2/sites/{{parameters.site_id}}/forms",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.forms}}"
            },
            "transform": {
                "output": "return (Array.isArray(output) ? output : []).map((item) => { const pageName = item && item.pageName ? String(item.pageName).trim() : ''; const displayName = item && item.displayName ? String(item.displayName).trim() : ''; const prefix = pageName ? `${pageName} - ` : ''; const nextDisplayName = prefix && displayName.startsWith(prefix) ? displayName : (pageName && displayName ? `${pageName} - ${displayName}` : (pageName || displayName || item.id)); return { ...item, displayName: nextDisplayName }; });"
            },
            "pagination": {
                "qs": {
                    "limit": 100,
                    "offset": "{{response.data.pagination.limit}} + {{response.data.pagination.offset}}"
                },
                "type": "offset",
                "default": {
                    "limit": 100,
                    "offset": 0
                },
                "condition": "{{response.data.pagination.offset}} < {{response.data.pagination.total}}"
            }
        }
    },
