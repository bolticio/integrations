    "create": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `mutation { create_board (board_name: \"{{parameters.board_name}}\", board_kind: {{parameters.board_kind}}, ${typeof {{parameters.template_id}} !== 'undefined' ? `template_id: {{parameters.template_id}},` : ''} workspace_id: {{parameters.workspace_id}} ) { id name } }` })"
            }
        },
        "parameters": [
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "max": 50,
                        "min": 3,
                        "required": true
                    },
                    "description": "Enter a descriptive name for the new board (3-50 characters)",
                    "displayName": "Board Name",
                    "displayType": "text",
                    "placeholder": "Enter the board name"
                },
                "name": "board_name"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Private",
                            "value": "private"
                        },
                        {
                            "label": "Public",
                            "value": "public"
                        },
                        {
                            "label": "Share",
                            "value": "share"
                        }
                    ],
                    "readOnly": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Board kind is a required field"
                        }
                    },
                    "description": "Kind of the new board which needs to be created",
                    "displayName": "Board Kind",
                    "displayType": "select",
                    "placeholder": "Select the board kind"
                },
                "name": "board_kind"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "max": 50,
                        "min": 3,
                        "required": false
                    },
                    "description": "Template ID of a board template that will be used to create a board.",
                    "displayName": "Template ID",
                    "displayType": "text",
                    "placeholder": "Template ID"
                },
                "name": "template_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "monday",
                            "secret": "{{parameters.secret}}",
                            "resource": "board",
                            "operation": "board.create",
                            "loadOptionsMethod": "getWorkspace"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the workspace where this new board should be created",
                    "displayName": "Workspace",
                    "displayType": "select",
                    "placeholder": "Select a workspace"
                },
                "name": "workspace_id"
            }
        ]
    },
    "get_board_values": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `query { boards (ids: {{parameters.board_id}}) { name state permissions items_page {items {id name} }  } }` })"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "monday",
                            "secret": "{{parameters.secret}}",
                            "resource": "board",
                            "operation": "board.get_board_values",
                            "loadOptionsMethod": "getBoard"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the board containing the items and values which needs to be retrieved",
                    "displayName": "Board",
                    "displayType": "select",
                    "placeholder": "Select a board"
                },
                "name": "board_id"
            }
        ]
    }
}
