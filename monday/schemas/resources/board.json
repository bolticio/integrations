{
    "getBoard": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": {},
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.data.boards}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `{ boards { id name } }` })"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Board",
                        "value": "board.create",
                        "description": "Creates a new board in a monday.com workspace with customizable columns and views."
                    },
                    {
                        "label": "Get Board Values",
                        "value": "board.get_board_values",
                        "description": "Retrieves all items and their column values from a specified monday.com board."
                    },
                    {
                        "label": "Archive Board",
                        "value": "board.archive",
                        "description": "Archives a monday.com board, preserving content while removing from active view."
                    },
                    {
                        "label": "Create Column",
                        "value": "board.create_column",
                        "description": "Adds a new column to an existing monday.com board."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "board",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getWorkspace": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": {},
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.data.workspaces}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `{ workspaces { id name } }` })"
            }
        }
    },
    "archive": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `mutation { archive_board ( board_id : {{parameters.board_id}} ) { id } }` })"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "monday",
                            "secret": "{{parameters.secret}}",
                            "resource": "board",
                            "operation": "board.archive",
                            "loadOptionsMethod": "getBoard"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the board which need to be archived (content will be preserved but hidden)",
                    "displayName": "Board",
                    "displayType": "select",
                    "placeholder": "Select a board"
                },
                "name": "board_id"
            }
        ]
    },
    "create_column": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": "{{parameters}}",
