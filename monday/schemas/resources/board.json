                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `mutation { create_column(board_id: {{parameters.board_id}}, title: \"{{parameters.title}}\", ${typeof {{parameters.description}} !== 'undefined' && {{parameters.description}} !== '' ? `description: \"{{parameters.description}}\",` : ''} column_type: {{parameters.column_type}}) { id title description } }` })"
