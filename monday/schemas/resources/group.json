{
    "getBoard": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": {},
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.data.boards}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `{ boards { id name } }` })"
            }
        }
    },
    "getGroup": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": {},
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.data.boards[0].groups}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `{ boards (ids: {{parameters.board_id}}) { groups { title id } } }` })"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Group",
                        "value": "group.create",
                        "description": "Creates a new group within a monday.com board for organizing and managing related items with custom naming."
                    },
                    {
                        "label": "Delete Group",
                        "value": "group.delete",
                        "description": "Permanently removes a group from a monday.com board, including all associated items."
                    },
                    {
                        "label": "Archive Group",
                        "value": "group.archive",
                        "description": "Archives a group, hiding it from the active board view while preserving all items and data for future access."
                    },
                    {
                        "label": "Duplicate Group",
                        "value": "group.duplicate",
                        "description": "Creates an exact copy of an existing group, including all items and their current states, perfect for templates or parallel workflows."
                    },
                    {
                        "label": "Get Group Details",
                        "value": "group.get_group_details",
                        "description": "Retrieves metadata about all groups in a board, including identifiers, titles, and structural information."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "group",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "duplicate": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": {},
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `mutation { duplicate_group (board_id: {{parameters.board_id}}, group_id: \"{{parameters.group_id}}\") { id } }` })"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "monday",
                            "secret": "{{parameters.secret}}",
                            "resource": "group",
                            "operation": "group.duplicate",
                            "loadOptionsMethod": "getBoard"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the board containing the group which needs to duplicated.",
                    "displayName": "Board",
                    "displayType": "select",
                    "placeholder": "Select a board"
                },
                "name": "board_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "monday",
                            "secret": "{{parameters.secret}}",
                            "board_id": "{{parameters.board_id}}",
                            "resource": "group",
                            "operation": "group.duplicate",
                            "loadOptionsMethod": "getGroup"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "title",
                        "valueKey": "id",
                        "condition": "{{parameters.board_id}}"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the group to create an exact copy of, including all its items.",
                    "displayName": "Group",
                    "displayType": "select",
                    "placeholder": "Select a Group"
                },
                "name": "group_id"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `mutation { create_group (board_id: {{parameters.board_id}}, group_name: \"{{parameters.group_name}}\") { id } }` })"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "monday",
                            "secret": "{{parameters.secret}}",
                            "resource": "group",
                            "operation": "group.create",
                            "loadOptionsMethod": "getBoard"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the target board where the new group will be created to organize your items.",
                    "displayName": "Board",
                    "displayType": "select",
                    "placeholder": "Select a board"
                },
                "name": "board_id"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "max": 50,
                        "min": 3,
                        "required": true
                    },
                    "description": "Enter a descriptive name for the new group (3-50 characters)",
                    "displayName": "Group Name",
                    "displayType": "text",
                    "placeholder": "Name of the new group"
                },
                "name": "group_name"
            }
        ]
    },
