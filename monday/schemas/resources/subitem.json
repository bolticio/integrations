{
    "getBoard": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": {},
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.data.boards}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `{ boards { id name } }` })"
            }
        }
    },
    "getUsers": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": {},
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.data.users}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `{ users { id name } }` })"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Subitem",
                        "value": "subitem.create",
                        "description": "Creates a subitem under a parent item with customizable properties for detailed task breakdown."
                    },
                    {
                        "label": "Update Subitem",
                        "value": "subitem.update",
                        "description": "Updates a subitem's properties while maintaining its parent relationship."
                    },
                    {
                        "label": "Get Subitem Values",
                        "value": "subitem.get_subitem_values",
                        "description": "Retrieves all field values and metadata for a specific subitem."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation to be performed on subitems",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "subitem",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getSubitems": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.data.items[0].subitems}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `{ items (ids: {{parameters.parent_item_id}}) { subitems { id name column_values { value text } } } }` })"
            }
        }
    },
    "getBoardItems": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.data.boards[0].items_page.items}}"
            },
            "transform": {
                "body": "return JSON.stringify({ query: `{ boards (ids: {{parameters.board_id}} ) { name items_page { items { id name } } } }` })"
            }
        }
    },
    "update": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": {},
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const itemId = {{parameters.subitem_id}}; const boardId = {{parameters.board_id}}; const STATUS = 'status', DATE = 'date0', PERSON = 'person'; let columnValues = {}; if ('{{parameters.status}}' !== 'undefined') columnValues[STATUS] = { index: {{parameters.status}} }; if ('{{parameters.date}}' !== 'undefined') columnValues[DATE] = { date: '{{parameters.date}}' }; if ('{{parameters.person}}' !== 'undefined') columnValues[PERSON] = { personsAndTeams: [{ id: {{parameters.person}}, kind: \"person\" }] }; const columnValuesString = JSON.stringify(columnValues).replace(/\"/g, '\\\\\\\"'); return JSON.stringify({ query: `mutation { change_multiple_column_values ( item_id: ${itemId}, board_id: ${boardId}, column_values: \\\"${columnValuesString}\\\" ) { id } }` });"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "monday",
                            "secret": "{{parameters.secret}}",
                            "resource": "subitem",
                            "operation": "subitem.update",
                            "loadOptionsMethod": "getBoard"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the board of subitem which needs to be updated.",
                    "displayName": "Board",
                    "displayType": "select",
                    "placeholder": "Select a board"
                },
                "name": "board_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "monday",
                            "secret": "{{parameters.secret}}",
                            "board_id": "{{parameters.board_id}}",
                            "resource": "subitem",
                            "operation": "subitem.update",
                            "loadOptionsMethod": "getBoardItems"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id",
                        "condition": "{{parameters.board_id}}"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the subitem to be updated.",
                    "displayName": "Subitem",
                    "displayType": "select",
                    "placeholder": "Select an subitem",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "board_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "subitem_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "monday",
                            "secret": "{{parameters.secret}}",
                            "resource": "subitem",
                            "operation": "subitem.update",
                            "loadOptionsMethod": "getUsers"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Select new owner of the subitem.",
                    "displayName": "Owner",
                    "displayType": "select",
                    "placeholder": "Select owner of the subitem",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "subitem_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "person"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Stuck",
                            "value": 1
                        },
                        {
                            "label": "Working On It",
                            "value": 2
                        },
                        {
                            "label": "Done",
                            "value": 3
                        }
                    ],
                    "readOnly": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false,
                        "requiredDetail": {
                            "errorMsg": "Status is a required field"
                        }
                    },
                    "description": "Select new status of subitem",
                    "displayName": "Status",
                    "displayType": "select",
                    "placeholder": "Select a Status",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "subitem_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "status"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "views": [
                            "year",
                            "month",
                            "day"
                        ],
                        "format": "YYYY-MM-DD",
                        "disabled": false,
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Date of the subitem",
                    "displayName": "Date",
                    "displayType": "date",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "subitem_id",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "date"
            }
        ]
    },
