    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Item",
                        "value": "item.create",
                        "description": "Creates a new work item on a monday.com board with customizable name, assignee, status, and due date."
                    },
                    {
                        "label": "Update Item",
                        "value": "item.update",
                        "description": "Updates an existing item's properties while preserving its history and change tracking."
                    },
                    {
                        "label": "Delete Item",
                        "value": "item.delete",
                        "description": "Permanently deletes an item and its associated data without recovery option."
                    },
                    {
                        "label": "Archive Item",
                        "value": "item.archive",
                        "description": "Archives an item while preserving its data and relationships for future reference."
                    },
                    {
                        "label": "Get Column Values",
                        "value": "item.get_column_values",
                        "description": "Retrieves all column values and metadata for a specific item."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation which needs to be performed.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "item",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getBoardItems": {
        "definition": {
            "url": "https://api.monday.com/v2",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "{{secrets.access_token}}"
            },
            "response": {
                "error": {
