            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const boardId = {{parameters.board_id}}; const itemName = '{{parameters.item_name}}'; const groupPresent = ('{{parameters.group_id}}' !== 'undefined'); const STATUS = 'status', DATE = 'date4', PERSON = 'person'; let columnValues = {}; if ('{{parameters.status}}' !== 'undefined') columnValues[STATUS] = { index: {{parameters.status}} }; if ('{{parameters.date}}' !== 'undefined') columnValues[DATE] = { date: '{{parameters.date}}' }; if ('{{parameters.person}}' !== 'undefined') columnValues[PERSON] = { personsAndTeams: [{ id: {{parameters.person}}, kind: \"person\" }] }; const columnValuesString = Object.keys(columnValues).length ? `,column_values: \\\"${JSON.stringify(columnValues).replace(/\"/g, '\\\\\\\"')}\\\"` : ''; return JSON.stringify({ query: `mutation { create_item ( board_id: ${boardId}, item_name: \"${itemName}\" ${groupPresent ? `,group_id: \"{{parameters.group_id}}\"` : ''} ${columnValuesString} ) { id } }` });"
            }
        },
