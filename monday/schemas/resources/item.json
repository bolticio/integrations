                            "resource": "item",
                            "operation": "item.get_column_values",
                            "loadOptionsMethod": "getBoard"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the board whose item details to be fetched.",
