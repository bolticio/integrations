                    },
                    {
                        "label": "Get all Conversation Messages",
                        "value": "conversations.conversationsMessagesList"
                    },
                    {
                        "label": "Rate Message",
                        "value": "conversations.conversationsMessagesFeedback"
                    }
                ],
                "validation": {
                    "required": true
                },
