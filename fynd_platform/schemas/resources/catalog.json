{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List products (listProducts)",
                        "value": "catalog.listProducts",
                        "description": "Retrieve a list of available products"
                    },
                    {
                        "label": "Get Product (getProduct)",
                        "value": "catalog.getProduct",
                        "description": "Retrieve data associated to a particular product."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is a required field"
                    }
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "autocomplete",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "catalog",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "listproducts": {
        "definition": {
            "qs": {
                "page_no": "{{parameters.page_no}}",
                "page_size": "{{parameters.page_size}}"
            },
            "url": "https://api.fynd.com/service/platform/catalog/v2.0/company/{{secrets.company_id}}/products/",
            "body": {},
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": ""
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": 12,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {},
                    "description": "Number of items to retrieve in each page. Default is 10.",
                    "displayName": "Page Size",
                    "displayType": "number"
                },
                "name": "page_size"
            },
            {
                "meta": {
                    "value": 1,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {},
                    "description": "For pagination type value can be cursor or number. Default is number.",
                    "displayName": "Page Number",
                    "displayType": "number"
                },
                "name": "page_no"
            }
        ]
    },
    "getproduct": {
        "definition": {
            "url": "https://api.fynd.com/service/platform/catalog/v2.0/company/{{secrets.company_id}}/products/{{parameters.item_id}}",
            "body": {},
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": ""
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {},
                    "description": "Item Id of the product.",
                    "displayName": "Item ID",
                    "displayType": "number"
                },
                "name": "item_id"
            }
        ]
    }
}
