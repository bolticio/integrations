{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Image analysis",
                        "value": "image.imageanalysis",
                        "description": "Analyze and describe image with OpenAI’s vision-capable models, send image inputs alongside text instructions and receive detailed output."
                    },
                    {
                        "label": "Image analysis (Responses API)",
                        "value": "image.imageanalysisResponsesAPI",
                        "description": "Use the Responses API to analyze and describe image with OpenAI’s vision-capable models, send image inputs alongside text instructions and receive detailed output."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "image",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getAllModels": {
        "definition": {
            "url": "https://openrouter.ai/api/v1/models",
            "method": "get",
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": []
    },
    "imageanalysis": {
        "definition": {
            "url": "https://openrouter.ai/api/v1/chat/completions",
            "body": {
                "model": "{{parameters.modelId}}",
                "messages": [
                    {
                        "role": "{{parameters.role}}",
                        "content": [
                            {
                                "text": "{{parameters.text}}",
                                "type": "text"
                            },
                            {
                                "type": "image_url",
                                "image_url": {
                                    "url": "{{parameters.image_url}}"
                                }
                            }
                        ]
                    }
                ],
                "temperature": "{{parameters.temperature}}",
                "max_completion_tokens": "{{parameters.max_token}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": "user",
                    "options": [
                        {
                            "label": "User (Message from the user)",
                            "value": "user",
                            "description": "Send a message as a user"
                        },
                        {
                            "label": "Assistant (Message from the assistant)",
                            "value": "assistant",
                            "description": "Send a message as an assistant"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Please select the role for the message."
                        }
                    },
                    "description": "Specify whether the message is sent by the user or the assistant.",
                    "displayName": "Message Role",
                    "displayType": "select",
                    "placeholder": "Choose the role for this message"
                },
                "name": "role"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "Boltic_AI",
                            "secret": "{{parameters.secret}}",
                            "resource": "chat",
                            "operation": "chat.chatCompletionWithText",
                            "loadOptionsMethod": "getAllModels"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Model is required field"
                        }
                    },
                    "description": "Name of the model to use.",
                    "displayName": "Model",
                    "displayType": "autocomplete",
                    "placeholder": "Select a model"
                },
                "name": "modelId"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Prompt is required field"
                        }
                    },
                    "description": "Text prompt to analyse the image",
                    "displayName": "Prompt",
                    "displayType": "textarea",
                    "placeholder": "Enter the Prompt"
                },
                "name": "text"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^(https?:\\/\\/).+\\.(jpg|jpeg|png|gif|bmp|webp|svg|tiff|ico)(\\?.*)?$",
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Image URL is required field"
                        }
                    },
                    "description": "Image URL of the image to be analysed.",
                    "displayName": "Image URL",
                    "displayType": "url",
                    "placeholder": "Enter the Image URL"
                },
                "name": "image_url"
            },
            {
                "meta": {
                    "value": 1024,
                    "validation": {
                        "required": false
                    },
                    "description": "An upper bound for the number of tokens that can be generated for a completion, including visible output tokens and reasoning tokens.",
                    "displayName": "Max Completion Tokens",
                    "displayType": "number",
                    "placeholder": "Specify the maximum tokens to generate"
                },
                "name": "max_tokens"
            },
            {
                "meta": {
                    "max": 2,
                    "min": 0,
                    "step": 0.1,
                    "value": 0.7,
                    "htmlProps": {
                        "showInfoIcon": true
                    },
                    "validation": {
                        "required": false,
                        "infoDetail": {
                            "infoMsg": "Choose a value between 0.1 (Very Deterministic) and 2.0 (Highly Random)"
                        }
                    },
                    "description": "Control the randomness of the response. Lower values produce more deterministic outputs. Default is 0.7.",
                    "displayName": "Temperature",
                    "displayType": "slider"
                },
                "name": "temperature"
            }
        ]
    },
    "imageanalysisresponsesapi": {
        "definition": {
            "url": "https://openrouter.ai/api/v1/responses",
            "body": {
                "input": [
                    {
                        "role": "{{parameters.role}}",
                        "type": "message",
                        "content": [
                            {
                                "text": "{{parameters.text}}",
                                "type": "input_text"
                            },
                            {
                                "type": "input_image",
                                "image_url": "{{parameters.image_url}}"
                            }
                        ]
                    }
                ],
                "model": "{{parameters.modelId}}",
                "temperature": "{{parameters.temperature}}",
                "max_output_tokens": "{{parameters.max_token}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const b = { ...body }; const t = Number(b.temperature); if (!Number.isNaN(t) && t === 0) { delete b.temperature; } return b;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": "user",
                    "options": [
                        {
                            "label": "User (Message from the user)",
                            "value": "user",
                            "description": "Send a message as a user"
                        },
                        {
                            "label": "Assistant (Message from the assistant)",
                            "value": "assistant",
                            "description": "Send a message as an assistant"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Please select the role for the message."
                        }
                    },
                    "description": "Specify whether the message is sent by the user or the assistant.",
                    "displayName": "Message Role",
                    "displayType": "select",
                    "placeholder": "Choose the role for this message"
                },
                "name": "role"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "Boltic_AI",
                            "secret": "{{parameters.secret}}",
                            "resource": "chat",
                            "operation": "chat.chatCompletionWithText",
                            "loadOptionsMethod": "getAllModels"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Model is required field"
                        }
                    },
                    "description": "Name of the model to use.",
                    "displayName": "Model",
                    "displayType": "autocomplete",
                    "placeholder": "Select a model"
                },
                "name": "modelId"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Prompt is required field"
                        }
                    },
                    "description": "Text prompt to analyse the image",
                    "displayName": "Prompt",
                    "displayType": "textarea",
                    "placeholder": "Enter the Prompt"
                },
                "name": "text"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^(https?:\\/\\/).+\\.(jpg|jpeg|png|gif|bmp|webp|svg|tiff|ico)(\\?.*)?$",
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Image URL is required field"
                        }
                    },
                    "description": "Image URL of the image to be analysed.",
                    "displayName": "Image URL",
                    "displayType": "url",
                    "placeholder": "Enter the Image URL"
                },
                "name": "image_url"
            },
            {
                "meta": {
                    "value": 1024,
                    "validation": {
                        "required": false
                    },
                    "description": "An upper bound for the number of tokens that can be generated for a completion, including visible output tokens and reasoning tokens.",
                    "displayName": "Max Completion Tokens",
                    "displayType": "number",
                    "placeholder": "Specify the maximum tokens to generate"
                },
                "name": "max_tokens"
            },
            {
                "meta": {
                    "max": 2,
                    "min": 0,
                    "step": 0.1,
                    "value": 0.7,
                    "htmlProps": {
                        "showInfoIcon": true
                    },
                    "validation": {
                        "required": false,
                        "infoDetail": {
                            "infoMsg": "Choose a value between 0.1 (Very Deterministic) and 2.0 (Highly Random)"
                        }
                    },
                    "description": "Control the randomness of the response. Lower values produce more deterministic outputs. Default is 0.7.",
                    "displayName": "Temperature",
                    "displayType": "slider"
                },
                "name": "temperature"
            }
        ]
    }
}
