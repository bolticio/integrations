    "createleaverequest": {
        "definition": {
            "url": "https://{{secrets.company}}.{{secrets.environment}}.com/api/v1/time/leaverequests",
            "body": {
                "note": "{{parameters.note}}",
                "reason": "{{parameters.reason}}",
                "toDate": "{{parameters.toDate}}",
                "fromDate": "{{parameters.fromDate}}",
                "toSession": "{{parameters.toSession}}",
                "employeeId": "{{parameters.employeeId}}",
                "fromSession": "{{parameters.fromSession}}",
                "leaveTypeId": "{{parameters.leaveTypeId}}",
                "requestedBy": "{{parameters.requestedBy}}"
            },
            "method": "post",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Employee ID is a mandatory field"
                        }
                    },
                    "description": "Please provide an employee id",
                    "displayName": "Employee ID",
                    "displayType": "text"
                },
                "name": "employeeId"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Please provide an id of a requesting employee"
                        }
                    },
                    "description": "Please provide id of an employee who is requesting for leave",
                    "displayName": "Requested By",
                    "displayType": "text"
                },
                "name": "requestedBy"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "From date is a mandatory field"
                        }
                    },
                    "description": "Please select the date from when you want to take a leave.",
                    "displayName": "From date",
                    "displayType": "date"
                },
                "name": "fromDate"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "To date is a mandatory field"
                        }
                    },
                    "description": "Please select the date till when you want to take a leave.",
                    "displayName": "To date",
                    "displayType": "date"
                },
                "name": "toDate"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "First Half",
                            "value": 0
                        },
                        {
                            "label": "Second Half",
                            "value": 1
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Please select the session from when you want to take a leave.",
                    "displayName": "From session",
                    "displayType": "select"
                },
                "name": "fromSession"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "First Half",
                            "value": 0
                        },
                        {
                            "label": "Second Half",
                            "value": 1
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Please select the session till when you want to take a leave.",
                    "displayName": "To session",
                    "displayType": "select"
                },
                "name": "toSession"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "keka",
                            "secret": "{{parameters.secret}}",
                            "resource": "leaves",
                            "operation": "leaves.createLeaveRequest",
                            "loadOptionsMethod": "getEveryLeaveTypes"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "identifier"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Leave type is a mandatory field"
                        }
                    },
                    "description": "Please select the leave type.",
                    "displayName": "Leave Types",
                    "displayType": "select"
                },
                "name": "leaveTypeId"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Reason for leave is a mandatory field"
                        }
                    },
                    "description": "Please provide the reason for taking leave.",
                    "displayName": "Reason for Leave",
                    "displayType": "text",
                    "placeholder": "Enter reason for leave"
                },
                "name": "reason"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Note is a required field"
                        }
                    },
                    "description": "Please provide the note for taking leave.",
                    "displayName": "Note for Leave",
                    "displayType": "text",
                    "placeholder": "Enter note for leave"
                },
                "name": "note"
            }
        ]
    },
