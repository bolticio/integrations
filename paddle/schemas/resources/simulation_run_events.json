{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List events for a simulation run",
                        "value": "simulation_run_events.list",
                        "description": "Get all events generated by a simulation run"
                    },
                    {
                        "label": "Get an event for a simulation run",
                        "value": "simulation_run_events.get",
                        "description": "Retrieve details of a specific simulation event"
                    },
                    {
                        "label": "Replay an event for a simulation run",
                        "value": "simulation_run_events.replay",
                        "description": "Replay a simulation event for testing"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "simulation_run_events",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "list": {
        "definition": {
            "qs": {
                "id": "{{parameters.id}}",
                "order_by": "{{parameters.order_by}}"
            },
            "url": "https://{{secrets.environment_url}}/simulations/{{parameters.simulation_id}}/runs/{{parameters.simulation_run_id}}/events",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "per_page": 50
                },
                "type": "url",
                "default": {
                    "next_url": null,
                    "per_page": 50
                },
                "next_url": "{{response.data.meta.pagination.next}}",
                "condition": "{{response.data.meta.pagination.has_more}} !== false"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Paddle ID of the simulation (sim_*).",
                    "displayName": "Simulation ID",
                    "displayType": "text",
                    "placeholder": "sim_abc123"
                },
                "name": "simulation_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Paddle ID of the simulation run (simrun_*).",
                    "displayName": "Simulation Run ID",
                    "displayType": "text",
                    "placeholder": "simrun_def456"
                },
                "name": "simulation_run_id"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "ID (ascending)",
                            "value": "id[ASC]"
                        },
                        {
                            "label": "ID (descending)",
                            "value": "id[DESC]"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Order returned entities by ID.",
                    "displayName": "Order By",
                    "displayType": "select",
                    "placeholder": "Select ordering"
                },
                "name": "order_by"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Comma-separated list of simulation-event IDs to return (ntfsimevt_*).",
                    "displayName": "ID",
                    "displayType": "text",
                    "placeholder": "ntfsimevt_001,ntfsimevt_002"
                },
                "name": "id"
            }
        ]
    },
    "replay": {
        "definition": {
            "url": "https://{{secrets.environment_url}}/simulations/{{parameters.simulation_id}}/runs/{{parameters.simulation_run_id}}/events/{{parameters.simulation_event_id}}/replay",
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Paddle ID of the simulation (sim_*).",
                    "displayName": "Simulation ID",
                    "displayType": "text",
                    "placeholder": "sim_abc123"
                },
                "name": "simulation_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Paddle ID of the simulation run (simrun_*).",
                    "displayName": "Simulation Run ID",
                    "displayType": "text",
                    "placeholder": "simrun_def456"
                },
                "name": "simulation_run_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Paddle ID of the simulation event to replay (ntfsimevt_*).",
                    "displayName": "Simulation Event ID",
                    "displayType": "text",
                    "placeholder": "ntfsimevt_789ghi"
                },
                "name": "simulation_event_id"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://{{secrets.environment_url}}/simulations/{{parameters.simulation_id}}/runs/{{parameters.simulation_run_id}}/events/{{parameters.simulation_event_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Simulation ID is required."
                        }
                    },
                    "description": "Paddle ID of the simulation entity to work with.",
                    "displayName": "Simulation ID",
                    "displayType": "text",
                    "placeholder": "ntfsim_01gsz8z1q1n00f12qt82y31smh"
                },
                "name": "simulation_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Simulation Run ID is required."
                        }
                    },
                    "description": "Paddle ID of the simulation run entity to work with.",
                    "displayName": "Simulation Run ID",
                    "displayType": "text",
                    "placeholder": "ntfsimrun_01gsz8z1q1n00f12qt82y31smh"
                },
                "name": "simulation_run_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Simulation Event ID is required."
                        }
                    },
                    "description": "Paddle ID of the simulation event entity to work with.",
                    "displayName": "Simulation Event ID",
                    "displayType": "text",
                    "placeholder": "ntfsimevt_01gsz8z1q1n00f12qt82y31smh"
                },
                "name": "simulation_event_id"
            }
        ]
    }
}
