                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "notification_settings",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
