                    },
                    "description": "Short description for this discount for your reference. Not shown to customers.",
                    "displayName": "Description",
                    "displayType": "text",
                    "placeholder": "Enter discount description"
                },
                "name": "description"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Flat",
                            "value": "flat"
