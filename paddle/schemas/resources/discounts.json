{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Discount",
                        "value": "discounts.create",
                        "description": "Create a new discount code with percentage or amount off"
                    },
                    {
                        "label": "Get Discount",
                        "value": "discounts.get",
                        "description": "Retrieve details of a specific discount"
                    },
                    {
                        "label": "List Discounts",
                        "value": "discounts.list",
                        "description": "Get a paginated list of all discounts with filtering options"
                    },
                    {
                        "label": "Update Discount",
                        "value": "discounts.update",
                        "description": "Modify discount details such as amount, restrictions, or expiry"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "discounts",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://{{secrets.environment_url}}/discounts",
            "body": {
                "code": "{{parameters.code}}",
                "mode": "{{parameters.mode}}",
                "type": "{{parameters.type}}",
                "recur": "{{parameters.recur}}",
                "amount": "{{parameters.amount}}",
                "expires_at": "{{parameters.expires_at}}",
                "custom_data": "{{parameters.custom_data}}",
                "description": "{{parameters.description}}",
                "restrict_to": "{{parameters.restrict_to}}",
                "usage_limit": "{{parameters.usage_limit}}",
                "currency_code": "{{parameters.currency_code}}",
                "discount_group_id": "{{parameters.discount_group_id}}",
                "enabled_for_checkout": "{{parameters.enabled_for_checkout}}",
                "maximum_recurring_intervals": "{{parameters.maximum_recurring_intervals}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Discount amount is required."
                        }
                    },
                    "description": "Amount to discount by. For percentage discounts, must be an amount between 0.01 and 100. For flat and flat_per_seat discounts, amount in the lowest denomination for a currency.",
                    "displayName": "Amount",
                    "displayType": "text",
                    "placeholder": "10"
                },
                "name": "amount"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Description is required."
