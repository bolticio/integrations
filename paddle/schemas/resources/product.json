{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Product",
                        "value": "product.create",
                        "description": "Create a new product in Paddle with specified details like name, description, and pricing"
                    },
                    {
                        "label": "Get Product",
                        "value": "product.get",
                        "description": "Retrieve details of a specific product using its ID"
                    },
                    {
                        "label": "List Products",
                        "value": "product.list",
                        "description": "Get a paginated list of all products in your Paddle account"
                    },
                    {
                        "label": "Update Product",
                        "value": "product.update",
                        "description": "Modify existing product information such as name, description, or status"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "product",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getProducts": {
        "definition": {
            "qs": {},
            "url": "https://{{secrets.environment_url}}/products",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            }
        }
    },
    "get": {
        "definition": {
            "url": "https://{{secrets.environment_url}}/products/{{parameters.product_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "paddle",
                            "secret": "{{parameters.secret}}",
                            "resource": "product",
                            "operation": "product.get",
                            "loadOptionsMethod": "getProducts"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Product name is required."
                        }
                    },
                    "description": "Select the product's name you want to fetch",
                    "displayName": "Product",
                    "displayType": "select",
                    "placeholder": "Select a product"
                },
                "name": "product_id"
            }
        ]
    },
    "update": {
        "definition": {
            "url": "https://{{secrets.environment_url}}/products/{{parameters.product_id}}",
            "body": {
                "name": "{{parameters.name}}",
                "type": "{{parameters.type}}",
                "status": "{{parameters.status}}",
                "image_url": "{{parameters.image_url}}",
                "description": "{{parameters.description}}",
                "tax_category": "{{parameters.tax_category}}"
            },
            "method": "patch",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Product ID is required."
                        }
                    },
                    "description": "Paddle ID of the product entity to work with.",
                    "displayName": "Product ID",
                    "displayType": "text",
                    "placeholder": "Enter the product ID"
                },
                "name": "product_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Name of your paddle product.",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter the name of the product"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Short description for this product.",
                    "displayName": "Description",
                    "displayType": "text",
                    "placeholder": "Enter the description of the product"
                },
                "name": "description"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Custom",
                            "value": "custom"
                        },
                        {
                            "label": "Standard",
                            "value": "standard"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Type of item. Standard items are considered part of your catalog and are shown on the Paddle web app. Custom or Non-catalog item and not returned when listing or shown in the Paddle web app.",
                    "displayName": "Type",
                    "displayType": "select",
                    "placeholder": "Select a type"
                },
                "name": "type"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Digital Goods",
                            "value": "digital-goods"
                        },
                        {
                            "label": "eBooks",
                            "value": "ebooks"
                        },
                        {
                            "label": "Implementation Services",
                            "value": "implementation-services"
                        },
                        {
                            "label": "Professional Services",
                            "value": "professional-services"
                        },
                        {
                            "label": "SAAS",
                            "value": "saas"
                        },
                        {
                            "label": "Software Programming Services",
                            "value": "software-programming-services"
                        },
                        {
                            "label": "Standard",
                            "value": "standard"
                        },
                        {
                            "label": "Training Services",
                            "value": "training-services"
                        },
                        {
                            "label": "Website Hosting",
                            "value": "website-hosting"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Tax category for this product. Used for charging the correct rate of tax. Selected tax category must be enabled on your Paddle account.",
                    "displayName": "Tax category",
                    "displayType": "select",
                    "placeholder": "Select a tax category"
                },
                "name": "tax_category"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Image for this product. Included in the checkout and on some customer documents.",
                    "displayName": "Image URL",
                    "displayType": "text",
                    "placeholder": "Enter image URL"
                },
                "name": "image_url"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Active",
                            "value": "active"
                        },
                        {
                            "label": "Archived",
                            "value": "archived"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Whether this entity can be used in Paddle.",
                    "displayName": "Status",
                    "displayType": "select",
                    "placeholder": "Select the status"
                },
                "name": "status"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://{{secrets.environment_url}}/products",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Name of the product is required."
                        }
                    },
                    "description": "Name of this product.",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter the name of this product"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Short description of this product.",
                    "displayName": "Description",
                    "displayType": "text",
                    "placeholder": "Enter the description of this product"
                },
                "name": "description"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Digital Goods",
                            "value": "digital-goods"
                        },
                        {
                            "label": "eBooks",
                            "value": "ebooks"
                        },
                        {
                            "label": "Implementation Services",
                            "value": "implementation-services"
                        },
                        {
                            "label": "Professional Services",
                            "value": "professional-services"
                        },
                        {
                            "label": "SAAS",
                            "value": "saas"
                        },
                        {
                            "label": "Software Programming Services",
                            "value": "software-programming-services"
                        },
                        {
                            "label": "Standard",
                            "value": "standard"
                        },
                        {
                            "label": "Training Services",
                            "value": "training-services"
                        },
                        {
                            "label": "Website Hosting",
                            "value": "website-hosting"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Tax category is required."
                        }
                    },
                    "description": "Tax category for this product. Used for charging the correct rate of tax. Selected tax category must be enabled on your Paddle account.",
                    "displayName": "Tax category",
                    "displayType": "select",
                    "placeholder": "Select a tax category"
                },
                "name": "tax_category"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Image for this product. Included in the checkout and on some customer documents.",
                    "displayName": "Image URL",
                    "displayType": "text",
                    "placeholder": "Enter the image URL for this product"
                },
                "name": "image_url"
            }
        ]
    },
    "list": {
        "definition": {
            "qs": {
                "id": "{{parameters.id}}",
                "order_by": "{{parameters.order_by}}"
            },
            "url": "https://{{secrets.environment_url}}/products",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "per_page": 200
                },
                "type": "url",
                "default": {
                    "next_url": null,
                    "per_page": 200
                },
                "next_url": "{{response.data.meta.pagination.next}}",
                "condition": "{{response.data.meta.pagination.has_more}} !== false"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Return only the IDs specified. Use a comma-separated list to get multiple entities.",
                    "displayName": "ID",
                    "displayType": "text",
                    "placeholder": "Enter the product ID or comma-separated list."
                },
                "name": "id"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Created at (ascending)",
                            "value": "created_at[ASC]"
                        },
                        {
                            "label": "Created at (descending)",
                            "value": "created_at[DESC]"
                        },
                        {
                            "label": "Custom data (ascending)",
                            "value": "custom_data[ASC]"
                        },
                        {
                            "label": "Custom data (descending)",
                            "value": "custom_data[DESC]"
                        },
                        {
                            "label": "Description (ascending)",
                            "value": "description[ASC]"
                        },
                        {
                            "label": "Description (descending)",
                            "value": "description[DESC]"
                        },
                        {
                            "label": "ID (ascending)",
                            "value": "id[ASC]"
                        },
                        {
                            "label": "ID (descending)",
                            "value": "id[DESC]"
                        },
                        {
                            "label": "Image URL (ascending)",
                            "value": "image_url[ASC]"
                        },
                        {
                            "label": "Image URL (descending)",
                            "value": "image_url[DESC]"
                        },
                        {
                            "label": "Name (ascending)",
                            "value": "name[ASC]"
                        },
                        {
                            "label": "Name (descending)",
                            "value": "name[DESC]"
                        },
                        {
                            "label": "Status (ascending)",
                            "value": "status[ASC]"
                        },
                        {
                            "label": "Status (descending)",
                            "value": "status[DESC]"
                        },
                        {
                            "label": "Tax category (ascending)",
                            "value": "tax_category[ASC]"
                        },
                        {
                            "label": "Tax category (descending)",
                            "value": "tax_category[DESC]"
                        },
                        {
                            "label": "Updated at (ascending)",
                            "value": "updated_at[ASC]"
                        },
                        {
                            "label": "Updated at (descending)",
                            "value": "updated_at[DESC]"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Order returned entities by the specified field and direction ([ASC] or [DESC]). For example, ?order_by=id[ASC].",
                    "displayName": "Order By",
                    "displayType": "select",
                    "placeholder": "Select a response entity"
                },
                "name": "order_by"
            }
        ]
    }
}
