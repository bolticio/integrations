{
    "name": "threads",
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Thread For Code Interpretation",
                        "value": "threads.createthreadforcodeinterpretation",
                        "description": "Create an OpenAI thread for interpreting and analyzing code."
                    },
                    {
                        "label": "Create Thread For File Search",
                        "value": "threads.createthreadforfilesearch",
                        "description": "Create an OpenAI thread to search and retrieve data from uploaded files."
                    },
                    {
                        "label": "Retrieve Thread",
                        "value": "threads.retrievethread",
                        "description": "Fetch metadata and messages of an OpenAI Assistant thread."
                    },
                    {
                        "label": "Modify Thread",
                        "value": "threads.modifythread",
                        "description": "Update metadata or properties of an OpenAI thread."
                    },
                    {
                        "label": "Delete Thread",
                        "value": "threads.deletethread",
                        "description": "Delete an existing OpenAI thread permanently."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "threads",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getAllModels": {
        "definition": {
            "url": "https://api.openai.com/v1/models",
            "method": "get",
            "headers": {
                "content-type": "application/json",
                "Authorization": "Bearer {{secrets.api_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": []
    },
    "createthreadforcodeinterpretation": {
        "definition": {
            "url": "https://api.openai.com/v1/threads",
            "body": {
                "messages": "{{parameters.messages}}",
                "metadata": "{{parameters.metadata}}",
                "tool_resources": "{{parameters.tool_resources}}"
            },
            "method": "post",
            "headers": {
                "OpenAI-Beta": "assistants=v2",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "value": "user",
                                "options": [
                                    {
                                        "label": "User",
                                        "value": "user",
                                        "description": "Indicates the message is sent by an actual user and should be used in most cases to represent user-generated messages."
                                    },
                                    {
                                        "label": "Assistant",
                                        "value": "assistant",
                                        "description": "Indicates the message is generated by the assistant. Use this value to insert messages from the assistant into the conversation."
                                    }
                                ],
                                "htmlProps": {
                                    "allowDynamic": true
                                },
                                "validation": {
                                    "required": true
                                },
                                "description": "The role of the entity that is creating the message.",
                                "displayName": "Role",
                                "displayType": "select",
                                "placeholder": "Select a role"
                            },
                            "name": "role"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true,
                                    "requiredDetail": {
                                        "errorMsg": "Content is required field."
                                    }
                                },
                                "description": "The text content of the message.",
                                "displayName": "Content",
                                "displayType": "textarea",
                                "placeholder": "Enter a message content"
                            },
                            "name": "content"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "A list of messages to start the thread with.",
                    "displayName": "List of Messages",
                    "displayType": "array"
                },
                "name": "messages"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "children": [
                                    {
                                        "meta": {
                                            "value": [],
                                            "htmlProps": {
                                                "allowDynamic": true
                                            },
                                            "validation": {
                                                "required": false
                                            },
                                            "description": "A list of file IDs made available to the code_interpreter tool. There can be a maximum of 20 files associated with the tool.",
                                            "displayName": "File IDs",
                                            "displayType": "multitext",
                                            "placeholder": "Enter a list of file ids"
                                        },
                                        "name": "file_ids"
                                    }
                                ],
                                "validation": {
                                    "required": false
                                },
                                "description": "Resources for the code interpreter tool",
                                "displayName": "Code Interpreter",
                                "displayType": "object"
                            },
                            "name": "code_interpreter"
                        }
                    ],
                    "validation": {
                        "required": false
                    },
                    "description": "Resources for tools that can be used by the assistant.",
                    "displayName": "Tool Resources",
                    "displayType": "object"
                },
                "name": "tool_resources"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "max": 64,
                                    "required": false
                                },
                                "displayName": "Key",
                                "displayType": "text"
                            },
                            "name": "key"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "max": 512,
                                    "required": false
                                },
                                "displayName": "Value",
                                "displayType": "text"
                            },
                            "name": "value"
                        }
                    ],
                    "htmlProps": {
                        "allowAdd": true,
                        "allowDynamic": true
                    },
                    "validation": {
                        "max": 16,
                        "required": false
                    },
                    "description": "Set of 16 key-value pairs in OpenAI to store structured, custom info on an object.",
                    "displayName": "Metadata",
                    "displayType": "keyvalue",
                    "placeholder": "Enter metadata key-value pairs"
                },
                "name": "metadata"
            }
        ]
    },
    "modifythread": {
        "definition": {
            "url": "https://api.openai.com/v1/threads/{{parameters.threadId}}",
            "body": {
                "bytes": "{{parameters.numberOfBytes}}",
                "purpose": "{{parameters.purpose}}",
                "filename": "{{parameters.fileName}}",
                "mime_type": "{{parameters.mimeType}}"
            },
            "method": "post",
            "headers": {
                "OpenAI-Beta": "assistants=v2",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "max": 256,
                        "required": true
                    },
                    "description": "The ID of the thread to modify.",
                    "displayName": "Thread ID",
                    "displayType": "text",
                    "placeholder": "Enter a thread id"
                },
                "name": "threadId"
            },
            {
                "meta": {
                    "validation": {
                        "required": false,
                        "maxLength": 512
                    },
                    "description": "The description of the assistant. The maximum length is 512 characters.",
                    "displayName": "Description",
                    "displayType": "textarea",
                    "placeholder": "Enter a Descriptions"
                },
                "name": "description"
            },
            {
                "meta": {
                    "validation": {
                        "required": false,
                        "maxLength": 256000
                    },
                    "description": "The system instructions that the assistant uses. The maximum length is 256,000 characters.",
                    "displayName": "Instructions",
                    "displayType": "textarea",
                    "placeholder": "Enter Instructions"
                },
                "name": "instructions"
            },
            {
                "meta": {
                    "value": [],
                    "children": [
                        {
                            "meta": {
                                "options": [
                                    {
                                        "label": "Code interpreter tool",
                                        "value": "code_interpreter"
                                    },
                                    {
                                        "label": "FileSearch tool",
                                        "value": "file_search"
                                    }
                                ],
                                "htmlProps": {
                                    "allowDynamic": true
                                },
                                "description": "Tools can be of types code_interpreter or file_search.",
                                "displayName": "Type of tool",
                                "displayType": "select",
                                "placeholder": "Select the type of tool"
                            },
                            "name": "type"
                        }
                    ],
                    "validation": {
                        "required": false
                    },
                    "description": "A list of tool enabled on the assistant. There can be a maximum of 128 tools per assistant.",
                    "displayName": "Tools",
                    "displayType": "array"
                },
                "name": "tools"
            }
        ]
    },
