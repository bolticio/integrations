{
    "name": "chat",
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Chat Completion",
                        "value": "chat.chatcompletionwithtextsingle",
                        "description": "Generate an OpenAI model response to a text-based conversation. Use this when you need to create AI-powered chat interactions with text-only inputs."
                    },
                    {
                        "label": "Create Chat Completion (Responses API)",
                        "value": "chat.chatcompletionwithtextsingleResponsesAPI",
                        "description": "Generate a model response for a text based conversation using the Responses API. Provide a role-based message as input to create AI-powered chat interactions."
                    },
                    {
                        "label": "Create Chat Completion Multiple Messages",
                        "value": "chat.chatcompletionwithtext",
                        "description": "Generate an OpenAI model response to a text-based conversation. Use this when you need to create AI-powered chat interactions with text-only inputs."
                    },
                    {
                        "label": "Create Chat Completion Multiple Messages (Responses API)",
                        "value": "chat.chatcompletionwithtextResponsesApi",
                        "description": "Generate a model response for a text-only, multi-message conversation using the Responses API. Provide an array of role-based messages as input to create AI-powered chat interactions."
                    },
                    {
                        "label": "Create Chat Completion With Image",
                        "value": "chat.chatcompletionwithimage",
                        "description": "Use OpenAI to generate chat responses from conversations with text and images, enabling visual content understanding in AI interactions."
                    },
                    {
                        "label": "Create Chat Completion With Image (Responses API)",
                        "value": "chat.chatcompletionwithimageResponsesAPI",
                        "description": "Use the Responses API to generate chat responses from conversations that include text and image inputs, enabling the model to understand and respond to visual content within your AI interactions."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "chat",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getAllModels": {
        "definition": {
            "url": "https://api.openai.com/v1/models",
            "method": "get",
            "headers": {
                "content-type": "application/json",
                "Authorization": "Bearer {{secrets.api_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": []
    },
    "chatcompletionwithtext": {
        "definition": {
            "url": "https://api.openai.com/v1/chat/completions",
            "body": {
                "model": "{{parameters.modelId}}",
                "top_p": "{{parameters.top_p}}",
                "messages": "{{parameters.chat}}",
                "temperature": "{{parameters.temperature}}",
                "max_completion_tokens": "{{parameters.maxCompletionTokens}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "openai",
                            "secret": "{{parameters.secret}}",
                            "resource": "chat",
                            "operation": "chat.chatcompletionwithtext",
                            "activity_id": "{{parameters.activity_id}}",
                            "loadOptionsMethod": "getAllModels"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "id",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Model is required field"
                        }
                    },
                    "description": "Select the model to use for the operation.",
                    "displayName": "Models",
                    "displayType": "autocomplete",
                    "placeholder": "Select a model"
                },
                "name": "modelId"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "value": "user",
                                "options": [
                                    {
                                        "label": "User (Message from the user)",
                                        "value": "user",
                                        "description": "Send a message as a user"
                                    },
                                    {
                                        "label": "Assistant (Message from the assistant)",
                                        "value": "assistant",
                                        "description": "Send a message as an assistant"
                                    },
                                    {
                                        "label": "System (Message from the assistant)",
                                        "value": "system",
                                        "description": "Send a message as an assistant"
                                    },
                                    {
                                        "label": "Developer (Message from the Developer)",
                                        "value": "developer",
                                        "description": "Send a message as a developer"
                                    }
                                ],
                                "htmlProps": {
                                    "allowDynamic": true
                                },
                                "validation": {
                                    "required": true,
                                    "requiredDetail": {
                                        "errorMsg": "Please select the role for the message."
                                    }
                                },
                                "description": "Specify whether the message is sent by the user, assistant or system.",
                                "displayName": "Message Role",
                                "displayType": "select",
                                "placeholder": "Choose the role for this message"
                            },
                            "name": "role"
                        },
                        {
                            "meta": {
                                "htmlProps": {
                                    "allowDynamic": true,
                                    "showInfoIcon": true
                                },
                                "validation": {
                                    "required": true,
                                    "infoDetail": {
                                        "infoMsg": "Add message to the content"
                                    }
                                },
                                "description": "This will be the prompt Eg. Tell me a fun fact.",
                                "displayName": "Content",
                                "displayType": "textarea",
                                "placeholder": "Enter the message part."
                            },
                            "name": "content"
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": "Provide the chat history to simulate an ongoing conversation.",
                    "displayName": "Messages",
                    "displayType": "array"
                },
                "name": "chat"
            },
            {
                "meta": {
                    "value": 1024,
                    "validation": {
                        "required": false
                    },
                    "description": "An upper bound for the number of tokens that can be generated for a completion, including visible output tokens and reasoning tokens.",
                    "displayName": "Max Completion Tokens",
                    "displayType": "number",
                    "placeholder": "Specify the maximum tokens to generate"
                },
                "name": "maxCompletionTokens"
            },
            {
                "meta": {
                    "max": 2,
                    "min": 0,
                    "step": 0.1,
                    "value": 0.7,
                    "htmlProps": {
                        "showInfoIcon": false
                    },
                    "validation": {
                        "required": false,
                        "infoDetail": {
                            "infoMsg": "Choose a value between 0(Very Deterministic) and 2 (Highly Random)"
                        }
                    },
                    "description": "Control the randomness of the response. Lower values produce more deterministic outputs. Default is 0.7.",
                    "displayName": "Temperature",
                    "displayType": "slider"
                },
                "name": "temperature"
            },
            {
                "meta": {
                    "value": 0.95,
                    "htmlProps": {
                        "showInfoIcon": true
                    },
                    "validation": {
                        "required": false,
                        "infoDetail": {
                            "infoMsg": "Add value to the topP or leave at default value"
                        }
                    },
                    "description": "Always selects the most probable token.",
                    "displayName": "top P",
                    "displayType": "number",
                    "placeholder": "Enter the value for top P"
                },
                "name": "top_p"
            }
        ]
    },
