    "chatcompletionwithtextsingleresponsesapi": {
        "definition": {
            "url": "https://api.openai.com/v1/responses",
            "body": {
                "input": [
                    {
                        "role": "{{parameters.role}}",
                        "content": [
                            {
                                "text": "{{parameters.content}}",
                                "type": "input_text"
                            }
                        ]
                    }
                ],
                "model": "{{parameters.modelId}}",
                "top_p": "{{parameters.top_p}}",
                "temperature": "{{parameters.temperature}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "function transformBody(){ const b = { ...body }; const t = Number(b.temperature); if (!Number.isNaN(t) && t === 0) { delete b.temperature; } return b; } return transformBody();"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
