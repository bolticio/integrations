{
    "name": "files",
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Files",
                        "value": "files.listfiles",
                        "description": "Retrieve a complete list of all your OpenAI files. Use this when you need to view or manage multiple files across your account."
                    },
                    {
                        "label": "Retrieve File",
                        "value": "files.retrievefile",
                        "description": "Get detailed information about a specific OpenAI file by its ID. Use this when you need to check a file's metadata or status."
                    },
                    {
                        "label": "Delete File",
                        "value": "files.deletefile",
                        "description": "Permanently remove an OpenAI file by its ID. Use this when you no longer need a specific file."
                    },
                    {
                        "label": "Retrieve File Content",
                        "value": "files.retrievefilecontent",
                        "description": "Download the actual contents of a specific OpenAI file. Use this when you need to access the raw data within a file."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "files",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "retrievefilecontent": {
        "definition": {
            "url": "https://api.openai.com/v1/files/{{parameters.fileId}}/content",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.api_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "File ID is required field"
                        }
                    },
                    "description": "The ID of the file to retrieve content from.",
                    "displayName": "File ID",
                    "displayType": "text",
                    "placeholder": "Enter a file id"
                },
                "name": "fileId"
            }
        ]
    },
    "listfiles": {
        "definition": {
            "qs": {
                "limit": "{{parameters.limit}}",
                "order": "{{parameters.order}}",
                "purpose": "{{parameters.purpose}}"
            },
            "url": "https://api.openai.com/v1/files",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.api_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "options": [
                        {
                            "label": "Assistants",
                            "value": "assistants",
                            "description": "OpenAI: Used in Assistants and Messages. Supports specific file types up to 2M tokens. See Assistants Tools guide for file requirements."
                        },
                        {
                            "label": "Batch",
                            "value": "batch",
                            "description": "Used for Batch API. The Batch API only supports .jsonl files up to 200 MB in size. The input also has a specific required format."
                        },
                        {
                            "label": "Fine-Tune",
                            "value": "fine-tune",
                            "description": "OpenAI: Used for Fine-tuning. Only .jsonl files are supported with specific formats for chat or completion model training."
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "The intended purpose of the uploaded file.",
                    "displayName": "Purpose",
                    "displayType": "select",
                    "placeholder": "Select a purpose"
                },
                "name": "purpose"
            },
            {
                "meta": {
                    "value": 10000,
                    "validation": {
                        "required": false
                    },
                    "description": "A limit on the number of objects to be returned. Limit can range between 1 and 10,000, and the default is 10,000.",
                    "displayName": "Limit (no. of objects)",
                    "displayType": "number",
                    "placeholder": "Enter limit"
                },
                "name": "limit"
            },
            {
                "meta": {
                    "value": "desc",
                    "options": [
                        {
                            "label": "Ascending",
                            "value": "asc"
                        },
                        {
                            "label": "Descending",
                            "value": "desc"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Sort order by the created_at timestamp of the objects. asc for ascending order and desc for descending order.",
                    "displayName": "Order",
                    "displayType": "select",
                    "placeholder": "Select a order type"
                },
                "name": "order"
            }
        ]
    },
    "retrievefile": {
        "definition": {
            "url": "https://api.openai.com/v1/files/{{parameters.fileId}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.api_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "File ID is required field"
                        }
                    },
                    "description": "The ID of the file to retrieve.",
                    "displayName": "File ID",
                    "displayType": "text",
                    "placeholder": "Enter a file id"
                },
                "name": "fileId"
            }
        ]
    },
    "deletefile": {
        "definition": {
            "url": "https://api.openai.com/v1/files/{{parameters.fileId}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.api_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "File ID is required field"
                        }
                    },
                    "description": "The ID of the file to delete.",
                    "displayName": "File ID",
                    "displayType": "text",
                    "placeholder": "Enter a file id"
                },
                "name": "fileId"
            }
        ]
    }
}
