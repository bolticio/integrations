{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Merge PDF",
                        "value": "pdf_merge.pdf_join",
                        "description": "Merge PDF."
                    },
                    {
                        "label": "Merge Various Document Type",
                        "value": "pdf_merge.pdf_concate",
                        "description": "Merge Various Document Type."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "autocomplete",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "pdf_merge",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "pdf_concate": {
        "definition": {
            "url": "https://api.pdf.co/v1/pdf/merge2",
            "body": {
                "url": "{{parameters.url}}"
            },
            "method": "post",
            "headers": {
                "x-api-key": "{{secrets.api_key}}",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "PDF URL is required"
                        }
                    },
                    "description": "If you want to merge multiple files, you can add multiple URLs using comma separated. Merge PDF from two or more PDF, DOC, XLS, images, even ZIP with documents and images into a new PDF.",
                    "displayName": "PDF URL",
                    "displayType": "url",
                    "placeholder": "Enter the url of two same format's url like two pdfs,two docs,two xls."
                },
                "name": "url"
            }
        ]
    },
    "pdf_join": {
        "definition": {
            "url": "https://api.pdf.co/v1/pdf/merge",
            "body": {
                "url": "{{parameters.url}}"
            },
            "method": "post",
            "headers": {
                "x-api-key": "{{secrets.api_key}}",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "PDF URL is required"
                        }
                    },
                    "description": "Enter the URL of the PDF file. If you want to merge multiple files, you can add multiple URLs using comma separated.",
                    "displayName": "PDF URL",
                    "displayType": "url",
                    "placeholder": "Merge multiple PDF files into a single PDF document."
                },
                "name": "url"
            }
        ]
    }
}
