                    },
                    {
                        "label": "Convert Excel to PDF",
                        "value": "excel_conversion.excel_to_pdf",
                        "description": "Convert Excel to PDF."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "autocomplete",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "excel_conversion",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "excel_to_csv": {
        "definition": {
            "url": "https://api.pdf.co/v1/xls/convert/to/csv",
            "body": {
                "url": "{{parameters.url}}"
            },
            "method": "post",
            "headers": {
                "x-api-key": "{{secrets.api_key}}",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Excel URL is required"
                        }
                    },
                    "description": "Converts a xls/xlsx file to csv.",
                    "displayName": "Excel URL",
                    "displayType": "url",
                    "placeholder": "Enter the URL of the Excel file in xls/xlsx format."
                },
                "name": "url"
            }
        ]
    },
