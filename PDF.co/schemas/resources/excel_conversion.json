{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Convert Excel to CSV",
                        "value": "excel_conversion.excel_to_csv",
                        "description": "Convert Excel to CSV."
                    },
                    {
                        "label": "Convert Excel to JSON",
                        "value": "excel_conversion.excel_to_json",
                        "description": "Convert Excel to JSON."
                    },
                    {
                        "label": "Convert Excel to HTML",
                        "value": "excel_conversion.excel_to_html",
                        "description": "Convert Excel to HTML."
                    },
                    {
