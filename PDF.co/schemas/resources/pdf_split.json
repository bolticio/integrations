{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Split PDF",
                        "value": "pdf_split.pdf_split_by_pages",
                        "description": "Split PDF."
                    },
                    {
                        "label": "Split PDF by Text Search",
                        "value": "pdf_split.pdf_split_by_text",
                        "description": "Split PDF by Text Search."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "autocomplete",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "pdf_split",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "pdf_split_by_text": {
        "definition": {
            "url": "https://api.pdf.co/v1/pdf/split2",
            "body": {
                "url": "{{parameters.url}}",
                "searchString": "{{parameters.searchString}}"
            },
            "method": "post",
            "headers": {
                "x-api-key": "{{secrets.api_key}}",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "PDF URL is required"
                        }
                    },
                    "description": "Split a PDF into multiple PDF files using page indexes or page ranges.",
                    "displayName": "PDF URL",
                    "displayType": "url",
                    "placeholder": "Enter the URL of the PDF file. If you want to split multiple files, you can add multiple URLs using comma separated."
                },
                "name": "url"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Text must be a string and is required."
                        }
                    },
                    "description": "Enter the Text to search for on pages. Must be a string.",
                    "displayName": "Text Search",
                    "displayType": "text",
                    "placeholder": "Enter the Text to search for on pages. Must be a string."
                },
                "name": "searchString"
            }
        ]
    },
    "pdf_split_by_pages": {
        "definition": {
            "url": "https://api.pdf.co/v1/pdf/split",
            "body": {
                "url": "{{parameters.url}}"
            },
            "method": "post",
            "headers": {
                "x-api-key": "{{secrets.api_key}}",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "PDF URL is required"
                        }
                    },
                    "description": "Enter the URL of the PDF file you want to split.",
                    "displayName": "PDF URL",
                    "displayType": "url",
                    "placeholder": "Enter the URL of the PDF file you want to split."
                },
                "name": "url"
            }
        ]
    }
}
