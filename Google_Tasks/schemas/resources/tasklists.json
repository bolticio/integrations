{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get Task Lists",
                        "value": "tasklists.getTaskLists",
                        "description": "Get a list of all task lists."
                    },
                    {
                        "label": "Get Task List Details",
                        "value": "tasklists.getTaskListByID",
                        "description": "Get details of the specific task list."
                    },
                    {
                        "label": "Create Task List",
                        "value": "tasklists.createTaskList",
                        "description": "Create a task list."
                    },
                    {
                        "label": "Rename Task List",
                        "value": "tasklists.updateTaskListTitle",
                        "description": "Rename a task list."
                    },
                    {
                        "label": "Delete Task List",
                        "value": "tasklists.deleteTaskListByID",
                        "description": "Delete a specific task list."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "tasklists",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getTaskListsDetails": {
        "definition": {
            "url": "https://tasks.googleapis.com/tasks/v1/users/@me/lists",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.items}}"
            },
            "pagination": {
                "qs": {
                    "pageToken": "{{response.data.nextPageToken}}",
                    "maxResults": 100
                },
                "type": "cursor",
                "default": {
                    "pageToken": null,
                    "maxResults": 100
                },
                "condition": "{{response.data.nextPageToken}} != null"
            }
        },
        "parameters": []
    },
    "gettasklists": {
        "definition": {
            "url": "https://tasks.googleapis.com/tasks/v1/users/@me/lists",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.items}}"
            },
            "pagination": {
                "qs": {
                    "pageToken": "{{response.data.nextPageToken}}",
                    "maxResults": 100
                },
                "type": "cursor",
                "default": {
                    "pageToken": null,
                    "maxResults": 100
                },
                "condition": "{{response.data.nextPageToken}} != null"
            }
        },
        "parameters": []
    },
    "createtasklist": {
        "definition": {
            "url": "https://tasks.googleapis.com/tasks/v1/users/@me/lists",
            "body": {
                "title": "{{parameters.title}}"
            },
            "method": "POST",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter a task list title.",
                    "displayName": "Title",
                    "displayType": "text",
                    "placeholder": "Enter a task list title"
                },
                "name": "title"
            }
        ]
    },
    "gettasklistbyid": {
        "definition": {
            "url": "https://tasks.googleapis.com/tasks/v1/users/@me/lists/{{parameters.tasklist_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "google_tasks",
                            "secret": "{{parameters.secret}}",
                            "resource": "tasklists",
                            "operation": "tasklists.getTaskListByID",
                            "loadOptionsMethod": "getTaskListsDetails"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "title",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select a task list. For dynamic input enter task list ID.",
                    "displayName": "Task List",
                    "displayType": "autocomplete",
                    "placeholder": "Select a task list"
                },
                "name": "tasklist_id"
            }
        ]
    },
    "deletetasklistbyid": {
        "definition": {
            "url": "https://tasks.googleapis.com/tasks/v1/users/@me/lists/{{parameters.tasklist_id}}",
            "method": "delete",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "output": "let data = output; data='Task list has been removed successfully!'; return data"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "google_tasks",
                            "secret": "{{parameters.secret}}",
                            "resource": "tasklists",
                            "operation": "tasklists.deleteTaskListByID",
                            "loadOptionsMethod": "getTaskListsDetails"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "title",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select a task list to delete. For dynamic input enter task list ID.",
                    "displayName": "Task List",
                    "displayType": "autocomplete",
                    "placeholder": "Select a task list"
                },
                "name": "tasklist_id"
            }
        ]
    },
    "updatetasklisttitle": {
        "definition": {
            "url": "https://tasks.googleapis.com/tasks/v1/users/@me/lists/{{parameters.tasklist_id}}",
            "body": {
                "title": "{{parameters.title}}"
            },
            "method": "PATCH",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "google_tasks",
                            "secret": "{{parameters.secret}}",
                            "resource": "tasklists",
                            "operation": "tasklists.updateTaskListTitle",
                            "loadOptionsMethod": "getTaskListsDetails"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "title",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select a task list to rename. For dynamic input enter task list ID.",
                    "displayName": "Task List",
                    "displayType": "autocomplete",
                    "placeholder": "Select a task list"
                },
                "name": "tasklist_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the new task list title.",
                    "displayName": "New Title",
                    "displayType": "text",
                    "placeholder": "Enter a new title"
                },
                "name": "title"
            }
        ]
    }
