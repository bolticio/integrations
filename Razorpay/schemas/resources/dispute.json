{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get All Disputes",
                        "value": "dispute.getdisputes",
                        "description": "Get all disputes raised by customers."
                    },
                    {
                        "label": "Get Dispute Details by ID",
                        "value": "dispute.getdisputebydisputeid",
                        "description": "Get dispute details using the dispute ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "dispute",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getdisputes": {
        "definition": {
            "qs": {
                "to": "{{parameters.to}}",
                "from": "{{parameters.from}}"
            },
            "url": "https://api.razorpay.com/v1/disputes",
            "method": "GET",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.client_id}}:{{secrets.client_secret}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.description}}"
                },
                "output": "{{response.data.items}}"
            },
            "pagination": {
                "qs": {
                    "skip": "{{pagination.skip}} + {{response.data.count}}",
                    "count": "{{pagination.count}}"
                },
                "type": "offset",
                "default": {
                    "skip": 0,
                    "count": 100
                },
                "condition": "{{response.data.count}} >= 0"
            }
        },
        "parameters": [
            {
                "meta": {
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "unixUnit": "seconds",
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        },
                        "outputFormat": "unix"
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Filter disputes created after this time.",
                    "displayName": "From",
                    "displayType": "datetime",
                    "placeholder": "Select start date and time"
                },
                "name": "from"
            },
            {
                "meta": {
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "unixUnit": "seconds",
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        },
                        "outputFormat": "unix"
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Filter disputes created before this time.",
                    "displayName": "To",
                    "displayType": "datetime",
                    "placeholder": "Select end date and time"
                },
                "name": "to"
            }
        ]
    },
    "getdisputebydisputeid": {
        "definition": {
            "url": "https://api.razorpay.com/v1/disputes/",
            "method": "GET",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.client_id}}:{{secrets.client_secret}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}",
                    "description": "{{response.data.error.description}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "url": "function transformURL(){var disputeId=(typeof parameters!=='undefined'&&parameters&&parameters.disputeId!=null)?parameters.disputeId:'{{parameters.disputeId}}';disputeId=String(disputeId).trim().replace(/^\\\"|\\\"$/g,'');if(!disputeId)throw new Error('Invalid disputeId');return (url.endsWith('/')?url:url+'/')+encodeURIComponent(disputeId);}return transformURL();",
                "error": "const obj = { message: error.message === 'undefined'  ? error.description : error.message, code: error && error.code != null ? error.code : null }; return obj;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the dispute ID you want to get details for.",
                    "displayName": "Dispute ID",
                    "displayType": "text",
                    "placeholder": "Enter a dispute ID"
                },
                "name": "disputeId"
            }
        ]
    }
}
