{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get All Settlements",
                        "value": "settlement.getsettlements",
                        "description": "Get details of all settlements."
                    },
                    {
                        "label": "Get Settlement Details by ID",
                        "value": "settlement.getsettlementbysettlementid",
                        "description": "Get settlement details using the settlement ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "settlement",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getsettlements": {
        "definition": {
            "qs": {
                "to": "{{parameters.to}}",
                "from": "{{parameters.from}}"
            },
            "url": "https://api.razorpay.com/v1/settlements",
            "method": "GET",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.client_id}}:{{secrets.client_secret}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.description}}"
                },
                "output": "{{response.data.items}}"
            },
            "pagination": {
                "qs": {
                    "skip": "{{pagination.skip}} + {{response.data.count}}",
                    "count": "{{pagination.count}}"
                },
                "type": "offset",
                "default": {
                    "skip": 0,
                    "count": 100
                },
                "condition": "{{response.data.count}} >= 0"
            }
        },
        "parameters": [
            {
                "meta": {
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "unixUnit": "seconds",
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        },
                        "outputFormat": "unix"
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Filter settlements created after this time.",
                    "displayName": "From",
                    "displayType": "datetime",
                    "placeholder": "Select start date and time"
                },
                "name": "from"
            },
            {
                "meta": {
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "unixUnit": "seconds",
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        },
                        "outputFormat": "unix"
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Filter settlements created before this time.",
                    "displayName": "To",
                    "displayType": "datetime",
                    "placeholder": "Select end date and time"
                },
                "name": "to"
            }
        ]
    },
    "getsettlementbysettlementid": {
        "definition": {
            "url": "https://api.razorpay.com/v1/settlements/",
            "method": "GET",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.client_id}}:{{secrets.client_secret}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}",
                    "description": "{{response.data.error.description}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "url": "function transformURL(){var settlementId=(typeof parameters!=='undefined'&&parameters&&parameters.settlementId!=null)?parameters.settlementId:'{{parameters.settlementId}}';settlementId=String(settlementId).trim().replace(/^\\\"|\\\"$/g,'');if(!settlementId)throw new Error('Invalid settlementId');return (url.endsWith('/')?url:url+'/')+encodeURIComponent(settlementId);}return transformURL();",
                "error": "const obj = { message: error.message === 'undefined'  ? error.description : error.message, code: error && error.code != null ? error.code : null }; return obj;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Get a settlement by its ID.",
                    "displayName": "Settlement ID",
                    "displayType": "text",
                    "placeholder": "Enter a settlement ID (for example: setl_00001)"
                },
                "name": "settlementId"
            }
        ]
    }
}
