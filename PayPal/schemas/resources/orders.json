{
    "get": {
        "definition": {
            "url": "https://{{secrets.environment}}.paypal.com/v2/checkout/orders/{{parameters.order_id}}",
            "method": "GET",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Unique PayPal order identifier to retrieve details for",
                    "displayName": "Order ID",
                    "displayType": "text",
                    "placeholder": "Enter PayPal order ID"
                },
                "name": "order_id"
            }
        ]
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Order",
                        "value": "orders.create",
                        "description": "Create a new PayPal order for payment processing."
                    },
                    {
                        "label": "Confirm Payment Source",
                        "value": "orders.confirm_payment",
                        "description": "Confirm a PayPal payment source (e.g., 3D Secure) for an order."
                    },
                    {
                        "label": "Refund Payment",
                        "value": "orders.refund_payment",
                        "description": "Refund a PayPal captured payment partially or fully."
                    },
                    {
                        "label": "Get Order Details",
                        "value": "orders.get_order",
                        "description": "Retrieve detailed information about a specific PayPal order or payment."
                    },
                    {
                        "label": "List Payments",
                        "value": "orders.list_payments",
                        "description": "List PayPal payments with optional filtering."
                    },
                    {
                        "label": "Update Order",
                        "value": "orders.update",
                        "description": "Update PayPal order details like amount, shipping, or items."
                    },
                    {
                        "label": "Authorize Payment for Order",
                        "value": "orders.authorize",
                        "description": "Authorize a PayPal payment for an order without capturing funds."
                    },
                    {
                        "label": "Capture Payment for Order",
                        "value": "orders.capture",
                        "description": "Capture funds for a PayPal order authorization or approval."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "orders",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "authorize": {
        "definition": {
            "url": "https://{{secrets.environment}}.paypal.com/v2/checkout/orders/{{parameters.order_id}}/authorize",
            "body": {},
            "method": "POST",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "ID of the confirmed order to authorize payment.",
                    "displayName": "Order ID",
                    "displayType": "text",
                    "placeholder": "Enter approved order ID"
                },
                "name": "order_id"
            }
        ]
    },
    "capture": {
        "definition": {
            "url": "https://{{secrets.environment}}.paypal.com/v2/checkout/orders/{{parameters.order_id}}/capture",
            "method": "POST",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "ID of the confirmed order to capture payment.",
                    "displayName": "Order ID",
                    "displayType": "text",
                    "placeholder": "Enter approved order ID"
                },
                "name": "order_id"
            }
        ]
    },
    "confirm_payment": {
        "definition": {
            "url": "https://{{secrets.environment}}.paypal.com/v2/checkout/orders/{{parameters.order_id}}/confirm-payment-source",
            "body": {
                "payment_source": {
                    "card": {
                        "expiry": "{{parameters.card_expiry}}",
                        "number": "{{parameters.card_number}}"
                    }
                }
            },
            "method": "POST",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "PayPal Order ID to confirm payment for",
                    "displayName": "Order ID",
                    "displayType": "text",
                    "placeholder": "Enter Order ID"
                },
                "name": "order_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Credit or debit card number (13-19 digits, numbers only)",
                    "displayName": "Card Number",
                    "displayType": "number",
                    "placeholder": "Enter you card number"
                },
                "name": "card_number"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Card expiration date e.g., 2030-02",
                    "displayName": "Card Expiry",
                    "displayType": "text",
                    "placeholder": "YYYY-MM"
                },
                "name": "card_expiry"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://{{secrets.environment}}.paypal.com/v2/checkout/orders",
            "body": {
                "intent": "{{parameters.intent}}",
                "payment_source": {
                    "paypal": {
                        "experience_context": {
                            "cancel_url": "{{parameters.cancel_url}}",
                            "return_url": "{{parameters.return_url}}"
                        }
                    }
                },
                "purchase_units": [
                    {
                        "amount": {
                            "value": "{{parameters.amount}}",
                            "currency_code": "{{parameters.currency}}"
                        }
                    }
                ]
            },
            "method": "POST",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "options": [
                        {
                            "label": "Continue",
                            "value": "CONTINUE"
                        },
                        {
                            "label": "Pay Now",
                            "value": "PAY_NOW"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Specify whether to continue to the payment page or not",
                    "displayName": "User Action",
                    "displayType": "select",
                    "placeholder": "Select user action"
                },
                "name": "user_action"
            },
            {
                "meta": {
                    "value": "CAPTURE",
                    "options": [
                        {
                            "label": "Capture",
                            "value": "CAPTURE",
                            "description": "Capture payment immediately when buyer approves"
                        },
                        {
                            "label": "Authorize",
                            "value": "AUTHORIZE",
                            "description": "Authorize payment for later capture (up to 29 days)"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Specify whether to capture payment immediately or authorize for later capture",
                    "displayName": "Payment Intent",
                    "displayType": "select",
                    "placeholder": "Select payment intent"
                },
                "name": "intent"
            },
            {
                "meta": {
                    "validation": {
                        "min": 0.01,
                        "required": true
                    },
                    "description": "Total amount for the order in decimal format (minimum 0.01)",
                    "displayName": "Order Amount",
                    "displayType": "number",
                    "placeholder": "Enter order amount (e.g., 100.00)"
                },
                "name": "amount"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Australian Dollar (AUD)",
                            "value": "AUD"
                        },
                        {
                            "label": "Brazilian Real (BRL)",
                            "value": "BRL"
                        },
                        {
                            "label": "Canadian Dollar (CAD)",
                            "value": "CAD"
                        },
                        {
                            "label": "Chinese Renmenbi (CNY)",
                            "value": "CNY"
                        },
                        {
                            "label": "Czech Koruna (CZK)",
                            "value": "CZK"
                        },
                        {
                            "label": "Danish Krone (DKK)",
                            "value": "DKK"
                        },
                        {
                            "label": "Euro (EUR)",
                            "value": "EUR"
                        },
                        {
                            "label": "Pound Sterling (GBP)",
                            "value": "GBP"
                        },
                        {
                            "label": "Hong Kong Dollar (HKD)",
                            "value": "HKD"
                        },
                        {
                            "label": "Hungarian Forint (HUF)",
                            "value": "HUF"
                        },
                        {
                            "label": "Israeli New Shekel (ILS)",
                            "value": "ILS"
                        },
                        {
                            "label": "Japanese Yen (JPY)",
                            "value": "JPY"
                        },
                        {
                            "label": "Malaysian Ringgit (MYR)",
                            "value": "MYR"
                        },
                        {
                            "label": "Mexican Peso (MXN)",
                            "value": "MXN"
                        },
                        {
                            "label": "New Zealand Dollar (NZD)",
                            "value": "NZD"
                        },
                        {
                            "label": "Norwegian Krone (NOK)",
                            "value": "NOK"
                        },
                        {
                            "label": "Philippine Peso (PHP)",
                            "value": "PHP"
                        },
                        {
                            "label": "Polish Złoty (PLN)",
                            "value": "PLN"
                        },
                        {
                            "label": "Russian Ruble (RUB)",
                            "value": "RUB"
                        },
                        {
                            "label": "Singapore Dollar (SGD)",
                            "value": "SGD"
                        },
                        {
                            "label": "Swedish Krona (SEK)",
                            "value": "SEK"
                        },
                        {
                            "label": "Swiss Franc (CHF)",
                            "value": "CHF"
                        },
                        {
                            "label": "New Taiwan Dollar (TWD)",
                            "value": "TWD"
                        },
                        {
                            "label": "Thai Baht (THB)",
                            "value": "THB"
                        },
                        {
                            "label": "US Dollar (USD)",
                            "value": "USD"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Three-character ISO currency code for the payment",
                    "displayName": "Currency Code",
                    "displayType": "autocomplete",
                    "placeholder": "Select currency"
                },
                "name": "currency"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)$",
                        "required": true
                    },
                    "description": "URL to redirect user after successful payment approval",
                    "displayName": "Return URL",
                    "displayType": "text",
                    "placeholder": "https://example.com/success"
                },
                "name": "return_url"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)$",
                        "required": true
                    },
                    "description": "URL to redirect user if they cancel the payment",
                    "displayName": "Cancel URL",
                    "displayType": "text",
                    "placeholder": "https://example.com/cancel"
                },
                "name": "cancel_url"
            }
        ]
    },
    "update": {
        "definition": {
            "url": "https://{{secrets.environment}}.paypal.com/v2/checkout/orders/{{parameters.order_id}}",
            "body": "{{parameters.array1}}",
            "method": "PATCH",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Unique PayPal order identifier to update",
                    "displayName": "Order ID",
                    "displayType": "text",
                    "placeholder": "Enter PayPal order ID"
                },
                "name": "order_id"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "The operation to update e.g. replace",
                                "displayName": "Operation",
                                "displayType": "text",
                                "placeholder": "Enter Operation"
                            },
                            "name": "op"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "The name of the path to update e.g. /description",
                                "displayName": "Path",
                                "displayType": "text",
                                "placeholder": "Enter the path which you want to update"
                            },
                            "name": "path"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "The value to update e.g. Blue M",
                                "displayName": "Value",
                                "displayType": "text",
                                "placeholder": "Enter value"
                            },
                            "name": "value"
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": "The Order details to update",
                    "displayName": "Array ",
                    "displayType": "array"
                },
                "name": "array1"
            }
        ]
    },
    "refund_payment": {
