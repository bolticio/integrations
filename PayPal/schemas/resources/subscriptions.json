    "create_plan": {
        "definition": {
            "url": "https://{{secrets.environment}}.paypal.com/v1/billing/plans",
            "body": {
                "name": "{{parameters.plan_name}}",
                "taxes": {
                    "inclusive": false,
                    "percentage": "{{parameters.tax_percentage}}"
                },
                "status": "{{parameters.plan_status}}",
                "product_id": "{{parameters.product_id}}",
                "description": "{{parameters.plan_description}}",
                "billing_cycles": [
                    {
                        "sequence": 1,
                        "frequency": {
                            "interval_unit": "{{parameters.trial_interval_unit}}",
                            "interval_count": "{{parameters.trial_interval_count}}"
                        },
                        "tenure_type": "{{parameters.tenure_type}}",
                        "total_cycles": 1,
                        "pricing_scheme": {
                            "fixed_price": {
                                "value": "{{parameters.trial_price}}",
                                "currency_code": "{{parameters.currency}}"
                            }
                        }
                    },
                    {
                        "sequence": 2,
                        "frequency": {
                            "interval_unit": "{{parameters.interval_unit}}",
                            "interval_count": "{{parameters.interval_count}}"
                        },
                        "tenure_type": "REGULAR",
                        "total_cycles": "{{parameters.total_cycles}}",
                        "pricing_scheme": {
                            "fixed_price": {
                                "value": "{{parameters.price}}",
                                "currency_code": "{{parameters.currency}}"
                            }
                        }
                    }
                ],
                "payment_preferences": {
                    "setup_fee": {
                        "value": "{{parameters.setup_fee}}",
                        "currency_code": "{{parameters.currency}}"
                    },
                    "auto_bill_outstanding": true,
                    "setup_fee_failure_action": "{{parameters.setup_fee_failure_action}}",
                    "payment_failure_threshold": "{{parameters.payment_failure_threshold}}"
                }
            },
            "method": "POST",
            "headers": {
                "Prefer": "return=representation",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
