{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Batch Payout",
                        "value": "payouts.create_batch",
                        "description": "Create a PayPal batch payout to multiple recipients."
                    },
                    {
                        "label": "Get Batch Payout",
                        "value": "payouts.get_batch",
                        "description": "Get details of a PayPal batch payout."
                    },
                    {
                        "label": "Get Payout Item",
                        "value": "payouts.get_item",
                        "description": "Get details of a specific PayPal payout item."
                    },
                    {
                        "label": "Cancel Payout Item",
                        "value": "payouts.cancel_item",
                        "description": "Cancel an unclaimed PayPal payout item."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "payouts",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create_batch": {
        "definition": {
            "url": "https://{{secrets.environment}}.paypal.com/v1/payments/payouts",
            "body": {
                "items": [
                    {
                        "note": "{{parameters.note}}",
                        "amount": {
                            "value": "{{parameters.amount}}",
                            "currency": "{{parameters.currency}}"
                        },
                        "receiver": "{{parameters.receiver_email}}",
                        "recipient_type": "{{parameters.recipient_type}}",
                        "sender_item_id": "{{parameters.sender_item_id}}"
                    }
                ],
                "sender_batch_header": {
                    "email_message": "{{parameters.email_message}}",
                    "email_subject": "{{parameters.email_subject}}",
                    "sender_batch_id": "{{parameters.sender_batch_id}}"
                }
            },
            "method": "POST",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Unique ID for this batch payout",
                    "displayName": "Sender Batch ID",
                    "displayType": "text",
                    "placeholder": "Enter unique batch ID"
                },
                "name": "sender_batch_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Subject for payout notification email",
                    "displayName": "Email Subject",
                    "displayType": "text",
                    "placeholder": "Enter email subject"
                },
                "name": "email_subject"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Message for payout notification email",
                    "displayName": "Email Message",
                    "displayType": "text",
                    "placeholder": "Enter email message"
                },
                "name": "email_message"
            },
            {
                "meta": {
                    "value": "EMAIL",
                    "options": [
                        {
                            "label": "Email",
                            "value": "EMAIL"
                        },
                        {
                            "label": "Phone",
                            "value": "PHONE"
                        },
                        {
                            "label": "PayPal ID",
                            "value": "PAYPAL_ID"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Type of recipient",
                    "displayName": "Recipient Type",
                    "displayType": "select",
                    "placeholder": "Select recipient type"
                },
                "name": "recipient_type"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Amount to payout",
                    "displayName": "Amount",
                    "displayType": "number",
                    "placeholder": "Enter payout amount"
                },
                "name": "amount"
            },
            {
                "meta": {
                    "value": "USD",
                    "options": [
                        {
                            "label": "Australian Dollar (AUD)",
                            "value": "AUD"
                        },
                        {
                            "label": "Brazilian Real (BRL)",
                            "value": "BRL"
                        },
                        {
                            "label": "Canadian Dollar (CAD)",
                            "value": "CAD"
                        },
                        {
                            "label": "Chinese Renmenbi (CNY)",
                            "value": "CNY"
                        },
                        {
                            "label": "Czech Koruna (CZK)",
                            "value": "CZK"
                        },
                        {
                            "label": "Danish Krone (DKK)",
                            "value": "DKK"
                        },
                        {
                            "label": "Euro (EUR)",
                            "value": "EUR"
                        },
                        {
                            "label": "Pound Sterling (GBP)",
                            "value": "GBP"
                        },
                        {
                            "label": "Hong Kong Dollar (HKD)",
                            "value": "HKD"
                        },
                        {
                            "label": "Hungarian Forint (HUF)",
                            "value": "HUF"
                        },
                        {
                            "label": "Israeli New Shekel (ILS)",
                            "value": "ILS"
                        },
                        {
                            "label": "Japanese Yen (JPY)",
                            "value": "JPY"
                        },
                        {
                            "label": "Malaysian Ringgit (MYR)",
                            "value": "MYR"
                        },
                        {
                            "label": "Mexican Peso (MXN)",
                            "value": "MXN"
                        },
                        {
                            "label": "New Zealand Dollar (NZD)",
                            "value": "NZD"
                        },
                        {
                            "label": "Norwegian Krone (NOK)",
                            "value": "NOK"
                        },
                        {
                            "label": "Philippine Peso (PHP)",
                            "value": "PHP"
                        },
                        {
                            "label": "Polish Złoty (PLN)",
                            "value": "PLN"
                        },
                        {
                            "label": "Russian Ruble (RUB)",
                            "value": "RUB"
                        },
                        {
                            "label": "Singapore Dollar (SGD)",
                            "value": "SGD"
                        },
                        {
                            "label": "Swedish Krona (SEK)",
                            "value": "SEK"
                        },
                        {
                            "label": "Swiss Franc (CHF)",
                            "value": "CHF"
                        },
                        {
                            "label": "New Taiwan Dollar (TWD)",
                            "value": "TWD"
                        },
                        {
                            "label": "Thai Baht (THB)",
                            "value": "THB"
                        },
                        {
                            "label": "US Dollar (USD)",
                            "value": "USD"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Currency for the payout",
                    "displayName": "Currency",
                    "displayType": "autocomplete",
                    "placeholder": "Select currency"
                },
                "name": "currency"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Note to recipient",
                    "displayName": "Note",
                    "displayType": "text",
                    "placeholder": "Enter note for recipient"
                },
                "name": "note"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Unique ID for this payout item",
                    "displayName": "Sender Item ID",
                    "displayType": "text",
                    "placeholder": "Enter unique item ID"
                },
                "name": "sender_item_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Email address of the recipient",
                    "displayName": "Receiver Email",
                    "displayType": "text",
                    "placeholder": "Enter recipient email"
                },
                "name": "receiver_email"
            }
        ]
    },
    "cancel_item": {
        "definition": {
            "url": "https://{{secrets.environment}}.paypal.com/v1/payments/payouts-item/{{parameters.payout_item_id}}/cancel",
            "method": "POST",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The payout item ID to cancel",
                    "displayName": "Payout Item ID",
                    "displayType": "text",
                    "placeholder": "Enter payout item ID"
                },
                "name": "payout_item_id"
            }
        ]
    },
    "get_batch": {
        "definition": {
            "url": "https://{{secrets.environment}}.paypal.com/v1/payments/payouts/{{parameters.batch_id}}",
            "method": "GET",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The batch payout ID to retrieve",
                    "displayName": "Batch ID",
                    "displayType": "text",
                    "placeholder": "Enter batch payout ID"
                },
                "name": "batch_id"
            }
        ]
    },
    "get_item": {
        "definition": {
            "url": "https://{{secrets.environment}}.paypal.com/v1/payments/payouts-item/{{parameters.payout_item_id}}",
            "method": "GET",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The payout item ID to retrieve",
                    "displayName": "Payout Item ID",
                    "displayType": "text",
                    "placeholder": "Enter payout item ID"
                },
                "name": "payout_item_id"
            }
        ]
    }
}
