{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Contact",
                        "value": "contacts.create_contact",
                        "description": "Create contact of specific user"
                    },
                    {
                        "label": "Update Contact",
                        "value": "contacts.update_contact",
                        "description": "Update contact of specific user"
                    },
                    {
                        "label": "Find Contact",
                        "value": "contacts.find_contact",
                        "description": "Find contact of specific user"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "contacts",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "loadContacts": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/contacts",
            "method": "get",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error.code}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.value}}"
            }
        }
    },
    "create_contact": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/contacts",
            "body": {
                "surname": "{{parameters.surname}}",
                "jobTitle": "{{parameters.jobTitle}}",
                "givenName": "{{parameters.givenName}}",
                "department": "{{parameters.department}}",
                "companyName": "{{parameters.companyName}}",
                "mobilePhone": "{{parameters.mobilePhone}}",
                "emailAddresses": [
                    {
                        "name": "{{parameters.fullName}}",
                        "address": "{{parameters.email}}"
                    }
                ],
                "officeLocation": "{{parameters.officeLocation}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error.code}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const c=v=>{if(v===undefined||v===null)return'';if(typeof v==='number')return v.toString();if(typeof v==='string'&&v.startsWith('{{'))return'';return v;};body.givenName=c(body.givenName);body.surname=c(body.surname);const e=c(body.emailAddresses?.[0]?.address);const n=c(body.emailAddresses?.[0]?.name);body.emailAddresses=n?[{address:e,name:n}]:[{address:e}];body.mobilePhone=c(body.mobilePhone);body.jobTitle=c(body.jobTitle);body.companyName=c(body.companyName);body.department=c(body.department);body.officeLocation=c(body.officeLocation);return body;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Given name of the contact",
                    "displayName": "First Name",
                    "displayType": "text",
                    "placeholder": "Enter first name"
                },
                "name": "givenName"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Surname of the contact",
                    "displayName": "Last Name",
                    "displayType": "text",
                    "placeholder": "Enter last name"
                },
                "name": "surname"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Full name for the email address",
                    "displayName": "Full Name",
                    "displayType": "text",
                    "placeholder": "Enter full name"
                },
                "name": "fullName"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
                        "required": true
                    },
                    "description": "Email address of the contact",
                    "displayName": "Email Address",
                    "displayType": "email",
                    "placeholder": "Enter email"
                },
                "name": "email"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Mobile phone number",
                    "displayName": "Mobile Phone",
                    "displayType": "number",
                    "placeholder": "Enter mobile number"
                },
                "name": "mobilePhone"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Job title of the contact",
                    "displayName": "Job Title",
                    "displayType": "text",
                    "placeholder": "Enter job title"
                },
                "name": "jobTitle"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Company of the contact",
                    "displayName": "Company Name",
                    "displayType": "text",
                    "placeholder": "Enter company name"
                },
                "name": "companyName"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Department of the contact",
                    "displayName": "Department",
                    "displayType": "text",
                    "placeholder": "Enter department"
                },
                "name": "department"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Office location of the contact",
                    "displayName": "Office Location",
                    "displayType": "text",
                    "placeholder": "Enter office location"
                },
                "name": "officeLocation"
            }
        ]
    },
    "update_contact": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/contacts/{{parameters.contact_id}}",
            "body": {
                "surname": "{{parameters.surname}}",
                "jobTitle": "{{parameters.jobTitle}}",
                "givenName": "{{parameters.givenName}}",
                "department": "{{parameters.department}}",
                "companyName": "{{parameters.companyName}}",
                "mobilePhone": "{{parameters.mobilePhone}}",
                "emailAddresses": [
                    {
                        "name": "{{parameters.fullName}}",
                        "address": "{{parameters.emailAddress}}"
                    }
                ],
                "officeLocation": "{{parameters.officeLocation}}"
            },
            "method": "patch",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error.code}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const c=v=>{if(v===undefined||v===null)return'';if(typeof v==='number')return v.toString();if(typeof v==='string'&&v.startsWith('{{'))return'';return v;};body.givenName=c(body.givenName);body.surname=c(body.surname);const e=c(body.emailAddresses?.[0]?.address);const n=c(body.emailAddresses?.[0]?.name);body.emailAddresses=n?[{address:e,name:n}]:[{address:e}];body.mobilePhone=c(body.mobilePhone);body.jobTitle=c(body.jobTitle);body.companyName=c(body.companyName);body.department=c(body.department);body.officeLocation=c(body.officeLocation);return body;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "microsoft_outlook",
                            "secret": "{{parameters.secret}}",
                            "resource": "contacts",
                            "operation": "contacts.update_contact",
                            "loadOptionsMethod": "loadContacts"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select a contact to update",
                    "displayName": "Contact Name",
                    "displayType": "autocomplete",
                    "placeholder": "Select a contact"
                },
                "name": "contact_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "First name of the contact",
                    "displayName": "First Name",
                    "displayType": "text",
                    "placeholder": "Enter first name"
                },
                "name": "givenName"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Last name of the contact",
                    "displayName": "Last Name",
                    "displayType": "text",
                    "placeholder": "Enter last name"
                },
                "name": "surname"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Full name of the contact",
                    "displayName": "Full Name",
                    "displayType": "text",
                    "placeholder": "Enter full name"
                },
                "name": "fullName"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
                        "required": false
                    },
                    "description": "Primary email of the contact",
                    "displayName": "Email Address",
                    "displayType": "email",
                    "placeholder": "Enter email address"
                },
                "name": "emailAddress"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Mobile phone number of the contact",
                    "displayName": "Mobile Phone",
                    "displayType": "number",
                    "placeholder": "Enter mobile phone number"
                },
                "name": "mobilePhone"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Job title of the contact",
                    "displayName": "Job Title",
                    "displayType": "text",
                    "placeholder": "Enter job title"
                },
                "name": "jobTitle"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Company name of the contact",
                    "displayName": "Company Name",
                    "displayType": "text",
                    "placeholder": "Enter company name"
                },
                "name": "companyName"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Department of the contact",
                    "displayName": "Department",
                    "displayType": "text",
                    "placeholder": "Enter department"
                },
                "name": "department"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Office location of the contact",
                    "displayName": "Office Location",
                    "displayType": "text",
                    "placeholder": "Enter office location"
                },
                "name": "officeLocation"
            }
        ]
    },
    "find_contact": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/contacts?$search=\"{{parameters.searchQuery}}\"",
            "method": "get",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}",
                "ConsistencyLevel": "eventual"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error.code}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.value}}"
            },
            "transform": {
                "body": "return body;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter any contact information (name, email, phone, etc.)",
                    "displayName": "Search Contact",
                    "displayType": "text",
                    "placeholder": "Search using any contact detail"
                },
                "name": "searchQuery"
            }
        ]
    }
}
