{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Send Mail",
                        "value": "mail.send_mail",
                        "description": "Send mail to specific user"
                    },
                    {
                        "label": "Find Mail",
                        "value": "mail.find_mail",
                        "description": "Find mail of specific user"
                    },
                    {
                        "label": "Reply To a Mail",
                        "value": "mail.reply_mail",
                        "description": "Reply to a mail"
                    },
                    {
                        "label": "Create a Draft Mail",
                        "value": "mail.create_draft_mail",
                        "description": "Create a draft mail"
                    },
                    {
                        "label": "Send Created Draft Mail",
                        "value": "mail.send_draft_mail",
                        "description": "Send already created draft mail"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "mail",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "loadMessages": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/messages?$top=50",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error.code}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.value}}"
            }
        }
    },
    "loadDraftMessages": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/mailFolders/drafts/messages",
            "method": "get",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error.code}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.value}}"
            },
            "transform": {}
        }
    },
    "send_mail": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/sendMail",
            "body": {
                "message": {
                    "body": {
                        "content": "{{parameters.content}}",
                        "contentType": "Text"
                    },
                    "subject": "{{parameters.subject}}",
                    "ccRecipients": [
                        {
                            "emailAddress": {
                                "address": "{{parameters.ccRecipients_address}}"
                            }
                        }
                    ],
                    "toRecipients": [
                        {
                            "emailAddress": {
                                "address": "{{parameters.recipients_address}}"
                            }
                        }
                    ]
                },
                "saveToSentItems": "true"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.status}}"
            },
            "transform": {
                "body": "const toList=body.message.toRecipients[0].emailAddress.address.split(',').map(addr=>({emailAddress:{address:addr.trim()}})).filter(r=>r.emailAddress.address);const ccRaw=body.message.ccRecipients?.[0]?.emailAddress?.address||'';const ccList=ccRaw?ccRaw.split(',').map(addr=>({emailAddress:{address:addr.trim()}})).filter(r=>r.emailAddress.address):[];body.message.toRecipients=toList;if(ccList.length>0){body.message.ccRecipients=ccList;}else{delete body.message.ccRecipients;}return body;",
                "output": "return { message: 'Mail Sent successfully' };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the subject of the mail you want to send.",
                    "displayName": "Subject",
                    "displayType": "text",
                    "placeholder": "Enter the subject of mail"
                },
                "name": "subject"
            },
            {
                "meta": {
                    "htmlProps": {
                        "maxRows": 4,
                        "minRows": 4
                    },
                    "validation": {
                        "required": true,
                        "maxLength": 300,
                        "minLength": 10,
                        "requiredDetail": {
                            "errorMsg": "Content of Mail is required"
                        }
                    },
                    "description": "Enter the content of the mail you want to send.",
                    "displayName": "Content of Mail",
                    "displayType": "textarea",
                    "placeholder": "Enter the Content of mail here"
                },
                "name": "content"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
                        "required": true
                    },
                    "description": "Enter the address of the recipient you want to share mail with.",
                    "displayName": "Recipients Address",
                    "displayType": "email",
                    "placeholder": "Enter the recipients address"
                },
                "name": "recipients_address"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
                        "required": false
                    },
                    "description": "Provide the email address of the recipient to be added to CC.",
                    "displayName": "Cc",
                    "displayType": "email",
                    "placeholder": "Enter the Cc address"
                },
                "name": "ccRecipients_address"
            }
        ]
    },
    "find_mail": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/messages?$search=\"{{parameters.search_query}}\"",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}",
                "ConsistencyLevel": "eventual"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.value}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Search term to find emails (matches subject, body, from, etc.)",
                    "displayName": "Search Query",
                    "displayType": "text",
                    "placeholder": "Enter search text like subject, body or from"
                },
                "name": "search_query"
            }
        ]
    },
    "reply_mail": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/messages/{{parameters.message_id}}/reply",
            "body": {
                "comment": "{{parameters.comment}}",
                "recipients_address": "{{parameters.recipients_address}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error.code}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const toList = body.recipients_address ? body.recipients_address.split(',').map(addr=>({emailAddress:{address:addr.trim()}})).filter(r=>r.emailAddress.address):[]; return toList.length>0 ? {comment: body.comment, message: {toRecipients: toList}} : {comment: body.comment};",
                "output": "return { message: 'Mail Replied Successfully' };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "microsoft_outlook",
                            "secret": "{{parameters.secret}}",
                            "resource": "mail",
                            "operation": "mail.reply_mail",
                            "loadOptionsMethod": "loadMessages"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "subject",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Choose a message To Reply",
                    "displayName": "Reply To Mail",
                    "displayType": "autocomplete",
                    "placeholder": "Select a message by Subject"
                },
                "name": "message_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The comment you want to add in your reply.",
                    "displayName": "Reply Comment",
                    "displayType": "textarea",
                    "placeholder": "Enter your reply text here"
                },
                "name": "comment"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
                        "required": false
                    },
                    "description": "Override recipients for the reply. If left blank, the original sender(s) will be used.",
                    "displayName": "Recipients Address",
                    "displayType": "email",
                    "placeholder": "Enter recipients for reply (comma separated)"
                },
                "name": "recipients_address"
            }
        ]
    },
    "create_draft_mail": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/messages",
            "body": {
                "body": {
                    "content": "{{parameters.content}}",
                    "contentType": "HTML"
                },
                "subject": "{{parameters.subject}}",
                "ccRecipients": [
                    {
                        "emailAddress": {
                            "address": "{{parameters.ccRecipients_address}}"
                        }
                    }
                ],
                "toRecipients": [
                    {
                        "emailAddress": {
                            "address": "{{parameters.recipients_address}}"
                        }
                    }
                ]
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error.code}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const toList=body.toRecipients[0].emailAddress.address.split(',').map(addr=>({emailAddress:{address:addr.trim()}})).filter(r=>r.emailAddress.address);const ccRaw=body.ccRecipients?.[0]?.emailAddress?.address||'';const ccList=ccRaw?ccRaw.split(',').map(addr=>({emailAddress:{address:addr.trim()}})).filter(r=>r.emailAddress.address):[];body.toRecipients=toList;if(ccList.length>0){body.ccRecipients=ccList;}else{delete body.ccRecipients;}return body;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Subject of the draft email",
                    "displayName": "Draft Mail Subject",
                    "displayType": "text",
                    "placeholder": "Enter draft subject"
                },
                "name": "subject"
            },
            {
                "meta": {
                    "htmlProps": {
                        "maxRows": 6,
                        "minRows": 4
                    },
                    "validation": {
                        "required": true,
                        "minLength": 5
                    },
                    "description": "The body content of the draft email",
                    "displayName": "Draft Content",
                    "displayType": "textarea",
                    "placeholder": "Enter the content of draft"
                },
                "name": "content"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "To whom the draft mail is addressed",
                    "displayName": "Recipients Address",
                    "displayType": "text",
                    "placeholder": "Enter recipients (comma separated)"
                },
                "name": "recipients_address"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Optional CC recipients for the draft",
                    "displayName": "CC Recipients Address",
                    "displayType": "text",
                    "placeholder": "Enter CC addresses (comma separated)"
                },
                "name": "Cc"
            }
        ]
    },
    "send_draft_mail": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/messages/{{parameters.draft_id}}/send",
            "body": {},
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "output": "return { message: 'Mail Sent successfully' };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "microsoft_outlook",
                            "secret": "{{parameters.secret}}",
                            "resource": "mail",
                            "operation": "mail.send_draft_mail",
                            "loadOptionsMethod": "loadDraftMessages"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "subject",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Choose a Draft message To send",
                    "displayName": "Draft message to send",
                    "displayType": "autocomplete",
                    "placeholder": "Select a Draft message by Subject",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "mail.send_draft_mail",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "draft_id"
            }
        ]
    }
}
