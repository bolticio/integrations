    "loadCalendars": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/calendars",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message || response.data || 'Unknown error'}}"
                },
                "output": "{{response.data.value}}"
            }
        }
    },
    "create_event": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/calendars/{{parameters.calendar_id}}/events",
            "body": {
                "end": {
                    "dateTime": "{{parameters.endDateTime}}",
                    "timeZone": "{{parameters.timeZone}}"
                },
                "body": {
                    "content": "{{parameters.content}}",
                    "contentType": "HTML"
                },
                "start": {
                    "dateTime": "{{parameters.startDateTime}}",
                    "timeZone": "{{parameters.timeZone}}"
                },
                "subject": "{{parameters.subject}}",
                "location": {
                    "displayName": "{{parameters.location}}"
                },
                "attendees": "{{parameters.attendees}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error.code}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "if (body.attendees) {\n  let attendees = [];\n  let parts = body.attendees.split('/').map(p => p.trim()).filter(p => p);\n  attendees = parts.map(p => {\n    let [email, name] = p.split(',').map(x => x.trim());\n    return {\n      emailAddress: {\n        address: email || '',\n        name: name || ''\n      },\n      type: 'required'\n    };\n  }).filter(a => a.emailAddress.address);\n  body.attendees = attendees;\n}\nreturn body;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "microsoft_outlook",
                            "secret": "{{parameters.secret}}",
                            "resource": "calendar",
                            "operation": "calendar.create_event",
                            "loadOptionsMethod": "loadCalendars"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Choose a Microsoft Outlook calendar to create the event in",
                    "displayName": "Calendar",
                    "displayType": "autocomplete",
                    "placeholder": "Select a calendar"
                },
                "name": "calendar_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Title of the event",
                    "displayName": "Title",
                    "displayType": "text",
                    "placeholder": "Enter event title"
                },
                "name": "subject"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Description of the event",
                    "displayName": "Content",
                    "displayType": "textarea",
                    "placeholder": "Enter event description"
                },
                "name": "content"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Please enter date and start time",
                    "displayName": "Enter Date And Start Time",
                    "displayType": "datetime",
                    "placeholder": "Please enter date and start time"
                },
                "name": "startDateTime"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Please enter date and end time",
                    "displayName": "Enter Date And End Time",
                    "displayType": "datetime",
                    "placeholder": "Please enter date and end time"
                },
                "name": "endDateTime"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Time zone of the event",
                    "displayName": "Time Zone",
                    "displayType": "text",
                    "placeholder": "e.g. India Standard Time"
                },
                "name": "timeZone"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Location of the event",
                    "displayName": "Location",
                    "displayType": "text",
                    "placeholder": "Enter location"
                },
                "name": "location"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Insert Attendees With Mail and Name",
                    "displayName": "Attendees",
                    "displayType": "textarea",
                    "placeholder": "e.g. 'john@example.com,John Doe / jane@example.com,Jane Smith' "
                },
                "name": "attendees"
            }
        ]
    },
