{
    "loadEvents": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/calendars/{{parameters.calendar_id}}/events",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message || response.data || 'Unknown error'}}"
                },
                "output": "{{response.data.value}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Event",
                        "value": "calendar.create_event",
                        "description": "Create an event in a specific calendar"
                    },
                    {
                        "label": "Update Event",
                        "value": "calendar.update_event",
                        "description": "Update an event in a specific calendar"
                    },
                    {
                        "label": "Add Attendees",
                        "value": "calendar.add_Attendees",
                        "description": "Update an event Attendees in a specific calendar"
                    },
                    {
                        "label": "Delete Event",
                        "value": "calendar.delete_event",
                        "description": "Delete an event in a specific calendar"
                    },
                    {
                        "label": "Find Event",
                        "value": "calendar.find_event",
                        "description": "Find an event in a specific calendar"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "calendar",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
