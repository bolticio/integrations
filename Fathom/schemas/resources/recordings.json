{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get Summary",
                        "value": "recordings.getSummary",
                        "description": "Retrieve the summary for a meeting recording."
                    },
                    {
                        "label": "Get Transcript",
                        "value": "recordings.getTranscript",
                        "description": "Retrieve the transcript for a meeting recording."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "recordings",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getMeetingDetails": {
        "definition": {
            "url": "https://api.fathom.ai/external/v1/meetings",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.items}}"
            }
        }
    },
    "gettranscript": {
        "definition": {
            "url": "https://api.fathom.ai/external/v1/recordings/{{parameters.recording_id}}/transcript",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "url": "return `https://api.fathom.ai/external/v1/recordings/{{parameters.recording_id}}`.replace(/\\s+/g, '') + '/transcript';",
                "error": "if (error.code === 404 || error.code === 401) { return { message: 'Provide a valid meeting ID.', code: 404 }; } return error;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "fathom",
                            "secret": "{{parameters.secret}}",
                            "resource": "recordings",
                            "operation": "recordings.getTranscript",
                            "loadOptionsMethod": "getMeetingDetails"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "title",
                        "valueKey": "recording_id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the meeting to get the transcript. For dynamic input enter meeting ID.",
                    "displayName": "Meeting",
                    "displayType": "autocomplete",
                    "placeholder": "Select a meeting"
                },
                "name": "recording_id"
            }
        ]
    },
    "getsummary": {
        "definition": {
            "url": "https://api.fathom.ai/external/v1/recordings/{{parameters.recording_id}}/summary",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "url": "return `https://api.fathom.ai/external/v1/recordings/{{parameters.recording_id}}`.replace(/\\s+/g, '') + '/summary';",
                "error": "if (error.code === 404 || error.code === 401) { return { message: 'Provide a valid meeting ID.', code: 404 }; } return error;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "fathom",
                            "secret": "{{parameters.secret}}",
                            "resource": "recordings",
                            "operation": "recordings.getSummary",
                            "loadOptionsMethod": "getMeetingDetails"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "title",
                        "valueKey": "recording_id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the meeting to get the summary. For dynamic input enter meeting ID.",
                    "displayName": "Meeting",
                    "displayType": "autocomplete",
                    "placeholder": "Select a meeting"
                },
                "name": "recording_id"
            }
        ]
    }
}
