{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Share Snapshot via Email",
                        "value": "snapshots.share_snapshot_via_email",
                        "description": "Create a dashboard snapshot job and notify recipients via email."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operations",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": [
                    {
                        "field": "resource",
                        "value": "snapshots",
                        "operator": "EQUALS"
                    }
                ]
            },
            "name": "operation"
        }
    ],
    "share_snapshot_via_email": {
        "definition": {
            "url": "https://api.intelligence.fynd.com/service/panel/snapshots/v1.0/snapshot/jobs",
            "body": {
                "companyId": "{{secrets.company_id}}",
                "dashboardId": "{{parameters.dashboard_id}}",
                "notification": {
                    "type": "email",
                    "email": "{{parameters.notification_email_id}}"
                }
            },
            "method": "POST",
            "headers": {
                "Content-Type": "application/json",
                "x-product-line": "{{parameters.product_line}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": "COMMERCE",
                    "options": [
                        {
                            "label": "Fynd Commerce",
                            "value": "COMMERCE",
                            "description": "Snapshots related to Fynd Commerce"
                        }
                    ],
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Product Line is required"
                        }
                    },
                    "description": "Product line for snapshot generation.",
                    "displayName": "Product Line",
                    "displayType": "select",
                    "placeholder": "Fynd Commerce"
                },
                "name": "product_line"
            },
            {
                "meta": {
                    "value": "fc-company-dashboard",
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Dashboard ID is required"
                        }
                    },
                    "description": "Dashboard identifier to capture snapshot for.",
                    "displayName": "Dashboard ID",
                    "displayType": "text",
                    "placeholder": "Enter dashboard ID (e.g., fc-company-dashboard)"
                },
                "name": "dashboard_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Notification email is required"
                        }
                    },
                    "description": "Single email or comma-separated emails to receive the snapshot notification.",
                    "displayName": "Notification Email(s)",
                    "displayType": "text",
                    "placeholder": "user@example.com or user1@example.com,user2@example.com"
                },
                "name": "notification_email_id"
            }
        ]
    }
}
