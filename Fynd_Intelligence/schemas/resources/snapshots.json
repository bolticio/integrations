{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Share Snapshot via Email",
                        "value": "snapshots.share_snapshot_via_email",
                        "description": "Create a dashboard snapshot job and notify recipients via email."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operations",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": [
                    {
                        "field": "resource",
                        "value": "snapshots",
                        "operator": "EQUALS"
                    }
                ]
            },
            "name": "operation"
        }
    ],
    "getDashboards": {
        "definition": {
            "url": "https://api.intelligence.fynd.com/___/internal/analytics/dashboards",
            "body": {
                "company_id": "{{secrets.company_id}}",
                "product_line": "{{parameters.product_line}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.data.result}}"
            },
            "transform": {
                "body": "const params = {{parameters}}; return { product_line: params.product_line || 'COMMERCE', company_id: Number('{{secrets.company_id}}') };"
            }
        }
    },
    "generate_report": {
        "config": {
            "url": "integrations/parameters",
            "body": {
                "name": "fynd_intelligence_report_scheduler",
                "secret": "{{parameters.secret}}",
                "user_id": "{{parameters.user_id}}",
                "resource": "reports",
                "operation": "reports.generate_report",
                "report_id": "{{parameters.report_id}}",
                "product_line": "{{parameters.product_line}}",
                "loadParametersMethod": "getReportQuestions"
            },
            "method": "post",
            "urlType": "parameters",
            "condition": "{{parameters.report_id}}"
        },
        "definition": {
            "url": "https://api.intelligence.fynd.com/___/internal/analytics/reports/generate",
            "body": {
                "answers": "{{parameters}}",
                "api_key": "{{secrets.api_key}}",
                "user_id": "{{secrets.api_key}}",
                "report_id": "{{parameters.report_id}}",
                "api_secret": "{{secrets.api_secret}}",
                "company_id": "{{secrets.company_id}}",
                "product_line": "{{parameters.product_line}}"
            },
            "method": "POST",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const params = {{parameters}}; const answers = {}; const excludeKeys = ['report_id', 'user_id', 'product_line', 'company_id', 'notification_email_id', 'operation', 'resource', 'secret', 'notification_email_id_hidden', 'time_gap', 'sales_channel_id', '__field_types__']; let typeMapping = {}; try { if (params.__field_types__) { typeMapping = JSON.parse(params.__field_types__); } } catch (e) {} const getType = (key) => { if (typeMapping[key]) return typeMapping[key]; const lowerKey = key.toLowerCase(); if (lowerKey.includes('sales_channel') || lowerKey.includes('saleschannel') || lowerKey.includes('channel_id')) return 'salesChannel'; if (lowerKey.includes('store') || lowerKey.includes('location')) return 'store'; return 'string'; }; for (const key in params) { if (!excludeKeys.includes(key) && params[key] !== undefined && params[key] !== null && params[key] !== '') { const type = getType(key); let value = params[key]; if (type === 'salesChannel') { value = Array.isArray(value) ? value.map(v => String(v)) : [String(value)]; } else if (type === 'store') { value = Array.isArray(value) ? value : [value]; } else { value = String(value); } answers[key] = value; } } answers.notification_email_id = params.notification_email_id || ''; if (params.time_gap) { answers.time_gap = params.time_gap; } return { report_id: params.report_id, user_id: '{{secrets.api_key}}', product_line: params.product_line, company_id: '{{secrets.company_id}}', sales_channel_id: params.sales_channel_id ? [params.sales_channel_id] : [], answers: answers, api_key: '{{secrets.api_key}}', api_secret: '{{secrets.api_secret}}' };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "options": [
                        {
                            "label": "Fynd Commerce",
                            "value": "COMMERCE",
                            "description": "Reports related to Fynd Commerce"
                        },
                        {
                            "label": "Fynd StoreOS",
                            "value": "STOREOS",
                            "description": "Reports related to Fynd StoreOS"
                        },
                        {
                            "label": "Fynd Engage",
                            "value": "ENGAGE",
                            "description": "Reports related to Fynd Engage"
                        },
                        {
                            "label": "Fynd Konnect",
                            "value": "KONNECT",
                            "description": "Reports related to Fynd Konnect"
                        },
                        {
                            "label": "Fynd CommerceB2B",
                            "value": "COMMERCEB2B",
                            "description": "Reports related to Fynd CommerceB2B"
                        }
                    ],
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Product Line is required"
                        }
                    },
                    "description": "Select the product line for which you want to generate reports.",
                    "displayName": "Product Line",
                    "displayType": "select",
                    "placeholder": "Select a product line"
                },
                "name": "product_line"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Email ID is required"
                        }
                    },
                    "description": "Email ID to receive the report notification.",
                    "displayName": "Notification Email ID",
                    "displayType": "text",
                    "placeholder": "Enter email address (e.g., user@example.com)"
                },
                "name": "notification_email_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "secret": "{{parameters.secret}}",
                            "resource": "reports",
                            "operation": "reports.generate_report",
                            "product_line": "{{parameters.product_line}}",
                            "loadOptionsMethod": "getReports"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "title",
                        "valueKey": "id",
                        "condition": "{{parameters.product_line}}"
                    },
                    "options": [],
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Report selection is required"
                        }
                    },
                    "description": "Select a report template to generate. After selection, dynamic fields will appear below based on the report's questions.",
                    "displayName": "Report",
                    "displayType": "autocomplete",
                    "placeholder": "Select a report to load its question fields",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "product_line",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    },
                    "loadDynamicParameters": true
                },
                "name": "report_id"
            }
        ]
    },
    "share_snapshot_via_email": {
        "definition": {
            "url": "https://api.intelligence.fynd.com/service/panel/snapshots/v1.0/snapshot/jobs",
            "body": {
                "companyId": "{{secrets.company_id}}",
                "dashboardId": "{{parameters.dashboard_id}}",
                "notification": {
                    "type": "email",
                    "email": "{{parameters.notification_email_id}}"
                }
            },
            "method": "POST",
            "headers": {
                "Content-Type": "application/json",
                "x-product-line": "{{parameters.product_line}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": "COMMERCE",
                    "options": [
                        {
                            "label": "Fynd Commerce",
                            "value": "COMMERCE",
                            "description": "Snapshots related to Fynd Commerce"
                        }
                    ],
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Product Line is required"
                        }
                    },
                    "description": "Product line for snapshot generation.",
                    "displayName": "Product Line",
                    "displayType": "select",
                    "placeholder": "Fynd Commerce"
                },
                "name": "product_line"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "secret": "{{parameters.secret}}",
                            "resource": "snapshots",
                            "operation": "snapshots.share_snapshot_via_email",
                            "product_line": "{{parameters.product_line}}",
                            "loadOptionsMethod": "getDashboards"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "value"
                    },
                    "options": [],
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Dashboard is required"
                        }
                    },
                    "description": "Select dashboard from the fetched list.",
                    "displayName": "Dashboards",
                    "displayType": "select",
                    "placeholder": "Select dashboard"
                },
                "name": "dashboard_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Notification email is required"
                        }
                    },
                    "description": "Single email or comma-separated emails to receive the snapshot notification.",
                    "displayName": "Notification Email(s)",
                    "displayType": "text",
                    "placeholder": "user@example.com or user1@example.com,user2@example.com"
                },
                "name": "notification_email_id"
            }
        ]
    }
}
