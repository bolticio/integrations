{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Query",
                        "value": "data_analytics.query",
                        "description": "Run a SQL query against analytics data."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operations",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": [
                    {
                        "field": "resource",
                        "value": "data_analytics",
                        "operator": "EQUALS"
                    }
                ]
            },
            "name": "operation"
        }
    ],
    "query": {
        "definition": {
            "url": "https://api.intelligence.fynd.com/___/internal/analytics/query?page_size=200&page_number=1",
            "body": {
                "query": "{{parameters.query}}",
                "user_id": "{{secrets.api_key}}",
                "company_id": "{{secrets.company_id}}"
            },
            "method": "POST",
            "headers": {
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "SQL query is required"
                        }
                    },
                    "description": "Enter the SQL query to run against analytics data.",
                    "displayName": "SQL Query",
                    "displayType": "text",
                    "placeholder": "SELECT * FROM ... LIMIT 10"
                },
                "name": "query"
            }
        ]
    }
}
