                                    }
                                ],
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the gender of the contact.",
                                "displayName": "Gender",
                                "displayType": "select",
                                "placeholder": "Enter the gender"
                            },
                            "name": "gender"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the age of the contact.",
                                "displayName": "Age",
                                "displayType": "number",
                                "placeholder": "Enter the age"
                            },
                            "name": "age"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the birthday of the contact.",
                                "displayName": "Birthday",
                                "displayType": "date",
                                "placeholder": "Enter the birthday"
