{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Add Contact",
                        "value": "contact.create"
                    },
                    {
                        "label": "List Contacts",
                        "value": "contact.list"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "contact",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getTimezone": {
        "definition": {
            "qs": {},
            "url": "https://worldtimeapi.org/api/timezone",
            "method": "get",
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "output": "const result = output.map((timezone) => { return { label: timezone, value: timezone }; }); return result;"
            }
        }
    },
    "create": {
        "definition": {
            "qs": {},
            "url": "https://api.mailmodo.com/api/v1/addToList",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "Accept": "application/json, application/xml",
                "mmApiKey": "{{secrets.api_key}}",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the email for the contact.",
                    "displayName": "Email",
                    "displayType": "text",
                    "placeholder": "Enter the email"
                },
                "name": "email"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the first name for the contact.",
                                "displayName": "First Name",
                                "displayType": "text",
                                "placeholder": "Enter the First Name"
                            },
                            "name": "first_name"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the last name for the contact.",
                                "displayName": "Last Name",
                                "displayType": "text",
                                "placeholder": "Enter the Last Name"
                            },
                            "name": "last_name"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the name for the contact.",
                                "displayName": "Name",
                                "displayType": "text",
                                "placeholder": "Enter the name"
                            },
                            "name": "name"
                        },
                        {
                            "meta": {
                                "htmlProps": {
                                    "disabled": false,
                                    "readOnly": false,
                                    "continents": [
                                        "AF",
                                        "NA",
                                        "EU",
                                        "SA",
                                        "AS",
                                        "OC"
                                    ],
                                    "defaultCountry": "IN",
                                    "preferredCountries": [
                                        "IN"
                                    ]
                                },
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the phone for the contact.",
                                "displayName": "Phone",
                                "displayType": "phone",
                                "placeholder": "Enter the phone"
                            },
                            "name": "phone"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "Enter the first line of the address for the contact.",
                                "displayName": "Address Line 1",
                                "displayType": "text",
                                "placeholder": "Enter the first line of the address"
                            },
                            "name": "address1"
                        },
                        {
                            "meta": {
                                "validation": {
