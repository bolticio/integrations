                                "placeholder": "Enter the anniversary date"
                            },
                            "name": "anniversary_date"
                        }
                    ],
                    "displayName": "Data",
                    "displayType": "object"
                },
                "name": "data"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "mailmodo",
                            "secret": "{{parameters.secret}}",
                            "resource": "contact",
                            "operation": "contact.create",
                            "loadOptionsMethod": "getTimezone"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "label",
                        "valueKey": "value"
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Enter the timezone for the contact eg.Africa/Abidjan.",
                    "displayName": "Timezone",
                    "displayType": "select",
                    "placeholder": "Enter the timezone"
                },
                "name": "timezone"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the List Name of the contact.",
                    "displayName": "List Name",
                    "displayType": "text",
                    "placeholder": "Enter the List Name"
                },
                "name": "listName"
            }
        ]
    },
    "list": {
        "definition": {
            "qs": {},
            "url": "https://api.mailmodo.com/api/v1/getAllContactLists",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "mmApiKey": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    }
}
