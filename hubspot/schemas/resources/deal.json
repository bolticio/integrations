                    "displayName": "Deal ID",
                    "displayType": "text",
                    "placeholder": "Enter the deal ID"
                },
                "name": "deal_id"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://api.hubapi.com/crm/v3/objects/deals/{{parameters.deal_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
