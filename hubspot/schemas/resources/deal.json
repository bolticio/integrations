                    "displayName": "Deal ID",
                    "displayType": "text",
                    "placeholder": "Enter the deal ID"
                },
                "name": "deal_id"
            }
        ]
    },
    "update": {
        "config": {
            "url": "integrations/parameters",
            "body": {
                "secret": "{{parameters.secret}}",
                "resource": "deal",
                "loadParametersMethod": "getMoreParameters"
            },
            "method": "post",
            "urlType": "parameters"
        },
