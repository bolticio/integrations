{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get Owner by ID",
                        "value": "owners.get_owner_by_id",
                        "description": "Retrieves the details of a specific owner (HubSpot user) from HubSpot using their unique Owner ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "owners",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "get_owner_by_id": {
        "definition": {
            "url": "https://api.hubapi.com/crm/v3/owners/{{parameters.ownerid}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "min": 1,
                        "required": true
                    },
                    "description": "The unique ID of the owner to retrieve.",
                    "displayName": "Owner ID",
                    "displayType": "text",
                    "placeholder": "Enter owner ID"
                },
                "name": "ownerid"
            }
        ]
    }
}
