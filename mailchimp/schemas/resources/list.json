{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Search Lists",
                        "value": "list.search"
                    },
                    {
                        "label": "Get List",
                        "value": "list.get"
                    },
                    {
                        "label": "Create List",
                        "value": "list.create"
                    },
                    {
                        "label": "Update List",
                        "value": "list.update"
                    },
                    {
                        "label": "Delete List",
                        "value": "list.delete"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "list",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "get": {
        "definition": {
            "url": "https://{{secrets.data_center}}.api.mailchimp.com/3.0/lists/{{parameters.list_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique id for the list.",
                    "displayName": "List ID",
                    "displayType": "text",
                    "placeholder": "Enter the List ID"
                },
                "name": "list_id"
            }
        ]
    },
    "search": {
        "definition": {
            "qs": {
                "query": "{{parameters.query}}"
            },
            "url": "https://{{secrets.data_center}}.api.mailchimp.com/3.0/lists",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "description": "The search query to find lists.",
                    "displayName": "Search Query",
                    "displayType": "text",
                    "placeholder": "Enter search query"
                },
                "name": "query"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://{{secrets.data_center}}.api.mailchimp.com/3.0/lists",
            "body": {
                "name": "{{parameters.name}}",
                "contact": {
                    "zip": "{{parameters.contact_zip}}",
                    "city": "{{parameters.contact_city}}",
                    "state": "{{parameters.contact_state}}",
                    "company": "{{parameters.contact_company}}",
                    "country": "{{parameters.contact_country}}",
                    "address1": "{{parameters.contact_address1}}"
                },
                "campaign_defaults": {
                    "subject": "{{parameters.campaign_defaults_subject}}",
                    "language": "{{parameters.campaign_defaults_language}}",
                    "from_name": "{{parameters.campaign_defaults_from_name}}",
                    "from_email": "{{parameters.campaign_defaults_from_email}}"
                },
                "email_type_option": true,
                "permission_reminder": "{{parameters.permission_reminder.default}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the list.",
                    "displayName": "List Name",
                    "displayType": "text",
                    "placeholder": "Enter the list name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "description": "The company for the list.",
                    "displayName": "Company",
                    "displayType": "text",
                    "placeholder": "Enter the company"
                },
                "name": "contact_company"
            },
            {
                "meta": {
                    "description": "The first line of the address for the list.",
                    "displayName": "Address Line 1",
                    "displayType": "text",
                    "placeholder": "Enter address line 1"
                },
                "name": "contact_address1"
            },
            {
                "meta": {
                    "description": "The city for the list.",
                    "displayName": "City",
                    "displayType": "text",
                    "placeholder": "Enter the city"
                },
                "name": "contact_city"
            },
            {
                "meta": {
                    "description": "The state for the list.",
                    "displayName": "State",
                    "displayType": "text",
                    "placeholder": "Enter the state"
                },
                "name": "contact_state"
            },
            {
                "meta": {
                    "description": "The ZIP code for the list.",
                    "displayName": "ZIP Code",
                    "displayType": "text",
                    "placeholder": "Enter the ZIP code"
                },
                "name": "contact_zip"
            },
            {
                "meta": {
                    "description": "The country for the list.",
                    "displayName": "Country",
                    "displayType": "text",
                    "placeholder": "Enter the country"
                },
                "name": "contact_country"
            },
            {
                "meta": {
                    "default": "You are receiving this email because you signed up for updates on our website.",
                    "description": "The permission reminder for the list.",
                    "displayName": "Permission Reminder",
                    "displayType": "text",
                    "placeholder": "Enter the permission reminder"
                },
                "name": "permission_reminder"
            },
            {
                "meta": {
                    "description": "The default from name for campaigns.",
                    "displayName": "From Name",
                    "displayType": "text",
                    "placeholder": "Enter the from name"
                },
                "name": "campaign_defaults_from_name"
            },
            {
                "meta": {
                    "description": "The default from email for campaigns.",
                    "displayName": "From Email",
                    "displayType": "text",
                    "placeholder": "Enter the from email"
                },
                "name": "campaign_defaults_from_email"
            },
            {
                "meta": {
                    "description": "The default subject for campaigns.",
                    "displayName": "Subject",
                    "displayType": "text",
                    "placeholder": "Enter the subject"
                },
                "name": "campaign_defaults_subject"
            },
            {
                "meta": {
                    "description": "The default language for campaigns.",
                    "displayName": "Language",
                    "displayType": "text",
                    "placeholder": "Enter the language"
                },
                "name": "campaign_defaults_language"
            }
        ]
    },
    "update": {
        "definition": {
            "url": "https://{{secrets.data_center}}.api.mailchimp.com/3.0/lists/{{parameters.list_id}}",
            "body": {
                "name": "{{parameters.name}}"
            },
            "method": "patch",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique id for the list.",
                    "displayName": "List ID",
                    "displayType": "text",
                    "placeholder": "Enter the List ID"
                },
                "name": "list_id"
            },
            {
                "meta": {
                    "description": "The new name of the list.",
                    "displayName": "List Name",
                    "displayType": "text",
                    "placeholder": "Enter the new list name"
                },
                "name": "name"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://{{secrets.data_center}}.api.mailchimp.com/3.0/lists/{{parameters.list_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique id for the list.",
                    "displayName": "List ID",
                    "displayType": "text",
                    "placeholder": "Enter the List ID"
                },
                "name": "list_id"
            }
        ]
    }
}
