{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get user profile",
                        "value": "user.get_user_profile",
                        "description": "Retrieve the display name, user ID, and profile picture of a LINE user."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to performs.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation"
            },
            "name": "operation"
        }
    ],
    "get_user_profile": {
        "definition": {
            "url": "https://api.line.me/v2/bot/profile/{{parameters.userId}}",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.api_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The LINE user ID to retrieve profile information for.",
                    "displayName": "User ID",
                    "displayType": "text",
                    "placeholder": "Enter LINE user ID",
                    "requiredDetail": {
                        "errorMsg": "Location title is required."
                    }
                },
                "name": "userId"
            }
        ]
    }
}
