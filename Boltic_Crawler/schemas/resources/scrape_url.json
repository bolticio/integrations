{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Scrape URL",
                        "value": "scrape_url.scrape",
                        "description": "Scrape content from a single URL."
                    },
                    {
                        "label": "Batch Scrape",
                        "value": "scrape_url.batch_scrape",
                        "description": "Scrape content from multiple URLs in batch."
                    },
                    {
                        "label": "Batch Scrape Status",
                        "value": "scrape_url.scrape_status",
                        "description": "Check the status of a batch scrape job."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "scrape_url",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "batch_scrape": {
        "definition": {
            "url": "https://api.firecrawl.dev/v1/batch/scrape",
            "body": {
                "urls": "{{parameters.urls}}",
                "formats": "{{parameters.formats}}",
                "timeout": "{{parameters.timeout}}",
                "parsePDF": "{{parameters.parsePDF}}",
                "onlyMainContent": "{{parameters.onlyMainContent}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "URLs is required field"
                        }
                    },
                    "description": "Enter the URLs you want to batch scrape.",
                    "displayName": "URLs",
                    "displayType": "multitext",
                    "placeholder": "Enter the URLs"
                },
                "name": "urls"
            },
            {
                "meta": {
                    "value": [
                        "markdown"
                    ],
                    "options": [
                        {
                            "label": "Markdown",
                            "value": "markdown"
                        },
                        {
                            "label": "HTML",
                            "value": "html"
                        },
                        {
                            "label": "Raw HTML",
                            "value": "rawHtml"
                        },
                        {
                            "label": "Screenshot",
                            "value": "screenshot"
                        },
                        {
                            "label": "Links",
                            "value": "links"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Output Formats is required field"
                        }
                    },
                    "description": "Choose one or more output formats (e.g., markdown, html, screenshot, links, rawHtml).",
                    "displayName": "Output Formats",
                    "displayType": "multiselect",
                    "placeholder": "Select output formats"
                },
                "name": "formats"
            },
            {
                "meta": {
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Only Main Content is required field"
                        }
                    },
                    "description": "Return only the main content of the page (excluding headers, nav, footers, etc.).",
                    "displayName": "Only Main Content",
                    "displayType": "toggle",
                    "placeholder": "Enter Only Main Content"
                },
                "name": "onlyMainContent"
            },
            {
                "meta": {
                    "value": 30000,
                    "validation": {
                        "min": 1000,
                        "required": false
                    },
                    "description": "Maximum duration in milliseconds to wait for the page to respond.",
                    "displayName": "Timeout (ms)",
                    "displayType": "number",
                    "placeholder": "Enter Timeout"
                },
                "name": "timeout"
            },
            {
                "meta": {
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Extract and convert PDF content to markdown.",
                    "displayName": "Parse PDF",
                    "displayType": "toggle",
                    "placeholder": "Enter Parse PDF"
                },
                "name": "parsePDF"
            }
        ]
    },
    "scrape_status": {
        "definition": {
            "url": "https://api.firecrawl.dev/v1/batch/scrape/{{parameters.batch_id}}",
            "method": "get",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "Invalid Scrape ID, connect with support@boltic.io"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Batch Scrape ID is required field"
                        }
                    },
                    "description": "The ID of the Batch Scrape job to check status for.",
                    "displayName": "Batch Scrape ID",
                    "displayType": "text",
                    "placeholder": "Enter Batch Scrape ID"
                },
                "name": "batch_id"
            }
        ]
    },
    "scrape": {
        "definition": {
            "url": "https://api.firecrawl.dev/v1/scrape",
            "body": {
                "url": "{{parameters.url}}",
                "formats": "{{parameters.formats}}",
                "timeout": "{{parameters.timeout}}",
                "parsePDF": "{{parameters.parsePDF}}",
                "onlyMainContent": "{{parameters.onlyMainContent}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "URL is required field"
                        }
                    },
                    "description": "Enter the URL you want to scrape.",
                    "displayName": "URL",
                    "displayType": "url",
                    "placeholder": "Enter the URL"
                },
                "name": "url"
            },
            {
                "meta": {
                    "value": [
                        "markdown"
                    ],
                    "options": [
                        {
                            "label": "Markdown",
                            "value": "markdown"
                        },
                        {
                            "label": "HTML",
                            "value": "html"
                        },
                        {
                            "label": "Raw HTML",
                            "value": "rawHtml"
                        },
                        {
                            "label": "Screenshot",
                            "value": "screenshot"
                        },
                        {
                            "label": "Links",
                            "value": "links"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Output Formats is required field"
                        }
                    },
                    "description": "Choose one or more output formats (e.g., markdown, html, screenshot, links, rawHtml).",
                    "displayName": "Output Formats",
                    "displayType": "multiselect",
                    "placeholder": "Select output formats"
                },
                "name": "formats"
            },
            {
                "meta": {
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Return only the main content of the page (excluding headers, nav, footers, etc.).",
                    "displayName": "Only Main Content",
                    "displayType": "toggle",
                    "placeholder": "Enter Only Main Content"
                },
                "name": "onlyMainContent"
            },
            {
                "meta": {
                    "value": 30000,
                    "validation": {
                        "min": 1000,
                        "required": false
                    },
                    "description": "Maximum duration in milliseconds to wait for the page to respond.",
                    "displayName": "Timeout (ms)",
                    "displayType": "number",
                    "placeholder": "Enter Timeout"
                },
                "name": "timeout"
            },
            {
                "meta": {
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Extract and convert PDF content to markdown.",
                    "displayName": "Parse PDF",
                    "displayType": "toggle",
                    "placeholder": "Enter Parse PDF"
                },
                "name": "parsePDF"
            }
        ]
    }
}
