{
    "getViews": {
        "definition": {
            "qs": {},
            "url": "https://analyticsapi.zoho.in/restapi/v2/workspaces/{{parameters.workspace_id}}/views",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}",
                "ZANALYTICS-ORGID": "{{parameters.organization_id}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.data.errorCode}}",
                    "status": "{{response.data.status}}",
                    "message": "{{response.data.data.errorMessage || response.data}}",
                    "summary": "{{response.data.summary}}"
                },
                "output": "{{response.data.data.views}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Add Row",
                        "value": "row.create",
                        "description": "Add a new row in the specified Zoho Analytics table."
                    },
                    {
                        "label": "Update Row(s)",
                        "value": "row.update",
                        "description": "Update existing row(s) in the specified Zoho Analytics table."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is required"
                    }
                },
                "description": "Choose the operation you want to perform on rows.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "row",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
