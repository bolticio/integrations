{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Greeting",
                        "value": "greetings.create",
                        "description": "Create a new greeting."
                    },
                    {
                        "label": "List all Greetings",
                        "value": "greetings.list",
                        "description": "List all greetings."
                    },
                    {
                        "label": "Get Greeting Details by ID",
                        "value": "greetings.get",
                        "description": "Get detailed information about all greetings."
                    },
                    {
                        "label": "Update Greeting",
                        "value": "greetings.update",
                        "description": "Update an existing greeting."
                    },
                    {
                        "label": "Delete Greeting",
                        "value": "greetings.delete",
                        "description": "Delete an existing greeting."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": [
                    {
                        "field": "resource",
                        "value": "greetings",
                        "operator": "EQUALS"
                    }
                ]
            },
            "name": "operation"
        }
    ],
    "get": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/greetings/{{parameters.greetings_id}}",
            "body": {
                "data": "{{secrets}}",
                "greetings_id": "{{parameters.greetings_id}}"
            },
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "content-type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.description}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the ID given by the Zendesk of the greetings you want to get details of.",
                    "displayName": "Greetings ID",
                    "displayType": "text",
                    "placeholder": "Enter Greetings ID"
                },
                "name": "greetings_id"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/greetings",
            "body": {
                "data": "{{secrets}}",
                "greeting": {
                    "name": "{{parameters.name}}",
                    "category_id": "{{parameters.category_id}}"
                }
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "content-type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.description}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the Name of the address.",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter the Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "You can enter any Category ID of the greeting.",
                    "displayName": "Category ID",
                    "displayType": "text",
                    "placeholder": "Enter the Category ID"
                },
                "name": "category_id"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/greetings",
            "body": {
                "data": "{{secrets}}"
            },
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "content-type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.description}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    },
    "delete": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/greetings/{{parameters.greetings_id}}",
            "body": {
                "data": "{{secrets}}",
                "greetings_id": "{{parameters.greetings_id}}"
            },
            "method": "delete",
            "headers": {
                "Accept": "application/json",
                "content-type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.description}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the ID given by the Zendesk of the greetings you want to delete.",
                    "displayName": "Greetings ID",
                    "displayType": "text",
                    "placeholder": "Enter Greetings ID"
                },
                "name": "greetings_id"
            }
        ]
    },
    "update": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/greetings/{{parameters.greetings_id}}",
            "body": {
                "data": "{{secrets}}",
                "greeting": {
                    "name": "{{parameters.name}}"
                },
                "greetings_id": "{{parameters.greetings_id}}"
            },
            "method": "put",
            "headers": {
                "Accept": "application/json",
                "content-type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.description}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the Name of the address.",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter the Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the ID given by the Zendesk of the greetings you want to update the details of.",
                    "displayName": "Greetings ID",
                    "displayType": "text",
                    "placeholder": "Enter Greetings ID"
                },
                "name": "greetings_id"
            }
        ]
    }
}
