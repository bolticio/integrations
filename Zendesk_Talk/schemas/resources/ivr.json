{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create IVR",
                        "value": "ivr.create",
                        "description": "Create a new IVR."
                    },
                    {
                        "label": "List all IVRs",
                        "value": "ivr.list",
                        "description": "List all IVRs."
                    },
                    {
                        "label": "Get IVR Details by ID",
                        "value": "ivr.get",
                        "description": "Get detailed information about all IVRs."
                    },
                    {
                        "label": "Update IVR",
                        "value": "ivr.update",
                        "description": "Update an existing IVR."
                    },
                    {
                        "label": "Delete IVR",
                        "value": "ivr.delete",
                        "description": "Delete an existing IVR."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": [
                    {
                        "field": "resource",
                        "value": "ivr",
                        "operator": "EQUALS"
                    }
                ]
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/ivr",
            "body": {
                "ivr": {
                    "name": "{{parameters.name}}"
                },
                "data": "{{secrets}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.description}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the Name of the IVR.",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter the Name"
                },
                "name": "name"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/ivr",
            "body": {
                "data": "{{secrets}}"
            },
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.description}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    },
    "delete": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/ivr/{{parameters.ivr_id}}",
            "body": {
                "data": "{{secrets}}",
                "ivr_id": "{{parameters.ivr_id}}"
            },
            "method": "delete",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.description}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the ID given by Zendesk of the IVR you want to delete.",
                    "displayName": "IVR ID",
                    "displayType": "text",
                    "placeholder": "Enter IVR ID"
                },
                "name": "ivr_id"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/ivr/{{parameters.ivr_id}}",
