            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the Name of the IVR.",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter the Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
