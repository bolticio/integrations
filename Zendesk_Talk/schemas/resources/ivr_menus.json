    "create": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/ivr/{{parameters.ivr_id}}/menus",
            "body": {
                "data": "{{secrets}}",
                "ivr_id": "{{parameters.ivr_id}}",
                "ivr_menu": {
                    "name": "{{parameters.name}}"
                }
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.description}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the Name of the IVR Menu you want to create.",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter the Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
