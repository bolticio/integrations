{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List all Greetings Categories",
                        "value": "greeting_categories.list",
                        "description": "List all greetings categories."
                    },
                    {
                        "label": "Get Greeting Categories by ID",
                        "value": "greeting_categories.get",
                        "description": "Get detailed information about all greetings categories."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": [
                    {
                        "field": "resource",
                        "value": "greeting_categories",
                        "operator": "EQUALS"
                    }
                ]
            },
            "name": "operation"
        }
    ],
    "list": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/greeting_categories",
            "body": {
                "data": "{{secrets}}"
            },
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.description}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    },
    "get": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/greeting_categories/{{parameters.greeting_categories_id}}",
            "body": {
                "data": "{{secrets}}",
                "greeting_categories_id": "{{parameters.greeting_categories_id}}"
            },
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.description}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the ID given by the Zendesk of the greeting categories you want to get details of.",
                    "displayName": "Greeting Categories ID",
                    "displayType": "text",
                    "placeholder": "Enter Greeting Categories ID"
                },
                "name": "greeting_categories_id"
            }
        ]
    }
}
