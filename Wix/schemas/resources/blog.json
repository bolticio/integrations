    "draft_create": {
        "definition": {
            "url": "https://www.wixapis.com/blog/v3/draft-posts",
            "body": {
                "draftPost": {
                    "slug": "{{parameters.slug}}",
                    "title": "{{parameters.title}}",
                    "tagIds": "{{parameters.tag_ids}}",
                    "excerpt": "{{parameters.excerpt}}",
                    "featured": "{{parameters.featured}}",
                    "memberId": "{{parameters.member_id}}",
                    "categoryIds": "{{parameters.category_ids}}",
                    "richContent": "{{parameters.rich_content}}",
                    "commentingEnabled": "{{parameters.commenting_enabled}}"
                }
            },
            "method": "post",
            "filters": {
                "body": {
                    "allowEmptyArray": false,
                    "allowEmptyValue": false,
                    "allowEmptyObject": false
                }
            },
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Content-Type": "application/json",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.draftPost}}"
            },
            "transform": {
                "body": "const isTemplate = function (v) { return typeof v === 'string' && v.indexOf('{{') !== -1; }; const out = JSON.parse(JSON.stringify(body || {})); const draft = (out && out.draftPost) ? { ...out.draftPost } : {}; if (typeof draft.featured === 'string') { const t = draft.featured.trim().toLowerCase(); draft.featured = t === 'true'; } if (typeof draft.commentingEnabled === 'string') { const t = draft.commentingEnabled.trim().toLowerCase(); draft.commentingEnabled = t === 'true'; } ['categoryIds','tagIds'].forEach(function(k){ const v = draft[k]; if (typeof v === 'string') { const t = v.trim(); if (!t || isTemplate(t)) { delete draft[k]; } else { try { const p = JSON.parse(t); if (Array.isArray(p)) { draft[k] = p.map(String); } else { draft[k] = t.split(',').map(function(s){return s.trim();}).filter(Boolean); } } catch (e) { draft[k] = t.split(',').map(function(s){return s.trim();}).filter(Boolean); } } } }); if (typeof draft.richContent === 'string') { const t = draft.richContent.trim(); if (!t || isTemplate(t)) { delete draft.richContent; } else { const p = JSON.parse(t); if (!p || typeof p !== 'object') { throw new Error('Rich Content must be a JSON object.'); } draft.richContent = p; } } out.draftPost = draft; return out;"
            }
        },
