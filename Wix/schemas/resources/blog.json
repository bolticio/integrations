    "getPostsForOptions": {
        "definition": {
            "url": "https://www.wixapis.com/blog/v3/posts",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.posts}}"
            },
            "transform": {
                "output": "const list=Array.isArray(output)?output:(output&&Array.isArray(output.posts)?output.posts:[]);return list.map((x)=>{const id=x&&x.id?x.id:null;const displayName=x&&x.title?x.title:id;return id?Object.assign({},x,{displayName}):null;}).filter(Boolean);"
            }
        }
    },
