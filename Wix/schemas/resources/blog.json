    "posts_query": {
        "definition": {
            "url": "https://www.wixapis.com/blog/v3/posts/query",
            "body": {
                "query": {
                    "sort": [
                        {
                            "order": "{{parameters.sort_order}}",
                            "fieldName": "{{parameters.sort_field}}"
                        }
                    ],
                    "filter": "{{parameters.filter}}",
                    "cursorPaging": {
                        "limit": 100
                    }
                }
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Content-Type": "application/json",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.posts}}"
            },
            "transform": {
                "body": "const isTemplate = function (v) { return typeof v === 'string' && v.indexOf('{{') !== -1; }; const out = JSON.parse(JSON.stringify(body || {})); const query = (out && out.query) ? { ...out.query } : {}; if (typeof query.filter === 'string') { const trimmed = query.filter.trim(); if (!trimmed || isTemplate(trimmed)) { delete query.filter; } else { const parsed = JSON.parse(trimmed); if (!parsed || Array.isArray(parsed) || typeof parsed !== 'object') { throw new Error('Filter must be a JSON object.'); } query.filter = parsed; } } if (Array.isArray(query.sort)) { query.sort = query.sort.filter(function (s) { if (!s) return false; const fn = s.fieldName != null ? String(s.fieldName).trim() : ''; const ord = s.order != null ? String(s.order).trim() : ''; if (!fn || !ord) return false; if (isTemplate(fn) || isTemplate(ord)) return false; return true; }); if (query.sort.length === 0) { delete query.sort; } } out.query = query; return out;"
            },
            "pagination": {
                "body": {
                    "query": {
                        "cursorPaging": {
                            "limit": 100,
                            "cursor": "{{response.data.pagingMetadata.cursors.next}}"
                        }
                    }
                },
                "type": "body",
                "default": {
                    "query": {
                        "cursorPaging": {
                            "limit": 100,
                            "cursor": null
                        }
                    }
                },
                "condition": "{{response.data.pagingMetadata.hasNext}} == true"
            }
        },
        "parameters": [
            {
