    "get_all": {
        "definition": {
            "url": "https://www.wixapis.com/categories/v1/categories/search",
            "body": {
                "search": {
                    "cursorPaging": {
                        "limit": 100
                    }
                },
                "treeReference": {
                    "appNamespace": "@wix/stores"
                }
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Content-Type": "application/json",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.categories}}"
            },
            "transform": {
                "body": "const isTemplate = function (v) { return typeof v === 'string' && v.indexOf('{{') !== -1; }; const out = JSON.parse(JSON.stringify(body || {})); if (out.search && out.search.cursorPaging) { const c = out.search.cursorPaging.cursor; if (c === undefined || c === null || c === '' || (typeof c === 'string' && (isTemplate(c) || c.trim().toLowerCase() === 'undefined' || c.trim().toLowerCase() === 'null'))) { delete out.search.cursorPaging.cursor; } } return out;"
            },
            "pagination": {
                "body": {
                    "search": {
                        "cursorPaging": {
                            "limit": 100,
                            "cursor": "{{response.data.pagingMetadata.cursors.next}}"
                        }
                    }
                },
                "type": "body",
                "default": {
                    "search": {
                        "cursorPaging": {
                            "limit": 100,
                            "cursor": null
                        }
                    }
                },
                "condition": "{{response.data.pagingMetadata.hasNext}} == true"
            }
        },
        "parameters": []
    }
}
