                        "label": "Remove Products from Categories",
                        "value": "categories.delete_products",
                        "description": "Removes the products from specified categories."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the category operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "categories",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getCategoriesForOptions": {
        "definition": {
            "url": "https://www.wixapis.com/categories/v1/categories/search",
            "body": {
                "search": {
                    "cursorPaging": {
                        "limit": 100
                    }
                },
                "treeReference": {
                    "appNamespace": "@wix/stores"
                }
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Content-Type": "application/json",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.categories}}"
            },
            "transform": {
                "output": "const list = Array.isArray(output) ? output : (output && Array.isArray(output.categories) ? output.categories : []); return list.filter(c => c && c.id).map(c => Object.assign({}, c, { displayName: c.name || c.id }));"
            },
            "pagination": {
                "body": {
                    "search": {
                        "cursorPaging": {
                            "limit": 100,
                            "cursor": "{{response.data.pagingMetadata.cursors.next}}"
                        }
                    }
                },
                "type": "body",
                "default": {
                    "search": {
                        "cursorPaging": {
                            "limit": 100,
                            "cursor": null
                        }
                    }
                },
                "condition": "{{response.data.pagingMetadata.hasNext}} == true"
            }
        }
    },
    "add_products": {
        "definition": {
            "url": "https://www.wixapis.com/stores/v3/bulk/products/add-to-categories-by-filter",
            "body": {
                "filter": "{{parameters.filter}}",
                "categoryIds": "{{parameters.category_ids}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Content-Type": "application/json",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const out = { ...body }; if (typeof out.categoryIds === 'string') { const trimmed = out.categoryIds.trim(); if (trimmed.startsWith('[')) { out.categoryIds = JSON.parse(trimmed); } else if (trimmed) { out.categoryIds = [trimmed]; } } if (typeof out.filter === 'string') { const trimmedFilter = out.filter.trim(); if (!trimmedFilter) { throw new Error('Filter must be a valid JSON object.'); } const parsedFilter = JSON.parse(trimmedFilter); if (!parsedFilter || Array.isArray(parsedFilter) || typeof parsedFilter !== 'object') { throw new Error('Filter must be a JSON object.'); } out.filter = parsedFilter; } return out;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "wix",
                            "secret": "{{parameters.secret}}",
                            "resource": "categories",
                            "operation": "categories.add_products",
                            "loadOptionsMethod": "getCategoriesForOptions"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "At least one category is required (max 5)"
                        }
                    },
                    "description": "Select up to 5 categories to add the matched products to.",
                    "displayName": "Categories",
                    "displayType": "multiselect",
                    "placeholder": "Select categories",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "categories.add_products",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "category_ids"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "md",
                        "language": "json",
                        "fullscreen": true,
                        "showSuggestions": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Filter is required"
                        }
                    },
                    "description": "Wix Query Language filter selecting which products to add. Example: {\"id\":{\"$in\":[\"product-id-1\",\"product-id-2\"]}} to target specific products.",
                    "displayName": "Product Filter",
                    "displayType": "code",
                    "placeholder": "Enter a JSON filter, e.g. {\"id\":{\"$in\":[\"product-id-1\"]}}",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "categories.add_products",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "filter"
            }
        ]
    },
