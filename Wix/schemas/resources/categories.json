    "search": {
        "definition": {
            "url": "https://www.wixapis.com/categories/v1/categories/search",
            "body": {
                "search": {
                    "sort": [
                        {
                            "order": "{{parameters.sort_order}}",
                            "fieldName": "name"
                        }
                    ],
                    "filter": "{{parameters.filter}}"
                },
                "treeReference": {
                    "appNamespace": "@wix/stores"
                }
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Content-Type": "application/json",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.categories}}"
            },
            "transform": {
                "body": "const isTemplate = function (v) { return typeof v === 'string' && v.indexOf('{{') !== -1; }; const out = JSON.parse(JSON.stringify(body || {})); const search = (out && out.search) ? { ...out.search } : {}; if (typeof search.filter === 'string') { const trimmed = search.filter.trim(); if (!trimmed || isTemplate(trimmed)) { delete search.filter; } else { const parsed = JSON.parse(trimmed); if (!parsed || Array.isArray(parsed) || typeof parsed !== 'object') { throw new Error('Filter must be a JSON object.'); } search.filter = parsed; } } if (Array.isArray(search.sort)) { search.sort = search.sort.filter(function (s) { if (!s) return false; const fn = s.fieldName != null ? String(s.fieldName).trim() : ''; const ord = s.order != null ? String(s.order).trim() : ''; if (!fn || !ord) return false; if (isTemplate(fn) || isTemplate(ord)) return false; return true; }); if (search.sort.length === 0) { delete search.sort; } } if (search.cursorPaging) { const c = search.cursorPaging.cursor; if (c === undefined || c === null || c === '' || (typeof c === 'string' && (isTemplate(c) || c.trim().toLowerCase() === 'undefined' || c.trim().toLowerCase() === 'null'))) { delete search.cursorPaging.cursor; } } out.search = search; return out;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "htmlProps": {
                        "size": "md",
                        "language": "json",
                        "fullscreen": true,
                        "showSuggestions": true
                    },
                    "description": "Optional. JSON filter object to narrow results. Example: {\"name\": {\"$startsWith\": \"Summer\"}}",
                    "displayName": "Filter",
                    "displayType": "code",
                    "placeholder": "Enter JSON filter (optional)",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "categories.search",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "filter"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Ascending (A → Z)",
                            "value": "ASC"
                        },
                        {
                            "label": "Descending (Z → A)",
                            "value": "DESC"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "description": "Sort categories by name in ascending or descending order.",
                    "displayName": "Sort Order",
                    "displayType": "select",
                    "placeholder": "Select sort order",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "categories.search",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "sort_order"
            }
        ]
    },
