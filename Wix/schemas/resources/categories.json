{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Search Categories",
                        "value": "categories.search",
                        "description": "Searches for categories by filter parameter."
                    },
                    {
                        "label": "Get all categories",
                        "value": "categories.get_all",
                        "description": "Returns all categories."
