    "get_submissions": {
        "definition": {
            "url": "https://www.wixapis.com/form-submission-service/v4/submissions/namespace/query",
            "body": {
                "query": {
                    "sort": [
                        {
                            "order": "{{parameters.sort_order}}",
                            "fieldName": "{{parameters.sort_field}}"
                        }
                    ],
                    "filter": {
                        "formId": "{{parameters.form_id}}",
                        "namespace": "wix.form_app.form"
                    },
                    "cursorPaging": {
                        "limit": 100
                    }
                }
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Content-Type": "application/json",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.submissions}}"
            },
            "transform": {
                "body": "const isTemplate = function (v) { return typeof v === 'string' && v.indexOf('{{') !== -1; }; const out = JSON.parse(JSON.stringify(body || {})); const query = (out && out.query) ? { ...out.query } : {}; if (Array.isArray(query.sort)) { query.sort = query.sort.filter(function (s) { if (!s) return false; const fn = s.fieldName != null ? String(s.fieldName).trim() : ''; const ord = s.order != null ? String(s.order).trim() : ''; if (!fn || !ord) return false; if (isTemplate(fn) || isTemplate(ord)) return false; return true; }); if (query.sort.length === 0) { delete query.sort; } } out.query = query; return out;",
                "output": "let submissions = output; if (typeof submissions === 'string') { try { submissions = JSON.parse(submissions); } catch (e) { submissions = []; } } if (!Array.isArray(submissions)) submissions = []; return submissions.map(s => ({ ...s, created_at: s?.updatedDate || s?._updatedDate || s?.createdDate || s?._createdDate || s?.submittedDate || null })).filter(s => !!s.created_at);"
            },
            "pagination": {
                "body": {
                    "query": {
                        "cursorPaging": {
                            "limit": 100,
                            "cursor": "{{response.data.pagingMetadata.cursors.next}}"
                        }
                    }
                },
                "type": "body",
                "default": {
                    "query": {
                        "cursorPaging": {
                            "limit": 100,
                            "cursor": null
                        }
                    }
                },
                "condition": "{{response.data.pagingMetadata.hasNext}} == true"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "wix",
                            "secret": "{{parameters.secret}}",
                            "resource": "forms",
                            "operation": "forms.get_submissions",
                            "loadOptionsMethod": "getFormsForOptions"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Form ID is required"
                        }
                    },
                    "description": "Select a form from the list, or paste a Form ID directly. Forms appear after they receive at least one submission.",
                    "displayName": "Form",
                    "displayType": "autocomplete",
                    "placeholder": "Select a form or enter Form ID",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "secret",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "resource",
                                "value": "forms",
                                "operator": "EQUALS"
                            },
                            {
