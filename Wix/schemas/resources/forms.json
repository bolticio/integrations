                            }
                        ]
                    }
                },
                "name": "form_id"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Updated Date",
                            "value": "updatedDate"
                        },
                        {
                            "label": "Created Date",
                            "value": "createdDate"
                        }
                    ],
                    "description": "Optional. Field to sort submissions by.",
                    "displayName": "Sort By",
                    "displayType": "select",
                    "placeholder": "Select sort field",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "forms.get_submissions",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "sort_field"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Ascending",
                            "value": "ASC"
                        },
                        {
