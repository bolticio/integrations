    "getFormsForOptions": {
        "definition": {
            "qs": {
                "namespace": "wix.form_app.form"
            },
            "url": "https://www.wixapis.com/form-schema-service/v4/forms",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.forms}}"
            },
            "transform": {
                "output": "const list=Array.isArray(output)?output:(output&&Array.isArray(output.forms)?output.forms:[]);return list.map((x)=>{const id=x&&x.id?x.id:null;const props=(x&&x.properties)?x.properties:{};const displayName=props.name||x&&x.name||x&&x.title||id;return id?Object.assign({},x,{displayName}):null;}).filter(Boolean);"
            },
            "pagination": {
                "qs": {
                    "paging.limit": 100,
                    "paging.cursor": "{{response.data.pagingMetadata.cursors.next}}"
                },
                "type": "cursor",
                "default": {
                    "paging.limit": 100,
                    "paging.cursor": null
                },
                "condition": "{{response.data.pagingMetadata.hasNext}} == true"
            }
        }
    },
