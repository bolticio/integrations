    "update": {
        "definition": {
            "url": "https://www.wixapis.com/form-schema-service/v4/forms/{{parameters.form_id}}",
            "body": {
                "form": "{{parameters.form}}"
            },
            "method": "patch",
            "filters": {
                "body": {
                    "allowEmptyArray": false,
                    "allowEmptyValue": false,
                    "allowEmptyObject": false
                }
            },
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Content-Type": "application/json",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data.form}}"
            },
            "transform": {
                "body": "const isTemplate = function (v) { return typeof v === 'string' && v.indexOf('{{') !== -1; }; const out = JSON.parse(JSON.stringify(body || {})); if (typeof out.form === 'string') { const t = out.form.trim(); if (!t || isTemplate(t)) { delete out.form; } else { const parsed = JSON.parse(t); if (!parsed || Array.isArray(parsed) || typeof parsed !== 'object') { throw new Error('Form must be a JSON object.'); } out.form = parsed; } } return out;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "wix",
                            "secret": "{{parameters.secret}}",
                            "resource": "forms",
                            "operation": "forms.update",
                            "loadOptionsMethod": "getFormsForOptions"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Form is required"
                        }
                    },
                    "description": "Select the form to update.",
                    "displayName": "Form",
                    "displayType": "select",
                    "placeholder": "Select a form",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "forms.update",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "form_id"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "md",
                        "language": "json",
                        "fullscreen": true,
                        "showSuggestions": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Form payload is required"
                        }
                    },
                    "description": "JSON object containing the form fields to update. Tip: run Get a Form first and edit only the fields you want to change.",
                    "displayName": "Form Payload",
                    "displayType": "code",
                    "placeholder": "Enter form JSON payload",
                    "dependencies": {
