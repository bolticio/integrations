    "bulk_delete": {
        "definition": {
            "url": "https://www.wixapis.com/stores/v3/bulk/products/delete",
            "body": {
                "productIds": "{{parameters.product_ids}}"
            },
            "method": "post",
            "filters": {
                "body": {
                    "allowEmptyArray": false,
                    "allowEmptyValue": false,
                    "allowEmptyObject": false
                }
            },
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Content-Type": "application/json",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const ids = body && body.productIds; const idList = Array.isArray(ids) ? ids.filter(function (x) { return x != null && String(x).trim(); }).map(String) : (typeof ids === 'string' && ids.trim() ? ids.split(',').map(function (s) { return s.trim(); }).filter(Boolean) : []); if (!idList.length) { throw new Error('Select at least one product to delete.'); } return { productIds: idList };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "wix",
                            "secret": "{{parameters.secret}}",
                            "resource": "products",
                            "operation": "products.bulk_delete",
                            "loadOptionsMethod": "getProductsForOptions"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Select at least one product"
                        }
                    },
                    "description": "Select one or more products to delete.",
                    "displayName": "Products",
                    "displayType": "multiselect",
                    "placeholder": "Select products",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "products.bulk_delete",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "product_ids"
            }
        ]
    },
    "get_all": {
        "definition": {
            "url": "https://www.wixapis.com/stores/v3/products/search",
            "body": {
                "search": {
                    "cursorPaging": {
                        "limit": 100
                    }
                }
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Content-Type": "application/json",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.products}}"
            },
            "pagination": {
                "body": {
                    "search": {
                        "cursorPaging": {
                            "limit": 100,
                            "cursor": "{{response.data.pagingMetadata.cursors.next}}"
                        }
                    }
                },
                "type": "body",
                "default": {
                    "search": {
                        "cursorPaging": {
                            "limit": 100,
                            "cursor": null
                        }
                    }
                },
                "condition": "{{response.data.pagingMetadata.hasNext}} == true"
            }
        },
        "parameters": []
    }
}
