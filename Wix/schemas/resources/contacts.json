{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Contacts",
                        "value": "contacts.list",
                        "description": "Lists contacts in the site."
                    },
                    {
                        "label": "Get a Contact",
                        "value": "contacts.get",
                        "description": "Returns the data of a specified contact."
                    },
                    {
                        "label": "Create a Contact",
                        "value": "contacts.create",
                        "description": "Creates a new contact. At least one of name, email, or phone is required."
                    },
                    {
                        "label": "Update a Contact",
                        "value": "contacts.update",
                        "description": "Updates an existing contact."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the contact operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "contacts",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getContactsForOptions": {
        "definition": {
            "url": "https://www.wixapis.com/contacts/v4/contacts",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "wix-site-id": "{{secrets.site_id}}",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.contacts}}"
            },
            "transform": {
                "output": "const list=Array.isArray(output)?output:(output&&Array.isArray(output.contacts)?output.contacts:[]);return list.map((c)=>{const id=c&&c.id?c.id:null;const info=c&&c.info?c.info:{};const name=info.name||{};const extended=info.extendedFields&&info.extendedFields.items?info.extendedFields.items:{};const first=name.first?String(name.first).trim():'';const last=name.last?String(name.last).trim():'';const fullName=[first,last].filter(Boolean).join(' ');const displayByFirst=extended['contacts.displayByFirstName']?String(extended['contacts.displayByFirstName']).trim():'';const email=(c&&c.primaryInfo&&c.primaryInfo.email)||(info.emails&&Array.isArray(info.emails.items)&&info.emails.items[0]?info.emails.items[0].email:null);const phone=(c&&c.primaryInfo&&c.primaryInfo.phone)||(info.phones&&Array.isArray(info.phones.items)&&info.phones.items[0]?info.phones.items[0].phone:null);const displayName=fullName||displayByFirst||email||phone||id;return id?Object.assign({},c,{displayName}):null;}).filter(Boolean);"
            },
            "pagination": {
                "qs": {
                    "paging.limit": 100,
                    "paging.offset": "{{response.data.pagingMetadata.offset}} + {{response.data.pagingMetadata.count}}"
                },
                "type": "offset",
                "default": {
                    "paging.limit": 100,
                    "paging.offset": 0
                },
                "condition": "{{response.data.pagingMetadata.hasNext}} == true"
            }
        }
    },
