{
    "api_key": {
        "validate": {
            "url": "https://www.wixapis.com/contacts/v4/contacts",
            "method": "get",
            "headers": {
                "wix-site-id": "{{secrets.site_id}}",
                "Authorization": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "API key is required"
                        }
                    },
                    "description": "Your Wix API key. Generate one from the Wix Developers Center under API Keys.",
                    "displayName": "API Key",
                    "displayType": "password",
                    "placeholder": "Enter your Wix API Key",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "api_key",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "api_key"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Site ID is required"
                        }
                    },
                    "description": "Your Wix Site ID. Find it in your Wix dashboard under Settings > General Info, or in the URL of your Wix dashboard.",
                    "displayName": "Site ID",
                    "displayType": "text",
                    "placeholder": "Enter your Wix Site ID",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "api_key",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "site_id"
            }
        ]
    },
    "parameters": [
        {
            "meta": {
                "value": "api_key",
                "options": [
                    {
                        "label": "API Key",
                        "value": "api_key"
                    }
                ],
                "isDisabled": true,
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Authentication type is required"
                    }
                },
                "description": "Choose the type of authentication you want to use.",
                "displayName": "Authentication Type",
                "displayType": "select",
                "placeholder": "Select an authentication type"
            },
            "name": "type"
        }
    ]
}
