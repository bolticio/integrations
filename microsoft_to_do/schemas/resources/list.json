{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create List",
                        "value": "list.create",
                        "description": "Create a new list."
                    },
                    {
                        "label": "Update List",
                        "value": "list.update",
                        "description": "Update an existing list."
                    },
                    {
                        "label": "Delete List",
                        "value": "list.deleteTodoList",
                        "description": "Delete an existing list."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "list",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "loadTodoLists": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/todo/lists",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message }}"
                },
                "output": "{{response.data.value}}"
            }
        }
    },
    "deletetodolist": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{parameters.todo_list_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "output": "return { message: 'List deleted successfully' };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "microsoft_todo",
                            "secret": "{{parameters.secret}}",
                            "resource": "list",
                            "operation": "list.deleteTodoList",
                            "loadOptionsMethod": "loadTodoLists"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Choose a Microsoft To Do list to delete",
                    "displayName": "To Do List",
                    "displayType": "autocomplete",
                    "placeholder": "Select a To Do list to delete"
                },
                "name": "todo_list_id"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/todo/lists",
            "body": {
                "displayName": "{{parameters.name}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.error.code || response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the name of the list you want to create.",
                    "displayName": "List Name",
                    "displayType": "text",
                    "placeholder": "Enter the name of the list"
                },
                "name": "name"
            }
        ]
    },
    "update": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{parameters.todo_list_id}}",
            "body": {
                "displayName": "{{parameters.updated_name}}"
            },
            "method": "patch",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "output": "return { message: 'List updated successfully' };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "microsoft_todo",
                            "secret": "{{parameters.secret}}",
                            "resource": "list",
                            "operation": "list.deleteTodoList",
                            "loadOptionsMethod": "loadTodoLists"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Choose a Microsoft To Do list to update",
                    "displayName": "To Do List",
                    "displayType": "autocomplete",
                    "placeholder": "Select a To Do list to update"
                },
                "name": "todo_list_id"
            },
            {
                "meta": {
                    "displayName": "todo list ID",
                    "displayType": "hidden"
                },
                "name": "todo_list_id"
            },
            {
                "meta": {
                    "description": "New name of the list to update",
                    "displayName": "Update Name",
                    "displayType": "text",
                    "placeholder": "Enter updated name"
                },
                "name": "updated_name"
            }
        ]
    }
}
