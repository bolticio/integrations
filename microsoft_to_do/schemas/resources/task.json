            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "microsoft_todo",
                            "secret": "{{parameters.secret}}",
                            "resource": "task",
                            "operation": "task.find_task",
                            "loadOptionsMethod": "loadTodoLists"
