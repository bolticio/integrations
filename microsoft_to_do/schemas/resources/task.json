    "find_task": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{parameters.todo_list_id}}/tasks?$filter=startswith(title,'{{parameters.task_title}}')",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.value}}"
            }
        },
