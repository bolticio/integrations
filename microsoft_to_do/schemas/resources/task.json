{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Task",
                        "value": "task.create",
                        "description": "Create a new task."
                    },
                    {
                        "label": "Update Task",
                        "value": "task.update",
                        "description": "Update an existing task."
                    },
                    {
                        "label": "Find Task",
                        "value": "task.find_task",
                        "description": "Find an existing task."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "task",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "loadTodoLists": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/todo/lists",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.value}}"
            }
        }
    },
    "loadTodotasks": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{parameters.todo_list_id}}/tasks",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.value}}"
            }
        }
    },
    "deletetodolist": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{parameters.todo_list_id}}",
            "method": "delete",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "output": "return { message: 'List deleted successfully' };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "microsoft_todo",
                            "secret": "{{parameters.secret}}",
                            "resource": "list",
                            "operation": "list.deleteTodoList",
                            "loadOptionsMethod": "loadTodoLists"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Choose a Microsoft To Do list to delete",
                    "displayName": "To Do List",
                    "displayType": "autocomplete",
                    "placeholder": "Select a To Do list to delete"
                },
                "name": "todo_list_id"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{parameters.todo_list_id}}/tasks",
            "body": {
                "body": {
                    "content": "{{parameters.content_data}}",
                    "contentType": "text"
                },
                "title": "{{parameters.taskName}}",
                "importance": "{{parameters.importance}}",
                "dueDateTime": {
                    "dateTime": "{{parameters.datetime_due}}",
                    "timeZone": "{{parameters.timezone}}"
                },
                "isReminderOn": true,
                "reminderDateTime": {
                    "dateTime": "{{parameters.datetime}}",
                    "timeZone": "{{parameters.timezone}}"
                }
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "microsoft_todo",
                            "secret": "{{parameters.secret}}",
                            "resource": "task",
                            "operation": "task.create",
                            "loadOptionsMethod": "loadTodoLists"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "displayName",
                        "valueKey": "id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Choose a Microsoft To Do list to create a task",
                    "displayName": "To Do List",
                    "displayType": "autocomplete",
                    "placeholder": "Select a To Do list where you want to create task"
                },
                "name": "todo_list_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the name of the task you want to create.",
                    "displayName": "Task Name",
                    "displayType": "text",
                    "placeholder": "Enter the name of the task"
                },
                "name": "taskName"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "High",
                            "value": "high"
                        },
                        {
                            "label": "Normal",
                            "value": "normal"
                        },
                        {
                            "label": "Low",
                            "value": "low"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Importance is a required field"
                        }
                    },
                    "description": "Select how much the task is important.",
                    "displayName": "Importance",
                    "displayType": "select",
                    "placeholder": "Select how much the task is important"
                },
                "name": "importance",
                "prop": "personalInfo"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Please enter date and start time",
                    "displayName": "Start Date And Time",
                    "displayType": "datetime",
                    "placeholder": "Enter the reminder date of the task"
                },
                "name": "datetime"
            },
            {
                "meta": {
                    "readOnly": false,
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Please enter Due date and time",
                    "displayName": "Due Date And Time",
                    "displayType": "datetime",
                    "placeholder": "Enter the Due date of the task"
                },
                "name": "datetime_due"
            },
            {
                "meta": {
                    "value": "UTC",
                    "validation": {
                        "required": true
                    },
                    "description": "Microsoft To Do Supports UTC+5:30 format.",
                    "displayName": "Timezone",
                    "displayType": "text",
                    "placeholder": "Enter the timezone"
                },
                "name": "timezone"
            },
            {
                "meta": {
                    "htmlProps": {
                        "maxRows": 4,
                        "minRows": 4
                    },
                    "validation": {
                        "required": false,
                        "maxLength": 300,
                        "minLength": 5,
                        "requiredDetail": {
                            "errorMsg": "content is required"
                        }
                    },
                    "description": "Please provide your content to be added to task",
                    "displayName": "Content Of Your Task",
                    "displayType": "textarea",
                    "placeholder": "Enter your content here"
                },
                "name": "content_data"
            }
        ]
    },
