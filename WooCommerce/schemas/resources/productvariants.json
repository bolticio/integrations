{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create a Product Variation",
                        "value": "productVariants.create",
                        "description": "Create a new variation for an existing variable product, including attributes like size, color, price, and stock status."
                    },
                    {
                        "label": "List Product Variations",
                        "value": "productVariants.list",
                        "description": "Retrieve a list of product variations for a specific variable product."
                    },
                    {
                        "label": "Get a Product Variant",
                        "value": "productVariants.get",
                        "description": "Search for specific product variations."
                    },
                    {
                        "label": "Update a Product Variation",
                        "value": "productVariants.update",
                        "description": "Update a specific product variation."
                    },
                    {
                        "label": "Delete a Product Variation",
                        "value": "productVariants.delete",
                        "description": "Delete a product variation by ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "productVariants",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getProducts": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products",
            "method": "get",
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "pagination": {
                "qs": {},
                "type": "url",
                "default": {},
                "next_key": "next",
                "next_url": "{{response.headers.link}}",
                "condition": "{{response.headers.link}} !== null"
            }
        },
        "parameters": []
    },
    "list": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products/{{parameters.product_id}}/variations",
            "method": "get",
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "pagination": {
                "qs": {},
                "type": "url",
                "default": {},
                "next_key": "next",
                "next_url": "{{response.headers.link}}",
                "condition": "{{response.headers.link}} !== null"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "WooCommerce",
                            "secret": "{{parameters.secret}}",
                            "resource": "productVariants",
                            "operation": "productVariants.list",
                            "loadOptionsMethod": "getProducts"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the parent product to list the variations.",
                    "displayName": "Parent Product",
                    "displayType": "select"
                },
                "name": "product_id"
            }
        ]
    },
    "create": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products/{{parameters.product_id}}/variations",
            "body": {
                "sku": "{{parameters.sku}}",
                "attributes": "{{parameters.attributes}}",
                "regular_price": "{{parameters.regular_price}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "WooCommerce",
                            "secret": "{{parameters.secret}}",
                            "resource": "productVariants",
                            "operation": "productVariants.create",
                            "loadOptionsMethod": "getProducts"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Select the parent product to create a product variation",
                    "displayName": "Parent Product",
                    "displayType": "select"
                },
                "name": "product_id"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
                        "required": true,
                        "patternDetail": {
                            "errorMsg": "Price must be a valid number."
                        }
                    },
                    "description": "Regular price for the variation.",
                    "displayName": "Regular Price",
                    "displayType": "text",
                    "placeholder": "Enter regular price"
                },
                "name": "regular_price"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Stock Keeping Unit for the variation.",
                    "displayName": "SKU",
                    "displayType": "text",
                    "placeholder": "Enter SKU"
                },
                "name": "sku"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "Name of the attribute (e.g. Size, Color).",
                                "displayName": "Attribute Name",
                                "displayType": "text",
                                "placeholder": "Enter Attribute Name"
                            },
                            "name": "name"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "Value of the attribute (e.g. Small, Red).",
                                "displayName": "Attribute Option",
                                "displayType": "text",
                                "placeholder": "Enter Attribute Option"
                            },
                            "name": "option"
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": " Variation attributes like size or color.",
                    "displayName": "Attributes",
                    "displayType": "array"
                },
                "name": "attributes"
            }
        ]
    },
    "get": {
        "definition": {
            "qs": {
