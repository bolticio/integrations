{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create a Product Category",
                        "value": "productCategories.create",
                        "description": "Create a new product category."
                    },
                    {
                        "label": "Retrieve a Product Category",
                        "value": "productCategories.get",
                        "description": "Retrieve a specific product category by ID."
                    },
                    {
                        "label": "List All Product Categories",
                        "value": "productCategories.list",
                        "description": "Retrieve a list of all product categories."
                    },
                    {
                        "label": "Update a Product Category",
                        "value": "productCategories.update",
                        "description": "Update an existing product category."
                    },
                    {
                        "label": "Delete a Product Category",
                        "value": "productCategories.delete",
                        "description": "Delete a product category by ID."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation"
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products/categories",
            "body": {
                "name": "{{parameters.name}}",
                "image": {
                    "src": "{{parameters.image}}"
                }
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the product category (e.g., Clothing, Electronics).",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter category name."
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "A brief description of the product category.",
                    "displayName": "Description",
                    "displayType": "textarea",
                    "placeholder": "Enter category description"
                },
                "name": "description"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The URL of the image associated with the category.",
                    "displayName": "Image URL",
                    "displayType": "text",
                    "placeholder": "Enter image URL"
                },
                "name": "image"
            }
        ]
    },
    "list": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products/categories",
            "method": "get",
            "response": {
                "error": {
                    "code": "{{response.data.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "pagination": {
                "qs": {},
                "type": "url",
                "default": {},
                "next_key": "next",
                "next_url": "{{response.headers.link}}",
                "condition": "{{response.headers.link}} !== null"
            }
        },
        "parameters": []
    },
    "delete": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products/categories/{{parameters.category_id}}?force=true",
            "method": "delete",
            "response": {
                "error": {
                    "code": "{{response.data.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "WooCommerce",
                            "secret": "{{parameters.secret}}",
                            "resource": "productCategories",
                            "operation": "productCategories.get",
                            "loadOptionsMethod": "list"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "The Name of the product category you want to delete.",
                    "displayName": "Category Name",
                    "displayType": "select",
                    "placeholder": "Enter category Name"
                },
                "name": "category_id"
            }
        ]
    },
    "update": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products/categories/{{parameters.category_id}}",
            "body": {
                "description": "{{parameters.description}}"
            },
            "method": "put",
            "response": {
                "error": {
                    "code": "{{response.data.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "WooCommerce",
                            "secret": "{{parameters.secret}}",
                            "resource": "productCategories",
                            "operation": "productCategories.update",
                            "loadOptionsMethod": "list"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "The Name of the product category you want to Update.",
                    "displayName": "Category Name",
                    "displayType": "select",
                    "placeholder": "Enter category Name"
                },
                "name": "category_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "A brief description of the product category.",
                    "displayName": "Description",
                    "displayType": "textarea",
                    "placeholder": "Enter category description"
                },
                "name": "description"
            }
        ]
    },
    "get": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products/categories/{{parameters.category_id}}",
            "method": "get",
            "response": {
                "error": {
                    "code": "{{response.data.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "WooCommerce",
                            "secret": "{{parameters.secret}}",
                            "resource": "productCategories",
                            "operation": "productCategories.get",
                            "loadOptionsMethod": "list"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "The Name of the product category you want to retrieve.",
                    "displayName": "Category Name",
                    "displayType": "select",
                    "placeholder": "Enter category name"
                },
                "name": "category_id"
            }
        ]
    }
}
