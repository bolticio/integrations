{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create an Order",
                        "value": "orders.create",
                        "description": "Create a new WooCommerce order with customer details, billing/shipping information, line items, and payment method."
                    },
                    {
                        "label": "Retrieve an Order",
                        "value": "orders.retrieve",
                        "description": "Fetch detailed information about a specific order using its unique order ID, including order status, customer details, and line items."
                    },
                    {
                        "label": "List Orders",
                        "value": "orders.list",
                        "description": "Retrieve a paginated list of all orders in your WooCommerce store with their basic details."
                    },
                    {
                        "label": "Update Order Status",
                        "value": "orders.update",
                        "description": "Modify an existing order's status (e.g., from pending to processing, completed, or cancelled)."
                    },
                    {
                        "label": "Delete an Order",
                        "value": "orders.delete",
                        "description": "Permanently remove an order from your WooCommerce store (this action cannot be undone)."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "orders",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getPayments": {
        "definition": {
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/payment_gateways?consumer_key={{secrets.consumer_key}}&consumer_secret={{secrets.consumer_secret}}",
            "method": "get",
            "headers": {
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        }
    },
    "getProducts": {
        "definition": {
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products?consumer_key={{secrets.consumer_key}}&consumer_secret={{secrets.consumer_secret}}",
            "method": "get",
            "headers": {
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        }
    },
    "update": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/orders/{{parameters.order_id}}",
            "body": {
                "status": "{{parameters.status}}"
            },
            "method": "put",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "WooCommerce",
                            "secret": "{{parameters.secret}}",
                            "resource": "orders",
                            "operation": "orders.update",
                            "loadOptionsMethod": "list"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "id",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the order to update.",
                    "displayName": "Order ID",
                    "displayType": "select"
                },
                "name": "order_id"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Pending",
                            "value": "pending",
                            "description": "Order is pending."
                        },
                        {
                            "label": "Processing",
                            "value": "processing",
                            "description": "Order is being processed."
                        },
                        {
                            "label": "On-hold",
                            "value": "on-hold",
                            "description": "Order is on hold."
                        },
                        {
                            "label": "Completed",
                            "value": "completed",
                            "description": "Order is completed."
                        },
                        {
                            "label": "cancelled",
                            "value": "cancelled",
                            "description": "Order is cancelled."
                        },
                        {
                            "label": "Delete an Order",
                            "value": "orders.delete",
                            "description": "Delete an order."
                        },
                        {
                            "label": "Refunded",
                            "value": "refunded",
                            "description": "Order is refunded."
                        },
                        {
                            "label": "Failed",
                            "value": "failed",
                            "description": "Order is failed."
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": "The new status of the order.",
                    "displayName": "Status of the Order",
                    "displayType": "select"
                },
                "name": "status"
            }
        ]
