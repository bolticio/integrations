{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Customer",
                        "value": "customer.create",
                        "description": "Create a new WooCommerce customer with billing information and account details. This operation allows you to add a new customer to your store with their contact and address information."
                    },
                    {
                        "label": "Retrieve Customer",
                        "value": "customer.get",
                        "description": "Retrieve detailed information about a specific customer using their unique ID. This includes their profile details, billing information, and account status."
                    },
                    {
                        "label": "List Customers",
                        "value": "customer.list",
                        "description": "Retrieve a comprehensive list of all customers in your WooCommerce store. This operation supports pagination and returns customer profiles with their basic information."
                    },
                    {
                        "label": "Update Customer",
                        "value": "customer.update",
                        "description": "Modify an existing customer's information including their profile details, billing address, and contact information. This operation allows you to keep customer data up-to-date."
                    },
                    {
                        "label": "Delete Customer",
                        "value": "customer.delete",
                        "description": "Permanently remove a customer from your WooCommerce store. This action cannot be undone and will delete all associated customer data."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Choose the customer operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "customer",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "update": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/customers/{{parameters.customer_id}}",
            "body": {
                "email": "{{parameters.email}}",
                "billing": {
                    "city": "{{parameters.city}}",
                    "state": "{{parameters.state}}",
                    "country": "{{parameters.country}}",
                    "postcode": "{{parameters.postcode}}",
                    "address_1": "{{parameters.address_1}}"
                },
                "username": "{{parameters.username}}",
                "last_name": "{{parameters.last_name}}",
                "first_name": "{{parameters.first_name}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "WooCommerce",
                            "secret": "{{parameters.secret}}",
                            "resource": "customer",
                            "operation": "customer.update",
                            "loadOptionsMethod": "list"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "id",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "The unique identifier of the customer to be updated.",
                    "displayName": "Customer ID",
                    "displayType": "select",
                    "placeholder": "Enter the customer"
                },
                "name": "customer_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "patternDetail": {
                            "errorMsg": "Email must be a valid email address."
                        }
                    },
                    "description": "The email address of the customer.",
                    "displayName": "Email",
                    "displayType": "email",
                    "placeholder": "Enter customer email"
                },
                "name": "email"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The first name of the customer.",
                    "displayName": "First Name",
                    "displayType": "text",
                    "placeholder": "Enter first name"
                },
                "name": "first_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The last name of the customer.",
                    "displayName": "Last Name",
                    "displayType": "text",
                    "placeholder": "Enter last name"
                },
                "name": "last_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The username for the customer account.",
                    "displayName": "Username",
                    "displayType": "text",
                    "placeholder": "Enter username"
                },
                "name": "username"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The primary address line.",
                    "displayName": "Address 1",
                    "displayType": "textarea",
                    "placeholder": "Enter address line 1"
                },
                "name": "address_1"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "City for billing address.",
                    "displayName": "City",
                    "displayType": "text",
                    "placeholder": "Enter city"
                },
                "name": "city"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "State for billing address.",
                    "displayName": "State",
                    "displayType": "text",
                    "placeholder": "Enter state"
                },
                "name": "state"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]{6}(?:-[0-9]{4})?$",
                        "required": true,
                        "patternDetail": {
                            "errorMsg": "Postcode must be a valid postal code."
                        }
                    },
                    "description": "Postcode for billing address.",
                    "displayName": "Postcode",
                    "displayType": "text",
                    "placeholder": "Enter postcode"
                },
                "name": "postcode"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Country for billing address.",
                    "displayName": "Country",
                    "displayType": "text",
                    "placeholder": "Enter country"
                },
                "name": "country"
            }
        ]
    },
