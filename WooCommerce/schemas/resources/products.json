{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create a Product",
                        "value": "products.create",
                        "description": "Create a new product in your WooCommerce store with details like name, price, description, and images. This operation allows you to add new items to your product catalog."
                    },
                    {
                        "label": "Get Product by ID",
                        "value": "products.get",
                        "description": "Retrieve detailed information about a specific product using its unique identifier. This operation returns all product attributes including pricing, inventory, and metadata."
                    },
                    {
                        "label": "List Products",
                        "value": "products.list",
                        "description": "Retrieve a comprehensive list of all products in your WooCommerce store. This operation supports pagination and returns basic product information for each item."
                    },
                    {
                        "label": "Update a Product",
                        "value": "products.update",
                        "description": "Modify existing product details such as price, description, or stock levels. This operation allows you to keep your product information current and accurate."
                    },
                    {
                        "label": "Delete a Product",
                        "value": "products.delete",
                        "description": "Permanently remove a product from your WooCommerce store by its ID. This operation cannot be undone and will remove all associated product data."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "products",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "get": {
        "definition": {
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products/{{parameters.product_id}}?consumer_key={{secrets.consumer_key}}&consumer_secret={{secrets.consumer_secret}}",
            "method": "get",
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "WooCommerce",
                            "secret": "{{parameters.secret}}",
                            "resource": "products",
                            "operation": "products.get",
                            "loadOptionsMethod": "list"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "The ID of the Product to retrieve.",
                    "displayName": "Product ID",
                    "displayType": "select"
                },
                "name": "product_id"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products?consumer_key={{secrets.consumer_key}}&consumer_secret={{secrets.consumer_secret}}",
            "method": "get",
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "pagination": {
                "qs": {},
                "type": "url",
                "default": {},
                "next_key": "next",
                "next_url": "{{response.headers.link}}",
                "condition": "{{response.headers.link}} !== null"
            }
        },
        "parameters": []
    },
    "create": {
        "definition": {
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products?consumer_key={{secrets.consumer_key}}&consumer_secret={{secrets.consumer_secret}}",
            "body": {
                "name": "{{parameters.name}}",
                "type": "{{parameters.type}}",
                "images": [
                    {
                        "src": "{{parameters.src}}"
                    }
                ],
                "description": "{{parameters.description}}",
                "regular_price": "{{parameters.regular_price}}",
                "short_description": "{{parameters.short_description}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The name of the product.",
                    "displayName": "Product Name",
                    "displayType": "text",
                    "placeholder": "Enter product name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Simple",
                            "value": "simple"
                        },
                        {
                            "label": "Variable",
                            "value": "variable"
                        },
                        {
                            "label": "Grouped",
                            "value": "grouped"
                        },
                        {
                            "label": "External",
                            "value": "external"
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": "The type of product (simple, variable, grouped, etc.).",
                    "displayName": "Product Type",
                    "displayType": "select",
                    "placeholder": "Select product type"
                },
                "name": "type"
            },
            {
                "meta": {
                    "validation": {
                        "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
                        "required": true,
                        "patternDetail": {
                            "errorMsg": "Price must be a valid number."
                        }
                    },
                    "description": "The regular price of the product.",
                    "displayName": "Regular Price",
                    "displayType": "text",
                    "placeholder": "Enter regular price"
                },
                "name": "regular_price"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "A short description of the product.",
                    "displayName": "Short Description",
                    "displayType": "text",
                    "placeholder": "Enter short description"
                },
                "name": "short_description"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The description of the product.",
                    "displayName": "Description",
                    "displayType": "text",
                    "placeholder": "Enter product description"
                },
                "name": "description"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Direct URL of a new image to upload.",
                    "displayName": "Image URL",
                    "displayType": "text",
                    "placeholder": "Enter image URL"
                },
                "name": "src"
            }
        ]
    },
    "update": {
        "definition": {
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products/{{parameters.product_id}}?consumer_key={{secrets.consumer_key}}&consumer_secret={{secrets.consumer_secret}}",
            "body": {
                "sku": "{{parameters.sku}}",
                "regular_price": "{{parameters.regular_price}}"
            },
            "method": "put",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "WooCommerce",
                            "secret": "{{parameters.secret}}",
                            "resource": "products",
                            "operation": "products.update",
                            "loadOptionsMethod": "list"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "ID of the product to update.",
                    "displayName": "Product ID",
                    "displayType": "select",
                    "placeholder": "Enter product ID"
                },
                "name": "product_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Updated price for the product.",
                    "displayName": "Regular Price",
                    "displayType": "text",
                    "placeholder": "Enter new price"
                },
                "name": "regular_price"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Updated Quantity for the product.",
                    "displayName": "Stock Keeping Unit",
                    "displayType": "text",
                    "placeholder": "Enter new Stock Quantity"
                },
                "name": "sku"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products/{{parameters.product_id}}?force=true&consumer_key={{secrets.consumer_key}}&consumer_secret={{secrets.consumer_secret}}",
            "method": "delete",
            "headers": {
                "Accept": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.data}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "WooCommerce",
                            "secret": "{{parameters.secret}}",
                            "resource": "products",
                            "operation": "products.get",
                            "loadOptionsMethod": "list"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "Name of the product to delete.",
                    "displayName": "Product Name",
                    "displayType": "select",
                    "placeholder": "Enter product name"
                },
                "name": "product_id"
            }
        ]
    }
}
