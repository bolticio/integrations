                "description": "{{parameters.description}}"
            },
            "method": "put",
            "response": {
                "error": {
                    "code": "{{response.data.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "WooCommerce",
                            "secret": "{{parameters.secret}}",
                            "resource": "productTags",
                            "operation": "productTags.update",
                            "loadOptionsMethod": "list"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "The Name of the product tag you want to update.",
                    "displayName": "Product Tag Name",
                    "displayType": "select",
                    "placeholder": "Enter Product Tag Name"
                },
                "name": "product_tag_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "A brief description of the product tag (e.g., 'Genuine leather').",
                    "displayName": "Description",
                    "displayType": "textarea",
                    "placeholder": "Enter product tag description"
                },
                "name": "description"
            }
        ]
    },
