{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create a Product Tag",
                        "value": "productTags.create",
                        "description": "Add a new product tag to your WooCommerce store. This is useful for organizing products under new categories or themes. You can specify details like the tag name and description during creation."
                    },
                    {
                        "label": "Retrieve a Product Tag",
                        "value": "productTags.get",
                        "description": "Fetch details for a specific product tag using its unique identifier. This operation helps to view the current configuration and usage of a specific tag."
                    },
                    {
                        "label": "List All Product Tags",
                        "value": "productTags.list",
                        "description": "Get a list of all product tags available in your WooCommerce store. This is useful for reviewing all tag categories that are currently in use."
                    },
                    {
                        "label": "Update a Product Tag",
                        "value": "productTags.update",
                        "description": "Modify an existing product tag's information, such as its name or description. This allows you to keep your product categorization up to date."
                    },
                    {
                        "label": "Delete a Product Tag",
                        "value": "productTags.delete",
                        "description": "Remove a product tag from your store using its ID. This is helpful when tags are no longer needed or relevant to your product catalog."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation"
            },
            "name": "operation"
        }
    ],
    "list": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
            "url": "https://{{secrets.store_domain}}/wp-json/wc/v3/products/tags",
            "method": "get",
            "response": {
                "error": {
                    "code": "{{response.data.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "pagination": {
                "qs": {},
                "type": "url",
                "default": {},
                "next_key": "next",
                "next_url": "{{response.headers.link}}",
                "condition": "{{response.headers.link}} !== null"
            }
        },
        "parameters": []
    },
    "update": {
        "definition": {
            "qs": {
                "consumer_key": "{{secrets.consumer_key}}",
                "consumer_secret": "{{secrets.consumer_secret}}"
            },
