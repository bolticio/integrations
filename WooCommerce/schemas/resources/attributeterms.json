                "options": [
                    {
                        "label": "Create an Attribute Term",
                        "value": "attributeTerms.create",
                        "description": "Create a new term (e.g., Small, Red) for a given product attribute."
                    },
                    {
                        "label": "Get Attribute Term",
                        "value": "attributeTerms.getOne",
                        "description": "Retrieve a product attribute term by its ID."
                    },
                    {
                        "label": "List Attribute Terms",
                        "value": "attributeTerms.list",
                        "description": "Get all terms for a specific product attribute."
                    },
                    {
                        "label": "Update an Attribute Term",
                        "value": "attributeTerms.update",
                        "description": "Update an existing attribute term."
                    },
                    {
                        "label": "Delete an Attribute Term",
                        "value": "attributeTerms.delete",
                        "description": "Delete a specific attribute term."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Choose the action you want to perform on attribute terms.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "attributeTerms",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
