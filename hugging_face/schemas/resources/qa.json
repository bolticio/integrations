{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Question Answering",
                        "value": "qa.question_answering"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Choose the type of question-answering operation.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "qa",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getModelsQuestionAnswering": {
        "definition": {
            "url": "https://huggingface.co/api/models?filter=question-answering&sort=downloads",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        }
    },
    "question_answering": {
        "definition": {
            "url": "https://router.huggingface.co/hf-inference/models/{{parameters.models}}",
            "body": {
                "inputs": {
                    "context": "{{parameters.context}}",
                    "question": "{{parameters.question}}"
                }
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "hugging_face",
                            "secret": "{{parameters.secret}}",
                            "resource": "qa",
                            "operation": "qa.question_answering",
                            "loadOptionsMethod": "getModelsQuestionAnswering"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "modelId",
                        "valueKey": "modelId"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the model for Question Answering.",
                    "displayName": "Models",
                    "displayType": "autocomplete",
                    "placeholder": "Select a model"
                },
                "name": "models"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The question you want answered.",
                    "displayName": "Question",
                    "displayType": "text",
                    "placeholder": "Enter your question"
                },
                "name": "question"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Provide the text context for the question.",
                    "displayName": "Context",
                    "displayType": "textarea",
                    "placeholder": "Enter the context text"
                },
                "name": "context"
            }
        ]
    }
}
