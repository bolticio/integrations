{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Chat Completion",
                        "value": "text_functions.chat"
                    },
                    {
                        "label": "Summarize Text",
                        "value": "text_functions.summarize"
                    },
                    {
                        "label": "Classify Text",
                        "value": "text_functions.classify"
                    },
                    {
                        "label": "Generate Text",
                        "value": "text_functions.generate"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the Text Tasks",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an task",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "text_functions",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getModelsSummarization": {
        "definition": {
            "url": "https://huggingface.co/api/models?filter=summarization&sort=downloads",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        }
    },
    "getModelsClassification": {
        "definition": {
            "url": "https://huggingface.co/api/models?filter=text-classification&sort=downloads",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        }
    },
    "getTextGenerationModels": {
        "definition": {
            "url": "https://huggingface.co/api/models?filter=text-generation&sort=downloads",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        }
    },
    "classify": {
        "definition": {
            "url": "https://router.huggingface.co/hf-inference/models/{{parameters.models}}",
            "body": {
                "inputs": "{{parameters.text}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "hugging_face",
                            "secret": "{{parameters.secret}}",
                            "resource": "text_functions",
                            "operation": "text_functions.classify",
                            "loadOptionsMethod": "getModelsClassification"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "modelId",
                        "valueKey": "modelId"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the model for classification.",
                    "displayName": "Models",
                    "displayType": "autocomplete",
                    "placeholder": "Select a model"
                },
                "name": "models"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Provide the text for classification.",
                    "displayName": "Text to Classify",
                    "displayType": "text",
                    "placeholder": "Enter the text to classify"
                },
                "name": "text"
            }
        ]
    },
    "summarize": {
        "definition": {
            "url": "https://router.huggingface.co/hf-inference/models/{{parameters.models}}",
            "body": {
                "inputs": "{{parameters.text}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "hugging_face",
                            "secret": "{{parameters.secret}}",
                            "resource": "text_functions",
                            "operation": "text_functions.summarize",
                            "loadOptionsMethod": "getModelsSummarization"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "modelId",
                        "valueKey": "modelId"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the model for summarization.",
                    "displayName": "Models",
                    "displayType": "autocomplete",
                    "placeholder": "Select a model"
                },
                "name": "models"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Provide the text you want summarized.",
                    "displayName": "Text to Summarize",
                    "displayType": "textarea",
                    "placeholder": "Enter the text to summarize"
                },
                "name": "text"
            }
        ]
    },
    "generate": {
        "definition": {
            "url": "https://router.huggingface.co/hf-inference/models/{{parameters.models}}",
            "body": {
                "model": "{{parameters.models}}",
                "stream": false,
                "messages": "{{parameters.prompt}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "hugging_face",
                            "secret": "{{parameters.secret}}",
                            "resource": "text_functions",
                            "operation": "text_functions.generate",
                            "loadOptionsMethod": "getTextGenerationModels"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "modelId",
                        "valueKey": "modelId"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the model for text generation.",
                    "displayName": "Models",
                    "displayType": "autocomplete",
                    "placeholder": "Select a model"
                },
                "name": "models"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The prompt text that you want the model to complete.",
                    "displayName": "Prompt",
                    "displayType": "textarea",
                    "placeholder": "Enter the text prompt"
                },
                "name": "prompt"
            }
        ]
    },
    "chat": {
        "definition": {
            "url": "https://router.huggingface.co/v1/chat/completions",
            "body": {
                "model": "{{parameters.model}}",
                "stream": false,
                "messages": [
                    {
                        "role": "user",
                        "content": "{{parameters.content}}"
                    }
                ],
                "max_tokens": "500"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "options": [
                        {
                            "label": "Google/gemma-2-2b-it",
                            "value": "google/gemma-2-2b-it"
                        },
                        {
                            "label": "Meta-llama/Meta-Llama-3.1-8B-Instruct",
                            "value": "meta-llama/Meta-Llama-3.1-8B-Instruct"
                        },
                        {
                            "label": "Microsoft/Phi-3-mini-4k-instruct",
                            "value": "microsoft/Phi-3-mini-4k-instruct"
                        },
                        {
                            "label": "Qwen/Qwen2.5-7B-Instruct",
                            "value": "qwen/Qwen2.5-7B-Instruct"
                        },
                        {
                            "label": "Meta-llama/Llama-3.2-11B-Vision-Instruct",
                            "value": "meta-llama/Llama-3.2-11B-Vision-Instruct"
                        },
                        {
                            "label": "Qwen/Qwen2-VL-7B-Instruct",
                            "value": "qwen/Qwen2-VL-7B-Instruct"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select the model for Chat completion.",
                    "displayName": "Models",
                    "displayType": "select",
                    "placeholder": "Select a model"
                },
                "name": "model"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Eg. What is the capital of France?",
                    "displayName": "Content",
                    "displayType": "textarea",
                    "placeholder": "Enter the content of the message"
                },
                "name": "content"
            }
        ]
    }
}
