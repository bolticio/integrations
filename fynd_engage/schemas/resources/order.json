{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Order",
                        "value": "order.create",
                        "description": "Create a new order, including discounts and applying loyalty points."
                    },
                    {
                        "label": "Create Order with points redemption",
                        "value": "order.create_order_with_points",
                        "description": "Create a new order while calculating applicable discounts through loyalty points redemption."
                    },
                    {
                        "label": "Points earned on Order",
                        "value": "order.earn",
                        "description": "Award loyalty points based on the value of the order placed."
                    },
                    {
                        "label": "Discount earned on Order",
                        "value": "order.discount",
                        "description": "Apply discounts based on the details of the order."
                    },
                    {
                        "label": "Delete Order",
                        "value": "order.delete",
                        "description": "Remove an existing order from the system."
                    },
                    {
                        "label": "Refund Order",
                        "value": "order.refund",
                        "description": "Initiate a refund for a previously placed order."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Choose the order operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation"
            },
            "name": "operation"
        }
    ],
    "create_order_with_points": {
        "definition": {
            "qs": {
                "phoneNumber": "{{parameters.phoneNumber}}"
            },
            "url": "https://api.engage.fynd.com/service/platform/v1/order",
            "body": {
                "items": "{{parameters.items}}",
                "cartId": "{{parameters.cartId}}",
                "points": "{{parameters.points}}",
                "orderAmount": "{{parameters.orderAmount}}",
                "activityName": "Order",
                "applyRedeemPointsImmediately": "true"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.api_key}}:{{secrets.api_secret}})"
            },
            "response": {
                "error": {
                    "code": "{{response.data.meta.statusCode}}",
                    "message": "{{response.data.meta.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The customer's phone number associated with the order.",
                    "displayName": "Phone Number",
                    "displayType": "number",
                    "placeholder": "Enter the phone number"
                },
                "name": "phoneNumber"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The number of loyalty points being redeemed in this order.",
                    "displayName": "Redeemable Points",
                    "displayType": "number",
                    "placeholder": "Enter the redeemable points"
                },
                "name": "points"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The total monetary amount of the order before any discounts or points.",
                    "displayName": "Order Amount",
                    "displayType": "number",
                    "placeholder": "Enter the order amount"
                },
                "name": "orderAmount"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The unique identifier of the cart associated with the order.",
                    "displayName": "Cart ID",
                    "displayType": "text",
                    "placeholder": "Enter the cart ID"
                },
                "name": "cartId"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "The unique identifier for the product/item.",
                                "displayName": "Item ID",
                                "displayType": "text",
                                "placeholder": "Enter the item ID"
                            },
                            "name": "itemId"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "The price of the item.",
                                "displayName": "Amount",
                                "displayType": "number",
                                "placeholder": "Enter the item amount"
                            },
                            "name": "amount"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "The number of units of this item being ordered.",
                                "displayName": "Quantity",
                                "displayType": "number",
                                "placeholder": "Enter the quantity"
                            },
                            "name": "quantity"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "The Stock Keeping Unit (SKU) code of the item.",
                                "displayName": "SKU Code",
                                "displayType": "text",
                                "placeholder": "Enter the SKU code"
                            },
                            "name": "skuCode"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "The European Article Number (EAN) of the item, if available.",
                                "displayName": "EAN Identifier",
                                "displayType": "text",
                                "placeholder": "Enter the EAN identifier"
                            },
                            "name": "eanIdentifier"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "The number of days within which the item can be returned.",
                                "displayName": "Return Period",
                                "displayType": "text",
                                "placeholder": "Enter the return period (e.g., 30 days)"
                            },
                            "name": "returnPeriod"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": false
                                },
                                "description": "The internal reference ID for the article.",
                                "displayName": "Article ID",
                                "displayType": "text",
                                "placeholder": "Enter the article ID"
                            },
                            "name": "articleId"
                        },
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "description": "The currency code in which the item is priced.",
                                "displayName": "Currency",
                                "displayType": "text",
                                "placeholder": "Enter the currency (e.g., INR, USD)"
                            },
                            "name": "currency"
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": "An array of individual items included in the order.",
                    "displayName": "Items",
                    "displayType": "array"
                },
                "name": "items"
            }
        ]
    },
