{
    "getModels": {
        "definition": {
            "url": "https://app.nanonets.com/api/v2/ImageCategorization/Models/",
            "method": "get",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_token}}:X)"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Prediction with url",
                        "value": "ocr.ocrs",
                        "description": "Predict text from image"
                    },
                    {
                        "label": "Create model",
                        "value": "ocr.create_model",
                        "description": "Create a new model"
                    },
                    {
                        "label": "Retrieve a Model",
                        "value": "ocr.retrieve_model",
                        "description": "Retrieve details of a specific model"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "ocr",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "ocrs": {
        "definition": {
            "url": "https://app.nanonets.com/api/v2/OCR/Model/{{parameters.model}}/LabelUrls/",
            "body": "{{parameters}}",
            "retry": {
                "delay": 1000,
                "conditions": [
                    "{{response.status}} == 400"
                ],
                "multiplier": 2,
                "max_retries": 5
            },
            "method": "post",
            "headers": {
                "accept": "application/x-www-form-urlencoded",
                "Authorization": "Basic convertBufferBase64String({{secrets.api_token}}:X)"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const data = new FormData(); data.append('urls', '{{parameters.image_url}}'); return data;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "nanonets",
                            "secret": "{{parameters.secret}}",
                            "resource": "ocr",
                            "operation": "ocrs",
                            "loadOptionsMethod": "getModels"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "model_id",
                        "valueKey": "model_id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Model is required field."
                        }
                    },
                    "description": "OCR Model for prediction of an image.",
                    "displayName": "Model",
                    "displayType": "select",
                    "placeholder": "Select a Model"
                },
                "name": "model"
            },
            {
                "meta": {
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Image URL is required field."
                        }
                    },
                    "description": "The url of the image that you want to process.",
                    "displayName": "Image URL",
                    "displayType": "text",
                    "placeholder": "Enter image url"
                },
                "name": "image_url"
            }
        ]
    },
    "retrieve_model": {
        "definition": {
            "url": "https://app.nanonets.com/api/v2/OCR/Model/{{parameters.model_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Basic convertBufferBase64String({{secrets.api_token}}:X)"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "nanonets",
                            "secret": "{{parameters.secret}}",
                            "resource": "ocr",
                            "operation": "retrieve_model",
                            "loadOptionsMethod": "getModels"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "model_id",
                        "valueKey": "model_id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Model is required field."
                        }
                    },
                    "description": "OCR model to retrieve the details.",
                    "displayName": "Model",
                    "displayType": "select",
                    "placeholder": "Select a Model"
                },
                "name": "model_id"
            }
        ]
    },
    "create_model": {
        "definition": {
            "url": "https://app.nanonets.com/api/v2/OCR/Model/",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.api_token}}:X)"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const data = {'categories': '{{parameters.category}}'}; return data;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Category is required field."
                        }
                    },
                    "description": "This will be added to the description of the model (Eg. invoice, tables)",
                    "displayName": "Category",
                    "displayType": "multitext",
                    "placeholder": "Enter the Categories"
                },
                "name": "category"
            }
        ]
    }
}
