{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get Mail Threads",
                        "value": "mailbox.getmailthreads",
                        "description": "Retrieve mail threads in a specified folder with optional filtering"
                    },
                    {
                        "label": "Get One Mail Message",
                        "value": "mailbox.getonemailmessage",
                        "description": "Retrieve detailed information about a specific mail message including content and metadata"
                    },
                    {
                        "label": "Get Mail Thread",
                        "value": "mailbox.getmailthread",
                        "description": "Retrieve detailed information about a specific mail thread including all messages and metadata"
                    },
                    {
                        "label": "Get All Mail Messages Of Mail Thread",
                        "value": "mailbox.getmailthreadmessages",
                        "description": "Retrieve all messages within a specific mail thread with detailed content and metadata"
                    },
                    {
                        "label": "Update Mail Thread Details",
                        "value": "mailbox.updatemailthreaddetails",
                        "description": "Update details of a mail thread including status, labels, and metadata"
                    },
                    {
                        "label": "Delete Mail Thread",
                        "value": "mailbox.deletemailthread",
                        "description": "Permanently delete a specific mail thread from the system"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform on Mailbox.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "mailbox",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getonemailmessage": {
        "definition": {
            "qs": {
                "include_body": "{{parameters.include_body}}"
            },
            "url": "https://api.pipedrive.com/v1/mailbox/mailMessages/{{parameters.id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.statusText}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Mail Message ID is required field"
                        }
                    },
                    "description": "The ID of the mail message to fetch",
                    "displayName": "Mail Message ID",
                    "displayType": "number",
                    "placeholder": "Enter Mail Message ID"
                },
                "name": "id"
            },
            {
                "meta": {
                    "value": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Whether to include the full message body or not",
                    "displayName": "Include Body",
                    "displayType": "toggle",
                    "placeholder": "Include Body"
                },
                "name": "include_body"
            }
        ]
    },
    "getmailthread": {
        "definition": {
            "url": "https://api.pipedrive.com/v1/mailbox/mailThreads/{{parameters.id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.statusText}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Thread ID is required field"
                        }
                    },
                    "description": "The ID of the mail thread",
                    "displayName": "Thread ID",
                    "displayType": "text",
                    "placeholder": "Thread ID"
                },
                "name": "id"
            }
        ]
    },
    "getmailthreads": {
        "definition": {
            "qs": {
                "folder": "{{parameters.folder}}"
            },
            "url": "https://api.pipedrive.com/v1/mailbox/mailThreads",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.statusText}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "limit": 20,
                    "start": "{{response.data.additional_data.pagination.start}} + {{pagination.limit}}"
                },
                "type": "offset",
                "default": {
                    "limit": 20,
                    "start": 0
                },
                "condition": "{{response.data.additional_data.pagination.more_items_in_collection}} === true"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "Inbox",
                            "value": "inbox"
                        },
                        {
                            "label": "Drafts",
                            "value": "drafts"
                        },
                        {
                            "label": "Sent",
                            "value": "sent"
                        },
                        {
                            "label": "Archive",
                            "value": "archive"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Folder is required field"
                        }
                    },
                    "description": "Folder type to retrieve messages from",
                    "displayName": "Folder",
                    "displayType": "select",
                    "placeholder": "Folder"
                },
                "name": "folder"
            }
        ]
    },
    "getmailthreadmessages": {
        "definition": {
            "url": "https://api.pipedrive.com/v1/mailbox/mailThreads/{{parameters.id}}/mailMessages",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.statusText}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Thread ID is required field"
                        }
                    },
                    "description": "The ID of the mail thread",
                    "displayName": "Thread ID",
                    "displayType": "text",
                    "placeholder": "Thread ID"
                },
                "name": "id"
            }
        ]
    },
    "updatemailthreaddetails": {
        "definition": {
            "url": "https://api.pipedrive.com/v1/mailbox/mailThreads/{{parameters.id}}",
            "body": "{{parameters}}",
            "method": "put",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.statusText}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Thread ID is required field"
                        }
                    },
                    "description": "The ID of the mail thread",
                    "displayName": "Thread ID",
                    "displayType": "text",
                    "placeholder": "Thread ID"
                },
                "name": "id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "ID of the deal to associate with this thread",
                    "displayName": "Deal ID",
                    "displayType": "number",
                    "placeholder": "Enter Deal ID"
                },
                "name": "deal_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "ID of the lead to associate with this thread",
                    "displayName": "Lead ID",
                    "displayType": "text",
                    "placeholder": "Lead ID"
                },
                "name": "lead_id"
            },
            {
                "meta": {
                    "value": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Whether the thread should be shared",
                    "displayName": "Shared Flag",
                    "displayType": "toggle",
                    "placeholder": "Shared Flag"
                },
                "name": "shared_flag"
            },
            {
                "meta": {
                    "value": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Whether the thread is marked as read",
                    "displayName": "Read Flag",
                    "displayType": "toggle",
                    "placeholder": "Read Flag"
                },
                "name": "read_flag"
            },
            {
                "meta": {
                    "value": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Whether the thread should be archived",
                    "displayName": "Archived Flag",
                    "displayType": "toggle",
                    "placeholder": "Archived Flag"
                },
                "name": "archived_flag"
            }
        ]
    },
    "deletemailthread": {
        "definition": {
            "url": "https://api.pipedrive.com/v1/mailbox/mailThreads/{{parameters.id}}",
            "method": "delete",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.statusText}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Thread ID is required field"
                        }
                    },
                    "description": "The ID of the mail thread",
                    "displayName": "Thread ID",
                    "displayType": "text",
                    "placeholder": "Thread ID"
                },
                "name": "id"
            }
        ]
    }
}
