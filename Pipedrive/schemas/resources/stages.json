{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get All Stages",
                        "value": "stages.getallstages",
                        "description": "Retrieve all stages with optional filtering and pipeline association details"
                    },
                    {
                        "label": "Get Stage",
                        "value": "stages.getstage",
                        "description": "Retrieve detailed information about a specific stage including configuration and pipeline details"
                    },
                    {
                        "label": "Add Stage",
                        "value": "stages.addstage",
                        "description": "Create a new stage with all necessary details including name, pipeline association, and configuration"
                    },
                    {
                        "label": "Update Stage Details",
                        "value": "stages.updatestagedetails",
                        "description": "Update stage properties including name, configuration, and pipeline settings"
                    },
                    {
                        "label": "Delete Stage",
                        "value": "stages.deletestage",
                        "description": "Permanently delete a specific stage from the system and reassign associated deals"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform on Stages.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "stages",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getallstages": {
        "definition": {
            "qs": {
                "sort_by": "{{parameters.sort_by}}",
                "pipeline_id": "{{parameters.pipeline_id}}",
                "sort_direction": "{{parameters.sort_direction}}"
            },
            "url": "https://api.pipedrive.com/api/v2/stages",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "limit": 20,
                    "cursor": "{{response.data.additional_data.next_cursor}}"
                },
                "type": "cursor",
                "default": {
                    "limit": 20,
                    "cursor": null
                },
                "condition": "{{response.data.additional_data.next_cursor}} !== null"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The ID of the pipeline to fetch stages for. If omitted, stages for all pipelines will be fetched",
                    "displayName": "Pipeline ID",
                    "displayType": "number",
                    "placeholder": "Enter Pipeline ID"
                },
                "name": "pipeline_id"
            },
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "ID",
                            "value": "id"
                        },
                        {
                            "label": "Update Time",
                            "value": "update_time"
                        },
                        {
                            "label": "Add Time",
                            "value": "add_time"
                        },
                        {
                            "label": "Order Number",
                            "value": "order_nr"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "The field to sort by",
                    "displayName": "Sort By",
                    "displayType": "select",
                    "placeholder": "Sort By"
                },
                "name": "sort_by"
            },
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "Ascending",
                            "value": "asc"
                        },
                        {
                            "label": "Descending",
                            "value": "desc"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "The sorting direction",
                    "displayName": "Sort Direction",
                    "displayType": "select",
                    "placeholder": "Sort Direction"
                },
                "name": "sort_direction"
            }
        ]
    },
    "getstage": {
        "definition": {
            "url": "https://api.pipedrive.com/api/v2/stages/{{parameters.id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Stage ID is required field"
                        }
                    },
                    "description": "The ID of the stage",
                    "displayName": "Stage ID",
                    "displayType": "number",
                    "placeholder": "Enter Stage ID"
                },
                "name": "id"
            }
        ]
    },
    "addstage": {
        "definition": {
            "url": "https://api.pipedrive.com/api/v2/stages",
            "body": {
                "name": "{{parameters.name}}",
                "pipeline_id": "{{parameters.pipeline_id}}",
                "days_to_rotten": "{{parameters.days_to_rotten}}",
                "deal_probability": "{{parameters.deal_probability}}",
                "is_deal_rot_enabled": "{{parameters.is_deal_rot_enabled}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Stage Name is required field"
                        }
                    },
                    "description": "The name of the stage",
                    "displayName": "Stage Name",
                    "displayType": "text",
                    "placeholder": "Enter Stage Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Pipeline ID is required field"
                        }
                    },
                    "description": "The ID of the pipeline to add stage to",
                    "displayName": "Pipeline ID",
                    "displayType": "number",
                    "placeholder": "Enter Pipeline ID"
                },
                "name": "pipeline_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The success probability percentage of the deal. Used/shown when deal weighted values are used",
                    "displayName": "Deal Probability (%)",
                    "displayType": "number",
                    "placeholder": "Enter Deal Probability (%)"
                },
                "name": "deal_probability"
            },
            {
                "meta": {
                    "value": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Whether deals in this stage can become rotten",
                    "displayName": "Deal Rot Enabled",
                    "displayType": "toggle",
                    "placeholder": "Deal Rot Enabled"
                },
                "name": "is_deal_rot_enabled"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The number of days the deals not updated in this stage would become rotten. Applies only if deal rot is enabled",
                    "displayName": "Days to Rotten",
                    "displayType": "number",
                    "placeholder": "Enter Days to Rotten"
                },
                "name": "days_to_rotten"
            }
        ]
    },
    "updatestagedetails": {
        "definition": {
            "url": "https://api.pipedrive.com/api/v2/stages/{{parameters.id}}",
            "body": {
                "name": "{{parameters.name}}",
                "pipeline_id": "{{parameters.pipeline_id}}",
                "days_to_rotten": "{{parameters.days_to_rotten}}",
                "deal_probability": "{{parameters.deal_probability}}",
                "is_deal_rot_enabled": "{{parameters.is_deal_rot_enabled}}"
            },
            "method": "patch",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Stage ID is required field"
                        }
                    },
                    "description": "The ID of the stage",
                    "displayName": "Stage ID",
                    "displayType": "number",
                    "placeholder": "Enter Stage ID"
                },
                "name": "id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The name of the stage",
                    "displayName": "Stage Name",
                    "displayType": "text",
                    "placeholder": "Enter Stage Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The ID of the pipeline to add stage to",
                    "displayName": "Pipeline ID",
                    "displayType": "number",
                    "placeholder": "Enter Pipeline ID"
                },
                "name": "pipeline_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The success probability percentage of the deal. Used/shown when deal weighted values are used",
                    "displayName": "Deal Probability (%)",
                    "displayType": "number",
                    "placeholder": "Enter Deal Probability (%)"
                },
                "name": "deal_probability"
            },
            {
                "meta": {
                    "value": false,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Whether deals in this stage can become rotten",
                    "displayName": "Deal Rot Enabled",
                    "displayType": "toggle",
                    "placeholder": "Deal Rot Enabled"
                },
                "name": "is_deal_rot_enabled"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The number of days the deals not updated in this stage would become rotten. Applies only if deal rot is enabled",
                    "displayName": "Days to Rotten",
                    "displayType": "number",
                    "placeholder": "Enter Days to Rotten"
                },
                "name": "days_to_rotten"
            }
        ]
    },
    "deletestage": {
        "definition": {
            "url": "https://api.pipedrive.com/api/v2/stages/{{parameters.id}}",
            "method": "delete",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Stage ID is required field"
                        }
                    },
                    "description": "The ID of the stage",
                    "displayName": "Stage ID",
                    "displayType": "number",
                    "placeholder": "Enter Stage ID"
                },
                "name": "id"
            }
        ]
    }
}
