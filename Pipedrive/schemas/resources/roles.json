{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get All Roles",
                        "value": "roles.getallroles",
                        "description": "Retrieve all roles within the company with detailed permissions and configuration information"
                    },
                    {
                        "label": "Get Role",
                        "value": "roles.getrole",
                        "description": "Retrieve detailed information about a specific role including permissions and user assignments"
                    },
                    {
                        "label": "Add Role",
                        "value": "roles.addrole",
                        "description": "Create a new role with all necessary details including name, permissions, and configuration"
                    },
                    {
                        "label": "Update Role Details",
                        "value": "roles.updateroledetails",
                        "description": "Update role details including name, permissions, and configuration settings"
                    },
                    {
                        "label": "Delete Role",
                        "value": "roles.deleterole",
                        "description": "Permanently delete a specific role from the system and reassign associated users"
                    },
                    {
                        "label": "List Role Assignments",
                        "value": "roles.listroleassignments",
                        "description": "Retrieve all users assigned to a specific role with detailed assignment information"
                    },
                    {
                        "label": "Add Role Assignment",
                        "value": "roles.addroleassignment",
                        "description": "Assign a user to a specific role with proper permissions and access controls"
                    },
                    {
                        "label": "Delete Role Assignment",
                        "value": "roles.deleteroleassignment",
                        "description": "Remove user assignment from a specific role and update permissions accordingly"
                    },
                    {
                        "label": "List Role Settings",
                        "value": "roles.listrolesettings",
                        "description": "Retrieve all visibility settings and access controls for a specific role"
                    },
                    {
                        "label": "Add or Update Role Setting",
                        "value": "roles.addorupdaterolesetting",
                        "description": "Add or update visibility setting for a specific role with proper access controls"
                    },
                    {
                        "label": "List Pipeline Visibility for Role",
                        "value": "roles.listpipelinevisibilityforrole",
                        "description": "List visible or hidden pipelines for a role"
                    },
                    {
                        "label": "Update Pipeline Visibility for Role",
                        "value": "roles.updatepipelinevisibilityforrole",
                        "description": "Update pipeline visibility for a role"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform on Roles.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "roles",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getrole": {
        "definition": {
            "qs": {},
            "url": "https://api.pipedrive.com/v1/roles/{{parameters.id}}",
            "method": "get",
