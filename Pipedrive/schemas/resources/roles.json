            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Role ID is required field"
                        }
                    },
                    "description": "The ID of the role",
                    "displayName": "Role ID",
                    "displayType": "number",
                    "placeholder": "Enter Role ID"
                },
                "name": "id"
            }
        ]
    },
