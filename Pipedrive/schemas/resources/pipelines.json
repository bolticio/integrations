{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get All Pipelines",
                        "value": "pipelines.getallpipelines",
                        "description": "Retrieve all pipelines with optional filtering and detailed configuration information"
                    },
                    {
                        "label": "Get Pipeline",
                        "value": "pipelines.getpipeline",
                        "description": "Retrieve detailed information about a specific pipeline including stages and configuration"
                    },
                    {
                        "label": "Add Pipeline",
                        "value": "pipelines.addpipeline",
                        "description": "Create a new pipeline with all necessary details including name, stages, and configuration"
                    },
                    {
                        "label": "Update Pipeline",
                        "value": "pipelines.updatepipeline",
                        "description": "Update an existing pipeline with new information including name, stages, and configuration"
                    },
                    {
                        "label": "Delete Pipeline",
                        "value": "pipelines.deletepipeline",
                        "description": "Permanently delete a specific pipeline from the system and reassign associated deals"
                    },
                    {
                        "label": "Get Pipeline Conversion Statistics",
                        "value": "pipelines.getpipelineconversionstatistics",
                        "description": "Retrieve comprehensive deals conversion rates and analytics for a specific pipeline"
                    },
                    {
                        "label": "Get Pipeline Movement Statistics",
                        "value": "pipelines.getpipelinemovementstatistics",
                        "description": "Retrieve detailed deals movements and transitions within a specific pipeline"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform on Pipelines.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "pipelines",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getpipeline": {
        "definition": {
            "url": "https://api.pipedrive.com/api/v2/pipelines/{{parameters.id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Pipeline ID is required field"
                        }
                    },
                    "description": "The ID of the pipeline",
                    "displayName": "Pipeline ID",
                    "displayType": "number",
                    "placeholder": "Enter Pipeline ID"
                },
                "name": "id"
            }
        ]
    },
    "getallpipelines": {
        "definition": {
            "qs": {
                "sort_by": "{{parameters.sort_by}}",
                "sort_direction": "{{parameters.sort_direction}}"
            },
            "url": "https://api.pipedrive.com/api/v2/pipelines",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "limit": 20,
                    "cursor": "{{response.data.additional_data.next_cursor}}"
                },
                "type": "cursor",
                "default": {
                    "limit": 20,
                    "cursor": null
                },
                "condition": "{{response.data.additional_data.next_cursor}} !== null"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "ID",
                            "value": "id"
                        },
                        {
                            "label": "Update Time",
                            "value": "update_time"
                        },
                        {
                            "label": "Add Time",
                            "value": "add_time"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "The field to sort by",
                    "displayName": "Sort By",
                    "displayType": "select",
                    "placeholder": "Sort By"
                },
                "name": "sort_by"
            },
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "Ascending",
                            "value": "asc"
                        },
                        {
                            "label": "Descending",
                            "value": "desc"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "The sorting direction",
                    "displayName": "Sort Direction",
                    "displayType": "select",
                    "placeholder": "Sort Direction"
                },
                "name": "sort_direction"
            }
        ]
    },
    "updatepipeline": {
        "definition": {
            "url": "https://api.pipedrive.com/api/v2/pipelines/{{parameters.id}}",
            "body": {
                "name": "{{parameters.name}}",
                "is_deal_probability_enabled": "{{parameters.is_deal_probability_enabled}}"
            },
            "method": "patch",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}",
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Pipeline ID is required field"
                        }
                    },
                    "description": "The ID of the pipeline",
                    "displayName": "Pipeline ID",
                    "displayType": "number",
                    "placeholder": "Enter Pipeline ID"
                },
                "name": "id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The name of the pipeline",
                    "displayName": "Pipeline Name",
                    "displayType": "text",
                    "placeholder": "Enter Pipeline Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "value": true,
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Whether deal probability is disabled or enabled for this pipeline",
                    "displayName": "Deal Probability Enabled",
                    "displayType": "toggle",
                    "placeholder": "Deal Probability Enabled"
                },
                "name": "is_deal_probability_enabled"
            }
        ]
    },
