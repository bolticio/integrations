{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get All Call Logs",
                        "value": "calllogs.getallcalllogs",
                        "description": "Retrieve all call logs assigned to a particular user with pagination"
                    },
                    {
                        "label": "Get Call Log Details",
                        "value": "calllogs.getcalllogdetails",
                        "description": "Retrieve details of a specific call log"
                    },
                    {
                        "label": "Add Call Log",
                        "value": "calllogs.addcalllog",
                        "description": "Create a new call log with details like duration, outcome, and participants"
                    },
                    {
                        "label": "Delete Call Log",
                        "value": "calllogs.deletecalllog",
                        "description": "Permanently delete a specific call log"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform on Call Logs.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "calllogs",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getcalllogdetails": {
        "definition": {
            "url": "https://api.pipedrive.com/v1/callLogs/{{parameters.id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Call Log ID is required field"
                        }
                    },
                    "description": "The ID received when you create the call log",
                    "displayName": "Call Log ID",
                    "displayType": "text",
                    "placeholder": "Call Log ID"
                },
                "name": "id"
            }
        ]
    },
    "getallcalllogs": {
        "definition": {
            "url": "https://api.pipedrive.com/v1/callLogs",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "limit": 20,
                    "start": "{{response.data.additional_data.pagination.start}} + {{pagination.limit}}"
                },
                "type": "offset",
                "default": {
                    "limit": 20,
                    "start": 0
                },
                "condition": "{{response.data.additional_data.pagination.more_items_in_collection}} === true"
            }
        },
        "parameters": []
    },
    "addcalllog": {
        "definition": {
            "url": "https://api.pipedrive.com/v1/callLogs",
            "body": {
                "note": "{{parameters.note}}",
                "org_id": "{{parameters.org_id}}",
                "deal_id": "{{parameters.deal_id}}",
                "lead_id": "{{parameters.lead_id}}",
                "outcome": "{{parameters.outcome}}",
                "subject": "{{parameters.subject}}",
                "user_id": "{{parameters.user_id}}",
                "duration": "{{parameters.duration}}",
                "end_time": "{{parameters.end_time}}",
                "person_id": "{{parameters.person_id}}",
                "start_time": "{{parameters.start_time}}",
                "activity_id": "{{parameters.activity_id}}",
                "to_phone_number": "{{parameters.to_phone_number}}",
                "from_phone_number": "{{parameters.from_phone_number}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const b={...body}; const nil=v=>v===undefined||v===null||v===''; for (const k of Object.keys(b)){ if(typeof b[k]==='string' && b[k].trim()===''){ b[k]=undefined; } } if(!nil(b.deal_id) && !nil(b.lead_id)){ throw new Error('Provide either deal_id or lead_id, not both'); } const allowed=new Set(['connected','no_answer','left_message','left_voicemail','wrong_number','busy']); if(!allowed.has(String(b.outcome||'').toLowerCase())){ throw new Error('Invalid outcome'); } if(!nil(b.duration)){ const n=Number(b.duration); if(Number.isFinite(n) && n>=0){ b.duration=String(n|0); } } return b;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The ID of the owner of the call log",
                    "displayName": "User ID",
                    "displayType": "number",
                    "placeholder": "Enter User ID"
                },
                "name": "user_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "If set, this converts the activity into a call log using existing activity details. The activity_id must be a call type; deal_id, person_id, and org_id are ignored.",
                    "displayName": "Activity ID",
                    "displayType": "number",
                    "placeholder": "Enter Activity ID"
                },
                "name": "activity_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Name or title of the activity this call log is linked to.",
                    "displayName": "Subject",
                    "displayType": "text",
                    "placeholder": "Subject"
                },
                "name": "subject"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Call duration in seconds",
                    "displayName": "Duration",
                    "displayType": "text",
                    "placeholder": "Duration"
                },
                "name": "duration"
            },
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "Connected",
                            "value": "connected"
                        },
                        {
                            "label": "No Answer",
                            "value": "no_answer"
                        },
                        {
                            "label": "Left Message",
                            "value": "left_message"
                        },
                        {
                            "label": "Left Voicemail",
                            "value": "left_voicemail"
                        },
                        {
                            "label": "Wrong Number",
                            "value": "wrong_number"
                        },
                        {
                            "label": "Busy",
                            "value": "busy"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Outcome is required field"
                        }
                    },
                    "description": "Describes the outcome of the call",
                    "displayName": "Outcome",
                    "displayType": "select",
                    "placeholder": "Outcome"
                },
                "name": "outcome"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The number that made the call",
                    "displayName": "From Phone Number",
                    "displayType": "text",
                    "placeholder": "From Phone Number"
                },
                "name": "from_phone_number"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "To Phone Number is required field"
                        }
                    },
                    "description": "The number called",
                    "displayName": "To Phone Number",
                    "displayType": "text",
                    "placeholder": "To Phone Number"
                },
                "name": "to_phone_number"
            },
            {
                "meta": {
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Start Time in UTC (YYYY-MM-DD HH:MM:SS)",
                    "displayName": "Start Time",
                    "displayType": "datetime",
                    "placeholder": "Select Start Time"
                },
                "name": "start_time"
            },
            {
                "meta": {
                    "htmlProps": {
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "disabled": false,
                        "timeSteps": {
                            "hours": 1,
                            "minutes": 5,
                            "seconds": 5
                        }
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "End Time in UTC (YYYY-MM-DD HH:MM:SS)",
                    "displayName": "End Time",
                    "displayType": "datetime",
                    "placeholder": "Select End Time"
                },
                "name": "end_time"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "ID of the person associated with the call",
                    "displayName": "Person ID",
                    "displayType": "number",
                    "placeholder": "Enter Person ID"
                },
                "name": "person_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "ID of the organization associated with the call",
                    "displayName": "Organization ID",
                    "displayType": "number",
                    "placeholder": "Enter Organization ID"
                },
                "name": "org_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "ID of the deal the call is associated with A call log can relate to a deal or a lead.",
                    "displayName": "Deal ID",
                    "displayType": "number",
                    "placeholder": "Enter Deal ID"
                },
                "name": "deal_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "GUID of the lead associated with the call (deal or lead, not both)",
                    "displayName": "Lead ID",
                    "displayType": "text",
                    "placeholder": "Lead ID (GUID)"
                },
                "name": "lead_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Note in HTML format",
                    "displayName": "Note",
                    "displayType": "textarea",
                    "placeholder": "Note (HTML)"
                },
                "name": "note"
            }
        ]
    },
    "deletecalllog": {
        "definition": {
            "url": "https://api.pipedrive.com/v1/callLogs/{{parameters.id}}",
            "method": "delete",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Call Log ID is required field"
                        }
                    },
                    "description": "The ID received when you create the call log",
                    "displayName": "Call Log ID",
                    "displayType": "text",
                    "placeholder": "Call Log ID"
                },
                "name": "id"
            }
        ]
    }
}
