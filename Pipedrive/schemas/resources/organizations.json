                                "field": "secret",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "resource",
                                "value": "organizations",
                                "operator": "EQUALS"
                            },
                            {
                                "field": "operation",
                                "value": "organizations.updateorganization",
