                    "displayName": "Organization ID",
                    "displayType": "text",
                    "placeholder": "Enter Organization ID"
                },
                "name": "id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The unique name identifier for the organization you want to update",
                    "displayName": "Organization Name",
                    "displayType": "text",
                    "placeholder": "Enter Organization Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
