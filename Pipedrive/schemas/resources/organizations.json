                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const b = { ...body }; if (Array.isArray({{parameters.label_ids}})) { const ints = {{parameters.label_ids}}.map(v => parseInt(v)); b.label_ids = ints; } return b;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Organization ID is required field"
