    "updateorganization": {
        "definition": {
            "url": "https://api.pipedrive.com/api/v2/organizations/{{parameters.id}}",
            "body": {
                "name": "{{parameters.name}}",
                "owner_id": "{{parameters.owner_id}}",
                "label_ids": "{{parameters.label_ids}}",
                "visible_to": "{{parameters.visible_to}}"
            },
            "method": "patch",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
