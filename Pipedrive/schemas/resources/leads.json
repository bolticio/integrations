{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get All Leads",
                        "value": "leads.getallleads",
                        "description": "Retrieve all leads with optional filtering, sorting"
                    },
                    {
                        "label": "Get Lead",
                        "value": "leads.getlead",
                        "description": "Retrieve detailed information about a specific lead including all associated data and history"
                    },
                    {
                        "label": "Add Lead",
                        "value": "leads.addlead",
                        "description": "Create a new lead with all necessary details including contact information and source"
                    },
                    {
                        "label": "Update Lead",
                        "value": "leads.updatelead",
                        "description": "Update an existing lead with new information including status, contact details, and source"
                    },
                    {
                        "label": "Delete Lead",
                        "value": "leads.deletelead",
                        "description": "Permanently delete a specific lead from the system"
                    },
                    {
                        "label": "Search Leads",
                        "value": "leads.searchleads",
                        "description": "Search for leads using various criteria including name, email, and source information"
                    },
                    {
                        "label": "Get Permitted Users For Lead",
                        "value": "leads.getpermittedusersforlead",
                        "description": "Retrieve all users who have permission to access a specific lead"
                    },
                    {
                        "label": "Add Lead Label",
                        "value": "leads.addleadlabel",
                        "description": "Create a new lead label with all necessary details including name and color configuration"
                    },
                    {
                        "label": "Update Lead Label",
                        "value": "leads.updateleadlabel",
                        "description": "Update an existing lead label with new information including name and color configuration"
                    },
                    {
                        "label": "Delete Lead Label",
                        "value": "leads.deleteleadlabel",
                        "description": "Delete a specific lead label"
                    },
                    {
                        "label": "Get All Lead Sources",
                        "value": "leads.getallleadsources",
                        "description": "Retrieve all lead sources"
                    },
                    {
                        "label": "Get All Archived Leads",
                        "value": "leads.getallarchivedleads",
                        "description": "Retrieve all archived leads"
                    },
                    {
                        "label": "Get Lead Conversion Status",
                        "value": "leads.getleadconversionstatus",
                        "description": "Get conversion status of a lead (BETA)"
