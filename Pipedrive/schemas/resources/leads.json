    "getallleads": {
        "definition": {
            "qs": {
                "sort": "{{parameters.sort}}",
                "owner_id": "{{parameters.owner_id}}",
                "person_id": "{{parameters.person_id}}",
                "organization_id": "{{parameters.organization_id}}"
            },
            "url": "https://api.pipedrive.com/v1/leads",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error}}"
                },
                "output": "{{response.data.data}}"
            },
            "pagination": {
                "qs": {
                    "limit": 20,
                    "start": "{{response.data.additional_data.pagination.start}} + {{pagination.limit}}"
                },
                "type": "offset",
                "default": {
                    "limit": 20,
                    "start": 0
                },
                "condition": "{{response.data.additional_data.pagination.more_items_in_collection}} === true"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "If supplied, only leads matching the given user will be returned",
                    "displayName": "Owner ID",
                    "displayType": "number",
                    "placeholder": "Enter Owner ID"
                },
                "name": "owner_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "If supplied, only leads matching the given person will be returned",
                    "displayName": "Person ID",
                    "displayType": "number",
                    "placeholder": "Enter Person ID"
                },
                "name": "person_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "If supplied, only leads matching the given organization will be returned",
                    "displayName": "Organization ID",
                    "displayType": "number",
                    "placeholder": "Enter Organization ID"
                },
                "name": "organization_id"
            },
            {
                "meta": {
                    "value": "",
                    "options": [
                        {
                            "label": "ID ASC",
                            "value": "id ASC"
                        },
                        {
                            "label": "ID DESC",
                            "value": "id DESC"
                        },
                        {
                            "label": "Title ASC",
                            "value": "title ASC"
                        },
                        {
                            "label": "Title DESC",
