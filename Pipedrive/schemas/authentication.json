{
    "api_key": {
        "validate": {
            "url": "https://api.pipedrive.com/api/v1/users",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "x-api-token": "{{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error || 'Authentication failed. Please verify your API key.'}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Pipedrive API Key is required field"
                        }
                    },
                    "description": "Your Pipedrive API key for authentication. Available in My Account → Personal Preferences → API",
                    "displayName": "Pipedrive API Key",
                    "displayType": "password",
                    "placeholder": "Enter Pipedrive API Key"
                },
                "name": "api_key"
            }
        ]
    },
    "parameters": [
        {
            "meta": {
                "value": "api_key",
                "options": [
                    {
                        "label": "API Key",
                        "value": "api_key"
                    }
                ],
                "displayName": "Authentication Type",
                "displayType": "hidden"
            },
            "name": "type"
        }
    ]
}
