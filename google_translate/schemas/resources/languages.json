{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Languages",
                        "value": "languages.list"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "languages",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "list": {
        "definition": {
            "url": "https://translation.googleapis.com/language/translate/v2/languages?key={{secrets.api_key}}&target=en",
            "method": "get",
            "headers": {
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data.languages}}"
            }
        },
        "parameters": []
    }
}
