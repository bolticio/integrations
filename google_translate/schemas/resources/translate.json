{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Translate Text",
                        "value": "translate.translates"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "translate",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getLanguages": {
        "definition": {
            "url": "https://translation.googleapis.com/language/translate/v2/languages?key={{secrets.api_key}}&target=en",
            "method": "get",
            "headers": {
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.data.languages}}"
            }
        }
    },
    "translates": {
        "definition": {
            "url": "https://translation.googleapis.com/language/translate/v2?key={{secrets.api_key}}",
            "body": {
                "q": "{{parameters.q}}",
                "target": "{{parameters.target}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The text to translate.",
                    "displayName": "Text",
                    "displayType": "text",
                    "placeholder": "Enter the text to be translated"
                },
                "name": "q"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "google_translate",
                            "secret": "{{parameters.secret}}",
                            "resource": "translate",
                            "operation": "translate.translates",
                            "loadOptionsMethod": "getLanguages"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "language"
                    },
                    "options": [],
                    "validation": {
                        "required": true
                    },
                    "description": "The target language.",
                    "displayName": "Target Language",
                    "displayType": "select",
                    "placeholder": "Select the target language"
                },
                "name": "target"
            }
        ]
    }
}
