            "meta": {
                "options": [
                    {
                        "label": "Create Plan",
                        "value": "plan.create",
                        "description": "Create a new subscription plan in Zoho Billing."
                    },
                    {
                        "label": "Create Addon",
                        "value": "plan.createAddon",
                        "description": "Create a new addon in Zoho Billing."
                    }
