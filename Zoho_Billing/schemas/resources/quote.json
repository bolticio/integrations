                "date": "{{parameters.date}}",
                "notes": "{{parameters.notes}}",
                "terms": "{{parameters.terms}}",
                "gst_no": "{{parameters.gst_no}}",
                "tax_id": "{{parameters.tax_id}}",
                "discount": "{{parameters.discount}}",
                "adjustment": "{{parameters.adjustment}}",
                "line_items": "{{parameters.line_items}}",
                "project_id": "{{parameters.project_id}}",
                "custom_body": "{{parameters.custom_body}}",
                "customer_id": "{{parameters.customer_id}}",
                "expiry_date": "{{parameters.expiry_date}}",
                "template_id": "{{parameters.template_id}}",
                "discount_type": "{{parameters.discount_type}}",
                "exchange_rate": "{{parameters.exchange_rate}}",
                "gst_treatment": "{{parameters.gst_treatment}}",
                "tax_treatment": "{{parameters.tax_treatment}}",
                "vat_treatment": "{{parameters.vat_treatment}}",
                "custom_subject": "{{parameters.custom_subject}}",
                "contact_persons": "{{parameters.contact_persons}}",
                "estimate_number": "{{parameters.estimate_number}}",
                "place_of_supply": "{{parameters.place_of_supply}}",
                "shipping_charge": "{{parameters.shipping_charge}}",
                "avatax_exempt_no": "{{parameters.avatax_exempt_no}}",
                "is_inclusive_tax": "{{parameters.is_inclusive_tax}}",
                "reference_number": "{{parameters.reference_number}}",
                "salesperson_name": "{{parameters.salesperson_name}}",
                "tax_authority_id": "{{parameters.tax_authority_id}}",
                "adjustment_description": "{{parameters.adjustment_description}}",
                "is_discount_before_tax": "{{parameters.is_discount_before_tax}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}",
                "X-com-zoho-subscriptions-organizationid": "{{parameters.organization_id}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.code}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
