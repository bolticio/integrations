    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Subscription",
                        "value": "subscription.create",
                        "description": "Create a new subscription for a customer in Zoho Billing."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "subscription",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getProducts": {
        "definition": {
            "url": "https://www.zohoapis.in/billing/v1/products",
