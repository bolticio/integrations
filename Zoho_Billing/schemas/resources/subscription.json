{
    "getCards": {
        "definition": {
            "url": "https://www.zohoapis.in/billing/v1/customers/{{parameters.customer_id}}/cards",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}",
                "X-com-zoho-subscriptions-organizationid": "{{parameters.organization_id}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.cards}}"
            }
        }
    },
    "getPlans": {
        "definition": {
            "url": "https://www.zohoapis.in/billing/v1/plans?product_id={{parameters.product_id}}",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}",
                "X-com-zoho-subscriptions-organizationid": "{{parameters.organization_id}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.plans}}"
            }
        }
    },
    "getAddons": {
        "definition": {
            "url": "https://www.zohoapis.in/billing/v1/addons?product_id={{parameters.product_id}}",
