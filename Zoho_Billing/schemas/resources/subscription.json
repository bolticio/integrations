    "create": {
        "definition": {
            "url": "https://www.zohoapis.in/billing/v1/subscriptions",
            "body": {
                "plan": "{{parameters.plan}}",
                "addons": "{{parameters.addons}}",
                "card_id": "{{parameters.card_id}}",
                "starts_at": "{{parameters.starts_at}}",
                "account_id": "{{parameters.account_id}}",
                "coupon_code": "{{parameters.coupon_code}}",
                "customer_id": "{{parameters.customer_id}}",
                "template_id": "{{parameters.template_id}}",
                "auto_collect": "{{parameters.auto_collect}}",
                "reference_id": "{{parameters.reference_id}}",
                "exchange_rate": "{{parameters.exchange_rate}}",
                "payment_terms": "{{parameters.payment_terms}}",
                "payment_gateways": "{{parameters.payment_gateways}}",
                "salesperson_name": "{{parameters.salesperson_name}}",
                "payment_terms_label": "{{parameters.payment_terms_label}}",
                "allow_partial_payments": "{{parameters.allow_partial_payments}}",
                "add_to_unbilled_charges": "{{parameters.add_to_unbilled_charges}}",
                "create_backdated_invoice": "{{parameters.create_backdated_invoice}}",
                "can_charge_setup_fee_immediately": "{{parameters.can_charge_setup_fee_immediately}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}",
                "X-com-zoho-subscriptions-organizationid": "{{parameters.organization_id}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.code}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "return (function () {const addons_raw = {{parameters.addons}};const payment_gateways_raw = {{parameters.payment_gateways}};const addons = (Array.isArray(addons_raw))? addons_raw.filter(a => a.addon_code && a.addon_code.trim() !== '' && a.quantity && a.quantity.toString().trim() !== '' && a.price && a.price.toString().trim() !== ''): [];const payment_gateways = (Array.isArray(payment_gateways_raw))? payment_gateways_raw.filter(pg => pg.payment_gateway && pg.payment_gateway.trim() !== ''): []; return { ...body, payment_gateways, addons }; })()"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "zoho_billing",
                            "secret": "{{parameters.secret}}",
                            "resource": "subscription",
                            "operation": "subscription.create",
                            "loadOptionsMethod": "getOrganizations"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "organization_id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Your Zoho Books Organization ID",
                    "displayName": "Organization ID",
                    "displayType": "autocomplete",
                    "placeholder": "Enter Organization ID",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "operator": "NOT_EMPTY"
                            }
                        ]
                    }
                },
                "name": "organization_id"
            },
