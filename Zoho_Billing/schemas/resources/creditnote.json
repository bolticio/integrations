{
    "getItems": {
        "definition": {
            "url": "https://www.zohoapis.in/billing/v1/items",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}",
                "X-com-zoho-subscriptions-organizationid": "{{parameters.organization_id}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.items}}"
            }
        },
        "parameters": []
    },
    "getTaxes": {
        "definition": {
            "url": "https://www.zohoapis.in/billing/v1/settings/taxes",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}",
                "X-com-zoho-subscriptions-organizationid": "{{parameters.organization_id}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.taxes}}"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Credit Note",
                        "value": "creditnote.create",
                        "description": "Create a new credit note in Zoho Billing."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "creditnote",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getCustomers": {
        "definition": {
            "qs": {
                "page_size": "{{parameters.page_size}}",
                "current_page": "{{parameters.current_page}}"
            },
            "url": "https://www.zohoapis.in/billing/v1/customers",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}",
                "X-com-zoho-subscriptions-organizationid": "{{parameters.organization_id}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.customers}}"
            }
        }
    },
    "getOrganizations": {
        "definition": {
            "qs": {},
            "url": "https://www.zohoapis.in/billing/v1/organizations",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.organizations}}"
            }
        },
        "parameters": []
    },
    "getTaxExemptions": {
        "definition": {
            "url": "https://www.zohoapis.in/billing/v1/settings/taxexemptions",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}",
                "X-com-zoho-subscriptions-organizationid": "{{parameters.organization_id}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.tax_exemptions}}"
            }
        }
    },
    "create": {
        "definition": {
            "url": "https://www.zohoapis.in/billing/v1/creditnotes",
            "body": {
                "date": "{{parameters.date}}",
                "notes": "{{parameters.notes}}",
                "terms": "{{parameters.terms}}",
                "cfdi_usage": "{{parameters.cfdi_usage}}",
                "line_items": "{{parameters.creditnote_items}}",
                "customer_id": "{{parameters.customer_id}}",
                "template_id": "{{parameters.template_id}}",
                "custom_fields": [],
                "exchange_rate": "{{parameters.exchange_rate}}",
                "tax_treatment": "{{parameters.tax_treatment}}",
                "contact_persons": [],
                "reference_number": "{{parameters.reference_number}}",
                "creditnote_number": "{{parameters.creditnote_number}}",
                "cfdi_reference_type": "{{parameters.cfdi_reference_type}}",
                "ignore_auto_number_generation": "{{parameters.ignore_auto_number_generation}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}",
                "X-com-zoho-subscriptions-organizationid": "{{parameters.organization_id}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.code}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "zoho_billing",
                            "secret": "{{parameters.secret}}",
                            "resource": "creditnote",
                            "operation": "creditnote.create",
                            "loadOptionsMethod": "getOrganizations"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "organization_id"
                    },
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Your Zoho Books Organization ID",
                    "displayName": "Organization ID",
                    "displayType": "autocomplete",
                    "placeholder": "Enter Organization ID"
                },
                "name": "organization_id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "zoho_billing",
                            "secret": "{{parameters.secret}}",
