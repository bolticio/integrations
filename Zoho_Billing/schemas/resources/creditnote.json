                },
                "name": "date"
            },
            {
                "meta": {
                    "description": "Exchange rate for the currency associated with the customer",
                    "displayName": "Exchange Rate",
                    "displayType": "number",
                    "placeholder": "Enter exchange rate"
                },
                "name": "exchange_rate"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": true
