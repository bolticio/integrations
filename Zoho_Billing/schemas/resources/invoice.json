                        {
                            "label": "Unpaid",
                            "value": "Status.Unpaid"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "description": "Filter invoices by status, and supported values [Status.All, Status.Sent, Status.Draft, Status.OverDue, Status.Paid, Status.PartiallyPaid, Status.Void, Status.Unpaid]",
                    "displayName": "Invoice Status",
                    "displayType": "select",
                    "placeholder": "Select invoice status (optional)"
                },
                "name": "filter_by"
            }
        ]
