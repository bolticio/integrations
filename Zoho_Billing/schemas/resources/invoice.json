{
    "getItems": {
        "definition": {
            "url": "https://www.zohoapis.in/billing/v1/items",
            "method": "get",
            "headers": {
                "Authorization": "Zoho-oauthtoken {{secrets.access_token}}",
                "X-com-zoho-subscriptions-organizationid": "{{parameters.organization_id}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.items}}"
            }
        },
        "parameters": []
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Invoice",
                        "value": "invoice.create",
                        "description": "Create a new invoice for a customer in Zoho Billing."
                    },
                    {
                        "label": "List Invoices",
                        "value": "invoice.list",
                        "description": "Retrieve a list of invoices from Zoho Billing."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "invoice",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
