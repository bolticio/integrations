                    "displayType": "text",
                    "placeholder": "Enter customer ID"
                },
                "name": "customer_id"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "All",
                            "value": "Status.All"
                        },
                        {
                            "label": "Sent",
                            "value": "Status.Sent"
                        },
                        {
                            "label": "Draft",
                            "value": "Status.Draft"
                        },
                        {
                            "label": "Overdue",
                            "value": "Status.OverDue"
                        },
                        {
                            "label": "Paid",
                            "value": "Status.Paid"
                        },
                        {
                            "label": "Partially Paid",
                            "value": "Status.PartiallyPaid"
                        },
                        {
                            "label": "Void",
