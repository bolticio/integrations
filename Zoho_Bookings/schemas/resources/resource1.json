{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Account",
                        "value": "resource1.create",
                        "description": "Create a new account."
                    },
                    {
                        "label": "Delete Account",
                        "value": "resource1.delete",
                        "description": "Delete an existing account."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "resource1",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "delete": {
        "definition": {
            "url": "https://dummyjson.com/products/{{parameters.id}}",
            "method": "delete",
            "headers": {
                "ContentType": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors.code}}",
                    "message": "{{response.data.errors.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the ID of the account you want to delete.",
                    "displayName": "Account ID",
                    "displayType": "text",
                    "placeholder": "Enter the Account ID"
                },
                "name": "id"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://dummyjson.com/products",
            "body": "{{parameters}}",
            "method": "post",
            "headers": {
                "ContentType": "application/json"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors.code}}",
                    "message": "{{response.data.errors.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the name of the product you want to create.",
                    "displayName": "Product Name",
                    "displayType": "text",
                    "placeholder": "Enter the name of the product"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the description of the product you want to create.",
                    "displayName": "Product Description",
                    "displayType": "text",
                    "placeholder": "Enter the description of the product"
                },
                "name": "description"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the price of the product you want to create.",
                    "displayName": "Product Price",
                    "displayType": "number",
                    "placeholder": "Enter the price of the product"
                },
                "name": "price"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter the discount percentage for the product you want to create.",
                    "displayName": "Discount Percentage",
                    "displayType": "number",
                    "placeholder": "Enter the discount percentage"
                },
                "name": "discountPercentage"
            },
            {
                "meta": {
                    "value": true,
                    "options": [
                        {
                            "label": "Yes",
                            "value": true
                        },
                        {
                            "label": "No",
                            "value": false
                        }
                    ],
                    "description": "Status for the calendar, Determines whether all events in the calendar should be visible.",
                    "displayName": "Status",
                    "displayType": "select",
                    "placeholder": "Select status"
                },
                "name": "status",
                "prop": "personalInfo"
            }
        ]
    }
}
