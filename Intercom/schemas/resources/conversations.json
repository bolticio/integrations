{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Conversation",
                        "value": "conversations.create",
                        "description": "Create a new conversation."
                    },
                    {
                        "label": "Retrieve a Conversation",
                        "value": "conversations.retrieve",
                        "description": "Retrieve a specific conversation."
                    },
                    {
                        "label": "Update a Conversation",
                        "value": "conversations.update",
                        "description": "Update an existing conversation."
                    },
                    {
                        "label": "List all Conversations",
                        "value": "conversations.list",
                        "description": "List all conversations."
                    },
                    {
                        "label": "Delete a Conversation",
                        "value": "conversations.delete",
                        "description": "Delete an existing conversation."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "conversations",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "retrieve": {
        "definition": {
            "url": "https://api.intercom.io/conversations/{{parameters.id}}?display_as=plaintext",
            "body": {
                "id": "{{parameters.id}}"
            },
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Conversation ID is required"
                        }
                    },
                    "description": "Enter the ID of the Conversation given by the Intercom you want to retrieve.",
                    "displayName": "Conversation ID",
                    "displayType": "text",
                    "placeholder": "Enter the Conversation ID"
                },
                "name": "id"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://api.intercom.io/conversations",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "ContentType": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    },
    "update": {
        "definition": {
            "url": "https://api.intercom.io/conversations/{{parameters.id}}?display_as=plaintext",
            "body": {
                "id": "{{parameters.id}}",
                "read": "{{parameters.read}}",
                "title": "{{parameters.title}}"
            },
            "method": "put",
            "headers": {
                "Accept": "application/json",
                "ContentType": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Conversation ID is required"
                        }
                    },
                    "description": "Enter the ID of the Conversation given by the Intercom you want to update.",
                    "displayName": "Conversation ID",
                    "displayType": "text",
                    "placeholder": "Enter the Conversation ID"
                },
                "name": "id"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "True",
                            "value": "true",
                            "description": "true if yes"
                        },
                        {
                            "label": "False",
                            "value": "false",
                            "description": "false if no"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": false
                    },
                    "description": "Mark a conversation as read within Intercom.",
                    "displayName": "Read",
                    "displayType": "select",
                    "placeholder": "Mark a conversation as read within Intercom."
                },
                "name": "read"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "Enter the new title of the Conversation.",
                    "displayName": "Update the Conversation Title",
                    "displayType": "text",
                    "placeholder": "Enter the new title of the Conversation."
                },
                "name": "title"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://api.intercom.io/conversations",
            "body": {
                "body": "{{parameters.body}}",
                "from": {
                    "id": "{{parameters.id}}",
                    "type": "{{parameters.type}}"
                }
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "options": [
                        {
                            "label": "User",
                            "value": "user",
                            "description": "User associated to the Contact."
                        },
                        {
                            "label": "Lead",
                            "value": "lead",
                            "description": "Lead associated to the Contact."
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Role Type is required"
                        }
                    },
                    "description": "Enter the role for which you want your conversation.",
                    "displayName": "Role Type",
                    "displayType": "select",
                    "placeholder": "Select the role type"
                },
                "name": "type"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Role ID is required"
                        }
                    },
                    "description": "Enter the Contact ID associated to the role. For example if you are the user then enter the contact id for the role user.",
                    "displayName": "Role ID",
                    "displayType": "text",
                    "placeholder": "Enter the Role ID"
                },
                "name": "id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Body of Conversation is required"
                        }
                    },
                    "description": "Enter the Body of the Conversation",
                    "displayName": "Body of Conversation",
                    "displayType": "text",
                    "placeholder": "Enter the Body of Conversation"
                },
                "name": "body"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://api.intercom.io/conversations/{{parameters.id}}",
            "body": {
                "id": "{{parameters.id}}"
            },
            "method": "delete",
            "headers": {
                "Accept": "application/json",
                "ContentType": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Conversation ID is required"
                        }
                    },
                    "description": "Enter the ID of the conversation you want to delete.",
                    "displayName": "Conversation ID",
                    "displayType": "text",
                    "placeholder": "Enter the Conversation ID"
                },
                "name": "id"
            }
        ]
    }
}
