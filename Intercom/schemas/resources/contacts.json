{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Contact",
                        "value": "contacts.create",
                        "description": "Create a new contact."
                    },
                    {
                        "label": "Retrieve a Contact",
                        "value": "contacts.retrieve",
                        "description": "Retrieve a specific Contact."
                    },
                    {
                        "label": "List all Contacts",
                        "value": "contacts.get",
                        "description": "List all Contacts."
                    },
                    {
                        "label": "Delete Contact",
                        "value": "contacts.delete",
                        "description": "Delete an existing Contact."
                    },
                    {
                        "label": "Assign Company",
                        "value": "contacts.assign_company",
                        "description": "Assign company to contacts."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "contacts",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getCompanies": {
        "definition": {
            "url": "https://api.intercom.io/companies",
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.data}}"
            }
        },
        "parameters": []
    },
    "delete": {
        "definition": {
            "url": "https://api.intercom.io/contacts/{{parameters.id}}",
            "method": "delete",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data.deleted}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Contact ID is required"
                        }
                    },
                    "description": "Enter the Contact ID given by the Intercom you want to delete.",
                    "displayName": "Contact ID ",
                    "displayType": "text",
                    "placeholder": "Enter the Contact ID"
                },
                "name": "id"
            }
        ]
    },
    "retrieve": {
        "definition": {
            "url": "https://api.intercom.io/contacts/{{parameters.id}}",
            "body": {
                "id": "{{parameters.id}}"
            },
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Contact ID is required"
                        }
                    },
                    "description": "Enter the Contact ID given by the Intercom you want to retrieve.",
                    "displayName": "Contact ID",
                    "displayType": "text",
                    "placeholder": "Enter the Contact ID"
                },
                "name": "id"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://api.intercom.io/contacts",
            "body": {
                "name": "{{parameters.name}}",
                "role": "{{parameters.role}}",
                "email": "{{parameters.email}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "options": [
                        {
                            "label": "User",
                            "value": "user",
                            "description": "Assign role as a user."
                        },
                        {
                            "label": "Lead",
                            "value": "lead",
                            "description": "Assign role as a lead."
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Role is required"
                        }
                    },
                    "description": "Enter the role of the  you want to create.",
                    "displayName": "Role",
                    "displayType": "select",
                    "placeholder": "Enter role of the contact you want to create"
                },
                "name": "role"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Contact Name is required"
                        }
                    },
                    "description": "Enter the name of the contact you want to create.",
                    "displayName": "Contact Name",
                    "displayType": "text",
                    "placeholder": "Enter the name of the contact"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Email is required"
                        }
                    },
                    "description": "Enter the email of the contact you want to create.",
                    "displayName": "Email ID",
                    "displayType": "text",
                    "placeholder": "Enter the email of the contact"
                },
                "name": "email"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://api.intercom.io/contacts",
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    },
    "assign_company": {
        "definition": {
            "url": "https://api.intercom.io/contacts/{{parameters.id}}/companies",
            "body": {
                "id": "{{parameters.companyId}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The Intercom ID of the contact to assign a company to.",
                    "displayName": "Contact ID",
                    "displayType": "text",
                    "placeholder": "Enter the Contact ID"
                },
                "name": "id"
            },
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "contacts",
                            "secret": "{{parameters.secret}}",
                            "resource": "contacts",
                            "operation": "contacts.assign_company",
                            "loadOptionsMethod": "getCompanies"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {
                        "required": true
                    },
                    "description": "Select a Company which you want to assign to the user/lead.",
                    "displayName": "Company List",
                    "displayType": "select",
                    "placeholder": "Select a Company"
                },
                "name": "companyId"
            }
        ]
    }
}
