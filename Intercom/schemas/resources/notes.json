{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Note",
                        "value": "notes.create",
                        "description": "Create a new note."
                    },
                    {
                        "label": "Retrieve a Note by ID",
                        "value": "notes.retrieve",
                        "description": "Retrieve a specific note."
                    },
                    {
                        "label": "List all Notes",
                        "value": "notes.get",
                        "description": "List all notes."
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "notes",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://api.intercom.io/contacts/{{parameters.id}}/notes",
            "body": {
                "body": "{{parameters.body}}",
                "name": "{{parameters.name}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Contact ID is required"
                        }
                    },
                    "description": "Enter the Contact ID for the notes to be created.",
                    "displayName": "Contact ID",
                    "displayType": "text",
                    "placeholder": "Enter the Contact ID"
                },
                "name": "id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Notes are required"
                        }
                    },
                    "description": "Enter your notes description.",
                    "displayName": "Notes",
                    "displayType": "text",
                    "placeholder": "Enter your notes description."
                },
                "name": "body"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://api.intercom.io/contacts/{{parameters.id}}/notes",
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Contact ID is required"
                        }
                    },
                    "description": "Enter the Contact ID whose note you want to retrieve.",
                    "displayName": "Contact ID",
                    "displayType": "text",
                    "placeholder": "Enter the Contact ID"
                },
                "name": "id"
            }
        ]
    },
    "retrieve": {
        "definition": {
            "url": "https://api.intercom.io/notes/{{parameters.id}}",
            "body": {
                "id": "{{parameters.id}}"
            },
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}",
                "Intercom-Version": "2.14"
            },
            "response": {
                "error": {
                    "code": "{{response.data.errors[0].code}}",
                    "message": "{{response.data.errors[0].message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Note ID is required"
                        }
                    },
                    "description": "Enter the ID of the note given by the Intercom you want to retrieve.",
                    "displayName": "Note ID",
                    "displayType": "text",
                    "placeholder": "Enter the Note ID"
                },
                "name": "id"
            }
        ]
    }
}
