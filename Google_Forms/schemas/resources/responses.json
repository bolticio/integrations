{
    "getForms": {
        "definition": {
            "qs": {
                "q": "mimeType='application/vnd.google-apps.form' and trashed=false",
                "fields": "files(id,name,mimeType),nextPageToken"
            },
            "url": "https://www.googleapis.com/drive/v3/files",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.files}}"
            },
            "transform": {
                "output": "const files=Array.isArray(output)?output:(output&&Array.isArray(output.files)?output.files:[]);return files.map((x)=>{const id=x&&x.id?x.id:null;const label=x&&x.name?x.name:id;return id?{...x,name:label,displayName:label}:null;}).filter(Boolean);"
            },
            "pagination": {
                "qs": {
                    "pageSize": 100,
                    "pageToken": "{{response.data.nextPageToken}}"
                },
                "type": "cursor",
                "default": {
                    "pageSize": 100,
                    "pageToken": null
                },
                "condition": "{{response.data.nextPageToken}} != null"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Responses",
                        "value": "responses.list",
                        "description": "Retrieves a list of responses."
                    },
                    {
                        "label": "Get a Response",
                        "value": "responses.get",
                        "description": "Retrieves the details of a response by its ID."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is required"
                    }
                },
                "description": "Select the response operation you want to perform.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "responses",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getResponses": {
        "definition": {
            "qs": {},
            "url": "https://forms.googleapis.com/v1/forms/{{parameters.form_id}}/responses",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.responses}}"
            },
            "transform": {
                "output": "const responses=Array.isArray(output)?output:(output&&Array.isArray(output.responses)?output.responses:[]);return responses.map((x,index)=>{const id=x&&x.responseId?x.responseId:(x&&x.id?x.id:null);const label='Response '+(index+1);return id?{...x,id:id,displayName:label}:null;}).filter(Boolean);"
            },
            "pagination": {
                "qs": {
                    "pageSize": 100,
                    "pageToken": "{{response.data.nextPageToken}}"
                },
                "type": "cursor",
                "default": {
                    "pageSize": 100,
                    "pageToken": null
                },
                "condition": "{{response.data.nextPageToken}} != null"
            }
        }
    },
    "list": {
        "definition": {
            "qs": {},
            "url": "https://forms.googleapis.com/v1/forms/{{parameters.form_id}}/responses",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
