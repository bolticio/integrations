{
    "getSheets": {
        "definition": {
            "qs": {
                "fields": "sheets(properties(title,sheetId))"
            },
            "url": "https://sheets.googleapis.com/v4/spreadsheets/{{parameters.spreadsheet_id}}",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.sheets}}"
            },
            "transform": {
                "output": "const sheets=Array.isArray(output)?output:(output&&Array.isArray(output.sheets)?output.sheets:(output?[output]:[]));return sheets.map((x)=>{const title=x&&x.properties&&x.properties.title?x.properties.title:null;return title?{...x,id:title,title:title,displayName:title}:null;}).filter(Boolean);"
            }
        }
    },
