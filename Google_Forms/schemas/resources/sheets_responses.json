            "transform": {
                "output": "const raw = typeof output === 'string' ? output : JSON.stringify(output); const match = raw.match(/google\\.visualization\\.Query\\.setResponse\\(([\\s\\S]+?)\\);?\\s*$/); if (!match) return []; let parsed; try { parsed = JSON.parse(match[1]); } catch(e) { return []; } if (!parsed) return []; if (parsed.status === 'error') { const errors = Array.isArray(parsed.errors) ? parsed.errors : []; const message = errors.map((e) => e && (e.detailed_message || e.message || e.reason)).filter(Boolean).join('; ') || 'Google Sheets query failed'; throw new Error(message); } if (!parsed.table) return []; const cols = parsed.table.cols || []; const rows = parsed.table.rows || []; return rows.map((r) => { const obj = {}; cols.forEach((c, i) => { const key = c.label || c.id || ('col' + i); const cell = r.c && r.c[i]; obj[key] = cell && cell.v != null ? cell.v : ''; }); return obj; });"
            }
        },
