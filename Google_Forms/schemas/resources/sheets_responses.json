                "output": "function clean(v){if(v==null)return'';v=String(v).trim();if(!v||v==='undefined'||v==='null'||/^\\{\\{.*\\}\\}$/.test(v))return'';return v;}function readParam(name,fallback){if(typeof parameters!=='undefined'&&parameters&&parameters[name]!=null)return clean(parameters[name]);if(typeof input!=='undefined'&&input&&input[name]!=null)return clean(input[name]);if(typeof params!=='undefined'&&params&&params[name]!=null)return clean(params[name]);return clean(fallback);}function norm(v){return String(v||'').trim().toLowerCase();}const rows=Array.isArray(output&&output.values)?output.values:(Array.isArray(output&&output.data&&output.data.values)?output.data.values:(Array.isArray(output)?output:[]));if(rows.length===0)return[];const headers=(rows[0]||[]).map((h)=>String(h||'').trim());const filterColumn=readParam('filter_column','{{parameters.filter_column}}');const filterValue=readParam('filter_value','{{parameters.filter_value}}');const rawMax=readParam('max_results','{{parameters.max_results}}');const max=rawMax?Number(rawMax):0;let filterIndex=-1;if(filterColumn){filterIndex=headers.findIndex((h)=>h===filterColumn);if(filterIndex<0)filterIndex=headers.findIndex((h)=>norm(h)===norm(filterColumn));if(filterIndex<0)throw new Error('Filter column \"'+filterColumn+'\" was not found. Available columns: '+headers.filter(Boolean).join(', '));}const needle=filterValue.toLowerCase();const results=[];for(let i=1;i<rows.length;i++){const row=rows[i]||[];const obj={__row:i+1};headers.forEach((h,idx)=>{obj[h||('col'+idx)]=row[idx]!=null?row[idx]:'';});if(filterIndex>=0){const cell=String(row[filterIndex]!=null?row[filterIndex]:'').toLowerCase();if(!cell.includes(needle))continue;}results.push(obj);if(max&&results.length>=max)break;}return results;"
