    "getSpreadsheets": {
        "definition": {
            "qs": {
                "q": "mimeType='application/vnd.google-apps.spreadsheet' and trashed=false",
                "fields": "files(id,name),nextPageToken",
                "pageSize": 100
            },
            "url": "https://www.googleapis.com/drive/v3/files",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data.files}}"
            },
            "transform": {
                "output": "const files=Array.isArray(output)?output:(output&&Array.isArray(output.files)?output.files:[]);return files.map((x)=>{const id=x&&x.id?x.id:null;const label=x&&x.name?x.name:id;return id?{...x,name:label,displayName:label}:null;}).filter(Boolean);"
            }
        }
    },
    "search_advanced": {
        "definition": {
            "qs": {
                "tq": "{{parameters.query}}",
                "tqx": "out:json",
                "sheet": "{{parameters.sheet_name}}"
            },
            "url": "https://docs.google.com/spreadsheets/d/{{parameters.spreadsheet_id}}/gviz/tq",
            "method": "get",
            "headers": {
                "Accept": "text/plain",
