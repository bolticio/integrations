{
    "oauth2": {
        "token": {
            "url": "https://oauth2.googleapis.com/token",
            "body": {
                "code": "{{code}}",
                "client_id": "{{secrets.client_id}}",
                "grant_type": "authorization_code",
                "redirect_uri": "{{secrets.redirect_uri}}",
                "client_secret": "{{secrets.client_secret}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/x-www-form-urlencoded"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "refresh": {
            "url": "https://oauth2.googleapis.com/token",
            "body": {
                "client_id": "{{secrets.client_id}}",
                "grant_type": "refresh_token",
                "client_secret": "{{secrets.client_secret}}",
                "refresh_token": "{{secrets.refresh_token}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/x-www-form-urlencoded"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "validate": {
            "url": "https://www.googleapis.com/oauth2/v3/userinfo",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "authorize": {
            "qs": {
                "scope": "https://www.googleapis.com/auth/forms.body https://www.googleapis.com/auth/forms.responses.readonly https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/spreadsheets openid email profile",
                "state": "{{uuidv4()}}",
                "prompt": "consent",
                "client_id": "{{secrets.client_id}}",
                "access_type": "offline",
                "redirect_uri": "{{secrets.redirect_uri}}",
                "response_type": "code"
            },
            "url": "https://accounts.google.com/o/oauth2/v2/auth",
            "method": "get",
            "response": {
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "value": "v1/google/callback",
                    "displayName": "redirect_uri",
                    "displayType": "hidden",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "redirect_uri"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "small",
                        "style": {
                            "color": "#ffffff",
                            "height": "40px",
                            "padding": "16px",
                            "fontSize": "14px",
                            "fontWeight": 700,
                            "backgroundColor": "#ff592f"
                        },
                        "variant": "contained"
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Please connect with your Google Forms account"
                        }
                    },
                    "description": "Click to connect your Google Forms account.",
                    "displayName": "Connect Google Forms Account",
                    "displayType": "button",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "refresh_token",
                                "operator": "EMPTY"
                            },
                            {
                                "field": "expiry_date",
                                "operator": "EMPTY"
                            },
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "oauth2"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "small",
                        "style": {
                            "color": "#ffffff",
                            "backgroundColor": "#28A745"
                        },
                        "variant": "contained"
                    },
                    "description": "Your Google Forms account is connected.",
                    "displayName": "Google Forms Account Connected",
                    "displayType": "button",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "refresh_token",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "expiry_date",
                                "operator": "NOT_EMPTY"
                            },
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "oauth2_connected"
            },
            {
                "meta": {
                    "displayName": "Refresh Token",
                    "displayType": "hidden",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "refresh_token"
            },
            {
                "meta": {
                    "displayName": "Access Token",
                    "displayType": "hidden",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "access_token"
            },
            {
                "meta": {
                    "displayName": "Expiry Date",
                    "displayType": "hidden",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "oauth2",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "expiry_date"
            }
        ]
    },
    "parameters": [
        {
            "meta": {
                "value": "oauth2",
                "options": [
                    {
                        "label": "OAuth2",
                        "value": "oauth2"
                    }
                ],
                "displayName": "Authentication Type",
                "displayType": "hidden"
            },
            "name": "type"
        }
    ]
}
