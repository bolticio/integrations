{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Lists customer orders (getOrders)",
                        "value": "order.getOrders",
                        "description": "Retrieve a list of all orders placed by the customer with details like order status, items, and delivery information."
                    },
                    {
                        "label": "Fetches order by ID (getOrderById)",
                        "value": "order.getOrderById",
                        "description": "Get detailed information about a specific order using its unique identifier, including order items, payment details, and shipping status."
                    },
                    {
                        "label": "Fetches shipment by ID (getShipmentById)",
                        "value": "order.getShipmentById",
                        "description": "Retrieve shipping information for a specific order shipment, including tracking details, delivery status, and estimated delivery date."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is a required field"
                    }
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "autocomplete",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "order",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getorders": {
