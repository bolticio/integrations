{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get product details by slug (getProductDetailBySlug)",
                        "value": "catalog.getProductDetailBySlug",
                        "description": "Retrieve detailed information about a specific product using its unique slug identifier. This includes product name, description, images, variants, and other metadata."
                    },
                    {
                        "label": "Retrieve products (getProducts)",
                        "value": "catalog.getProducts",
                        "description": "Get a list of products from your catalog with optional filtering, sorting, and pagination. Useful for displaying product listings and search results."
                    },
                    {
                        "label": "Get product sizes by slug (getProductSizesBySlug)",
                        "value": "catalog.getProductSizesBySlug",
                        "description": "Fetch available sizes for a specific product using its slug. This includes size information, stock availability, and size-specific pricing."
                    },
                    {
                        "label": "Retrieve user's followed listings (getFollowedListing)",
                        "value": "catalog.getFollowedListing",
                        "description": "Get a list of products that the user has marked as favorites or followed. Useful for implementing wishlist functionality."
                    },
                    {
                        "label": "Unfollow an item by ID (unfollowById)",
                        "value": "catalog.unfollowById",
                        "description": "Remove a product from user's followed/favorite items list using the product's unique identifier."
                    },
                    {
                        "label": "Follow an item by ID (followById)",
                        "value": "catalog.followById",
                        "description": "Add a product to user's followed/favorite items list using the product's unique identifier."
                    },
                    {
                        "label": "Retrieve product price by slug (getProductPriceBySlug)",
                        "value": "catalog.getProductPriceBySlug",
                        "description": "Get detailed pricing information for a specific product using its slug. Includes current price, discounts, and any applicable price variations."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is a required field"
                    }
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
                "displayType": "autocomplete",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "catalog",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getproductsizesbyslug": {
        "definition": {
