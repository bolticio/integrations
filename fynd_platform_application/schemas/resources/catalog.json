    "getproducts": {
        "definition": {
            "qs": {
                "f": "{{parameters.f}}",
                "q": "{{parameters.q}}",
                "filters": "{{parameters.filters}}",
                "page_id": "{{parameters.page_id}}",
                "page_no": "{{parameters.page_no}}",
                "sort_on": "{{parameters.sort_on}}",
                "page_size": "{{parameters.page_size}}",
                "page_type": "{{parameters.page_type}}"
            },
            "url": "https://api.fynd.com/service/application/catalog/v1.0/products",
            "body": {},
            "method": "get",
            "headers": {
                "Authorization": "Bearer convertBufferBase64String({{secrets.api_key}}:{{secrets.api_secret}})"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": ""
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {},
                    "description": "The search query for entering partial or full name of product, brand, category, or collection.",
                    "displayName": "q",
                    "displayType": "text"
                },
                "name": "q"
            },
            {
                "meta": {
                    "validation": {},
                    "description": "The search filter parameters. Filter parameters will be passed in f parameter as shown in the example below. Double Pipe (||) denotes the OR condition, whereas Triple-colon (:::) indicates a new filter paramater applied as an AND condition.",
                    "displayName": "f",
                    "displayType": "text"
                },
                "name": "f"
            },
            {
                "meta": {
                    "value": true,
                    "options": [
                        {
                            "label": "True",
                            "value": "true"
                        },
                        {
                            "label": "False",
                            "value": "false"
                        }
                    ],
                    "validation": {},
                    "description": "This is a boolean value, True for fetching all filter parameters and False for disabling the filter parameters.",
                    "displayName": "filters",
                    "displayType": "select"
                },
                "name": "filters"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "latest",
                            "value": "latest"
                        },
                        {
                            "label": "popular",
                            "value": "popular"
                        },
                        {
                            "label": "price_asc",
                            "value": "price_asc"
                        },
                        {
                            "label": "price_dsc",
                            "value": "price_dsc"
                        },
                        {
                            "label": "discount_asc",
                            "value": "discount_asc"
                        },
                        {
                            "label": "discount_dsc",
                            "value": "discount_dsc"
                        }
                    ],
                    "htmlProps": {
                        "allowDynamic": true
                    },
                    "validation": {},
                    "description": "The order in which the list of products should be sorted, e.g. popularity, price, latest and discount, in either ascending or descending order. See the supported values below.",
                    "displayName": "sort_on",
                    "displayType": "select"
                },
                "name": "sort_on"
            },
            {
                "meta": {
                    "validation": {},
                    "description": "Page ID to retrieve next set of results.",
                    "displayName": "page_id",
                    "displayType": "text"
                },
                "name": "page_id"
            },
            {
                "meta": {
                    "value": 12,
                    "validation": {},
                    "description": "The number of items to retrieve in each page.",
                    "displayName": "page_size",
                    "displayType": "number"
                },
                "name": "page_size"
            },
            {
                "meta": {
                    "value": 1,
                    "validation": {},
                    "description": "The page number to navigate through the given set of results.",
                    "displayName": "page_no",
                    "displayType": "number"
                },
                "name": "page_no"
            },
            {
                "meta": {
                    "value": "cursor",
                    "validation": {},
                    "description": "Available pagination types are cursor or number.",
                    "displayName": "page_type",
                    "displayType": "text"
                },
                "name": "page_type"
            }
        ]
