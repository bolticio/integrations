{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "List Segments",
                        "value": "segments.list"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform.",
                "displayName": "Operation",
