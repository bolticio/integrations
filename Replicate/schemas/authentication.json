{
    "api_key": {
        "validate": {
            "url": "https://api.replicate.com/v1/account",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.detail}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "API key is mandatory"
                        }
                    },
                    "description": "Refer to the Replicate authentication documentation for detailed instructions on getting your API key.",
                    "displayName": "API Key",
                    "displayType": "password",
                    "placeholder": "Enter API key",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "api_key",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "api_key"
            }
        ]
    },
    "parameters": [
        {
            "meta": {
                "value": "api_key",
                "options": [
                    {
                        "label": "API Key",
                        "value": "api_key"
                    }
                ],
                "isDisabled": true,
                "validation": {
                    "required": true
                },
                "description": "Authenticate Replicate account using an API key",
                "displayName": "Replicate Authentication Type",
                "displayType": "select",
                "placeholder": "Select a Replicate authentication type"
            },
            "name": "type"
        }
    ]
}
