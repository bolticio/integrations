            "body": {
                "name": "{{parameters.name}}",
                "model": "{{parameters.model}}",
                "version": "{{parameters.version}}",
                "hardware": "{{parameters.hardware}}",
                "max_instances": "{{parameters.max_instances}}",
                "min_instances": "{{parameters.min_instances}}"
            },
            "method": "post",
