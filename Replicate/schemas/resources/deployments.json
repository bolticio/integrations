{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create a Deployment",
                        "value": "deployments.create",
                        "description": "Creates a new deployment for a model version."
                    },
                    {
                        "label": "List Deployments",
                        "value": "deployments.list",
                        "description": "Retrieves a paginated list of your deployments."
                    },
                    {
                        "label": "Get a Deployment",
                        "value": "deployments.get",
                        "description": "Retrieves a single deployment by owner and name."
                    },
                    {
                        "label": "Update a Deployment",
                        "value": "deployments.update",
                        "description": "Updates the configuration of an existing deployment."
                    },
                    {
                        "label": "Delete a Deployment",
                        "value": "deployments.delete",
                        "description": "Deletes a deployment that has been offline for 15+ minutes."
                    },
                    {
                        "label": "Create Prediction via Deployment",
                        "value": "deployments.create_prediction",
                        "description": "Runs a model using a specific deployment."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is required"
                    }
                },
                "description": "Select the operation you want to perform on Deployments.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "deployments",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create_prediction": {
        "definition": {
            "url": "https://api.replicate.com/v1/deployments/{{parameters.deployment_owner}}/{{parameters.deployment_name}}/predictions",
            "body": {
                "input": "{{parameters.input}}",
                "webhook": "{{parameters.webhook}}",
                "webhook_events_filter": "{{parameters.webhook_events_filter}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.detail}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "if (typeof body.input !== 'string') { return body; } const trimmedInput = body.input.trim(); if (trimmedInput.startsWith('{{') && trimmedInput.endsWith('}}')) { return body; } if (!trimmedInput) { throw new Error('Input must be a valid JSON object.'); } const parsedInput = JSON.parse(trimmedInput); if (!parsedInput || Array.isArray(parsedInput) || typeof parsedInput !== 'object') { throw new Error('Input must be a JSON object.'); } return { ...body, input: parsedInput };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Deployment owner is required"
                        }
                    },
                    "description": "The owner of the deployment to run.",
                    "displayName": "Deployment Owner",
                    "displayType": "text",
                    "placeholder": "e.g. my-username",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "deployments.create_prediction",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "deployment_owner"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Deployment name is required"
                        }
                    },
                    "description": "The name of the deployment to run.",
                    "displayName": "Deployment Name",
                    "displayType": "text",
                    "placeholder": "e.g. my-app-deployment",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "deployments.create_prediction",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "deployment_name"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "md",
                        "language": "json",
                        "fullscreen": true,
                        "showSuggestions": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Input is required"
                        }
                    },
                    "description": "The model's input as a JSON object.",
                    "displayName": "Input",
                    "displayType": "code",
                    "placeholder": "{ \"prompt\": \"A beautiful landscape\" }",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "deployments.create_prediction",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "input"
            },
            {
                "meta": {
                    "description": "Optional. An HTTPS URL to receive a POST when the prediction completes.",
                    "displayName": "Webhook URL",
                    "displayType": "url",
                    "placeholder": "https://example.com/webhook",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "deployments.create_prediction",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "webhook"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Start",
                            "value": "start"
                        },
                        {
                            "label": "Output",
                            "value": "output"
                        },
                        {
                            "label": "Logs",
                            "value": "logs"
                        },
                        {
                            "label": "Completed",
                            "value": "completed"
                        }
                    ],
                    "description": "Optional. Filter which lifecycle events trigger the webhook.",
                    "displayName": "Webhook Events Filter",
                    "displayType": "multiselect",
                    "placeholder": "Select events",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "deployments.create_prediction",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "webhook_events_filter"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://api.replicate.com/v1/deployments",
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.detail}}"
                },
                "output": "{{response.data.results}}"
            },
            "pagination": {
                "qs": {},
                "type": "url",
                "default": {
                    "next_url": null
                },
                "next_url": "{{response.data.next}}",
                "condition": "{{response.data.next}} != null"
            }
        },
        "parameters": []
    },
