                },
                "output": "{{response.data}}"
            },
            "transform": {
                "output": "return { message: 'Model version has been deleted successfully' };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Model owner is required"
                        }
                    },
