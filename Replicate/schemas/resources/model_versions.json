                                "field": "operation",
                                "value": "model_versions.delete",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "model_name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Version ID is required"
                        }
                    },
                    "description": "The ID of the model version to delete.",
                    "displayName": "Version ID",
