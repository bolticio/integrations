{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Get a Model",
                        "value": "models.get",
                        "description": "Retrieves a single model by owner and name."
                    },
                    {
                        "label": "Create a Model",
                        "value": "models.create",
                        "description": "Creates a new model under your account."
                    },
                    {
                        "label": "Update Model Metadata",
                        "value": "models.update",
                        "description": "Updates metadata fields on an existing model."
                    },
                    {
                        "label": "Delete a Model",
                        "value": "models.delete",
                        "description": "Deletes a private model that has no versions."
                    },
                    {
                        "label": "Create Prediction Using Model",
                        "value": "models.create_prediction",
                        "description": "Runs an official model directly without specifying a version."
                    },
                    {
                        "label": "Get Model README",
                        "value": "models.get_readme",
                        "description": "Retrieves the README for a model in Markdown format."
                    },
                    {
                        "label": "List Model Examples",
                        "value": "models.list_examples",
                        "description": "Retrieves a list of example predictions for a model."
                    },
                    {
                        "label": "Search Public Models",
                        "value": "models.search",
                        "description": "Search public models using a plain-text query (QUERY method)."
                    }
                ],
                "validation": {
                    "required": true,
                    "requiredDetail": {
                        "errorMsg": "Operation is required"
                    }
                },
                "description": "Select the operation you want to perform on Models.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "models",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "create_prediction": {
        "definition": {
            "url": "https://api.replicate.com/v1/models/{{parameters.model_owner}}/{{parameters.model_name}}/predictions",
            "body": {
                "input": "{{parameters.input}}",
                "webhook": "{{parameters.webhook}}",
                "webhook_events_filter": "{{parameters.webhook_events_filter}}"
            },
            "method": "post",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.api_key}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.detail}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "if (typeof body.input !== 'string') { return body; } const trimmedInput = body.input.trim(); if (trimmedInput.startsWith('{{') && trimmedInput.endsWith('}}')) { return body; } if (!trimmedInput) { throw new Error('Input must be a valid JSON object.'); } const parsedInput = JSON.parse(trimmedInput); if (!parsedInput || Array.isArray(parsedInput) || typeof parsedInput !== 'object') { throw new Error('Input must be a JSON object.'); } return { ...body, input: parsedInput };"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Model owner is required"
                        }
                    },
                    "description": "The owner of the official model to run.",
                    "displayName": "Model Owner",
                    "displayType": "text",
                    "placeholder": "e.g. stability-ai",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "models.create_prediction",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "model_owner"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Model name is required"
                        }
                    },
                    "description": "The name of the official model to run.",
                    "displayName": "Model Name",
                    "displayType": "text",
                    "placeholder": "e.g. stable-diffusion",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "models.create_prediction",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "model_name"
            },
            {
                "meta": {
                    "htmlProps": {
                        "size": "md",
                        "language": "json",
                        "fullscreen": true,
                        "showSuggestions": true
                    },
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Input is required"
                        }
                    },
                    "description": "The model's input as a JSON object. Keys depend on the specific model.",
                    "displayName": "Input",
                    "displayType": "code",
                    "placeholder": "{ \"prompt\": \"A beautiful landscape\" }",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "models.create_prediction",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "input"
            },
            {
                "meta": {
                    "description": "Optional. An HTTPS URL to receive a POST when the prediction completes.",
                    "displayName": "Webhook URL",
                    "displayType": "url",
                    "placeholder": "https://example.com/webhook",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "models.create_prediction",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "webhook"
            },
            {
                "meta": {
                    "options": [
                        {
                            "label": "Start",
                            "value": "start"
                        },
                        {
                            "label": "Output",
                            "value": "output"
                        },
                        {
                            "label": "Logs",
                            "value": "logs"
                        },
                        {
                            "label": "Completed",
                            "value": "completed"
                        }
                    ],
                    "description": "Optional. Filter which lifecycle events trigger the webhook.",
                    "displayName": "Webhook Events Filter",
                    "displayType": "multiselect",
                    "placeholder": "Select events",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "operation",
                                "value": "models.create_prediction",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "webhook_events_filter"
            }
        ]
    },
