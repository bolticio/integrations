{
    "parameters": [
        {
            "meta": {
                "value": "access_token",
                "options": [
                    {
                        "label": "Access Token",
                        "value": "access_token"
                    }
                ],
                "displayName": "Authentication Type",
                "displayType": "hidden"
            },
            "name": "type"
        }
    ],
    "access_token": {
        "validate": {
            "url": "https://api.stripe.com/v1/account",
            "method": "get",
            "headers": {
                "Authorization": "Bearer {{secrets.access_token}}"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.error.message}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "API Secret Key is required"
                        }
                    },
                    "description": "Refer to the <a href='https://stripe.com/docs/keys' target='blank'>Stripe authentication documentation</a> for detailed instructions on getting your API keys.",
                    "displayName": "API Secret Key",
                    "displayType": "password",
                    "placeholder": "sk_live_... or sk_test_...",
                    "dependencies": {
                        "conditions": [
                            {
                                "field": "type",
                                "value": "access_token",
                                "operator": "EQUALS"
                            }
                        ]
                    }
                },
                "name": "access_token"
            }
        ]
    }
}
