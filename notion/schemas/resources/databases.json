                                    },
                                    {
                                        "label": "Phone Number",
                                        "value": "phone_number"
                                    },
                                    {
                                        "label": "Rich Text",
                                        "value": "rich_text"
                                    }
                                ],
                                "validation": {
                                    "required": true
                                },
                                "description": "Choose the type of authentication you want to use.",
                                "displayName": "Property Value",
                                "displayType": "select",
                                "placeholder": "Select an property type"
                            },
                            "name": "propertyValue"
                        }
                    ],
                    "validation": {
                        "required": true
                    },
                    "description": "An array of properites . Each object should have a label and value.",
                    "displayName": "Properties",
                    "displayType": "array"
                },
                "name": "properties"
            }
        ]
