{
    "getPages": {
        "definition": {
            "url": "https://api.notion.com/v1/search",
            "body": {
                "query": "",
                "filter": {
                    "value": "page",
                    "property": "object"
                }
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}",
                "Notion-Version": "2022-06-28"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data.results}}"
            },
            "transform": {
                "output": "return output.map((page) => { let name = 'Untitled'; const url = page.url; if (url) { const matches = url.match(/https:\\/\\/www\\.notion\\.so\\/(.+)-[a-zA-Z0-9]+$/); if (matches && matches[1]) { name = matches[1].replace(/-/g, ' ').trim(); } } return { id: page.id, name }; });"
            }
        }
    },
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Query a Database",
                        "value": "databases.query"
                    },
                    {
                        "label": "Create a New Database",
                        "value": "databases.create"
                    },
                    {
                        "label": "Update Database Information",
                        "value": "databases.update"
                    },
                    {
                        "label": "Retrieve a Database",
                        "value": "databases.retrieve"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select the operation you want to perform on Notion databases.",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": {
                    "conditions": [
                        {
                            "field": "resource",
                            "value": "databases",
                            "operator": "EQUALS"
                        }
                    ]
                }
            },
            "name": "operation"
        }
    ],
    "getDatabases": {
        "definition": {
            "url": "https://api.notion.com/v1/search",
            "body": {
                "query": "",
                "filter": {
                    "value": "database",
                    "property": "object"
                }
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}",
                "Notion-Version": "2022-06-28"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "output": "const updatedRes = (output?.results || []).map((db) => ({ name: db?.title?.[0]?.plain_text || 'Untitled', id: db?.id })); return updatedRes;"
            }
        },
        "parameters": []
    },
    "update": {
        "definition": {
            "url": "https://api.notion.com/v1/databases/{{parameters.database_id}}",
            "body": {
                "icon": {
                    "type": "emoji",
                    "emoji": "{{parameters.icon}}"
                },
                "cover": {
                    "type": "external",
                    "external": {
                        "url": "{{parameters.cover}}"
                    }
                },
                "title": [
                    {
                        "text": {
                            "content": "{{parameters.title}}"
                        }
                    }
                ],
                "properties": "{{parameters.properties}}"
            },
            "method": "patch",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}",
                "Notion-Version": "2022-06-28"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const updatedBody = { ...body }; updatedBody.properties = updatedBody.properties.reduce((acc, property) => { acc[property.propertyName] = { [property.propertyValue]: {} }; return acc; }, {}); if (updatedBody.propertyTitle) { updatedBody.properties[updatedBody.propertyTitle] = { title: {} }; } if (!updatedBody.icon || !updatedBody.icon.emoji || Object.keys(updatedBody.icon).length === 0) { delete updatedBody.icon; } if (!updatedBody.cover || !updatedBody.cover.external || !updatedBody.cover.external.url || Object.keys(updatedBody.cover).length === 0) { delete updatedBody.cover; } if (!updatedBody.title || !Array.isArray(updatedBody.title) || updatedBody.title.length === 0 || !updatedBody.title[0]?.text?.content) { delete updatedBody.title; } delete updatedBody.propertyTitle; return updatedBody;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "notion",
                            "secret": "{{parameters.secret}}",
                            "resource": "databases",
                            "operation": "databases.update",
                            "loadOptionsMethod": "getDatabases"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Database ID is required to update the database."
                        }
                    },
                    "description": "Select the Notion database to update.",
                    "displayName": "Database",
                    "displayType": "select",
                    "placeholder": "Select a database"
                },
                "name": "database_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The title of the Notion database to be updated.",
                    "displayName": "Database Title",
                    "displayType": "text",
                    "placeholder": "Enter the title of the database"
                },
                "name": "title"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "An emoji to represent the database.",
                    "displayName": "Database icon",
                    "displayType": "text",
                    "placeholder": "Enter an emoji"
                },
                "name": "icon"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "A header or banner image URL for the database.",
                    "displayName": "Database Cover",
                    "displayType": "text",
                    "placeholder": "Enter the database cover URL"
                },
                "name": "cover"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "The title of the Notion database row to be created.",
                    "displayName": "Property Title",
                    "displayType": "text",
                    "placeholder": "Enter the title of the database coloumns"
                },
                "name": "propertyTitle"
            },
            {
                "meta": {
                    "children": [
                        {
                            "meta": {
                                "validation": {
                                    "required": true
                                },
                                "displayName": "Property Name",
                                "displayType": "text",
                                "placeholder": "Enter the name for the properites"
                            },
                            "name": "propertyName"
                        },
                        {
                            "meta": {
                                "options": [
                                    {
                                        "label": "Title",
                                        "value": "title"
                                    },
                                    {
                                        "label": "URL",
                                        "value": "url"
                                    },
                                    {
                                        "label": "Email",
                                        "value": "email"
                                    },
                                    {
                                        "label": "Files",
                                        "value": "file"
                                    },
                                    {
                                        "label": "Checkbox",
                                        "value": "checkbox"
                                    },
                                    {
                                        "label": "Created By",
                                        "value": "created_by"
                                    },
                                    {
                                        "label": "Created Time",
