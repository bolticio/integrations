    "create": {
        "definition": {
            "url": "https://api.notion.com/v1/databases/",
            "body": {
                "icon": {
                    "type": "emoji",
                    "emoji": "{{parameters.icon}}"
                },
                "cover": {
                    "external": {
                        "url": "{{parameters.cover}}"
                    }
                },
                "title": [
                    {
                        "text": {
                            "link": null,
                            "content": "{{parameters.title}}"
                        },
                        "type": "text"
                    }
                ],
                "parent": {
                    "type": "page_id",
                    "page_id": "{{parameters.page_id}}"
                },
                "properties": "{{parameters.properties}}",
                "propertyTitle": "{{parameters.propertyTitle}}"
            },
            "method": "post",
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer {{secrets.access_token}}",
                "Notion-Version": "2022-06-28"
            },
            "response": {
                "error": {
                    "code": "{{response.status}}",
                    "message": "{{response.data.message}}"
                },
                "output": "{{response.data}}"
            },
            "transform": {
                "body": "const updatedBody = { ...body }; updatedBody.properties = updatedBody.properties.reduce((acc, property) => { acc[property.propertyName] = { [property.propertyValue]: {} }; return acc; }, {}); if (updatedBody.propertyTitle) { updatedBody.properties[`${updatedBody.propertyTitle}`] = { title: {} }; } if (!updatedBody.icon || !updatedBody.icon.emoji || Object.keys(updatedBody.icon).length === 0) { delete updatedBody.icon; } if (!updatedBody.cover || !updatedBody.cover.external || !updatedBody.cover.external.url || Object.keys(updatedBody.cover).length === 0) { delete updatedBody.cover; } delete updatedBody.propertyTitle; return updatedBody;"
            }
        },
        "parameters": [
            {
                "meta": {
                    "config": {
                        "url": "integrations/options",
                        "body": {
                            "name": "notion",
                            "secret": "{{parameters.secret}}",
                            "resource": "databases",
                            "operation": "databases.create",
                            "loadOptionsMethod": "getPages"
                        },
                        "method": "post",
                        "urlType": "options",
                        "labelKey": "name",
                        "valueKey": "id"
                    },
                    "options": [],
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Parent page ID is required to create the database."
                        }
                    },
                    "description": "Select the Notion page to create DB.",
                    "displayName": "page",
                    "displayType": "select",
                    "placeholder": "Select a page"
                },
                "name": "page_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "An emoji to represent the database.",
                    "displayName": "Database icon",
                    "displayType": "text",
                    "placeholder": "Enter an emoji"
                },
                "name": "icon"
            },
            {
                "meta": {
                    "validation": {
                        "required": false
                    },
                    "description": "A header or banner image URL for the database.",
                    "displayName": "Database Cover",
                    "displayType": "text",
                    "placeholder": "Enter the database cover URL"
                },
                "name": "cover"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The title of the Notion database to be updated.",
                    "displayName": "Database Title",
                    "displayType": "text",
                    "placeholder": "Enter the title of the database"
                },
                "name": "title"
            },
            {
                "meta": {
                    "validation": {
