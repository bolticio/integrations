{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Badge Assignment",
                        "value": "badge_assignments.create",
                        "description": "Shows Information About A Single Badge Assignment"
                    },
                    {
                        "label": "List Badge Assignments",
                        "value": "badge_assignments.list",
                        "description": "List All Badge Assignments"
                    },
                    {
                        "label": "Delete Badge Assignment",
                        "value": "badge_assignments.delete",
                        "description": "Delete An Existing Badge Assignment"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select The Operation You Want To Perform",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": [
                    {
                        "field": "resource",
                        "value": "badge_assignments",
                        "operator": "EQUALS"
                    }
                ]
            },
            "name": "operation"
        }
    ],
    "delete": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badges/{{parameters.badge_id}}",
            "body": {
                "data": "{{secrets}}",
                "badge": {
                    "badge_id": "{{parameters.badge_id}}"
                }
            },
            "method": "DELETE",
            "headers": {
                "Accept": "application/json",
                "ContentType": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Badge ID You Want To Delete",
                    "displayName": "Badge ID",
                    "displayType": "text",
                    "placeholder": "Enter The Badge ID"
                },
                "name": "badge_id"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badge_assignments",
            "body": {
                "data": "{{secrets}}",
                "badge_assignment": {
                    "user_id": "{{parameters.user_id}}",
                    "badge_id": "{{parameters.badge_id}}"
                }
            },
            "method": "POST",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Badge ID Of The Badge Assignment",
                    "displayName": "Badge ID",
                    "displayType": "text",
                    "placeholder": "Enter The Badge ID"
                },
                "name": "badge_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The User ID Of The Badge Assignment",
                    "displayName": "User ID",
                    "displayType": "text",
                    "placeholder": "Enter The User ID"
                },
                "name": "user_id"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badge_assignments",
            "body": {
                "data": "{{secrets}}"
            },
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    },
    "get": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badge_categories/{{parameters.badge_category_id}}",
            "body": {
                "data": "{{secrets}}",
                "badge_category": {
                    "badge_category_id": "{{parameters.badge_category_id}}"
                }
            },
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Badge Category Id For Category",
                    "displayName": "Badge Category ID",
                    "displayType": "text",
                    "placeholder": "Enter the Badge Category ID"
                },
                "name": "badge_category_id"
            }
        ]
    },
    "update": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badges/{{parameters.badge_id}}",
            "body": {
                "data": "{{secrets}}",
                "badge": {
                    "name": "{{parameters.name}}",
                    "description": "{{parameters.description}}",
                    "badge_category_id": "{{parameters.badge_category_id}}"
                }
            },
            "method": "PUT",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Badge Category ID For Updating The Existing Badge",
                    "displayName": "Badge Category ID",
                    "displayType": "text",
                    "placeholder": "Enter Badge Category ID"
                },
                "name": "badge_category_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Name For Updating The Existing Badge",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter The Badge Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Description For Updating The Existing Badge",
                    "displayName": "Description",
                    "displayType": "text",
                    "placeholder": "Enter Description"
                },
                "name": "description"
            }
        ]
    }
}
