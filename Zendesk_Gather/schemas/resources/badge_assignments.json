{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Badge Assignment",
                        "value": "badge_assignments.create",
                        "description": "Shows Information About A Single Badge Assignment"
                    },
                    {
                        "label": "List Badge Assignments",
                        "value": "badge_assignments.list",
                        "description": "List All Badge Assignments"
                    },
                    {
                        "label": "Delete Badge Assignment",
                        "value": "badge_assignments.delete",
                        "description": "Delete An Existing Badge Assignment"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select The Operation You Want To Perform",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": [
                    {
                        "field": "resource",
                        "value": "badge_assignments",
                        "operator": "EQUALS"
                    }
                ]
            },
            "name": "operation"
        }
    ],
    "list": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badge_assignments",
            "body": {
                "data": "{{secrets}}"
            },
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": []
    },
    "create": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badge_assignments",
            "body": {
                "data": "{{secrets}}",
                "badge_assignment": {
                    "user_id": "{{parameters.user_id}}",
                    "badge_id": "{{parameters.badge_id}}"
                }
            },
            "method": "POST",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Badge ID Of The Badge Assignment",
                    "displayName": "Badge ID",
                    "displayType": "text",
                    "placeholder": "Enter The Badge ID"
                },
                "name": "badge_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The User ID Of The Badge Assignment",
                    "displayName": "User ID",
                    "displayType": "text",
                    "placeholder": "Enter The User ID"
                },
                "name": "user_id"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badge_assignments/{{parameters.badge_id}}",
            "body": {
                "data": "{{secrets}}",
                "badge_assignment": {
                    "badge_id": "{{parameters.badge_id}}"
                }
            },
            "method": "DELETE",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Badge Assignment ID Of The Badge Assignment",
                    "displayName": " Badge Assignment ID",
                    "displayType": "text",
                    "placeholder": "Enter the  Badge Assignment ID"
                },
                "name": "badge_id"
            }
        ]
    }
}
