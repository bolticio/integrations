{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Badge",
                        "value": "badge.create",
                        "description": "Add A New Badge To Your Zendesk Gather Community"
                    },
                    {
                        "label": "List Badges",
                        "value": "badge.list",
                        "description": "Retrieve All Badges Available In Your Account"
                    },
                    {
                        "label": "Get Badge ID",
                        "value": "badge.get",
                        "description": "Fetch Badge Details By Providing The Badge Id"
                    },
                    {
                        "label": "Update Badge",
                        "value": "badge.update",
                        "description": "Update Badge Details Like Name Or Description"
                    },
                    {
                        "label": "Delete Badge",
                        "value": "badge.delete",
                        "description": "Remove An Existing Badge Using The Badge Id"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select The Operation You Want To Perform",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": [
                    {
                        "field": "resource",
                        "value": "badge",
                        "operator": "EQUALS"
                    }
                ]
            },
            "name": "operation"
        }
    ],
    "delete": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badges/{{parameters.badge_id}}",
            "body": {
                "data": "{{secrets}}",
                "badge": {
                    "badge_id": "{{parameters.badge_id}}"
                }
            },
            "method": "DELETE",
            "headers": {
                "Accept": "application/json",
                "ContentType": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Badge ID You Want To Delete",
                    "displayName": "Badge ID",
                    "displayType": "text",
                    "placeholder": "Enter The Badge ID"
                },
                "name": "badge_id"
            }
        ]
    },
    "create": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badges",
            "body": {
                "data": "{{secrets}}",
                "badge": {
                    "name": "{{parameters.name}}",
                    "brand_id": "{{parameters.brand_id}}",
                    "description": "{{parameters.description}}",
                    "badge_category_id": "{{parameters.badge_category_id}}"
                }
            },
            "method": "POST",
            "headers": {
                "Accept": "application/json",
                "ContentType": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Name For Badge",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter The Badge Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Description For Badge",
                    "displayName": "Description",
                    "displayType": "text",
                    "placeholder": "Enter The Description"
                },
                "name": "description"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter Your Brand ID",
                    "displayName": "Brand ID",
                    "displayType": "text",
                    "placeholder": "Enter The Brand ID"
                },
                "name": "brand_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Badge Category ID",
                    "displayName": "Badge  Category ID",
                    "displayType": "text",
                    "placeholder": "Enter Badge Category ID"
                },
                "name": "badge_category_id"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badges",
            "body": {
                "data": "{{secrets}}",
                "badge": {
                    "brand_id": "{{parameters.brand_id}}"
                }
            },
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter Your Brand ID",
                    "displayName": "Brand ID",
                    "displayType": "text",
                    "placeholder": "Enter The Brand ID"
                },
                "name": "brand_id"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badges/{{parameters.badge_id}}",
            "body": {
                "data": "{{secrets}}",
                "badge_id": "{{parameters.badge_id}}"
            },
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The badge ID Given By The Zendesk",
                    "displayName": "Badge ID",
                    "displayType": "text",
                    "placeholder": "Enter Badge ID"
                },
                "name": "badge_id"
            }
        ]
    },
    "update": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badges/{{parameters.badge_id}}",
            "body": {
                "data": "{{secrets}}",
                "badge": {
                    "name": "{{parameters.name}}",
                    "description": "{{parameters.description}}",
                    "badge_category_id": "{{parameters.badge_category_id}}"
                }
            },
            "method": "PUT",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Badge Category ID For Updating The Existing Badge",
                    "displayName": "Badge Category ID",
                    "displayType": "text",
                    "placeholder": "Enter Badge Category ID"
                },
                "name": "badge_category_id"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Name For Updating The Existing Badge",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter The Badge Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Description For Updating The Existing Badge",
                    "displayName": "Description",
