{
    "parameters": [
        {
            "meta": {
                "options": [
                    {
                        "label": "Create Badge Category",
                        "value": "badge_categories.create",
                        "description": "Add A New Badge To Recognize Community Members"
                    },
                    {
                        "label": "List Badge Categories",
                        "value": "badge_categories.list",
                        "description": "Retrieve All Badges Available In The Community"
                    },
                    {
                        "label": "Get By Badge Category ID",
                        "value": "badge_categories.get",
                        "description": "Display Details Of A Single Badge"
                    },
                    {
                        "label": "Delete Badge Category",
                        "value": "badge_categories.delete",
                        "description": "Remove A Badge From The Community"
                    }
                ],
                "validation": {
                    "required": true
                },
                "description": "Select The Operation You Want To Perform",
                "displayName": "Operation",
                "displayType": "select",
                "placeholder": "Select an operation",
                "dependencies": [
                    {
                        "field": "resource",
                        "value": "badge_categories",
                        "operator": "EQUALS"
                    }
                ]
            },
            "name": "operation"
        }
    ],
    "create": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badge_categories",
            "body": {
                "data": "{{secrets}}",
                "badge_category": {
                    "name": "{{parameters.name}}",
                    "slug": "{{parameters.slug}}",
                    "brand_id": "{{parameters.brand_id}}"
                }
            },
            "method": "POST",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Give a meaningful name that represents the purpose of this badge category",
                    "displayName": "Name",
                    "displayType": "text",
                    "placeholder": "Enter the Name"
                },
                "name": "name"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "A Unique (Within The Brand) Textual Code Of The Badge Category",
                    "displayName": "Slug",
                    "displayType": "text",
                    "placeholder": "Enter the Slug"
                },
                "name": "slug"
            },
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "The Brand That The Badge Category Pertains To",
                    "displayName": "Brand ID",
                    "displayType": "text",
                    "placeholder": "Enter the Brand ID"
                },
                "name": "brand_id"
            }
        ]
    },
    "list": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badge_categories",
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Brand Id For Category",
                    "displayName": "Brand ID",
                    "displayType": "text",
                    "placeholder": "Enter the Brand ID"
                },
                "name": "brand_id"
            }
        ]
    },
    "get": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badge_categories/{{parameters.badge_category_id}}",
            "body": {
                "data": "{{secrets}}",
                "badge_category": {
                    "badge_category_id": "{{parameters.badge_category_id}}"
                }
            },
            "method": "GET",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Badge Category Id For Category",
                    "displayName": "Badge Category ID",
                    "displayType": "text",
                    "placeholder": "Enter the Badge Category ID"
                },
                "name": "badge_category_id"
            }
        ]
    },
    "delete": {
        "definition": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/gather/badge_categories/{{parameters.badge_id}}",
            "body": {
                "data": "{{secrets}}",
                "badge_category": {
                    "badge_id": "{{parameters.badge_id}}"
                }
            },
            "method": "DELETE",
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true
                    },
                    "description": "Enter The Badge Category Id For Category (If It's Not Attach To Any Badge)",
                    "displayName": "Badge Category ID",
                    "displayType": "text",
                    "placeholder": "Enter the Badge Category ID"
                },
                "name": "badge_id"
            }
        ]
    }
}
