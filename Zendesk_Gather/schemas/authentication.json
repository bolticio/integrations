{
    "parameters": [
        {
            "meta": {
                "value": "api_credentials",
                "options": [
                    {
                        "label": "API Credentials",
                        "value": "api_credentials"
                    }
                ],
                "displayName": "Authentication Type",
                "displayType": "hidden"
            },
            "name": "type"
        }
    ],
    "api_credentials": {
        "validate": {
            "url": "https://{{secrets.subdomain}}.zendesk.com/api/v2/channels/voice/greeting_categories",
            "body": {
                "data": "{{secrets}}"
            },
            "method": "get",
            "headers": {
                "Accept": "application/json",
                "content-type": "application/json",
                "Authorization": "Basic convertBufferBase64String({{secrets.email}}/token:{{secrets.api_token}})"
            },
            "response": {
                "error": {
                    "status": "{{response.status}}",
                    "details": "{{response.data.errors}}"
                },
                "output": "{{response.data}}"
            }
        },
        "parameters": [
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Subdomain Is Required"
                        }
                    },
                    "description": "Your Subdomain For Authentication. For Example, If Your Zendesk Url Is https://yourcompany.zendesk.com, Your Subdomain Is 'yourcompany'",
                    "displayName": "Subdomain",
                    "displayType": "text",
                    "placeholder": "Enter Subdomain"
                },
                "name": "subdomain"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": "Email Is Required"
                        }
                    },
                    "description": "Your Email For Authentication",
                    "displayName": "Email",
                    "displayType": "text",
                    "placeholder": "Enter Email"
                },
                "name": "email"
            },
            {
                "meta": {
                    "validation": {
                        "required": true,
                        "requiredDetail": {
                            "errorMsg": " Api Token Is Required"
                        }
                    },
                    "description": "Your Zendesk Api Token (Not Password). You Can Generate This In Your Zendesk Admin Center Under Apps & Integrations > Apis > Api Tokens",
                    "displayName": "API Token",
                    "displayType": "password",
                    "placeholder": "Enter your Zendesk API Token"
                },
                "name": "api_token"
            }
        ]
    }
}
